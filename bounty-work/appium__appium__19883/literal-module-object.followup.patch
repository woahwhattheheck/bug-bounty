+function unwrapEmbeddedDriver(value: EmbeddedDriverModule): DriverClass {
+  if (isDriverClass(value)) {
+    return value;
+  }
+  const candidates = new Set<DriverClass>();
+  for (const exported of Object.values(value)) {
+    if (isDriverClass(exported)) {
