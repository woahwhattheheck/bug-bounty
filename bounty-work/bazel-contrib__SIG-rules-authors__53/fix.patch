+"""Tests for github_traffic. They use a fake transport, never the network."""
+
+import io
+import json
+import os
+import re
+import sys
+import tempfile
+import unittest
+import urllib.parse
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+import github_traffic  # noqa: E402
+
+API = "https://api.github.com"
+
+
+def _response(status=200, payload=None, headers=None, text=None):
+    if text is not None:
+        body = text.encode("utf-8")
+    elif payload is not None:
+        body = json.dumps(payload).encode("utf-8")
+    else:
+        body = b""
+    return github_traffic.HttpResponse(status, headers or {}, body)
+
+
+class FakeTransport:
+    """Serves canned responses keyed by (method, URL without query)."""
+
+    def __init__(self, routes=None):
+        # Each route maps to a response or a list of responses served in order.
+        self.routes = dict(routes or {})
+        self.calls = []
+
+    def __call__(self, method, url, headers, body=None, timeout=60):
+        self.calls.append(
+            {
+                "method": method,
+                "url": url,
+                "headers": headers,
+                "body": json.loads(body.decode("utf-8")) if body else None,
+            }
+        )
+        parts = urllib.parse.urlsplit(url)
+        base = f"{parts.scheme}://{parts.netloc}{parts.path}"
+        for key in ((method, url), (method, base)):
+            if key in self.routes:
+                route = self.routes[key]
+                if isinstance(route, list):
+                    return route.pop(0) if len(route) > 1 else route[0]
+                return route
+        return _response(404, {"message": "Not Found"})
+
+
+def _views(days):
+    """Builds a /traffic/views payload from {date: (count, uniques)}."""
+    return {
+        "count": sum(c for c, _ in days.values()),
+        "uniques": max([u for _, u in days.values()] or [0]),
+        "views": [
+            {"timestamp": d + "T00:00:00Z", "count": c, "uniques": u}
+            for d, (c, u) in sorted(days.items())
+        ],
+    }
+
+
+def _clones(days):
+    payload = _views(days)
+    payload["clones"] = payload.pop("views")
+    return payload
+
+
+def _traffic_routes(repo, views, clones, referrers=(), paths=()):
+    base = f"{API}/repos/{repo}/traffic"
+    return {
+        ("GET", base + "/views"): _response(payload=_views(views)),
+        ("GET", base + "/clones"): _response(payload=_clones(clones)),
+        ("GET", base + "/popular/referrers"): _response(payload=list(referrers)),
+        ("GET", base + "/popular/paths"): _response(payload=list(paths)),
+    }
+
+
+class TrafficToRowsTest(unittest.TestCase):
+    def test_converts_api_payloads(self):
+        traffic = {
+            "views": _views({"2026-10-01": (10, 4), "2026-10-02": (7, 3)}),
+            "clones": _clones({"2026-10-02": (2, 1)}),
+            "referrers": [{"referrer": "Google", "count": 5, "uniques": 2}],
+            "paths": [
+                {
+                    "path": "/bazelbuild/rules_python",
+                    "title": "rules_python",
+                    "count": 9,
+                    "uniques": 4,
+                }
+            ],
+        }
+        rows = github_traffic.traffic_to_rows(
+            "bazelbuild/rules_python", traffic, "2026-10-03"
+        )
+        self.assertEqual(
+            rows["views.csv"],
+            [
+                {
+                    "repo": "bazelbuild/rules_python",
+                    "date": "2026-10-01",
+                    "count": 10,
+                    "uniques": 4,
+                },
+                {
+                    "repo": "bazelbuild/rules_python",
+                    "date": "2026-10-02",
+                    "count": 7,
+                    "uniques": 3,
+                },
+            ],
+        )
+        self.assertEqual(
+            rows["clones.csv"],
+            [
+                {
+                    "repo": "bazelbuild/rules_python",
+                    "date": "2026-10-02",
+                    "count": 2,
+                    "uniques": 1,
+                }
+            ],
+        )
+        self.assertEqual(
+            rows["summary.csv"],
+            [
+                {
+                    "collected": "2026-10-03",
+                    "repo": "bazelbuild/rules_python",
+                    "views": 17,
+                    "views_uniques": 4,
+                    "clones": 2,
+                    "clones_uniques": 1,
+                }
+            ],
+        )
+        self.assertEqual(rows["referrers.csv"][0]["referrer"], "Google")
+        self.assertEqual(rows["paths.csv"][0]["title"], "rules_python")
+        self.assertEqual(rows["paths.csv"][0]["collected"], "2026-10-03")
+
+
+class TableTest(unittest.TestCase):
+    def setUp(self):
+        self.views = github_traffic.TABLES_BY_NAME["views.csv"]
+        self.referrers = github_traffic.TABLES_BY_NAME["referrers.csv"]
+
+    def _day(self, date, count, uniques, repo="o/r"):
+        return {"repo": repo, "date": date, "count": count, "uniques": uniques}
+
+    def test_daily_merge_keeps_history_and_largest_values(self):
+        existing = [
+            self._day("2026-09-01", 5, 2),
+            self._day("2026-09-02", 3, 1),  # partial day, grows later
+            self._day("2026-09-03", 8, 4),
+        ]
+        new = [
+            self._day("2026-09-02", 6, 2),
+            self._day("2026-09-03", 7, 4),  # never lower a recorded value
+            self._day("2026-09-04", 1, 1),
+            self._day("2026-09-04", 1, 1, repo="o/other"),
+        ]
+        merged = self.views.parse(self.views.format(self.views.merge(existing, new)))
+        self.assertEqual(
+            merged,
+            [
+                self._day("2026-09-04", 1, 1, repo="o/other"),
+                self._day("2026-09-01", 5, 2),
+                self._day("2026-09-02", 6, 2),
+                self._day("2026-09-03", 8, 4),
+                self._day("2026-09-04", 1, 1),
+            ],
+        )
+
+    def test_snapshot_merge_replaces_same_day_and_repo(self):
+        def ref(collected, repo, referrer, count):
+            return {
+                "collected": collected,
+                "repo": repo,
+                "referrer": referrer,
+                "count": count,
+                "uniques": 1,
+            }
+
+        existing = [
+            ref("2026-09-01", "o/r", "google.com", 4),
+            ref("2026-09-02", "o/r", "google.com", 5),
+            ref("2026-09-02", "o/r", "bing.com", 1),
+            ref("2026-09-02", "o/other", "github.com", 3),
+        ]
+        new = [ref("2026-09-02", "o/r", "github.com", 9)]
+        merged = self.referrers.merge(existing, new)
+        self.assertCountEqual(
+            merged,
