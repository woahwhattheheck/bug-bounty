+#include <string>
+#include <vector>
+
+namespace obs_vst3 {
+
+class ComponentHandler;
+
+struct ProcessingSetup {
+	double sampleRate = 0.0;
+	uint32_t speakerLayout = 0;
+	uint32_t channels = 0;
+	uint32_t maxBlockFrames = 0;
+	bool sidechain = false;
+};
+
+/*
+ * One instantiated VST3 audio effect: module, component/processor, edit
+ * controller and the buffers used to drive IAudioProcessor::process().
+ *
+ * Threading follows the VST3 specification: everything except process() is
+ * called on the main (UI) thread of the bridge process. process() runs on the
+ * audio thread; the caller guarantees that configure() and process() never
+ * run at the same time.
+ */
+class PluginInstance {
+public:
+	static std::unique_ptr<PluginInstance> load(const std::string &modulePath, const std::string &classId,
+						    Steinberg::FUnknown *hostContext, std::atomic<uint32_t> &editCount,
+						    std::string &error);
+	~PluginInstance();
+
+	PluginInstance(const PluginInstance &) = delete;
+	PluginInstance &operator=(const PluginInstance &) = delete;
+
+	const std::string &name() const { return name_; }
+	const std::string &vendor() const { return vendor_; }
+	bool hasEditor() const { return controller_ != nullptr; }
+	bool hasSidechainInput() const { return auxInputBus_ >= 0; }
+
+	bool configure(const ProcessingSetup &setup, std::string &error);
+	bool reconfigure(std::string &error);
+	bool isConfigured() const { return active_; }
+	uint32_t processedChannels() const;
+	bool sidechainActive() const { return sidechainActive_; }
+	int32_t latencySamples() const { return latencySamples_; }
+
+	bool process(void *sharedMemory, const ProcessRequest &request);
+
+	bool getState(std::vector<uint8_t> &componentState, std::vector<uint8_t> &controllerState, std::string &error);
+	bool setState(const std::vector<uint8_t> &componentState, const std::vector<uint8_t> &controllerState,
+		      std::string &error);
+
+	Steinberg::IPtr<Steinberg::IPlugView> createEditorView();
+
+	/* Main thread housekeeping. Returns the restart flags requested by the plug-in. */
+	Steinberg::int32 idle();
+
+private:
+	PluginInstance() = default;
+
+	bool initialize(const std::string &modulePath, const std::string &classId, Steinberg::FUnknown *hostContext,
