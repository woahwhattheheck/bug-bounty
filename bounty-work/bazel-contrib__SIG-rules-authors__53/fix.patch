+# Collects GitHub traffic (views, clones, referrers, popular paths) for the
+# repositories in TRAFFIC_ORG and publishes the history to a Gist.
+# See tools/github_traffic/README.md for the one-time setup.
+name: GitHub traffic
+
+on:
+  schedule:
+    # GitHub keeps 14 days of traffic, so any cadence under two weeks loses
+    # nothing. Daily runs keep the published data fresh.
+    - cron: "17 6 * * *"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: github-traffic
+  cancel-in-progress: false
+
+jobs:
+  collect:
+    if: github.repository == 'bazel-contrib/SIG-rules-authors'
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    env:
+      # Token of an account with push access to the repositories.
+      GITHUB_TRAFFIC_TOKEN: ${{ secrets.TRAFFIC_TOKEN }}
+      # Optional token with Gist write access, if different from the above.
+      GIST_TOKEN: ${{ secrets.TRAFFIC_GIST_TOKEN }}
+      TRAFFIC_ORG: ${{ vars.TRAFFIC_ORG || 'bazelbuild' }}
+      TRAFFIC_MATCH: ${{ vars.TRAFFIC_MATCH }}
+      TRAFFIC_GIST_ID: ${{ vars.TRAFFIC_GIST_ID }}
+    steps:
+      - uses: actions/checkout@v4
+      - name: Collect traffic
+        shell: bash
+        run: |
+          if [[ -z "${GITHUB_TRAFFIC_TOKEN}" ]]; then
+            echo "::notice::The TRAFFIC_TOKEN secret is not set; nothing to collect."
+            exit 0
+          fi
+          args=(--org "${TRAFFIC_ORG}" --output-dir traffic-data)
+          if [[ -n "${TRAFFIC_MATCH}" ]]; then
+            args+=(--match "${TRAFFIC_MATCH}")
+          fi
+          if [[ -n "${TRAFFIC_GIST_ID}" ]]; then
+            args+=(--gist-id "${TRAFFIC_GIST_ID}")
+          fi
+          status=0
+          python3 tools/github_traffic/github_traffic.py "${args[@]}" >summary.txt || status=$?
+          cat summary.txt
+          {
+            echo '```'
+            cat summary.txt
+            echo '```'
+          } >>"${GITHUB_STEP_SUMMARY}"
+          exit "${status}"
+      - uses: actions/upload-artifact@v4
+        if: always() && hashFiles('traffic-data/*.csv') != ''
+        with:
+          name: traffic-data
+          path: traffic-data/
+          retention-days: 90
