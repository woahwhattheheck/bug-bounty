diff --git a/test/service/filesystem/filesystem.service.test.ts b/test/service/filesystem/filesystem.service.test.ts
new file mode 100644
index 0000000..99085ad
--- /dev/null
+++ b/test/service/filesystem/filesystem.service.test.ts
@@ -0,0 +1,110 @@
+import { expect } from "chai";
+import * as fs from "fs-extra";
+import * as os from "os";
+import * as path from "path";
+
+import { CustomConfig } from "../../../src/models/customConfig.model";
+import { IExtensionState } from "../../../src/models/state.model";
+import { FileSystemService } from "../../../src/service/filesystem/filesystem.service";
+
+function createState(
+  userFolder: string,
+  customConfig: Partial<CustomConfig>
+): IExtensionState {
+  const defaults = {
+    ignoreUploadFiles: ["state.*", "syncLocalSettings.json", "sync.lock"],
+    ignoreUploadFolders: ["workspaceStorage", "globalStorage", "History"],
+    supportedFileExtensions: ["json", "code-snippets"],
+    fileSystemPath: ""
+  };
+  const settings = Object.assign({}, defaults, customConfig);
+  return ({
+    commons: {
+      InitalizeSettings: async () => ({ customConfig: settings })
+    },
+    environment: { USER_FOLDER: userFolder + path.sep },
+    instanceID: "test",
+    watcher: { HandleStopWatching: async () => undefined }
+  } as unknown) as IExtensionState;
+}
+
+describe("FileSystemService", () => {
+  let root: string;
+  let userA: string;
+  let userB: string;
+  let folder: string;
+
+  beforeEach(async () => {
+    root = await fs.mkdtemp(path.join(os.tmpdir(), "css-filesystem-"));
+    userA = path.join(root, "userA");
+    userB = path.join(root, "userB");
+    folder = path.join(root, "shared");
+    await fs.outputFile(path.join(userA, "settings.json"), '{"a": 1}');
+    await fs.outputFile(path.join(userA, "keybindings.json"), "[]");
+    await fs.outputFile(
+      path.join(userA, "snippets", "javascript.json"),
+      '{"log": {}}'
+    );
+    await fs.outputFile(path.join(userA, "sync.lock"), "");
+    await fs.outputFile(path.join(userA, "state.vscdb"), "binary");
+    await fs.outputFile(path.join(userA, "History", "entries.json"), "{}");
+  });
+
+  afterEach(async () => {
+    await fs.remove(root);
+  });
+
+  it("exports supported settings files and skips ignored ones", async () => {
+    const service = new FileSystemService(
+      createState(userA, { fileSystemPath: folder })
+    );
+    await service.Export();
+
+    expect(
+      await fs.readFile(path.join(folder, "settings.json"), "utf8")
+    ).to.equal('{"a": 1}');
+    expect(
+      await fs.readFile(
+        path.join(folder, "snippets", "javascript.json"),
+        "utf8"
+      )
+    ).to.equal('{"log": {}}');
+    expect(await fs.pathExists(path.join(folder, "sync.lock"))).to.equal(false);
+    expect(await fs.pathExists(path.join(folder, "state.vscdb"))).to.equal(
+      false
+    );
+    expect(await fs.pathExists(path.join(folder, "History"))).to.equal(false);
+  });
+
+  it("imports exported files into another user folder", async () => {
+    const config = { fileSystemPath: folder };
+    await new FileSystemService(createState(userA, config)).Export();
+    await new FileSystemService(createState(userB, config)).Import();
+
+    expect(
+      await fs.readFile(path.join(userB, "settings.json"), "utf8")
+    ).to.equal('{"a": 1}');
+    expect(
+      await fs.readFile(path.join(userB, "keybindings.json"), "utf8")
+    ).to.equal("[]");
+    expect(
+      await fs.readFile(path.join(userB, "snippets", "javascript.json"), "utf8")
+    ).to.equal('{"log": {}}');
+  });
+
+  it("does nothing when no folder is configured", async () => {
+    const service = new FileSystemService(createState(userA, {}));
+    expect(await service.IsConfigured()).to.equal(false);
+    await service.Export();
+    expect(await fs.pathExists(folder)).to.equal(false);
+  });
+
+  it("reports configured only when the folder exists", async () => {
+    const service = new FileSystemService(
+      createState(userA, { fileSystemPath: folder })
+    );
+    expect(await service.IsConfigured()).to.equal(false);
+    await fs.ensureDir(folder);
+    expect(await service.IsConfigured()).to.equal(true);
+  });
+});
