 frontend/OBSStudioAPI.cpp                  | 66 +++++++++++++++++
 frontend/OBSStudioAPI.hpp                  |  7 ++
 frontend/api/obs-frontend-api.cpp          | 38 ++++++++++
 frontend/api/obs-frontend-api.h            | 11 +++
 frontend/api/obs-frontend-internal.hpp     |  8 ++
 frontend/widgets/OBSBasic.hpp              |  7 ++
 frontend/widgets/OBSBasic_SceneFolders.cpp | 70 ++++++++++++++++++
 8 files changed, 292 insertions(+)

diff --git a/docs/sphinx/reference-frontend-api.rst b/docs/sphinx/reference-frontend-api.rst
index d1be586..816b928 100644
--- a/docs/sphinx/reference-frontend-api.rst
+++ b/docs/sphinx/reference-frontend-api.rst
@@ -64,6 +64,14 @@ Structures/Enumerations
      Triggered when a scenes has been added/removed/reordered by the
      user.
 
+   - **OBS_FRONTEND_EVENT_SCENE_FOLDERS_CHANGED**
+
+     Triggered when scene folders of the Scenes dock have been added,
+     removed or renamed, or when scenes have been moved into or out of a
+     folder.
+
+     .. versionadded:: 33.1
+
    - **OBS_FRONTEND_EVENT_TRANSITION_CHANGED**
 
      Triggered when the current transition has changed by the user.
@@ -313,6 +321,83 @@ Functions
 
 ---------------------------------------
 
+.. function:: char **obs_frontend_get_scene_folder_names(void)
+
+   Scene folders only organize the Scenes dock. They are not sources,
+   and scene enumeration functions like :c:func:`obs_frontend_get_scenes`
+   and :c:func:`obs_frontend_get_scene_names` keep returning every scene
+   (in the order of the Scenes dock) regardless of folders.
+
+   :return: The list of scene folder names, ending with NULL, in the order
+            of the Scenes dock.  The list is stored within one contiguous
+            segment of memory, so freeing the returned pointer with
+            :c:func:`bfree()` will free the entire list.
+
+   .. versionadded:: 33.1
+
+---------------------------------------
+
+.. function:: char *obs_frontend_get_scene_folder(obs_source_t *scene)
+
+   :param scene: A scene
+   :return: The name of the folder containing the scene, or NULL if the
+            scene is not inside a folder.  Free with :c:func:`bfree()`.
+
+   .. versionadded:: 33.1
+
+---------------------------------------
+
+.. function:: void obs_frontend_get_scene_folder_scenes(const char *folder, struct obs_frontend_source_list *sources)
+
+   :param folder:  Name of the scene folder
+   :param sources: Pointer to a :c:type:`obs_frontend_source_list`
+                   structure to receive the list of reference-incremented
+                   scenes inside the folder, in the order of the Scenes
+                   dock.  Release with :c:func:`obs_frontend_source_list_free`
+
+   .. versionadded:: 33.1
+
+---------------------------------------
+
+.. function:: bool obs_frontend_add_scene_folder(const char *name)
+
+   Adds an empty scene folder at the end of the Scenes dock.
+
+   :param name: Name of the folder
+   :return:     *false* if the name is empty or a folder with that name
+                already exists, *true* otherwise
+
+   .. versionadded:: 33.1
+
+---------------------------------------
+
+.. function:: bool obs_frontend_remove_scene_folder(const char *name)
+
+   Removes a scene folder. The scenes inside the folder are not removed,
+   they are moved out of the folder at the same position.
+
+   :param name: Name of the folder
+   :return:     *false* if the folder does not exist, *true* otherwise
+
+   .. versionadded:: 33.1
+
+---------------------------------------
+
+.. function:: bool obs_frontend_set_scene_folder(obs_source_t *scene, const char *folder)
+
+   Moves a scene into a scene folder (as its last scene), creating the
+   folder if it does not exist yet.
+
+   :param scene:  The scene to move
+   :param folder: Name of the folder, or NULL/empty to move the scene out
+                  of its folder
+   :return:       *false* if the scene is not in the Scenes dock, *true*
+                  otherwise
+
+   .. versionadded:: 33.1
+
+---------------------------------------
+
 .. function:: void obs_frontend_get_transitions(struct obs_frontend_source_list *sources)
 
    :param sources: Pointer to a :c:type:`obs_frontend_source_list`
