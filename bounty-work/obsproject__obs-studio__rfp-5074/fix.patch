new file mode 100644
index 0000000..7ed08d7
--- /dev/null
+++ b/plugins/obs-vst3/PluginCatalog_Linux.cpp
@@ -0,0 +1,47 @@
+#include "PluginCatalog.hpp"
+
+#include <util/platform.h>
+
+#include <cstdlib>
+#include <sstream>
+
+namespace obs_vst3 {
+
+/*
+ * https://steinbergmedia.github.io/vst3_dev_portal/pages/Technical+Documentation/Locations+Format/Plugin+Locations.html
+ * VST3_PATH (colon separated, as used by other Linux hosts) is searched first.
+ */
+std::vector<std::string> PluginCatalog::defaultSearchPaths()
+{
+	std::vector<std::string> paths;
+
+	const char *environmentPaths = std::getenv("VST3_PATH");
+	if (environmentPaths && *environmentPaths) {
+		std::stringstream stream(environmentPaths);
+		std::string path;
+		while (std::getline(stream, path, ':')) {
+			if (!path.empty()) {
+				paths.push_back(path);
+			}
+		}
+	}
+
+	if (os_file_exists("/.flatpak-info")) {
+		/* org.freedesktop.LinuxAudio.Plugins extensions */
+		paths.push_back("/app/extensions/Plugins/vst3");
+	}
+
+	const char *home = std::getenv("HOME");
+	if (home && *home) {
+		paths.push_back(std::string(home) + "/.vst3");
+	}
+
+	paths.push_back("/usr/lib/vst3");
+	paths.push_back("/usr/local/lib/vst3");
+	/* Used by distributions with separate 64-bit library directories. */
+	paths.push_back("/usr/lib64/vst3");
+
+	return paths;
+}
+
+} // namespace obs_vst3
