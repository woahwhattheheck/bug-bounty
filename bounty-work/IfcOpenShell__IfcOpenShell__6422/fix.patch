+class PrintPreviewFile(NewFile):
+    @pytest.fixture(autouse=True)
+    def setup_print_preview(self, setup, monkeypatch):
+        prefs = tool.Blender.get_addon_preferences()
+        monkeypatch.setattr(
+            prefs, "svg2png_command", json.dumps([[sys.executable, "-c", FAKE_SVG2PNG, "svg", "png", "dpi"]])
+        )
+        bpy.ops.bim.create_project()
+        tool.Project.save_test_project()
+        bpy.ops.bim.load_drawings()
+        bpy.ops.bim.add_drawing()
+        self.drawing = next(e for e in tool.Ifc.get().by_type("IfcAnnotation") if e.ObjectType == "DRAWING")
+        bpy.ops.bim.activate_drawing(drawing=self.drawing.id())
+        self.camera = tool.Ifc.get_object(self.drawing)
+        self.svg = tool.Drawing.get_document_uri(tool.Drawing.get_drawing_document(self.drawing))
+
+    def get_render_calls(self) -> list[str]:
+        background = subject.get_print_preview_background(self.camera.data)
+        log = bpy.path.abspath(background.image.filepath) + ".log"
+        with open(log) as f:
+            return f.read().splitlines()
