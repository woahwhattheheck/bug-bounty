+    } else if (isPlainObject(date)) {
+      ({ year, month, day } = date);
+    }
+    add(`events.${index}.date.year`, year);
+    add(`events.${index}.date.month`, isNil(month) || month === '' ? undefined : Number(month));
+    add(`events.${index}.date.day`, isNil(day) || day === '' ? undefined : Number(day));
+    add(`events.${index}.country`, get(event, 'country'));
+  });
+
+  castArray(release.labels || []).forEach((label: any, index: number) => {
+    add(`labels.${index}.mbid`, isMbid(get(label, 'mbid')) ? label.mbid : undefined);
+    add(`labels.${index}.name`, get(label, 'name'));
+    add(`labels.${index}.catalog_number`, get(label, 'catalogNumber'));
+  });
+
+  castArray(release.mediums || []).forEach((medium: any, mediumIndex: number) => {
+    const tracks = castArray(get(medium, 'tracks', []));
+    if (tracks.length === 0) {
+      throw new MusicBrainzError(`Medium ${mediumIndex + 1} needs at least one track`);
+    }
+    add(`mediums.${mediumIndex}.format`, get(medium, 'format'));
+    add(`mediums.${mediumIndex}.name`, get(medium, 'name'));
+    tracks.forEach((track: any, trackIndex: number) => {
+      const prefix = `mediums.${mediumIndex}.track.${trackIndex}`;
+      const entry = isString(track) ? { name: track } : (track || {});
+      if (!isString(entry.name) || entry.name.trim() === '') {
+        throw new MusicBrainzError(`Track ${trackIndex + 1} on medium ${mediumIndex + 1} needs a name`);
+      }
+      add(`${prefix}.name`, entry.name);
+      add(`${prefix}.number`, entry.number);
+      add(`${prefix}.recording`, isMbid(entry.recording) ? entry.recording : undefined);
+      add(`${prefix}.length`, formatLength(entry.length));
+      if (entry.artistCredit) {
+        addArtistCredit(`${prefix}.artist_credit`, entry.artistCredit);
+      }
+    });
+  });
