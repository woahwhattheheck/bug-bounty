+{
+  "title": "MusicBrainz: submit a release",
+  "tags": [
+    "musicbrainz",
+    "music"
+  ],
+  "blocks": [
+    {
+      "type": "template",
+      "template": "<h2>Submit a release to MusicBrainz</h2><p>Fill in what you know about your release. The button below opens the MusicBrainz release editor with these details filled in, where you can review, complete and submit them. You need a <a href=\"https://musicbrainz.org/register\">MusicBrainz account</a>; if you are not logged in, MusicBrainz asks you to log in first. Please search MusicBrainz first to avoid adding a duplicate.</p>"
+    },
+    {
+      "type": "form",
+      "label": "Prepare submission",
+      "jsonSchema": {
+        "type": "object",
+        "required": [
+          "name",
+          "artist"
+        ],
+        "properties": {
+          "name": {
+            "type": "string",
+            "title": "Release title"
+          },
+          "artist": {
+            "type": "string",
+            "title": "Artist, as credited on the release"
+          },
+          "artistMbid": {
+            "type": "string",
+            "title": "Artist MBID (optional, if the artist is already in MusicBrainz)"
+          },
+          "type": {
+            "type": "string",
+            "title": "Type",
+            "enum": [
+              "album",
+              "single",
+              "ep",
+              "broadcast",
+              "other"
+            ],
+            "default": "album"
+          },
+          "status": {
+            "type": "string",
+            "title": "Status",
+            "enum": [
+              "official",
+              "promotion",
+              "bootleg",
+              "pseudo-release"
+            ],
+            "default": "official"
+          },
+          "date": {
+            "type": "string",
+            "title": "Release date (YYYY, YYYY-MM or YYYY-MM-DD)"
+          },
+          "country": {
+            "type": "string",
+            "title": "Country code (e.g. GB, or XW for worldwide)"
+          },
+          "label": {
+            "type": "string",
+            "title": "Label"
+          },
+          "catalogNumber": {
+            "type": "string",
+            "title": "Catalog number"
+          },
+          "barcode": {
+            "type": "string",
+            "title": "Barcode"
+          },
+          "format": {
+            "type": "string",
+            "title": "Format",
+            "enum": [
+              "Digital Media",
+              "CD",
+              "Vinyl",
+              "Cassette"
+            ],
+            "default": "Digital Media"
+          },
+          "tracks": {
+            "type": "array",
+            "title": "Tracks",
+            "items": {
+              "type": "object",
+              "properties": {
+                "name": {
+                  "type": "string",
+                  "title": "Title"
+                },
+                "length": {
+                  "type": "string",
+                  "title": "Length (m:ss)"
+                }
+              }
+            }
+          },
+          "url": {
+            "type": "string",
+            "title": "Link to the release (e.g. on your website or a store)"
+          }
+        }
+      },
+      "uiSchema": {}
+    },
+    {
+      "type": "mapping",
+      "blockComment": "Reshape the form into the release format the MusicBrainz block expects",
+      "mapping": "{name: data.name, type: data.type, status: data.status, barcode: data.barcode, artistCredit: [{name: data.artist, mbid: data.artistMbid}], events: [{date: data.date, country: data.country}], labels: [{name: data.label, catalogNumber: data.catalogNumber}], mediums: data.tracks && [{format: data.format, tracks: data.tracks}] || `[]`, urls: data.url && [data.url] || `[]`}"
