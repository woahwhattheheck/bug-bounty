+{
+	SceneTree *tree = qobject_cast<SceneTree *>(parent);
+
+	if (!tree) {
+		return false;
+	}
+
+	const bool isFolder = SceneTree::IsFolder(index);
+	const bool isInFolder = !isFolder && index.data(SceneTree::InFolderRole).toBool();
+
+	if (!isFolder && (!isInFolder || tree->GetGridMode())) {
+		return false;
+	}
+
+	indicatorRect = tree->GetFolderIndicatorRect(option.rect);
+	contentRect = option.rect;
+	contentRect.setLeft(indicatorRect.right() + 1);
+	return true;
+}
+
+void SceneRenameDelegate::paint(QPainter *painter, const QStyleOptionViewItem &option, const QModelIndex &index) const
+{
+	QRect indicatorRect;
+	QRect contentRect;
+
+	if (!GetContentRect(parent(), option, index, indicatorRect, contentRect)) {
+		QStyledItemDelegate::paint(painter, option, index);
+		return;
+	}
+
+	QStyleOptionViewItem contentOption(option);
+	contentOption.rect = contentRect;
+	QStyledItemDelegate::paint(painter, contentOption, index);
+
+	if (SceneTree::IsFolder(index)) {
+		SceneTree *tree = qobject_cast<SceneTree *>(parent());
+		tree->PaintFolderIndicator(painter, indicatorRect, index.data(SceneTree::FolderCollapsedRole).toBool());
+	}
+}
+
+void SceneRenameDelegate::updateEditorGeometry(QWidget *editor, const QStyleOptionViewItem &option,
+					       const QModelIndex &index) const
+{
+	QRect indicatorRect;
+	QRect contentRect;
+
+	if (!GetContentRect(parent(), option, index, indicatorRect, contentRect)) {
+		QStyledItemDelegate::updateEditorGeometry(editor, option, index);
+		return;
+	}
+
+	QStyleOptionViewItem contentOption(option);
+	contentOption.rect = contentRect;
+	QStyledItemDelegate::updateEditorGeometry(editor, contentOption, index);
+}
