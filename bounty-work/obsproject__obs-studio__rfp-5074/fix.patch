+namespace obs_vst3 {
+
+/*
+ * Native top-level window hosting a plug-in editor view. It implements
+ * IPlugFrame so the plug-in can resize its window. Destroying the window
+ * detaches the view (IPlugView::removed) before the native window goes away.
+ */
+class EditorWindow : public Steinberg::IPlugFrame {
+public:
+	virtual ~EditorWindow() = default;
+
+	virtual void bringToFront() = 0;
+
+	/* Lifetime is managed by the owner, reference counting is a no-op. */
