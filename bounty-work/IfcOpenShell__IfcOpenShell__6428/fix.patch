+    def get_sheet_layout(self, sheet: ifcopenshell.entity_instance) -> dict[str, Any]:
+        """Get sheet size and the placement of drawings, schedules and references on it, in mm."""
+        layout_path = tool.Drawing.get_document_uri(sheet, "LAYOUT")
+        assert layout_path
+        layout_root = ET.parse(layout_path).getroot()
+        items = []
+        for view in layout_root.findall(f"{SVG}g"):
+            if view.attrib.get("data-type") not in ("drawing", "schedule", "reference"):
+                continue
+            content = title = None
+            for image in view.findall(f"{SVG}image"):
+                if image.attrib.get("data-type") in ("foreground", "content"):
+                    content = image
+                elif image.attrib.get("data-type") == "view-title":
+                    title = image
+            if content is None:
+                continue
+            items.append(
+                {
+                    "reference_id": int(view.attrib["data-id"]),
+                    "content": self.get_image_rectangle(content),
+                    "title": None if title is None else self.get_image_rectangle(title),
+                }
+            )
+        return {
+            "width": self.convert_to_mm(layout_root.attrib["width"]),
+            "height": self.convert_to_mm(layout_root.attrib["height"]),
+            "items": items,
+        }
+
+    def get_image_rectangle(self, image: ET.Element) -> tuple[float, float, float, float]:
+        return tuple(self.convert_to_mm(image.attrib[a]) for a in ("x", "y", "width", "height"))
+
+    def set_sheet_item_positions(
+        self, sheet: ifcopenshell.entity_instance, positions: dict[int, tuple[float, float]]
+    ) -> None:
+        """Move sheet items, together with their view titles.
+
+        :param positions: Map of sheet item reference ids to their new top left corner, in mm.
+        """
+        ET.register_namespace("", "http://www.w3.org/2000/svg")
+        ET.register_namespace("xlink", "http://www.w3.org/1999/xlink")
+
+        layout_path = tool.Drawing.get_document_uri(sheet, "LAYOUT")
+        assert layout_path
+        layout_tree = ET.parse(layout_path)
+        for view in layout_tree.getroot().findall(f"{SVG}g"):
+            if (position := positions.get(int(view.attrib.get("data-id", 0)))) is None:
+                continue
+            images = view.findall(f"{SVG}image")
+            content = next((i for i in images if i.attrib.get("data-type") in ("foreground", "content")), None)
+            if content is None:
+                continue
+            offset_x = position[0] - self.convert_to_mm(content.attrib["x"])
+            offset_y = position[1] - self.convert_to_mm(content.attrib["y"])
+            for image in images:
+                image.attrib["x"] = str(round(self.convert_to_mm(image.attrib["x"]) + offset_x, 4))
+                image.attrib["y"] = str(round(self.convert_to_mm(image.attrib["y"]) + offset_y, 4))
+        layout_tree.write(layout_path)
+
