+void SceneTree::mousePressEvent(QMouseEvent *event)
+{
+	const QPoint position = event->position().toPoint();
+	QListWidgetItem *folder = itemAt(position);
+
+	if (event->button() == Qt::LeftButton && IsFolder(folder) &&
+	    GetFolderIndicatorRect(visualItemRect(folder)).contains(position)) {
+		isFolderIndicatorPressed = true;
+		SetFolderCollapsed(folder, !IsFolderCollapsed(folder));
+		event->accept();
+		return;
+	}
+
+	QListWidget::mousePressEvent(event);
+}
+
+void SceneTree::mouseReleaseEvent(QMouseEvent *event)
+{
+	/* Clicking the expand/collapse indicator must not change the selection */
+	if (isFolderIndicatorPressed) {
+		isFolderIndicatorPressed = false;
+		event->accept();
+		return;
+	}
+
+	QListWidget::mouseReleaseEvent(event);
+}
+
+void SceneTree::mouseDoubleClickEvent(QMouseEvent *event)
+{
+	QListWidgetItem *folder = itemAt(event->position().toPoint());
+
+	if (event->button() == Qt::LeftButton && IsFolder(folder)) {
+		isFolderIndicatorPressed =
+			GetFolderIndicatorRect(visualItemRect(folder)).contains(event->position().toPoint());
+		SetFolderCollapsed(folder, !IsFolderCollapsed(folder));
+		event->accept();
+		return;
+	}
+
+	QListWidget::mouseDoubleClickEvent(event);
+}
+
+void SceneTree::keyPressEvent(QKeyEvent *event)
+{
+	QListWidgetItem *current = currentItem();
+
+	if (!gridMode && current && event->modifiers() == Qt::NoModifier) {
+		if (event->key() == Qt::Key_Left) {
+			if (IsFolder(current) && !IsFolderCollapsed(current)) {
+				SetFolderCollapsed(current, true);
+				return;
+			} else if (IsInFolder(current)) {
+				setCurrentItem(GetFolderOf(current));
+				return;
+			}
+		} else if (event->key() == Qt::Key_Right && IsFolder(current)) {
+			if (IsFolderCollapsed(current)) {
+				SetFolderCollapsed(current, false);
+			} else if (!GetFolderScenes(current).isEmpty()) {
+				setCurrentItem(GetFolderScenes(current).first());
+			}
+			return;
+		}
+	}
+
+	QListWidget::keyPressEvent(event);
+}
+
+void SceneTree::currentChanged(const QModelIndex &current, const QModelIndex &previous)
+{
+	/* Reveal scenes that become current while their folder is collapsed,
+	 * e.g. when switching scenes with a hotkey */
+	QListWidgetItem *currentEntry = itemFromIndex(current);
+
+	if (!isApplyingLayout && IsInFolder(currentEntry)) {
+		QListWidgetItem *folder = GetFolderOf(currentEntry);
+
+		if (IsFolderCollapsed(folder)) {
+			folder->setData(FolderCollapsedRole, false);
+			UpdateFolders();
+			emit folderStateChanged();
+		}
+	}
+
+	QListWidget::currentChanged(current, previous);
+}
