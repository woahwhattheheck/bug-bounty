+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Threading.Tasks;
+using Xunit;
+using Stride.Core.Mathematics;
+using Stride.Games;
+using Stride.Graphics;
+using Stride.Graphics.Regression;
+using Stride.Rendering;
+using Stride.Rendering.Compositing;
+using Stride.Rendering.Decals;
+using Stride.Rendering.Lights;
+using Stride.Rendering.Materials;
+using Stride.Rendering.Materials.ComputeColors;
+using Stride.Rendering.ProceduralModels;
+
+namespace Stride.Engine.Tests
+{
+    /// <summary>
+    /// Base of the decal rendering tests: renders decals projected on a gray wall facing the camera, then checks the
+    /// color of the wall at given positions.
+    /// </summary>
+    public abstract class DecalTestGameBase : GameTestBase
+    {
+        private const int CheckFrame = 3;
+
+        private CameraComponent camera;
+
+        protected DecalTestGameBase()
+        {
+            GraphicsDeviceManager.PreferredBackBufferWidth = 640;
+            GraphicsDeviceManager.PreferredBackBufferHeight = 360;
+        }
+
+        /// <summary>
+        /// Whether the graphics compositor has a decal render stage. Otherwise, it is set up like a graphics compositor
+        /// created before decals existed: decals are rendered in the transparent stage.
+        /// </summary>
+        protected virtual bool UseDecalRenderStage => true;
+
+        protected List<string> Failures { get; } = [];
+
+        protected bool PixelsChecked { get; private set; }
+
+        protected MeshRenderFeature MeshRenderFeature { get; private set; }
+
+        protected override async Task LoadContent()
+        {
+            await base.LoadContent();
+
+            camera = new CameraComponent { NearClipPlane = 0.1f, FarClipPlane = 100.0f };
+            var compositor = GraphicsCompositorHelper.CreateDefault(false, camera: camera, clearColor: Color.Black, graphicsProfile: GraphicsDevice.Features.CurrentProfile);
+            MeshRenderFeature = compositor.RenderFeatures.OfType<MeshRenderFeature>().Single();
+
+            if (!UseDecalRenderStage)
+            {
+                ((ForwardRenderer)compositor.SingleView).DecalRenderStage = null;
+                foreach (var selector in MeshRenderFeature.RenderStageSelectors.OfType<MeshTransparentRenderStageSelector>())
+                    selector.DecalRenderStage = null;
+                MeshRenderFeature.RenderFeatures.Remove(MeshRenderFeature.RenderFeatures.OfType<DecalRenderFeature>().Single());
+            }
+
+            SceneSystem.GraphicsCompositor = compositor;
+
+            var scene = new Scene();
+
+            var cameraEntity = new Entity("Camera") { camera };
+            cameraEntity.Transform.Position = new Vector3(0.0f, 0.0f, 8.0f);
+            scene.Entities.Add(cameraEntity);
+
+            // A gray wall facing the camera, its front face at z = 0
+            var wall = new ModelComponent(new CubeProceduralModel { Size = new Vector3(10.0f, 10.0f, 0.2f) }.Generate(Services));
+            wall.Materials[0] = CreateMaterial(new ComputeColor(new Color4(0.5f, 0.5f, 0.5f, 1.0f)));
+            var wallEntity = new Entity("Wall") { wall };
+            wallEntity.Transform.Position = new Vector3(0.0f, 0.0f, -0.1f);
+            scene.Entities.Add(wallEntity);
+
+            CreateScene(scene);
+
+            SceneSystem.SceneInstance = new SceneInstance(Services, scene);
+        }
+
+        /// <summary>
+        /// Adds the lights and the decals of the test to the scene.
+        /// </summary>
+        protected abstract void CreateScene(Scene scene);
+
+        /// <summary>
+        /// Checks the rendered image, adding the problems found to <see cref="Failures"/>.
+        /// </summary>
+        protected abstract void CheckPixels(Func<float, float, Color> sampleWall);
+
+        protected override void RegisterTests()
+        {
+            base.RegisterTests();
+
+            // Keep the game running until the pixels have been checked
+            FrameGameSystem.Draw(CheckFrame + 1, () => { });
+        }
+
+        protected override void Draw(GameTime gameTime)
+        {
+            base.Draw(gameTime);
+
+            if (PixelsChecked || FrameGameSystem.CurrentFrame < CheckFrame)
+                return;
+
+            PixelsChecked = true;
+
+            using var image = GraphicsDevice.Presenter.BackBuffer.GetDataAsImage(GraphicsContext.CommandList);
+            var pixels = image.GetPixelBuffer(0, 0);
+
+            // Color of the pixel showing the point (x, y) of the front face of the wall
+            Color SampleWall(float x, float y)
+            {
+                var ndc = Vector3.TransformCoordinate(new Vector3(x, y, 0.0f), camera.ViewProjectionMatrix);
+                return pixels.GetPixel<Color>((int)((ndc.X + 1.0f) * 0.5f * pixels.Width), (int)((1.0f - ndc.Y) * 0.5f * pixels.Height));
+            }
+
+            CheckPixels(SampleWall);
+
+            var decalRenderFeatureCount = MeshRenderFeature.RenderFeatures.OfType<DecalRenderFeature>().Count();
+            if (decalRenderFeatureCount != 1)
+                Failures.Add($"Expected one {nameof(DecalRenderFeature)}, found {decalRenderFeatureCount}");
+        }
+
+        protected void Check(string description, Color pixel, bool condition)
+        {
+            if (!condition)
+                Failures.Add($"{description}: got {pixel}");
+        }
+
+        protected static bool IsGray(Color color) => color.R > 20 && Math.Abs(color.R - color.G) < 8 && Math.Abs(color.G - color.B) < 8;
+
+        protected static bool IsNear(Color left, Color right) => Math.Abs(left.R - right.R) < 8 && Math.Abs(left.G - right.G) < 8 && Math.Abs(left.B - right.B) < 8;
+
+        protected Entity AddDecal(Scene scene, Vector3 position, Quaternion rotation, Vector3 size, IComputeColor diffuse, float opacity = 1.0f, int sortOrder = 0)
+        {
+            var entity = new Entity("Decal")
+            {
+                new DecalComponent { Material = CreateMaterial(diffuse), Size = size, Opacity = opacity, SortOrder = sortOrder },
+            };
+            entity.Transform.Position = position;
+            entity.Transform.Rotation = rotation;
+            scene.Entities.Add(entity);
+            return entity;
+        }
+
+        protected Material CreateMaterial(IComputeColor diffuse)
+        {
+            return Material.New(GraphicsDevice, new MaterialDescriptor
+            {
+                Attributes =
+                {
+                    Diffuse = new MaterialDiffuseMapFeature(diffuse),
+                    DiffuseModel = new MaterialDiffuseLambertModelFeature(),
+                },
+            });
+        }
+
+        protected void RunTest()
+        {
+            var game = (DecalTestGameBase)Activator.CreateInstance(GetType());
+            RunGameTest(game);
+
+            Assert.True(game.PixelsChecked, "The rendered image was not checked");
+            Assert.Empty(game.Failures);
+        }
+    }
+
+    /// <summary>
+    /// Renders decals on a wall lit by an ambient light, and checks the color of the wall where each decal is projected.
+    /// </summary>
+    public class DecalRenderingTests : DecalTestGameBase
+    {
+        protected override void CreateScene(Scene scene)
+        {
+            scene.Entities.Add(new Entity("Ambient light") { new LightComponent { Type = new LightAmbient(), Intensity = 1.0f } });
+
+            // Opaque decal, projected straight into the wall
+            AddDecal(scene, new Vector3(-2.0f, 1.5f, 0.0f), Quaternion.Identity, Vector3.One, new ComputeColor(new Color4(1, 0, 0, 1)));
+            // Half transparent decal
+            AddDecal(scene, new Vector3(2.0f, 1.5f, 0.0f), Quaternion.Identity, Vector3.One, new ComputeColor(new Color4(0, 1, 0, 1)), opacity: 0.5f);
+            // Decal projected almost parallel to the wall: faded out by the angle fade
+            AddDecal(scene, new Vector3(-2.0f, -1.5f, 0.0f), Quaternion.RotationY(MathUtil.DegreesToRadians(88.0f)), Vector3.One, new ComputeColor(new Color4(0, 0, 1, 1)));
+            // Decal volume in front of the wall: does not reach it
+            AddDecal(scene, new Vector3(2.0f, -1.5f, 2.0f), Quaternion.Identity, Vector3.One, new ComputeColor(new Color4(1, 1, 0, 1)));
+            // Decal volume containing the camera
+            AddDecal(scene, new Vector3(0.0f, -1.25f, 4.0f), Quaternion.Identity, new Vector3(0.8f, 3.5f, 9.0f), new ComputeColor(new Color4(1, 0, 1, 1)));
+
+            // Textured decal: top-left red, top-right green, bottom-left blue, bottom-right white
+            var quadrants = Texture.New2D(GraphicsDevice, 2, 2, PixelFormat.R8G8B8A8_UNorm, new[] { Color.Red, Color.Lime, Color.Blue, Color.White });
+            AddDecal(scene, new Vector3(4.0f, 1.5f, 0.0f), Quaternion.Identity, new Vector3(1.6f, 1.6f, 1.0f), new ComputeTextureColor(quadrants));
+
+            // Overlapping decals: the one created first has the highest sort order, so it is drawn on top
+            AddDecal(scene, new Vector3(4.0f, -1.5f, 0.0f), Quaternion.Identity, Vector3.One, new ComputeColor(new Color4(1, 0.5f, 0, 1)), sortOrder: 1);
+            AddDecal(scene, new Vector3(4.0f, -1.5f, 0.0f), Quaternion.Identity, Vector3.One, new ComputeColor(new Color4(0, 0.5f, 1, 1)), sortOrder: 0);
+        }
+
+        protected override void CheckPixels(Func<float, float, Color> sampleWall)
+        {
+            var wall = sampleWall(0.0f, 1.5f);
+            Check("Wall without decal is gray", wall, IsGray(wall));
+
+            var opaque = sampleWall(-2.0f, 1.5f);
+            Check("Opaque decal is red", opaque, opaque.R > 200 && opaque.G < 60 && opaque.B < 60);
+
+            var halfTransparent = sampleWall(2.0f, 1.5f);
+            Check("Half transparent decal blends green over the wall", halfTransparent, halfTransparent.G > halfTransparent.R + 30 && halfTransparent.R > 40 && Math.Abs(halfTransparent.R - halfTransparent.B) < 8);
+
+            var grazing = sampleWall(-2.0f, -1.5f);
+            Check("Grazing decal is faded out", grazing, IsNear(grazing, wall));
+
+            var tooFar = sampleWall(2.0f, -1.5f);
+            Check("Decal volume not reaching the wall leaves it unchanged", tooFar, IsNear(tooFar, wall));
+
+            var cameraInside = sampleWall(0.0f, -2.0f);
+            Check("Decal containing the camera is visible", cameraInside, cameraInside.R > 180 && cameraInside.B > 180 && cameraInside.G < 60);
+
+            var topLeft = sampleWall(3.6f, 1.9f);
+            Check("Textured decal: top-left is red", topLeft, topLeft.R > 200 && topLeft.G < 60 && topLeft.B < 60);
+            var topRight = sampleWall(4.4f, 1.9f);
+            Check("Textured decal: top-right is green", topRight, topRight.G > 200 && topRight.R < 60 && topRight.B < 60);
+            var bottomLeft = sampleWall(3.6f, 1.1f);
+            Check("Textured decal: bottom-left is blue", bottomLeft, bottomLeft.B > 200 && bottomLeft.R < 60 && bottomLeft.G < 60);
+            var bottomRight = sampleWall(4.4f, 1.1f);
+            Check("Textured decal: bottom-right is white", bottomRight, bottomRight.R > 200 && bottomRight.G > 200 && bottomRight.B > 200);
+
+            // The sort order is only applied by the decal render stage (the transparent stage sorts by distance)
+            if (UseDecalRenderStage)
+            {
+                var sorted = sampleWall(4.0f, -1.5f);
+                Check("Decal with the highest sort order is drawn on top", sorted, sorted.R > 200 && sorted.B < 60);
+            }
+        }
+
+        [SkippableFact]
+        public void DecalsAreProjectedOnTheOpaqueGeometry() => RunTest();
+    }
+
+    /// <summary>
+    /// Renders decals with a graphics compositor created before decals existed (no decal render stage nor
+    /// <see cref="DecalRenderFeature"/>): the decal render feature is added automatically and decals are
+    /// rendered in the transparent stage.
+    /// </summary>
+    public class DecalRenderingWithoutDecalStageTests : DecalRenderingTests
+    {
+        protected override bool UseDecalRenderStage => false;
+    }
+
+    /// <summary>
+    /// Checks that decals are lit with the normal of the surface they are projected on, whatever their projection direction.
+    /// </summary>
+    public class DecalLightingTests : DecalTestGameBase
+    {
+        protected override void CreateScene(Scene scene)
+        {
+            // A directional light hitting the wall at 60 degrees, coming from +X
+            var light = new Entity("Directional light") { new LightComponent { Type = new LightDirectional(), Intensity = 1.0f } };
+            light.Transform.Rotation = Quaternion.RotationY(MathUtil.DegreesToRadians(60.0f));
+            scene.Entities.Add(light);
+
+            // The same decal projected straight into the wall, and at 45 degrees from both sides:
+            // shaded with the normal of the projector, they would get a very different amount of light
+            var white = new ComputeColor(new Color4(0.8f, 0.8f, 0.8f, 1.0f));
+            AddDecal(scene, new Vector3(-3.0f, 0.0f, 0.0f), Quaternion.Identity, Vector3.One, white);
+            AddDecal(scene, new Vector3(0.0f, 0.0f, 0.0f), Quaternion.RotationY(MathUtil.DegreesToRadians(45.0f)), Vector3.One, white);
+            AddDecal(scene, new Vector3(3.0f, 0.0f, 0.0f), Quaternion.RotationY(MathUtil.DegreesToRadians(-45.0f)), Vector3.One, white);
+
+            // The same decals with a normal map tilting the normal toward the U direction (local X axis of the decal, +X here):
+            // they receive more light than the flat decals, and the same amount whatever the projection direction
+            var normalMap = Texture.New2D(GraphicsDevice, 1, 1, PixelFormat.R8G8B8A8_UNorm, new[] { new Color(217, 128, 217, 255) });
+            var normalMapped = new MaterialDescriptor
+            {
+                Attributes =
+                {
+                    Diffuse = new MaterialDiffuseMapFeature(white),
+                    DiffuseModel = new MaterialDiffuseLambertModelFeature(),
+                    Surface = new MaterialNormalMapFeature(new ComputeTextureColor(normalMap)),
+                },
+            };
+            foreach (var (position, angle) in new[] { (new Vector3(-3.0f, -2.0f, 0.0f), 0.0f), (new Vector3(0.0f, -2.0f, 0.0f), 45.0f), (new Vector3(3.0f, -2.0f, 0.0f), -45.0f) })
+            {
+                var entity = new Entity("Normal mapped decal") { new DecalComponent { Material = Material.New(GraphicsDevice, normalMapped) } };
+                entity.Transform.Position = position;
+                entity.Transform.Rotation = Quaternion.RotationY(MathUtil.DegreesToRadians(angle));
+                scene.Entities.Add(entity);
+            }
+        }
+
+        protected override void CheckPixels(Func<float, float, Color> sampleWall)
+        {
+            var wall = sampleWall(0.0f, 2.0f);
+            Check("Lit wall is gray", wall, IsGray(wall));
+
+            var straight = sampleWall(-3.0f, 0.0f);
+            Check("Decal is brighter than the wall", straight, IsGray(straight) && straight.R > wall.R + 10);
+
+            var fromRight = sampleWall(0.0f, 0.0f);
+            Check("Decal projected at +45 degrees is lit like the straight one", fromRight, IsNear(fromRight, straight));
+
+            var fromLeft = sampleWall(3.0f, 0.0f);
+            Check("Decal projected at -45 degrees is lit like the straight one", fromLeft, IsNear(fromLeft, straight));
+
+            var normalMapped = sampleWall(-3.0f, -2.0f);
+            Check("Normal mapped decal facing the light is brighter than the flat one", normalMapped, IsGray(normalMapped) && normalMapped.R > straight.R + 10);
+
+            var normalMappedFromRight = sampleWall(0.0f, -2.0f);
+            Check("Normal mapped decal projected at +45 degrees is lit like the straight one", normalMappedFromRight, IsNear(normalMappedFromRight, normalMapped));
+
+            var normalMappedFromLeft = sampleWall(3.0f, -2.0f);
+            Check("Normal mapped decal projected at -45 degrees is lit like the straight one", normalMappedFromLeft, IsNear(normalMappedFromLeft, normalMapped));
+        }
+
+        [SkippableFact]
+        public void DecalsAreLitWithTheReceivingSurfaceNormal() => RunTest();
+    }
