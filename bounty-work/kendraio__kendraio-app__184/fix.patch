+<mat-error *ngIf="hasError">
+  {{ errorMessage }}
+</mat-error>
+
+<div class="spinner-wrapper" *ngIf="isLoading">
+  <mat-spinner diameter="50"></mat-spinner>
+</div>
+
+<!-- Release editor seeding: a plain form POST that opens the MusicBrainz release editor in a new tab.
+     ngNoForm stops Angular's NgForm from intercepting the native submit. -->
+<form *ngIf="seedFields.length > 0" class="musicbrainz-seed-form" ngNoForm method="post"
+      accept-charset="utf-8" target="_blank" [attr.action]="seedAction">
+  <input *ngFor="let field of seedFields" type="hidden" [attr.name]="field.name" [value]="field.value">
+  <p class="musicbrainz-seed-summary">{{ seedSummary }}</p>
+  <button mat-flat-button color="primary" type="submit">{{ seedLabel }}</button>
+</form>
