+} // namespace
+
+std::unique_ptr<PluginInstance> PluginInstance::load(const std::string &modulePath, const std::string &classId,
+						     FUnknown *hostContext, std::atomic<uint32_t> &editCount,
+						     std::string &error)
+{
+	std::unique_ptr<PluginInstance> instance(new PluginInstance());
+	if (!instance->initialize(modulePath, classId, hostContext, editCount, error)) {
+		return nullptr;
+	}
+
+	return instance;
+}
+
+bool PluginInstance::initialize(const std::string &modulePath, const std::string &classId, FUnknown *hostContext,
+				std::atomic<uint32_t> &editCount, std::string &error)
+{
+	module_ = VST3::Hosting::Module::create(modulePath, error);
+	if (!module_) {
+		if (error.empty()) {
+			error = "Could not load VST3 module '" + modulePath + "'";
+		}
+		return false;
+	}
+
+	auto classUid = VST3::UID::fromString(classId);
+	if (!classUid) {
+		error = "Invalid VST3 class ID '" + classId + "'";
+		return false;
+	}
+
+	const VST3::Hosting::PluginFactory &factory = module_->getFactory();
+	factory.setHostContext(hostContext);
+
+	bool foundClass = false;
+	for (const VST3::Hosting::ClassInfo &info : factory.classInfos()) {
+		if (info.ID() != *classUid) {
+			continue;
+		}
+
+		if (info.category() != kVstAudioEffectClass) {
+			error = "'" + info.name() + "' is not an audio effect";
+			return false;
+		}
+
+		name_ = info.name();
+		vendor_ = info.vendor();
+		foundClass = true;
+		break;
+	}
+
+	if (!foundClass) {
+		error = "The VST3 module does not contain the selected plug-in";
+		return false;
+	}
+
+	component_ = factory.createInstance<IComponent>(*classUid);
+	if (!component_) {
+		error = "Could not create the plug-in component";
+		return false;
+	}
+
+	if (component_->initialize(hostContext) != kResultOk) {
+		error = "The plug-in component failed to initialize";
+		return false;
+	}
+	componentInitialized_ = true;
+
+	processor_ = FUnknownPtr<IAudioProcessor>(component_);
+	if (!processor_) {
+		error = "The plug-in does not implement IAudioProcessor";
+		return false;
+	}
+
+	FUnknownPtr<IEditController> singleComponentController(component_);
+	if (singleComponentController) {
+		controller_ = singleComponentController;
+		controllerIsComponent_ = true;
+	} else {
+		TUID controllerClassId;
+		if (component_->getControllerClassId(controllerClassId) == kResultTrue) {
+			controller_ = factory.createInstance<IEditController>(VST3::UID::fromTUID(controllerClassId));
+			if (controller_ && controller_->initialize(hostContext) == kResultOk) {
+				controllerInitialized_ = true;
+			} else {
+				hostLog("'%s': edit controller could not be created, editor is unavailable",
+					name_.c_str());
+				controller_ = nullptr;
+			}
+		}
+	}
+
+	componentHandler_ = owned(new ComponentHandler(toProcessor_, editCount));
+
+	if (controller_) {
+		controller_->setComponentHandler(componentHandler_);
+		connectComponents();
+		synchronizeController();
+	}
+
+	return findBuses(error);
+}
+
+PluginInstance::~PluginInstance()
+{
+	deactivate();
+
+	if (controller_) {
+		controller_->setComponentHandler(nullptr);
+	}
+
+	disconnectComponents();
+
+	if (controller_ && controllerInitialized_) {
+		controller_->terminate();
+	}
+	controller_ = nullptr;
+
+	processor_ = nullptr;
+	if (component_ && componentInitialized_) {
+		component_->terminate();
+	}
+	component_ = nullptr;
+	componentHandler_ = nullptr;
+
+	/* The module (shared library) has to be released last. */
+	module_.reset();
+}
+
+bool PluginInstance::findBuses(std::string &error)
+{
+	int32 inputCount = component_->getBusCount(kAudio, kInput);
+	for (int32 bus = 0; bus < inputCount; bus++) {
+		BusInfo info = {};
+		if (component_->getBusInfo(kAudio, kInput, bus, info) != kResultTrue) {
+			continue;
+		}
+
+		if (info.busType == kMain && mainInputBus_ < 0) {
+			mainInputBus_ = bus;
+		} else if (info.busType == kAux && auxInputBus_ < 0) {
+			auxInputBus_ = bus;
+		}
+	}
+
+	int32 outputCount = component_->getBusCount(kAudio, kOutput);
+	for (int32 bus = 0; bus < outputCount; bus++) {
+		BusInfo info = {};
+		if (component_->getBusInfo(kAudio, kOutput, bus, info) == kResultTrue && info.busType == kMain) {
+			mainOutputBus_ = bus;
+			break;
+		}
+	}
+
+	if (mainInputBus_ < 0 && inputCount > 0 && auxInputBus_ != 0) {
+		mainInputBus_ = 0;
+	}
+	if (mainOutputBus_ < 0 && outputCount > 0) {
+		mainOutputBus_ = 0;
+	}
+
+	if (mainInputBus_ < 0 || mainOutputBus_ < 0) {
+		error = "'" + name_ + "' has no audio input or output bus (only effects are supported)";
+		return false;
+	}
+
+	return true;
+}
+
+void PluginInstance::connectComponents()
+{
+	if (controllerIsComponent_) {
+		return;
+	}
+
+	FUnknownPtr<IConnectionPoint> componentPoint(component_);
+	FUnknownPtr<IConnectionPoint> controllerPoint(controller_);
+	if (!componentPoint || !controllerPoint) {
+		return;
+	}
+
+	/* Messages are routed through proxies, as recommended for hosts. */
+	componentConnection_ = owned(new ConnectionProxy(componentPoint));
+	controllerConnection_ = owned(new ConnectionProxy(controllerPoint));
+	componentConnection_->connect(controllerPoint);
+	controllerConnection_->connect(componentPoint);
+}
+
+void PluginInstance::disconnectComponents()
+{
+	FUnknownPtr<IConnectionPoint> componentPoint(component_);
+	FUnknownPtr<IConnectionPoint> controllerPoint(controller_);
+
+	if (componentConnection_ && controllerPoint) {
+		componentConnection_->disconnect(controllerPoint);
+	}
+	if (controllerConnection_ && componentPoint) {
+		controllerConnection_->disconnect(componentPoint);
+	}
+
+	componentConnection_ = nullptr;
+	controllerConnection_ = nullptr;
+}
+
+void PluginInstance::synchronizeController()
+{
+	if (!controller_ || controllerIsComponent_) {
+		return;
+	}
+
+	MemoryStream stream;
+	if (component_->getState(&stream) == kResultOk) {
+		stream.seek(0, IBStream::kIBSeekSet, nullptr);
+		controller_->setComponentState(&stream);
+	}
+}
+
+void PluginInstance::deactivate()
+{
+	if (processing_) {
+		processor_->setProcessing(false);
+		processing_ = false;
+	}
+
+	if (active_) {
+		component_->setActive(false);
+		active_ = false;
+	}
+}
+
+uint32_t PluginInstance::processedChannels() const
+{
+	return std::min({mainInputChannels_, mainOutputChannels_, setup_.channels});
+}
+
+bool PluginInstance::configure(const ProcessingSetup &setup, std::string &error)
+{
+	deactivate();
+	setup_ = setup;
+
+	if (setup.channels == 0 || setup.channels > kMaxChannels || setup.maxBlockFrames == 0 ||
+	    setup.maxBlockFrames > kMaxBlockFrames || setup.sampleRate <= 0.0) {
+		error = "Invalid audio configuration";
+		return false;
+	}
+
+	if (processor_->canProcessSampleSize(kSample32) != kResultTrue) {
+		error = "'" + name_ + "' does not support 32-bit floating point processing";
+		return false;
+	}
+
+	/* Ask for the OBS channel layout on all used buses; plug-ins may answer with their own. */
+	SpeakerArrangement desired = speakerArrangementForLayout(setup.speakerLayout, setup.channels);
+	int32 inputCount = component_->getBusCount(kAudio, kInput);
+	int32 outputCount = component_->getBusCount(kAudio, kOutput);
+	std::vector<SpeakerArrangement> inputs(static_cast<size_t>(inputCount), SpeakerArr::kEmpty);
+	std::vector<SpeakerArrangement> outputs(static_cast<size_t>(outputCount), SpeakerArr::kEmpty);
+
+	for (int32 bus = 0; bus < inputCount; bus++) {
+		processor_->getBusArrangement(kInput, bus, inputs[bus]);
+	}
+	for (int32 bus = 0; bus < outputCount; bus++) {
+		processor_->getBusArrangement(kOutput, bus, outputs[bus]);
+	}
+
+	bool useSidechain = setup.sidechain && auxInputBus_ >= 0;
+	inputs[mainInputBus_] = desired;
+	outputs[mainOutputBus_] = desired;
+	if (useSidechain) {
+		inputs[auxInputBus_] = desired;
+	}
+
+	tresult arrangementResult =
+		processor_->setBusArrangements(inputs.data(), inputCount, outputs.data(), outputCount);
+	if (arrangementResult != kResultTrue && useSidechain) {
+		/* Many sidechain inputs are mono only. */
+		inputs[auxInputBus_] = SpeakerArr::kMono;
+		arrangementResult =
+			processor_->setBusArrangements(inputs.data(), inputCount, outputs.data(), outputCount);
+	}
+	if (arrangementResult != kResultTrue) {
+		hostLog("'%s' rejected the requested speaker arrangement, using its own", name_.c_str());
+	}
+
+	SpeakerArrangement arrangement = SpeakerArr::kEmpty;
+	processor_->getBusArrangement(kInput, mainInputBus_, arrangement);
+	mainInputChannels_ = static_cast<uint32_t>(SpeakerArr::getChannelCount(arrangement));
+	processor_->getBusArrangement(kOutput, mainOutputBus_, arrangement);
+	mainOutputChannels_ = static_cast<uint32_t>(SpeakerArr::getChannelCount(arrangement));
+	auxInputChannels_ = 0;
+	if (auxInputBus_ >= 0) {
+		processor_->getBusArrangement(kInput, auxInputBus_, arrangement);
+		auxInputChannels_ = static_cast<uint32_t>(SpeakerArr::getChannelCount(arrangement));
+	}
+
+	ProcessSetup processSetup = {kRealtime, kSample32, static_cast<int32>(setup.maxBlockFrames), setup.sampleRate};
+	if (processor_->setupProcessing(processSetup) != kResultOk) {
+		error = "'" + name_ + "' rejected the processing setup";
+		return false;
+	}
+
+	for (int32 bus = 0; bus < inputCount; bus++) {
+		bool enable = bus == mainInputBus_ || (useSidechain && bus == auxInputBus_);
+		component_->activateBus(kAudio, kInput, bus, enable);
+	}
+	for (int32 bus = 0; bus < outputCount; bus++) {
+		component_->activateBus(kAudio, kOutput, bus, bus == mainOutputBus_);
+	}
+	/* OBS does not provide MIDI, keep event buses inactive. */
+	for (int32 bus = 0; bus < component_->getBusCount(kEvent, kInput); bus++) {
+		component_->activateBus(kEvent, kInput, bus, false);
+	}
+	for (int32 bus = 0; bus < component_->getBusCount(kEvent, kOutput); bus++) {
+		component_->activateBus(kEvent, kOutput, bus, false);
+	}
+
+	sidechainActive_ = useSidechain && auxInputChannels_ > 0;
+
+	if (component_->setActive(true) != kResultOk) {
+		error = "'" + name_ + "' could not be activated";
+		return false;
+	}
+	active_ = true;
+
+	processData_.prepare(*component_, 0, kSample32);
+	processData_.processMode = kRealtime;
+	processData_.inputParameterChanges = &inputParameterChanges_;
+	processData_.outputParameterChanges = &outputParameterChanges_;
+	processData_.inputEvents = &inputEvents_;
+	processData_.outputEvents = &outputEvents_;
+	processData_.processContext = &processContext_;
+
+	int32 parameterCount = controller_ ? controller_->getParameterCount() : 0;
+	int32 queueCount = std::clamp(parameterCount, 16, kMaxParameterQueues);
+	inputParameterChanges_.setMaxParameters(queueCount);
+	outputParameterChanges_.setMaxParameters(queueCount);
+	audioThreadChanges_.reserve(256);
+
+	silence_.assign(setup.maxBlockFrames, 0.0f);
+	discard_.assign(setup.maxBlockFrames, 0.0f);
+	sidechainDownmix_.assign(setup.maxBlockFrames, 0.0f);
+
+	processContext_ = {};
+	processContext_.sampleRate = setup.sampleRate;
+	processContext_.tempo = kDefaultTempo;
+	processContext_.timeSigNumerator = 4;
+	processContext_.timeSigDenominator = 4;
+	processContext_.state = ProcessContext::kPlaying | ProcessContext::kTempoValid | ProcessContext::kTimeSigValid |
+				ProcessContext::kSystemTimeValid | ProcessContext::kProjectTimeMusicValid |
+				ProcessContext::kContTimeValid;
+
+	tresult processingResult = processor_->setProcessing(true);
+	processing_ = processingResult == kResultOk || processingResult == kResultTrue ||
+		      processingResult == kNotImplemented;
+
+	latencySamples_ = static_cast<int32_t>(processor_->getLatencySamples());
+
+	hostLog("'%s' configured: %.0f Hz, %u channels (plug-in: %u in / %u out), sidechain %s, latency %d",
+		name_.c_str(), setup.sampleRate, setup.channels, mainInputChannels_, mainOutputChannels_,
+		sidechainActive_ ? "on" : "off", latencySamples_);
+	return true;
+}
+
+bool PluginInstance::reconfigure(std::string &error)
+{
+	if (setup_.channels == 0) {
+		return true;
+	}
+
+	ProcessingSetup setup = setup_;
+	return configure(setup, error);
+}
+
+void PluginInstance::assignBuffers(void *sharedMemory, bool sidechainValid, uint32_t frames)
+{
+	std::fill_n(silence_.data(), frames, 0.0f);
+
+	bool feedSidechain = sidechainActive_ && sidechainValid;
+	if (feedSidechain && auxInputChannels_ == 1 && setup_.channels > 1) {
+		/* Mono sidechain bus: mix all sidechain channels down. */
+		float scale = 1.0f / static_cast<float>(setup_.channels);
+		std::fill_n(sidechainDownmix_.data(), frames, 0.0f);
+		for (uint32_t channel = 0; channel < setup_.channels; channel++) {
+			const float *source = audioPlane(sharedMemory, AudioRegion::Sidechain, channel);
+			for (uint32_t frame = 0; frame < frames; frame++) {
+				sidechainDownmix_[frame] += source[frame] * scale;
+			}
+		}
+	}
+
+	for (int32 bus = 0; bus < processData_.numInputs; bus++) {
+		AudioBusBuffers &buffers = processData_.inputs[bus];
+		buffers.silenceFlags = 0;
+
+		for (int32 channel = 0; channel < buffers.numChannels; channel++) {
+			float *plane = silence_.data();
+			uint32_t index = static_cast<uint32_t>(channel);
+
+			if (bus == mainInputBus_ && index < setup_.channels) {
+				plane = audioPlane(sharedMemory, AudioRegion::Input, index);
+			} else if (bus == auxInputBus_ && feedSidechain) {
+				if (buffers.numChannels == 1 && setup_.channels > 1) {
+					plane = sidechainDownmix_.data();
+				} else if (index < setup_.channels) {
+					plane = audioPlane(sharedMemory, AudioRegion::Sidechain, index);
+				}
+			}
+
+			buffers.channelBuffers32[channel] = plane;
+		}
+	}
+
+	for (int32 bus = 0; bus < processData_.numOutputs; bus++) {
+		AudioBusBuffers &buffers = processData_.outputs[bus];
+		buffers.silenceFlags = 0;
+
+		for (int32 channel = 0; channel < buffers.numChannels; channel++) {
+			uint32_t index = static_cast<uint32_t>(channel);
+			bool mainChannel = bus == mainOutputBus_ && index < setup_.channels;
+			buffers.channelBuffers32[channel] =
+				mainChannel ? audioPlane(sharedMemory, AudioRegion::Output, index) : discard_.data();
+		}
+	}
+}
+
+void PluginInstance::transferParameterChanges()
+{
+	inputParameterChanges_.clearQueue();
+	outputParameterChanges_.clearQueue();
+
+	if (!toProcessor_.tryDrain(audioThreadChanges_)) {
+		return;
+	}
+
+	for (const ParameterChange &change : audioThreadChanges_) {
+		int32 queueIndex = 0;
+		IParamValueQueue *queue = inputParameterChanges_.addParameterData(change.id, queueIndex);
+		if (queue) {
+			int32 pointIndex = 0;
+			queue->addPoint(0, change.value, pointIndex);
+		}
+	}
+}
+
+void PluginInstance::collectOutputParameterChanges()
+{
+	int32 count = outputParameterChanges_.getParameterCount();
+	for (int32 index = 0; index < count; index++) {
+		IParamValueQueue *queue = outputParameterChanges_.getParameterData(index);
+		if (!queue || queue->getPointCount() <= 0) {
+			continue;
+		}
+
+		int32 sampleOffset = 0;
+		ParamValue value = 0.0;
+		if (queue->getPoint(queue->getPointCount() - 1, sampleOffset, value) == kResultTrue) {
+			toController_.tryPush(queue->getParameterId(), value);
+		}
+	}
+}
+
+bool PluginInstance::process(void *sharedMemory, const ProcessRequest &request)
+{
+	if (!active_ || request.frames == 0 || request.frames > setup_.maxBlockFrames) {
+		return false;
+	}
+
+	assignBuffers(sharedMemory, (request.flags & kProcessFlagSidechain) != 0, request.frames);
+	transferParameterChanges();
+	inputEvents_.clear();
+	outputEvents_.clear();
+
+	auto now = std::chrono::steady_clock::now().time_since_epoch();
+	processContext_.systemTime = std::chrono::duration_cast<std::chrono::nanoseconds>(now).count();
+	processContext_.projectTimeSamples = request.projectTimeSamples;
+	processContext_.continousTimeSamples = request.projectTimeSamples;
+	processContext_.projectTimeMusic =
+		static_cast<double>(request.projectTimeSamples) / setup_.sampleRate * (processContext_.tempo / 60.0);
+
+	processData_.numSamples = static_cast<int32>(request.frames);
+	if (processor_->process(processData_) != kResultOk) {
+		return false;
+	}
+
+	collectOutputParameterChanges();
+
+	/* Channels the plug-in does not process are passed through unchanged. */
+	size_t bytes = request.frames * sizeof(float);
+	for (uint32_t channel = mainOutputChannels_; channel < setup_.channels; channel++) {
+		std::memcpy(audioPlane(sharedMemory, AudioRegion::Output, channel),
+			    audioPlane(sharedMemory, AudioRegion::Input, channel), bytes);
+	}
+
+	return true;
+}
+
+bool PluginInstance::getState(std::vector<uint8_t> &componentState, std::vector<uint8_t> &controllerState,
+			      std::string &error)
+{
+	MemoryStream componentStream;
+	if (component_->getState(&componentStream) != kResultOk) {
+		error = "'" + name_ + "' could not save its state";
+		return false;
+	}
+	componentState = streamContents(componentStream);
+
+	controllerState.clear();
+	if (controller_ && !controllerIsComponent_) {
+		MemoryStream controllerStream;
+		if (controller_->getState(&controllerStream) == kResultOk) {
+			controllerState = streamContents(controllerStream);
+		}
+	}
+
+	return true;
+}
+
+bool PluginInstance::setState(const std::vector<uint8_t> &componentState, const std::vector<uint8_t> &controllerState,
+			      std::string &error)
+{
+	if (!componentState.empty()) {
+		std::vector<uint8_t> buffer = componentState;
+		MemoryStream stream(buffer.data(), static_cast<TSize>(buffer.size()));
+
+		if (component_->setState(&stream) != kResultOk) {
+			error = "'" + name_ + "' rejected the saved state";
+			return false;
+		}
+
+		if (controller_ && !controllerIsComponent_) {
+			stream.seek(0, IBStream::kIBSeekSet, nullptr);
+			controller_->setComponentState(&stream);
+		}
+	}
+
+	if (!controllerState.empty() && controller_ && !controllerIsComponent_) {
+		std::vector<uint8_t> buffer = controllerState;
+		MemoryStream stream(buffer.data(), static_cast<TSize>(buffer.size()));
+		controller_->setState(&stream);
+	}
+
+	return true;
+}
+
+IPtr<IPlugView> PluginInstance::createEditorView()
+{
+	if (!controller_) {
+		return nullptr;
+	}
+
+	return owned(controller_->createView(ViewType::kEditor));
+}
+
+int32 PluginInstance::idle()
+{
+	if (controller_) {
+		toController_.drain(mainThreadChanges_);
+		for (const ParameterChange &change : mainThreadChanges_) {
+			controller_->setParamNormalized(change.id, change.value);
+		}
+	}
+
+	return componentHandler_ ? componentHandler_->takeRestartFlags() : 0;
+}
+
