+#include "HostLog.hpp"
+#include "PluginInstance.hpp"
+#include "../bridge/MessageReader.hpp"
+#include "../bridge/MessageWriter.hpp"
+#include "../bridge/SharedMemory.hpp"
+
+#include <pluginterfaces/vst/ivsteditcontroller.h>
+
+namespace obs_vst3 {
+
+using namespace Steinberg;
+
+HostSession::HostSession(IpcChannel commandChannel, IpcChannel audioChannel, std::unique_ptr<SharedMemory> memory)
+	: commandChannel_(std::move(commandChannel)),
+	  audioChannel_(std::move(audioChannel)),
+	  memory_(std::move(memory))
+{
+	header_ = static_cast<SharedAudioHeader *>(memory_->data());
+}
+
+HostSession::~HostSession()
+{
+	audioChannel_.interrupt();
+	if (audioThread_.joinable()) {
+		audioThread_.join();
+	}
+}
+
+int HostSession::run()
+{
+	if (header_->magic != kSharedMemoryMagic || header_->version != kProtocolVersion ||
+	    header_->maxChannels != kMaxChannels || header_->maxFrames != kMaxBlockFrames) {
+		hostLog("Shared memory layout mismatch, refusing to start");
+		return 1;
+	}
+
+	eventLoop_ = EventLoop::create();
+	hostContext_ = owned(static_cast<FUnknown *>(new HostContext(eventLoop_->platformRunLoop())));
+
+	audioThread_ = std::thread(&HostSession::audioThreadMain, this);
+
+	eventLoop_->run(
+		commandChannel_,
+		[this](Command command, const std::vector<uint8_t> &payload) { handleCommand(command, payload); },
+		[this]() { handleIdle(); });
+
+	unloadPlugin();
+
+	audioChannel_.interrupt();
+	if (audioThread_.joinable()) {
+		audioThread_.join();
+	}
+
+	eventLoop_.reset();
+	return 0;
+}
+
+void HostSession::audioThreadMain()
+{
+	for (;;) {
+		ProcessRequest request = {};
+		if (!audioChannel_.read(&request, sizeof(request), -1)) {
+			break;
+		}
+
+		ProcessReply reply = {static_cast<int32_t>(Status::Busy), 0};
+		{
+			/* Never wait for the main thread: a reconfiguration in progress just bypasses this block. */
+			std::unique_lock<std::mutex> lock(pluginMutex_, std::try_to_lock);
+			if (lock.owns_lock()) {
+				Status status = Status::Failed;
+				if (!plugin_) {
+					status = Status::NotLoaded;
+				} else if (!plugin_->isConfigured()) {
+					status = Status::NotConfigured;
+				} else if (request.frames == 0 || request.frames > kMaxBlockFrames) {
+					status = Status::ProtocolError;
+				} else if (plugin_->process(memory_->data(), request)) {
+					status = Status::Ok;
+					header_->processedBlocks.fetch_add(1);
+				}
+				reply.status = static_cast<int32_t>(status);
+			}
+		}
+
+		if (!audioChannel_.write(&reply, sizeof(reply), kProcessTimeoutMs)) {
+			break;
+		}
+	}
+}
+
+void HostSession::handleCommand(Command command, const std::vector<uint8_t> &payload)
+{
+	MessageWriter body;
+	std::string error;
+	Status status = Status::Failed;
+
+	switch (command) {
+	case Command::Hello:
+		status = handleHello(payload, body, error);
+		break;
+	case Command::LoadPlugin:
+		status = handleLoadPlugin(payload, body, error);
+		break;
+	case Command::Configure:
+		status = handleConfigure(payload, body, error);
+		break;
+	case Command::SetState:
+		status = handleSetState(payload, error);
+		break;
+	case Command::GetState:
+		status = handleGetState(body, error);
+		break;
+	case Command::ShowEditor:
+		status = handleShowEditor(payload, error);
+		break;
+	case Command::HideEditor:
+		closeEditor();
+		status = Status::Ok;
+		break;
+	case Command::Shutdown:
+		unloadPlugin();
+		status = Status::Ok;
+		eventLoop_->quit();
+		break;
+	default:
+		error = "Unknown command";
+		status = Status::ProtocolError;
+		break;
+	}
+
+	if (status != Status::Ok && !error.empty()) {
+		hostLog("%s", error.c_str());
+	}
+
+	MessageWriter reply;
+	reply.writeInt32(static_cast<int32_t>(status));
+	reply.writeString(error);
+	if (status == Status::Ok) {
+		reply.writeBytes(body.data());
+	}
+
+	if (!commandChannel_.sendMessage(command, reply.data(), kCommandTimeoutMs)) {
+		eventLoop_->quit();
+	}
+}
+
+Status HostSession::handleHello(const std::vector<uint8_t> &payload, MessageWriter &reply, std::string &error)
+{
+	MessageReader reader(payload);
+	uint32_t version = 0;
+	if (!reader.readUInt32(version)) {
+		error = "Malformed handshake";
+		return Status::ProtocolError;
+	}
+
+	reply.writeUInt32(kProtocolVersion);
+	if (version != kProtocolVersion) {
+		error = "Protocol version mismatch";
+		return Status::Unsupported;
+	}
+
+	return Status::Ok;
+}
+
+Status HostSession::handleLoadPlugin(const std::vector<uint8_t> &payload, MessageWriter &reply, std::string &error)
+{
+	MessageReader reader(payload);
+	std::string modulePath;
+	std::string classId;
+	if (!reader.readString(modulePath) || !reader.readString(classId)) {
+		error = "Malformed load request";
+		return Status::ProtocolError;
+	}
+
+	unloadPlugin();
+	header_->latencySamples.store(0);
+
+	std::unique_ptr<PluginInstance> plugin =
+		PluginInstance::load(modulePath, classId, hostContext_, header_->editCount, error);
+	if (!plugin) {
+		return Status::Failed;
+	}
+
+	hostLog("Loaded '%s' (%s) from %s", plugin->name().c_str(), plugin->vendor().c_str(), modulePath.c_str());
+
+	reply.writeString(plugin->name());
+	reply.writeString(plugin->vendor());
+	reply.writeBool(plugin->hasEditor());
+	reply.writeBool(plugin->hasSidechainInput());
+
+	std::lock_guard<std::mutex> lock(pluginMutex_);
+	plugin_ = std::move(plugin);
+	return Status::Ok;
+}
+
+Status HostSession::handleConfigure(const std::vector<uint8_t> &payload, MessageWriter &reply, std::string &error)
+{
+	MessageReader reader(payload);
+	ProcessingSetup setup;
+	if (!reader.readDouble(setup.sampleRate) || !reader.readUInt32(setup.speakerLayout) ||
+	    !reader.readUInt32(setup.channels) || !reader.readUInt32(setup.maxBlockFrames) ||
+	    !reader.readBool(setup.sidechain)) {
+		error = "Malformed configure request";
+		return Status::ProtocolError;
+	}
+
+	std::lock_guard<std::mutex> lock(pluginMutex_);
+	if (!plugin_) {
+		error = "No plug-in loaded";
+		return Status::NotLoaded;
+	}
+
+	if (!plugin_->configure(setup, error)) {
+		return Status::Failed;
+	}
+
+	header_->latencySamples.store(plugin_->latencySamples());
+
+	reply.writeInt32(plugin_->latencySamples());
+	reply.writeUInt32(plugin_->processedChannels());
+	reply.writeBool(plugin_->sidechainActive());
+	return Status::Ok;
+}
+
+Status HostSession::handleSetState(const std::vector<uint8_t> &payload, std::string &error)
+{
+	MessageReader reader(payload);
+	std::vector<uint8_t> componentState;
+	std::vector<uint8_t> controllerState;
+	if (!reader.readBlob(componentState) || !reader.readBlob(controllerState)) {
+		error = "Malformed state";
+		return Status::ProtocolError;
+	}
+
+	if (!plugin_) {
+		error = "No plug-in loaded";
+		return Status::NotLoaded;
+	}
+
+	return plugin_->setState(componentState, controllerState, error) ? Status::Ok : Status::Failed;
+}
+
+Status HostSession::handleGetState(MessageWriter &reply, std::string &error)
+{
+	if (!plugin_) {
+		error = "No plug-in loaded";
+		return Status::NotLoaded;
+	}
+
+	std::vector<uint8_t> componentState;
+	std::vector<uint8_t> controllerState;
+	if (!plugin_->getState(componentState, controllerState, error)) {
+		return Status::Failed;
+	}
+
+	reply.writeBlob(componentState);
+	reply.writeBlob(controllerState);
+	return Status::Ok;
+}
+
+Status HostSession::handleShowEditor(const std::vector<uint8_t> &payload, std::string &error)
+{
+	MessageReader reader(payload);
+	std::string title;
+	if (!reader.readString(title)) {
+		error = "Malformed editor request";
+		return Status::ProtocolError;
+	}
+
+	if (editorWindow_) {
+		editorWindow_->bringToFront();
+		return Status::Ok;
+	}
+
+	if (!plugin_ || !plugin_->hasEditor()) {
+		error = "The plug-in has no editor";
+		return Status::Unsupported;
+	}
+
+	IPtr<IPlugView> view = plugin_->createEditorView();
+	if (!view) {
+		error = "The plug-in did not create an editor";
+		return Status::Unsupported;
+	}
+
+	editorCloseRequested_ = false;
+	editorWindow_ = eventLoop_->openEditor(view, title, [this]() { editorCloseRequested_ = true; }, error);
+	if (!editorWindow_) {
+		return Status::Failed;
+	}
+
+	editorView_ = view;
+	header_->editorOpen.store(1);
+	return Status::Ok;
+}
+
+void HostSession::closeEditor()
+{
+	/* Destroying the window detaches the view (IPlugView::removed) first. */
+	editorWindow_.reset();
+	editorView_ = nullptr;
+	editorCloseRequested_ = false;
+	header_->editorOpen.store(0);
+}
+
+void HostSession::unloadPlugin()
+{
+	closeEditor();
+
+	std::lock_guard<std::mutex> lock(pluginMutex_);
+	plugin_.reset();
+}
+
+void HostSession::handleIdle()
+{
+	if (editorCloseRequested_) {
+		closeEditor();
+	}
+
+	if (!plugin_) {
+		return;
+	}
+
+	int32 restartFlags = plugin_->idle();
+	if ((restartFlags & (Vst::kLatencyChanged | Vst::kIoChanged | Vst::kReloadComponent)) == 0) {
+		return;
+	}
+
+	/* Latency and I/O changes require the processor to be deactivated and set up again. */
+	std::string error;
+	std::lock_guard<std::mutex> lock(pluginMutex_);
+	if (!plugin_->reconfigure(error)) {
+		hostLog("Reconfiguration after restart request failed: %s", error.c_str());
+	}
+	header_->latencySamples.store(plugin_->latencySamples());
+}
+
+} // namespace obs_vst3
