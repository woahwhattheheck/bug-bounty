+// testExecutable returns the path to the test binary and arranges for it to
+// act as a plugin when Gazelle starts it.
+func testExecutable(t *testing.T) string {
+	t.Helper()
+	exe, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv(pluginEnv, "1")
+	return exe
+}
