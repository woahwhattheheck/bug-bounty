+/**
+ * Build a Lucene query from field/value pairs, e.g.
+ * { artist: 'Björk', country: 'IS' } => artist:"Björk" AND country:"IS"
+ * Array values are OR-ed: { type: ['album', 'ep'] } => (type:"album" OR type:"ep")
+ * Empty values are skipped.
+ */
+export function buildLuceneQuery(fields: Record<string, any>): string {
+  const term = (field: string, value: any) => `${field}:"${String(value).replace(/(["\\])/g, '\\$1')}"`;
+  return Object.keys(fields || {})
+    .filter(field => /^[a-z][a-z_-]*$/i.test(field))
+    .map(field => {
+      const values = castArray(fields[field])
+        .filter(value => !isNil(value) && String(value).trim() !== '')
+        .map(value => term(field, String(value).trim()));
+      if (values.length === 0) {
+        return '';
+      }
+      return values.length === 1 ? values[0] : `(${values.join(' OR ')})`;
+    })
+    .filter(clause => clause !== '')
+    .join(' AND ');
