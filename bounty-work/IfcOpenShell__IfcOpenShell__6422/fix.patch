+# Stands in for Inkscape: writes a small PNG and logs each call next to it.
+FAKE_SVG2PNG = (
+    "import sys; from PIL import Image; Image.new('RGBA', (8, 8)).save(sys.argv[2]); "
+    "open(sys.argv[2] + '.log', 'a').write(sys.argv[1] + ' ' + sys.argv[3] + chr(10))"
