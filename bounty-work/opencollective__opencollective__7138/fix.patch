@@ -0,0 +1,22 @@
+import '../../server/env';
+
+import config from 'config';
+
+import logger from '../../server/lib/logger';
+import { postMonthlyStatsForAllConnectedAccounts } from '../../server/lib/microblogging';
+import { parseToBoolean } from '../../server/lib/utils';
+import { runCronJob } from '../utils';
+
+/**
+ * Publishes the stats of the previous month on the microblogging accounts (Mastodon) connected
+ * by collectives that enabled monthly stats posts. Requires the `MICROBLOGGING_POSTS` feature flag.
+ */
+if (require.main === module) {
+  // Only run on the 1st of the month
+  if (config.env === 'production' && new Date().getDate() !== 1 && !parseToBoolean(process.env.OFFCYCLE)) {
+    logger.info('OC_ENV is production and today is not the 1st of month, script aborted!');
+    process.exit();
+  }
+
+  runCronJob('microblogging-monthly-stats', () => postMonthlyStatsForAllConnectedAccounts(), 23 * 60 * 60);
+}
