+++ b/clap_complete/tests/testsuite/engine.rs
@@ -1309,6 +1309,136 @@ a_pos,c_pos
     );
 }
 
+#[test]
+fn suggest_flag_subcommand() {
+    let mut cmd = Command::new("pacman")
+        .arg(
+            clap::Arg::new("verbose")
+                .short('v')
+                .long("verbose")
+                .action(clap::ArgAction::SetTrue),
+        )
+        .subcommand(
+            Command::new("sync")
+                .short_flag('S')
+                .long_flag("sync")
+                .about("Synchronize packages")
+                .arg(
+                    clap::Arg::new("search")
+                        .short('s')
+                        .long("search")
+                        .action(clap::ArgAction::SetTrue),
+                )
+                .arg(
+                    clap::Arg::new("dbpath")
+                        .short('b')
+                        .long("dbpath")
+                        .value_parser(["db_a", "db_b"]),
+                )
+                .arg(clap::Arg::new("package").value_parser(["pkg_a", "pkg_b"])),
+        )
+        .subcommand(
+            Command::new("hidden")
+                .short_flag('H')
+                .long_flag("hidden")
+                .hide(true),
+        );
+
+    assert_data_eq!(
+        complete!(cmd, " [TAB]"),
+        snapbox::str![[r#"
+sync	Synchronize packages
+help	Print this message or the help of the given subcommand(s)
+--verbose
+--help	Print help
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "--[TAB]"),
+        snapbox::str![[r#"
+--verbose
+--help	Print help
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "--s[TAB]"),
+        snapbox::str![[r#"
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "--hid[TAB]"),
+        snapbox::str![[r#"
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "-[TAB]"),
+        snapbox::str![[r#"
+-v	--verbose
+-h	Print help
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "-S[TAB]"),
+        snapbox::str![[r#"
+-Sv	--verbose
+-Sh	Print help
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "-vS[TAB]"),
+        snapbox::str![[r#"
+-vSv	--verbose
+-vSh	Print help
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "-S [TAB]"),
+        snapbox::str![[r#"
+sync	Synchronize packages
+help	Print this message or the help of the given subcommand(s)
+--verbose
+--help	Print help
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "--sync [TAB]"),
+        snapbox::str![[r#"
+sync	Synchronize packages
+help	Print this message or the help of the given subcommand(s)
+--verbose
+--help	Print help
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "-vSs [TAB]"),
+        snapbox::str![[r#"
+sync	Synchronize packages
+help	Print this message or the help of the given subcommand(s)
+--verbose
+--help	Print help
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "-Sb [TAB]"),
+        snapbox::str![[r#"
+sync	Synchronize packages
+help	Print this message or the help of the given subcommand(s)
+--verbose
+--help	Print help
+"#]]
+    );
+}
