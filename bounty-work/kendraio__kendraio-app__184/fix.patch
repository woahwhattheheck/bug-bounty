+function checkPaging(name: string, value: any, min: number, max: number) {
+  if (isNil(value) || value === '') {
+    return undefined;
+  }
+  const num = Number(value);
+  if (!Number.isInteger(num) || num < min || num > max) {
+    throw new MusicBrainzError(`MusicBrainz ${name} must be a whole number between ${min} and ${max}`);
+  }
