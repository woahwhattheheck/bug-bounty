+/// Suffix to complete a flag into a valid argument
+fn flag_suffix(arg: &clap::Arg) -> &'static str {
+    // `require_equals` errors without an `=` when a value is required
+    if arg.is_require_equals_set() && arg.get_num_args().expect("built").min_values() > 0 {
+        "="
+    } else {
+        ""
+    }
+}
+
 fn populate_arg_candidate(candidate: CompletionCandidate, arg: &clap::Arg) -> CompletionCandidate {
     candidate
         .help(arg.get_help().cloned())
@@ -637,7 +660,7 @@ fn parse_shortflags<'c, 's>(
                     is_find.unwrap_or(false)
                 });
                 if opt
-                    .map(|o| o.get_num_args().expect("built").takes_values())
+                    .map(|o| takes_attached_value(o, &short))
                     .unwrap_or(false)
                 {
                     takes_value_opt = opt;
@@ -654,6 +677,23 @@ fn parse_shortflags<'c, 's>(
     (leading_flags, takes_value_opt, short)
 }
 
+/// Whether `opt` takes the rest of its short flags, `rest`, as its value
+fn takes_attached_value(opt: &clap::Arg, rest: &clap_lex::ShortFlags<'_>) -> bool {
+    let num_args = opt.get_num_args().expect("built");
+    if opt.is_require_equals_set() && num_args.min_values() == 0 {
+        // Without `=`, the optional value is skipped and `rest` is more short flags
+        matches!(rest.clone().next_flag(), Some(Ok('=')))
+    } else {
+        num_args.takes_values()
+    }
+}
+
+/// Whether `opt` takes its value from the next argument when none is attached
+fn takes_next_value(opt: &clap::Arg) -> bool {
+    // `require_equals` only accepts values attached with `=`
+    opt.get_num_args().expect("built").takes_values() && !opt.is_require_equals_set()
+}
+
 /// Parse the positional arguments. Return the new state and the new positional index.
