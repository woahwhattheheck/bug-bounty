+#pragma once
+
+#include "../EventLoop.hpp"
+#include "RunLoopLinux.hpp"
+
+#include <map>
+
+struct _XDisplay;
+union _XEvent;
+
+namespace obs_vst3 {
+
+class EditorWindowX11;
+
+/*
+ * poll() based main loop of the bridge process on Linux. The X11 display is
+ * only opened when the first editor is shown, so processing works without a
+ * display server. Under Wayland sessions editors use XWayland; OBS itself
+ * never talks to X11 on behalf of a plug-in.
+ */
+class EventLoopX11 : public EventLoop {
+public:
+	EventLoopX11();
+	~EventLoopX11() override;
+
+	void run(IpcChannel &commandChannel, const CommandHandler &onCommand, const IdleHandler &onIdle) override;
+	void quit() override;
+	std::unique_ptr<EditorWindow> openEditor(Steinberg::IPlugView *view, const std::string &title,
+						 CloseHandler onCloseRequested, std::string &error) override;
+	Steinberg::FUnknown *platformRunLoop() override { return &runLoop_; }
+
+	void registerWindow(unsigned long window, EditorWindowX11 *editor);
+	void unregisterWindow(unsigned long window);
+
+private:
+	bool openDisplay(std::string &error);
+	void processWindowEvents();
+
+	_XDisplay *display_ = nullptr;
+	RunLoopLinux &runLoop_ = RunLoopLinux::instance();
+	std::map<unsigned long, EditorWindowX11 *> windows_;
+	bool running_ = false;
+};
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/host/linux/RunLoopLinux.cpp b/plugins/obs-vst3/host/linux/RunLoopLinux.cpp
new file mode 100644
index 0000000..d36c176
--- /dev/null
+++ b/plugins/obs-vst3/host/linux/RunLoopLinux.cpp
@@ -0,0 +1,138 @@
+#include "RunLoopLinux.hpp"
+
+#include <algorithm>
+
+namespace obs_vst3 {
+
+using namespace Steinberg;
+
+RunLoopLinux &RunLoopLinux::instance()
+{
+	/* Intentionally never destroyed, see the class description. */
+	static RunLoopLinux *runLoop = new RunLoopLinux();
+	return *runLoop;
+}
+
+tresult PLUGIN_API RunLoopLinux::queryInterface(const TUID iid, void **object)
+{
+	if (FUnknownPrivate::iidEqual(iid, FUnknown::iid) || FUnknownPrivate::iidEqual(iid, Linux::IRunLoop::iid)) {
+		*object = static_cast<Linux::IRunLoop *>(this);
+		return kResultOk;
+	}
+
+	*object = nullptr;
+	return kNoInterface;
+}
+
+tresult PLUGIN_API RunLoopLinux::registerEventHandler(Linux::IEventHandler *handler, Linux::FileDescriptor fd)
+{
+	if (!handler || fd < 0) {
+		return kInvalidArgument;
+	}
+
+	eventHandlers_.push_back({shared(handler), fd});
+	return kResultTrue;
+}
+
+tresult PLUGIN_API RunLoopLinux::unregisterEventHandler(Linux::IEventHandler *handler)
+{
+	auto removed = std::remove_if(eventHandlers_.begin(), eventHandlers_.end(),
+				      [handler](const EventHandlerEntry &entry) { return entry.handler == handler; });
+	if (removed == eventHandlers_.end()) {
+		return kInvalidArgument;
+	}
+
+	eventHandlers_.erase(removed, eventHandlers_.end());
+	return kResultTrue;
+}
+
+tresult PLUGIN_API RunLoopLinux::registerTimer(Linux::ITimerHandler *handler, Linux::TimerInterval milliseconds)
+{
+	if (!handler || milliseconds == 0) {
+		return kInvalidArgument;
+	}
+
+	std::chrono::milliseconds interval(milliseconds);
+	timers_.push_back({shared(handler), interval, Clock::now() + interval});
+	return kResultTrue;
+}
+
+tresult PLUGIN_API RunLoopLinux::unregisterTimer(Linux::ITimerHandler *handler)
+{
+	auto removed = std::remove_if(timers_.begin(), timers_.end(),
+				      [handler](const TimerEntry &entry) { return entry.handler == handler; });
+	if (removed == timers_.end()) {
+		return kInvalidArgument;
+	}
+
+	timers_.erase(removed, timers_.end());
+	return kResultTrue;
+}
+
+void RunLoopLinux::prepare(std::vector<pollfd> &descriptors)
+{
+	polledHandlers_ = eventHandlers_;
+	for (const EventHandlerEntry &entry : polledHandlers_) {
+		descriptors.push_back({entry.fd, POLLIN, 0});
+	}
+}
+
+bool RunLoopLinux::isRegistered(const EventHandlerEntry &entry) const
+{
+	return std::any_of(eventHandlers_.begin(), eventHandlers_.end(), [&entry](const EventHandlerEntry &current) {
+		return current.handler == entry.handler && current.fd == entry.fd;
+	});
+}
+
+void RunLoopLinux::dispatch(const std::vector<pollfd> &descriptors, size_t firstIndex, bool callAll)
+{
+	/* Handlers may (un)register others while being called, so work on the polled snapshot. */
+	std::vector<EventHandlerEntry> polled;
+	polled.swap(polledHandlers_);
+
+	for (size_t index = 0; index < polled.size() && firstIndex + index < descriptors.size(); index++) {
+		const pollfd &descriptor = descriptors[firstIndex + index];
+		if ((descriptor.revents == 0 && !callAll) || !isRegistered(polled[index])) {
+			continue;
+		}
+
+		polled[index].handler->onFDIsSet(polled[index].fd);
+	}
+}
+
+void RunLoopLinux::dispatchTimers()
+{
+	Clock::time_point now = Clock::now();
+	std::vector<TimerEntry> dueTimers;
+
+	for (TimerEntry &timer : timers_) {
+		if (timer.due <= now) {
+			timer.due = now + timer.interval;
+			dueTimers.push_back(timer);
+		}
+	}
+
+	for (TimerEntry &timer : dueTimers) {
+		bool stillRegistered = std::any_of(timers_.begin(), timers_.end(), [&timer](const TimerEntry &current) {
+			return current.handler == timer.handler;
+		});
+		if (stillRegistered) {
+			timer.handler->onTimer();
+		}
+	}
+}
+
+int RunLoopLinux::timeoutMs(int maximumMs) const
+{
+	Clock::time_point now = Clock::now();
+	int timeout = maximumMs;
+
+	for (const TimerEntry &timer : timers_) {
+		auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(timer.due - now).count();
+		timeout = std::min(timeout, remaining > 0 ? static_cast<int>(remaining) : 0);
+	}
+
+	return timeout;
+}
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/host/linux/RunLoopLinux.hpp b/plugins/obs-vst3/host/linux/RunLoopLinux.hpp
new file mode 100644
index 0000000..b957351
--- /dev/null
+++ b/plugins/obs-vst3/host/linux/RunLoopLinux.hpp
@@ -0,0 +1,76 @@
+#pragma once
+
+#include <pluginterfaces/gui/iplugview.h>
+
+#include <chrono>
+#include <vector>
+
+#include <poll.h>
+
+namespace obs_vst3 {
+
+/*
+ * Steinberg::Linux::IRunLoop implementation. Plug-in editors on Linux do not
+ * run their own event loop; they register the file descriptors of their X11
+ * connection and periodic timers here, and the bridge's main loop calls them
+ * back on the UI thread.
+ */
+class RunLoopLinux : public Steinberg::Linux::IRunLoop {
+public:
+	/*
+	 * The run loop lives as long as the process. Plug-in toolkits keep references
+	 * to it in static objects (VSTGUI stores it in its platform factory) and
+	 * release them from exit handlers, after the event loop is gone.
+	 */
+	static RunLoopLinux &instance();
+
+	Steinberg::tresult PLUGIN_API registerEventHandler(Steinberg::Linux::IEventHandler *handler,
+							   Steinberg::Linux::FileDescriptor fd) override;
+	Steinberg::tresult PLUGIN_API unregisterEventHandler(Steinberg::Linux::IEventHandler *handler) override;
+	Steinberg::tresult PLUGIN_API registerTimer(Steinberg::Linux::ITimerHandler *handler,
+						    Steinberg::Linux::TimerInterval milliseconds) override;
+	Steinberg::tresult PLUGIN_API unregisterTimer(Steinberg::Linux::ITimerHandler *handler) override;
+
+	Steinberg::tresult PLUGIN_API queryInterface(const Steinberg::TUID iid, void **object) override;
+	Steinberg::uint32 PLUGIN_API addRef() override { return 1; }
+	Steinberg::uint32 PLUGIN_API release() override { return 1; }
+
+	/* Appends the registered descriptors; dispatch() expects the same vector after poll(). */
+	void prepare(std::vector<pollfd> &descriptors);
+
+	/*
+	 * Calls the handlers whose descriptor became readable. With callAll set every
+	 * handler is called: toolkits like VSTGUI read X11 events into their own queue
+	 * while doing other requests, so a readable socket is not the only signal that
+	 * events are pending (the SDK's own editorhost polls the handlers continuously).
+	 */
+	void dispatch(const std::vector<pollfd> &descriptors, size_t firstIndex, bool callAll);
+	void dispatchTimers();
+
+	/* Milliseconds until the next timer is due, capped at maximumMs. */
+	int timeoutMs(int maximumMs) const;
+
+private:
+	using Clock = std::chrono::steady_clock;
+
+	struct EventHandlerEntry {
+		Steinberg::IPtr<Steinberg::Linux::IEventHandler> handler;
+		int fd;
+	};
+
+	struct TimerEntry {
+		Steinberg::IPtr<Steinberg::Linux::ITimerHandler> handler;
+		std::chrono::milliseconds interval;
+		Clock::time_point due;
+	};
+
+	RunLoopLinux() = default;
+
+	bool isRegistered(const EventHandlerEntry &entry) const;
+
+	std::vector<EventHandlerEntry> eventHandlers_;
+	std::vector<EventHandlerEntry> polledHandlers_;
+	std::vector<TimerEntry> timers_;
+};
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/host/macos/EditorWindowCocoa.hpp b/plugins/obs-vst3/host/macos/EditorWindowCocoa.hpp
new file mode 100644
index 0000000..ddc3ce6
--- /dev/null
+++ b/plugins/obs-vst3/host/macos/EditorWindowCocoa.hpp
@@ -0,0 +1,41 @@
+#pragma once
+
+#include "../EditorWindow.hpp"
+#include "../EventLoop.hpp"
+
+#include <memory>
+#include <string>
+
+namespace obs_vst3 {
+
+/* NSWindow embedding a plug-in editor (kPlatformTypeNSView). */
+class EditorWindowCocoa : public EditorWindow {
+public:
+	static std::unique_ptr<EditorWindowCocoa> create(Steinberg::IPlugView *view, const std::string &title,
+							 EventLoop::CloseHandler onCloseRequested, std::string &error);
+	~EditorWindowCocoa() override;
+
+	Steinberg::tresult PLUGIN_API resizeView(Steinberg::IPlugView *view, Steinberg::ViewRect *newSize) override;
+	Steinberg::tresult PLUGIN_API queryInterface(const Steinberg::TUID iid, void **object) override;
+
+	void bringToFront() override;
+
+	/* Called by the window delegate. */
+	void closeRequested();
+	void windowResized();
+
+private:
+	EditorWindowCocoa(Steinberg::IPlugView *view, EventLoop::CloseHandler onCloseRequested);
+
+	Steinberg::IPtr<Steinberg::IPlugView> view_;
+	EventLoop::CloseHandler onCloseRequested_;
+
+	/* NSWindow and its delegate, retained (bridged to keep this header plain C++). */
+	void *window_ = nullptr;
+	void *delegate_ = nullptr;
+	bool resizable_ = false;
+	bool attached_ = false;
+	bool resizing_ = false;
+};
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/host/macos/EditorWindowCocoa.mm b/plugins/obs-vst3/host/macos/EditorWindowCocoa.mm
new file mode 100644
index 0000000..22463e7
--- /dev/null
+++ b/plugins/obs-vst3/host/macos/EditorWindowCocoa.mm
@@ -0,0 +1,170 @@
+#include "EditorWindowCocoa.hpp"
+
+#import <Cocoa/Cocoa.h>
+
+@interface OBSVST3EditorWindowDelegate : NSObject <NSWindowDelegate>
+@property (nonatomic, assign) obs_vst3::EditorWindowCocoa *owner;
+@end
+
+@implementation OBSVST3EditorWindowDelegate
+
+- (BOOL)windowShouldClose:(NSWindow *)sender
+{
+    (void) sender;
+    if (self.owner) {
+        self.owner->closeRequested();
+    }
+    /* The owner closes the window outside of event dispatching. */
+    return NO;
+}
+
+- (void)windowDidResize:(NSNotification *)notification
+{
+    (void) notification;
+    if (self.owner) {
+        self.owner->windowResized();
+    }
+}
+
+@end
+
+namespace obs_vst3 {
+
+    using namespace Steinberg;
+
+    namespace {
+
+        constexpr CGFloat kDefaultWidth = 640;
+        constexpr CGFloat kDefaultHeight = 480;
+
+    }  // namespace
+
+    EditorWindowCocoa::EditorWindowCocoa(IPlugView *view, EventLoop::CloseHandler onCloseRequested) :
+        view_(shared(view)), onCloseRequested_(std::move(onCloseRequested))
+    {}
+
+    std::unique_ptr<EditorWindowCocoa> EditorWindowCocoa::create(IPlugView *view, const std::string &title,
+                                                                 EventLoop::CloseHandler onCloseRequested,
+                                                                 std::string &error)
+    {
+        if (view->isPlatformTypeSupported(kPlatformTypeNSView) != kResultTrue) {
+            error = "The plug-in editor does not support NSView";
+            return nullptr;
+        }
+
+        std::unique_ptr<EditorWindowCocoa> editor(new EditorWindowCocoa(view, std::move(onCloseRequested)));
+        editor->resizable_ = view->canResize() == kResultTrue;
+
+        ViewRect rect;
+        NSRect contentRect = NSMakeRect(0, 0, kDefaultWidth, kDefaultHeight);
+        if (view->getSize(&rect) == kResultTrue && rect.getWidth() > 0 && rect.getHeight() > 0) {
+            contentRect = NSMakeRect(0, 0, rect.getWidth(), rect.getHeight());
+        }
+
+        NSWindowStyleMask style = NSWindowStyleMaskTitled | NSWindowStyleMaskClosable | NSWindowStyleMaskMiniaturizable;
+        if (editor->resizable_) {
+            style |= NSWindowStyleMaskResizable;
+        }
+
+        NSWindow *window = [[NSWindow alloc] initWithContentRect:contentRect styleMask:style
+                                                         backing:NSBackingStoreBuffered
+                                                           defer:NO];
+        [window setReleasedWhenClosed:NO];
+        [window setTitle:[NSString stringWithUTF8String:title.c_str()]];
+
+        OBSVST3EditorWindowDelegate *delegate = [[OBSVST3EditorWindowDelegate alloc] init];
+        delegate.owner = editor.get();
+        [window setDelegate:delegate];
+        [window center];
+
+        editor->window_ = (__bridge_retained void *) window;
+        editor->delegate_ = (__bridge_retained void *) delegate;
+
+        view->setFrame(editor.get());
+        if (view->attached((__bridge void *) [window contentView], kPlatformTypeNSView) != kResultOk) {
+            error = "The plug-in editor could not be attached to its window";
+            return nullptr;
+        }
+        editor->attached_ = true;
+
+        [window makeKeyAndOrderFront:nil];
+        [NSApp activateIgnoringOtherApps:YES];
+        return editor;
+    }
+
+    EditorWindowCocoa::~EditorWindowCocoa()
+    {
+        if (attached_) {
+            view_->removed();
+        }
+        view_->setFrame(nullptr);
+
+        NSWindow *window = (__bridge_transfer NSWindow *) window_;
+        OBSVST3EditorWindowDelegate *delegate = (__bridge_transfer OBSVST3EditorWindowDelegate *) delegate_;
+        delegate.owner = nullptr;
+
+        [window setDelegate:nil];
+        [window orderOut:nil];
+        [window close];
+    }
+
+    tresult PLUGIN_API EditorWindowCocoa::queryInterface(const TUID iid, void **object)
+    {
+        if (FUnknownPrivate::iidEqual(iid, FUnknown::iid) || FUnknownPrivate::iidEqual(iid, IPlugFrame::iid)) {
+            *object = static_cast<IPlugFrame *>(this);
+            return kResultOk;
+        }
+
+        *object = nullptr;
+        return kNoInterface;
+    }
+
+    tresult PLUGIN_API EditorWindowCocoa::resizeView(IPlugView *view, ViewRect *newSize)
+    {
+        if (!newSize || view != view_.get() || newSize->getWidth() <= 0 || newSize->getHeight() <= 0) {
+            return kInvalidArgument;
+        }
+
+        NSWindow *window = (__bridge NSWindow *) window_;
+        resizing_ = true;
+        [window setContentSize:NSMakeSize(newSize->getWidth(), newSize->getHeight())];
+        view_->onSize(newSize);
+        resizing_ = false;
+        return kResultTrue;
+    }
+
+    void EditorWindowCocoa::bringToFront()
+    {
+        NSWindow *window = (__bridge NSWindow *) window_;
+        [window makeKeyAndOrderFront:nil];
+        [NSApp activateIgnoringOtherApps:YES];
+    }
+
+    void EditorWindowCocoa::closeRequested()
+    {
+        if (onCloseRequested_) {
+            onCloseRequested_();
+        }
+    }
+
+    void EditorWindowCocoa::windowResized()
+    {
+        if (!attached_ || resizing_ || !resizable_) {
+            return;
+        }
+
+        NSWindow *window = (__bridge NSWindow *) window_;
+        NSRect frame = [[window contentView] frame];
+        ViewRect rect(0, 0, static_cast<int32>(frame.size.width), static_cast<int32>(frame.size.height));
+
+        if (view_->checkSizeConstraint(&rect) == kResultTrue &&
+            (rect.getWidth() != frame.size.width || rect.getHeight() != frame.size.height)) {
+            resizing_ = true;
+            [window setContentSize:NSMakeSize(rect.getWidth(), rect.getHeight())];
+            resizing_ = false;
+        }
+
+        view_->onSize(&rect);
+    }
+
+}  // namespace obs_vst3
diff --git a/plugins/obs-vst3/host/macos/EventLoopCocoa.hpp b/plugins/obs-vst3/host/macos/EventLoopCocoa.hpp
