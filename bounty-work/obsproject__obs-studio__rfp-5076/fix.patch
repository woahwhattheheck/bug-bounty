 	}
 }
 
+void OBSStudioAPI::obs_frontend_get_scene_folder_names(std::vector<std::string> &strings)
+{
+	QStringList names;
+	QMetaObject::invokeMethod(main, [this, &names]() { names = main->GetSceneFolderNames(); }, WaitConnection());
+
+	for (const QString &name : names) {
+		strings.emplace_back(name.toStdString());
+	}
+}
+
+char *OBSStudioAPI::obs_frontend_get_scene_folder(obs_source_t *scene)
+{
+	QString name;
+	QMetaObject::invokeMethod(
+		main, [this, &name, scene = OBSSource(scene)]() { name = main->GetSceneFolderName(scene); },
+		WaitConnection());
+
+	return name.isEmpty() ? nullptr : bstrdup(QT_TO_UTF8(name));
+}
+
+void OBSStudioAPI::obs_frontend_get_scene_folder_scenes(const char *folder, struct obs_frontend_source_list *sources)
+{
+	QList<OBSSource> scenes;
+	QMetaObject::invokeMethod(
+		main, [this, &scenes, folder = QT_UTF8(folder)]() { scenes = main->GetSceneFolderScenes(folder); },
+		WaitConnection());
+
+	for (const OBSSource &scene : scenes) {
+		obs_source_t *source = scene.Get();
+
+		if (obs_source_get_ref(source) != nullptr) {
+			da_push_back(sources->sources, &source);
+		}
+	}
+}
+
+bool OBSStudioAPI::obs_frontend_add_scene_folder(const char *name)
+{
+	bool success = false;
+	QMetaObject::invokeMethod(
+		main, [this, &success, name = QT_UTF8(name)]() { success = main->CreateSceneFolder(name); },
+		WaitConnection());
+	return success;
+}
+
+bool OBSStudioAPI::obs_frontend_remove_scene_folder(const char *name)
+{
+	bool success = false;
+	QMetaObject::invokeMethod(
+		main, [this, &success, name = QT_UTF8(name)]() { success = main->DeleteSceneFolder(name); },
+		WaitConnection());
+	return success;
+}
+
+bool OBSStudioAPI::obs_frontend_set_scene_folder(obs_source_t *scene, const char *folder)
+{
+	bool success = false;
+	QMetaObject::invokeMethod(
+		main,
+		[this, &success, scene = OBSSource(scene), folder = QT_UTF8(folder)]() {
+			success = main->SetSceneFolder(scene, folder);
+		},
+		WaitConnection());
+	return success;
+}
+
 obs_source_t *OBSStudioAPI::obs_frontend_get_current_scene()
 {
 	if (main->IsPreviewProgramMode()) {
