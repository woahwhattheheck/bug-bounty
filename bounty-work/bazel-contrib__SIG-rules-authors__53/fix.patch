+class GistStoreTest(unittest.TestCase):
+    def test_loads_truncated_files_from_raw_url_and_saves_changes(self):
+        raw_url = "https://gist.githubusercontent.com/u/abc/raw/123/views.csv"
+        transport = FakeTransport(
+            {
+                ("GET", API + "/gists/abc"): _response(
+                    payload={
+                        "files": {
+                            "views.csv": {
+                                "truncated": True,
+                                "content": "repo,da",
+                                "raw_url": raw_url,
+                            },
+                            "clones.csv": {
+                                "truncated": False,
+                                "content": "repo,date,count,uniques\n",
+                            },
+                            "notes.md": {"content": "unrelated"},
+                        }
+                    }
+                ),
+                ("GET", raw_url): _response(
+                    text="repo,date,count,uniques\no/r,2026-09-01,1,1\n"
+                ),
+                ("PATCH", API + "/gists/abc"): _response(payload={}),
+            }
+        )
+        client = github_traffic.GitHubClient("t", transport=transport)
+        store = github_traffic.GistStore(client, "abc")
+        files = store.load()
+        self.assertEqual(
+            files,
+            {
+                "views.csv": "repo,date,count,uniques\no/r,2026-09-01,1,1\n",
+                "clones.csv": "repo,date,count,uniques\n",
+            },
+        )
+        # The raw download must not carry the token.
+        raw_call = next(c for c in transport.calls if c["url"] == raw_url)
+        self.assertNotIn("Authorization", raw_call["headers"])
+
+        store.save(
+            {
+                "views.csv": files["views.csv"],  # unchanged, not sent
+                "clones.csv": "repo,date,count,uniques\no/r,2026-09-01,2,1\n",
+            }
+        )
+        patch = [c for c in transport.calls if c["method"] == "PATCH"]
+        self.assertEqual(len(patch), 1)
+        self.assertEqual(
+            patch[0]["body"],
+            {
+                "files": {
+                    "clones.csv": {
+                        "content": "repo,date,count,uniques\no/r,2026-09-01,2,1\n"
+                    }
+                }
+            },
+        )
+        # Saving the same content again does nothing.
+        store.save({"clones.csv": "repo,date,count,uniques\no/r,2026-09-01,2,1\n"})
+        self.assertEqual(len([c for c in transport.calls if c["method"] == "PATCH"]), 1)
