@@ -0,0 +1,47 @@
+#include "ComponentHandler.hpp"
+#include "ParameterQueue.hpp"
+
+namespace obs_vst3 {
+
+using namespace Steinberg;
+
+ComponentHandler::ComponentHandler(ParameterQueue &toProcessor, std::atomic<uint32_t> &editCount)
+	: toProcessor_(toProcessor),
+	  editCount_(editCount){FUNKNOWN_CTOR}
+
+	  ComponentHandler::~ComponentHandler(){FUNKNOWN_DTOR}
+
+	  IMPLEMENT_FUNKNOWN_METHODS(ComponentHandler, Vst::IComponentHandler, Vst::IComponentHandler::iid)
+
+		  tresult PLUGIN_API ComponentHandler::beginEdit(Vst::ParamID id)
+{
+	(void)id;
+	return kResultOk;
+}
+
+tresult PLUGIN_API ComponentHandler::performEdit(Vst::ParamID id, Vst::ParamValue valueNormalized)
+{
+	toProcessor_.push(id, valueNormalized);
+	editCount_.fetch_add(1);
+	return kResultOk;
+}
+
+tresult PLUGIN_API ComponentHandler::endEdit(Vst::ParamID id)
+{
+	(void)id;
+	editCount_.fetch_add(1);
+	return kResultOk;
+}
+
+tresult PLUGIN_API ComponentHandler::restartComponent(int32 flags)
+{
+	restartFlags_.fetch_or(flags);
+	return kResultOk;
+}
+
+int32 ComponentHandler::takeRestartFlags()
+{
+	return restartFlags_.exchange(0);
+}
+
+} // namespace obs_vst3
