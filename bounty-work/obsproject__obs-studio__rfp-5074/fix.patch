+
+constexpr int32 kMaxParameterQueues = 1024;
+constexpr double kDefaultTempo = 120.0;
+
+std::vector<uint8_t> streamContents(MemoryStream &stream)
+{
+	const auto *data = reinterpret_cast<const uint8_t *>(stream.getData());
+	return std::vector<uint8_t>(data, data + stream.getSize());
+}
