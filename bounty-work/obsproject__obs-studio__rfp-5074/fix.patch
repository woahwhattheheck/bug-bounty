@@ -0,0 +1,36 @@
+#pragma once
+
+#include "../EventLoop.hpp"
+
+#include <atomic>
+#include <thread>
+
+namespace obs_vst3 {
+
+/*
+ * Win32 message loop of the bridge process. A reader thread receives
+ * commands from the pipe and posts them to a message-only window, so they are
+ * also delivered while a modal loop (window move/resize, plug-in dialogs)
+ * is running. A WM_TIMER drives the idle callback.
+ */
+class EventLoopWin32 : public EventLoop {
+public:
+	EventLoopWin32();
+	~EventLoopWin32() override;
+
+	void run(IpcChannel &commandChannel, const CommandHandler &onCommand, const IdleHandler &onIdle) override;
+	void quit() override;
+	std::unique_ptr<EditorWindow> openEditor(Steinberg::IPlugView *view, const std::string &title,
+						 CloseHandler onCloseRequested, std::string &error) override;
+
+private:
+	static intptr_t __stdcall messageWindowProc(void *window, unsigned int message, uintptr_t wParam,
+						    intptr_t lParam);
+
+	void *messageWindow_ = nullptr;
+	const CommandHandler *onCommand_ = nullptr;
+	const IdleHandler *onIdle_ = nullptr;
+	bool oleInitialized_ = false;
+};
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/obs-vst3.cpp b/plugins/obs-vst3/obs-vst3.cpp
new file mode 100644
index 0000000..c0ec6ec
--- /dev/null
+++ b/plugins/obs-vst3/obs-vst3.cpp
@@ -0,0 +1,135 @@
+#include "PluginCatalog.hpp"
+#include "VST3Filter.hpp"
+
+#include <obs-module.h>
+#include <util/bmem.h>
+#include <util/platform.h>
+
+#include <string>
+
+OBS_DECLARE_MODULE()
+OBS_MODULE_USE_DEFAULT_LOCALE("obs-vst3", "en-US")
+
+MODULE_EXPORT const char *obs_module_description(void)
+{
+	return "VST3 Plug-in filter";
+}
+
+using obs_vst3::PluginCatalog;
+using obs_vst3::VST3Filter;
+
+namespace {
+
+#ifdef _WIN32
+constexpr const char *kHostExecutable = "obs-vst3-host.exe";
+#else
+constexpr const char *kHostExecutable = "obs-vst3-host";
+#endif
+
+std::string findHostExecutable()
+{
+	char *path = os_get_executable_path_ptr(kHostExecutable);
+	std::string result = path ? path : "";
+	bfree(path);
+	return result;
+}
+
+std::string cacheFilePath()
+{
+	char *path = obs_module_config_path("plugin-cache.json");
+	std::string result = path ? path : "";
+	bfree(path);
+	return result;
+}
+
+const char *filterName(void *typeData)
+{
+	(void)typeData;
+	return obs_module_text("VST3Filter");
+}
+
+void *filterCreate(obs_data_t *settings, obs_source_t *source)
+{
+	auto *catalog = static_cast<PluginCatalog *>(obs_source_get_type_data(source));
+	auto *filter = new VST3Filter(source, *catalog);
+	filter->update(settings);
+	return filter;
+}
+
+void filterDestroy(void *data)
+{
+	delete static_cast<VST3Filter *>(data);
+}
+
+void filterUpdate(void *data, obs_data_t *settings)
+{
+	static_cast<VST3Filter *>(data)->update(settings);
+}
+
+void filterSave(void *data, obs_data_t *settings)
+{
+	static_cast<VST3Filter *>(data)->save(settings);
+}
+
+struct obs_audio_data *filterAudio(void *data, struct obs_audio_data *audio)
+{
+	return static_cast<VST3Filter *>(data)->filterAudio(audio);
+}
+
+void filterTick(void *data, float seconds)
+{
+	(void)seconds;
+	static_cast<VST3Filter *>(data)->tick();
+}
+
+obs_properties_t *filterProperties(void *data, void *typeData)
+{
+	if (!data) {
+		return VST3Filter::getTypeProperties(*static_cast<PluginCatalog *>(typeData));
+	}
+
+	return static_cast<VST3Filter *>(data)->getProperties();
+}
+
+void filterDefaults(obs_data_t *settings)
+{
+	VST3Filter::getDefaults(settings);
+}
+
+void freeTypeData(void *typeData)
+{
+	delete static_cast<PluginCatalog *>(typeData);
+}
+
+} // namespace
+
+bool obs_module_load(void)
+{
+	std::string hostExecutable = findHostExecutable();
+	if (hostExecutable.empty() || !os_file_exists(hostExecutable.c_str())) {
+		blog(LOG_WARNING, "[obs-vst3] '%s' was not found, the VST3 filter is unavailable", kHostExecutable);
+		return false;
+	}
+
+	auto *catalog = new PluginCatalog(hostExecutable, cacheFilePath());
+	catalog->scanInBackground();
+
+	struct obs_source_info info = {};
+	info.id = "vst3_filter";
+	info.type = OBS_SOURCE_TYPE_FILTER;
+	info.output_flags = OBS_SOURCE_AUDIO;
+	info.get_name = filterName;
+	info.create = filterCreate;
+	info.destroy = filterDestroy;
+	info.update = filterUpdate;
+	info.save = filterSave;
+	info.filter_audio = filterAudio;
+	info.video_tick = filterTick;
+	info.get_properties2 = filterProperties;
+	info.get_defaults = filterDefaults;
+	info.type_data = catalog;
+	info.free_type_data = freeTypeData;
+
+	obs_register_source(&info);
+	return true;
+}
