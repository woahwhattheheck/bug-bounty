+  castArray(release.urls || []).forEach((url: any, index: number) => {
+    const entry = isString(url) ? { url } : (url || {});
+    add(`urls.${index}.url`, entry.url);
+    add(`urls.${index}.link_type`, entry.linkType);
+  });
