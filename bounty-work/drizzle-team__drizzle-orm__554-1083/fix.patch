@@ -38,6 +38,13 @@ export class SelectionProxyHandler<T extends Subquery | Record<string, unknown>
 		 * @default false
 		 */
 		replaceOriginalName?: boolean;
+
+		/**
+		 * Whether the columns are the output of a query (e.g. a query-built view), meaning
