+++ b/src/app/blocks/musicbrainz-block/musicbrainz-block.component.spec.ts
@@ -0,0 +1,170 @@
+import { fakeAsync, flushMicrotasks, TestBed } from '@angular/core/testing';
+import { FormsModule } from '@angular/forms';
+import { MatButtonModule } from '@angular/material/button';
+import { MatFormFieldModule } from '@angular/material/form-field';
+import { MatProgressSpinnerModule } from '@angular/material/progress-spinner';
+import { MusicbrainzBlockComponent } from './musicbrainz-block.component';
+import { MusicBrainzError, MusicBrainzService } from '../../services/musicbrainz.service';
+
+const ARTIST_MBID = '87c5dedd-371d-4a53-9f7f-80522fb7f3cb';
+
+describe('MusicbrainzBlockComponent', () => {
+  let component: MusicbrainzBlockComponent;
+  let musicbrainz: jasmine.SpyObj<MusicBrainzService>;
+  let emitted: any[];
+
+  beforeEach(() => {
+    musicbrainz = jasmine.createSpyObj('MusicBrainzService', ['request']);
+    component = new MusicbrainzBlockComponent(musicbrainz);
+    component.context = { queryParams: { mbid: ARTIST_MBID } };
+    emitted = [];
+    component.output.subscribe(value => emitted.push(value));
+  });
+
+  it('searches with values taken from the incoming data and emits the result list', fakeAsync(() => {
+    musicbrainz.request.and.returnValue(Promise.resolve({ count: 1, artists: [{ id: ARTIST_MBID, name: 'Björk' }] }));
+    component.config = {
+      type: 'musicbrainz', operation: 'search', entity: 'artist', limit: 10, resultsOnly: true,
+      valueGetters: { query: 'data.name' }
+    };
+    component.onData({ name: 'Björk' }, false);
+    flushMicrotasks();
+    expect(musicbrainz.request).toHaveBeenCalledWith(
+      { operation: 'search', entity: 'artist', query: 'Björk', limit: 10 }, {});
+    expect(emitted).toEqual([[{ id: ARTIST_MBID, name: 'Björk' }]]);
+    expect(component.hasError).toBeFalse();
+  }));
+
+  it('looks up an entity using the Flow context and passes client options through', fakeAsync(() => {
+    const artist = { id: ARTIST_MBID, name: 'Björk' };
+    musicbrainz.request.and.returnValue(Promise.resolve(artist));
+    component.config = {
+      type: 'musicbrainz', operation: 'lookup', entity: 'artist', inc: ['aliases', 'url-rels'],
+      userAgent: 'MyFlow/1.0 ( me@example.com )', cacheTtlMs: 0,
+      valueGetters: { mbid: 'context.queryParams.mbid' }
+    };
+    component.onData({}, false);
+    flushMicrotasks();
+    expect(musicbrainz.request).toHaveBeenCalledWith(
+      { operation: 'lookup', entity: 'artist', mbid: ARTIST_MBID, inc: ['aliases', 'url-rels'] },
+      { userAgent: 'MyFlow/1.0 ( me@example.com )', cacheTtlMs: 0 });
+    expect(emitted).toEqual([artist]);
+  }));
+
+  it('browses linked entities with release type and status filters', fakeAsync(() => {
+    musicbrainz.request.and.returnValue(Promise.resolve({ releases: [] }));
+    component.config = {
+      type: 'musicbrainz', operation: 'browse', entity: 'release', linkedEntity: 'artist',
+      releaseType: ['album', 'ep'], releaseStatus: 'official', offset: 25,
+      valueGetters: { linkedMbid: 'data.id' }
+    };
+    component.onData({ id: ARTIST_MBID }, false);
+    flushMicrotasks();
+    expect(musicbrainz.request).toHaveBeenCalledWith({
+      operation: 'browse', entity: 'release', linkedEntity: 'artist', linkedMbid: ARTIST_MBID,
+      type: ['album', 'ep'], status: 'official', offset: 25
+    }, {});
+  }));
+
+  it('does nothing on the initial empty model, or until there is something to search for', () => {
+    component.config = { type: 'musicbrainz', operation: 'search', entity: 'artist', valueGetters: { query: 'data.name' } };
+    component.onData({}, true);
+    component.onData({ name: '  ' }, false);
+    component.onData({}, false);
+    expect(musicbrainz.request).not.toHaveBeenCalled();
+    expect(component.hasError).toBeFalse();
+  });
+
+  it('shows request errors', fakeAsync(() => {
+    musicbrainz.request.and.returnValue(Promise.reject(new MusicBrainzError('"abc" is not a valid MusicBrainz identifier (MBID)')));
+    component.config = { type: 'musicbrainz', operation: 'lookup', entity: 'artist', mbid: 'abc' };
+    component.onData({}, false);
+    flushMicrotasks();
+    expect(component.hasError).toBeTrue();
+    expect(component.isLoading).toBeFalse();
+    expect(component.errorMessage).toContain('not a valid MusicBrainz identifier');
+    expect(emitted).toEqual([]);
+  }));
+
+  it('ignores responses that were superseded by newer input', fakeAsync(() => {
+    let resolveFirst;
+    musicbrainz.request.and.returnValues(
+      new Promise(resolve => resolveFirst = resolve),
+      Promise.resolve({ artists: [{ name: 'second' }] })
+    );
+    component.config = { type: 'musicbrainz', operation: 'search', entity: 'artist', valueGetters: { query: 'data.q' } };
+    component.onData({ q: 'first' }, false);
+    component.onData({ q: 'second' }, false);
+    flushMicrotasks();
+    resolveFirst({ artists: [{ name: 'first' }] });
+    flushMicrotasks();
+    expect(emitted).toEqual([{ artists: [{ name: 'second' }] }]);
+  }));
+
+  it('prepares release editor seed fields from the incoming data', () => {
+    component.config = { type: 'musicbrainz', operation: 'seed-release', siteRoot: 'https://test.musicbrainz.org' };
+    component.onData({ name: 'Demo EP', type: 'ep', mediums: [{ format: 'Digital Media', tracks: ['One', 'Two'] }] }, false);
+    expect(musicbrainz.request).not.toHaveBeenCalled();
+    expect(component.seedAction).toEqual('https://test.musicbrainz.org/release/add');
+    expect(component.seedSummary).toEqual('Demo EP (2 tracks)');
+    expect(component.seedFields.slice(0, 3)).toEqual([
+      { name: 'name', value: 'Demo EP' },
+      { name: 'type', value: 'ep' },
+      { name: 'mediums.0.format', value: 'Digital Media' }
+    ]);
+    expect(emitted).toEqual([{ action: 'https://test.musicbrainz.org/release/add', fields: component.seedFields }]);
+  });
+
+  it('waits for a release name before offering to seed the release editor', () => {
+    component.config = { type: 'musicbrainz', operation: 'seed-release', valueGetters: { release: 'data.release' } };
+    component.onData({ release: { type: 'album' } }, false);
+    expect(component.seedFields).toEqual([]);
+    expect(component.hasError).toBeFalse();
+    expect(emitted).toEqual([]);
+  });
+});
+
+describe('MusicbrainzBlockComponent template', () => {
+
+  beforeEach(() => {
+    TestBed.configureTestingModule({
+      // FormsModule is imported by the app module: the seed form must not be taken over by NgForm
+      imports: [FormsModule, MatButtonModule, MatFormFieldModule, MatProgressSpinnerModule],
+      declarations: [MusicbrainzBlockComponent],
+      providers: [{ provide: MusicBrainzService, useValue: jasmine.createSpyObj('MusicBrainzService', ['request']) }]
+    });
+  });
+
+  it('renders a native POST form that opens the release editor in a new tab', () => {
+    const fixture = TestBed.createComponent(MusicbrainzBlockComponent);
+    const component = fixture.componentInstance;
+    component.config = { type: 'musicbrainz', operation: 'seed-release', label: 'Send to MusicBrainz' };
+    component.context = {};
+    component.onData({ name: 'Demo', artistCredit: 'Someone', mediums: [{ tracks: ['Intro'] }] }, false);
+    fixture.detectChanges();
+
+    const form: HTMLFormElement = fixture.nativeElement.querySelector('form.musicbrainz-seed-form');
+    expect(form.getAttribute('action')).toEqual('https://musicbrainz.org/release/add');
+    expect(form.getAttribute('method')).toEqual('post');
+    expect(form.getAttribute('target')).toEqual('_blank');
+    const inputs = Array.from(form.querySelectorAll('input[type=hidden]')) as HTMLInputElement[];
+    expect(inputs.map(input => `${input.name}=${input.value}`)).toEqual(component.seedFields.map(f => `${f.name}=${f.value}`));
+    expect(inputs.map(input => input.name)).toContain('mediums.0.track.0.name');
+    expect(form.querySelector('button[type=submit]').textContent.trim()).toEqual('Send to MusicBrainz');
+
+    const submit = new Event('submit', { cancelable: true });
+    form.dispatchEvent(submit);
+    expect(submit.defaultPrevented).toBeFalse();
+  });
+
+  it('shows errors and no form for invalid release data', () => {
+    const fixture = TestBed.createComponent(MusicbrainzBlockComponent);
+    const component = fixture.componentInstance;
+    component.config = { type: 'musicbrainz', operation: 'seed-release' };
+    component.context = {};
+    component.onData({ name: 'Demo', mediums: [{ tracks: [] }] }, false);
+    fixture.detectChanges();
+    expect(fixture.nativeElement.querySelector('form')).toBeNull();
+    expect(fixture.nativeElement.querySelector('mat-error').textContent).toContain('Medium 1 needs at least one track');
+  });
