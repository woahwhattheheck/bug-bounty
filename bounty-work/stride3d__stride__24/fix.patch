     }
 
+    // Decals (#24): DecalRenderFeature mixes DecalProjection after the normal shaders of the forward
+    // shading effect. It reconstructs the receiving surface from the depth buffer and replaces the
+    // position, normal, tangent frame and texture coordinate streams before the material and the
+    // (clustered) lighting are evaluated, then fades and discards the result.
+    [Theory]
+    [InlineData(false, false)]
+    [InlineData(true, false)]
+    [InlineData(false, true)]
+    [InlineData(true, true)]
+    public void DecalProjectionForwardShadingCompiles(bool normalMap, bool vulkan)
+    {
+        var shaderSource = DecalForwardShadingMixin(normalMap);
+        var options = vulkan
+            ? new ShaderMixer.Options(ResourcesRegisterSeparate: false, StripGoogleUserType: true)
+            : new ShaderMixer.Options(ResourcesRegisterSeparate: true);
+
+        var shaderMixer = new ShaderMixer(new ShaderLoader("./assets/Stride/SDSL"));
+        var log = new Stride.Core.Diagnostics.LoggerResult();
+        shaderMixer.MergeSDSL(shaderSource, options, log, out var bytecode, out var effectReflection, out _, out _);
+
+        if (log.HasErrors)
+            Assert.Fail(string.Join(Environment.NewLine, log.Messages.Where(m => m.Type == Stride.Core.Diagnostics.LogMessageType.Error).Select(m => m.Text)));
+
+        var shaderName = $"DecalProjection{(normalMap ? "NormalMap" : "")}{(vulkan ? ".Vulkan" : "")}";
+        File.WriteAllBytes($"{shaderName}.spv", bytecode);
+        var validationResult = Spv.ValidateFile($"{shaderName}.spv", targetVulkan: vulkan);
+        Assert.True(validationResult.IsValid, validationResult.Output);
+
+        // The decal parameters are uploaded per draw by DecalRenderFeature, and the depth is bound per view by the forward renderer
+        var decalParameters = Assert.Single(effectReflection.ConstantBuffers.SelectMany(cb => cb.Members), m => m.KeyInfo.KeyName == "DecalProjection.DecalParameters");
+        Assert.Equal("Decal", decalParameters.LogicalGroup);
+        var depthStencil = Assert.Single(effectReflection.ResourceBindings, r => r.KeyInfo.KeyName == "DepthBase.DepthStencil");
+        Assert.Equal("PerView", depthStencil.ResourceGroup);
+
+        if (!vulkan && SpirvCrossSupport.Available && OperatingSystem.IsWindows())
+        {
+            // What the Direct3D effect compiler runs: legalize, translate to HLSL and compile with fxc
+            var legalized = SpirvTools.LegalizeForHlsl(System.Runtime.InteropServices.MemoryMarshal.Cast<byte, uint>(bytecode));
+            var translator = new SpirvTranslator(legalized.AsMemory());
+            foreach (var entryPoint in translator.GetEntryPoints())
+            {
+                var hlsl = translator.Translate(Backend.Hlsl, entryPoint);
+                var profile = entryPoint.ExecutionModel == ExecutionModel.Fragment ? "ps_5_0" : "vs_5_0";
+                var errors = FxcSupport.Compile(hlsl, profile);
+                Assert.True(errors is null, errors + Environment.NewLine + hlsl);
+            }
+        }
+    }
+
+    /// <summary>
+    /// Builds the forward shading effect of a decal the way StrideForwardShadingEffect composes it when
+    /// <c>StrideEffectBaseKeys.DecalShader</c> is set: a textured material, optionally normal mapped, blended
+    /// with the alpha blend transparency mode, lit by the clustered point and spot lights and the ambient light.
+    /// </summary>
+    private static ShaderMixinSource DecalForwardShadingMixin(bool normalMap)
+    {
+        ShaderMixinSource Compose(params ShaderClassCode[] mixins)
+        {
+            var source = new ShaderMixinSource();
+            source.Mixins.AddRange(mixins);
+            source.Macros.AddRange(
+            [
+                new ShaderMacro("STRIDE_RENDER_TARGET_COUNT", "1"),
+                new ShaderMacro("STRIDE_MULTISAMPLE_COUNT", "1"),
+                new ShaderMacro("STRIDE_GRAPHICS_API_DIRECT3D", "1"),
+                new ShaderMacro("STRIDE_GRAPHICS_API_DIRECT3D11", "1"),
+                new ShaderMacro("STRIDE_GRAPHICS_PROFILE", "45056"),
+                new ShaderMacro("GRAPHICS_PROFILE_LEVEL_9_1", "37120"),
+                new ShaderMacro("GRAPHICS_PROFILE_LEVEL_9_2", "37376"),
+                new ShaderMacro("GRAPHICS_PROFILE_LEVEL_9_3", "37632"),
+                new ShaderMacro("GRAPHICS_PROFILE_LEVEL_10_0", "40960"),
+                new ShaderMacro("GRAPHICS_PROFILE_LEVEL_10_1", "41216"),
+                new ShaderMacro("GRAPHICS_PROFILE_LEVEL_11_0", "45056"),
+                new ShaderMacro("GRAPHICS_PROFILE_LEVEL_11_1", "45312"),
+                new ShaderMacro("GRAPHICS_PROFILE_LEVEL_11_2", "45568"),
+                new ShaderMacro("class", "shader"),
+            ]);
+            return source;
+        }
+
+        // StrideEffectBase: the decal shader comes after the transformation and normal shaders
+        var root = Compose(
+            new ShaderClassSource("ShaderBase"),
+            new ShaderClassSource("ShadingBase"),
+            new ShaderClassSource("TransformationBase"),
+            new ShaderClassSource("NormalStream"),
+            new ShaderClassSource("TransformationWAndVP"),
+            new ShaderClassSource(normalMap ? "NormalFromNormalMapping" : "NormalFromMesh"),
+            new ShaderClassSource("DecalProjection"),
+            new ShaderClassSource("MaterialSurfacePixelStageCompositor"));
+
+        var directLightGroups = new ShaderArraySource();
+        directLightGroups.Add(Compose(new ShaderClassSource("LightClusteredPointGroup")));
+        directLightGroups.Add(Compose(new ShaderClassSource("LightClusteredSpotGroup")));
+        root.Compositions.Add("directLightGroups", directLightGroups);
+
+        var environmentLights = new ShaderArraySource();
+        environmentLights.Add(Compose(new ShaderClassSource("LightSimpleAmbient")));
+        root.Compositions.Add("environmentLights", environmentLights);
+
+        var materialLayers = new ShaderArraySource();
+
+        var diffuse = Compose(new ShaderClassSource("MaterialSurfaceDiffuse"));
+        diffuse.Compositions.Add("diffuseMap", new ShaderClassSource("ComputeColorTextureScaledOffsetDynamicSampler", "Material.DiffuseMap", "TEXCOORD0", "Material.Sampler.i0", "rgba", "Material.TextureScale", "Material.TextureOffset"));
+        materialLayers.Add(diffuse);
+
+        if (normalMap)
+        {
+            var normal = Compose(new ShaderClassSource("MaterialSurfaceNormalMap", "true", "true"));
+            normal.Compositions.Add("normalMap", new ShaderClassSource("ComputeColorTextureScaledOffsetDynamicSampler", "Material.NormalMap", "TEXCOORD0", "Material.Sampler.i0", "rgba", "Material.TextureScale.i1", "Material.TextureOffset.i1"));
+            materialLayers.Add(normal);
+        }
+
