@@ -0,0 +1,135 @@
+// Copyright (c) .NET Foundation and Contributors (https://dotnetfoundation.org/ & https://stride3d.net)
+// Distributed under the MIT license. See the LICENSE.md file in the project root for more information.
+
+using Stride.Core;
+using Stride.Core.Mathematics;
+using Stride.Engine;
+using Stride.Engine.Gizmos;
+using Stride.Graphics;
+using Stride.Rendering;
+using Buffer = Stride.Graphics.Buffer;
+using Material = Stride.Rendering.Material;
+
+namespace Stride.Assets.Presentation.AssetEditors.Gizmos
+{
+    /// <summary>
+    /// The gizmo of the <see cref="DecalComponent"/>: a billboard, and the projection volume with the projection direction when selected.
+    /// </summary>
+    [GizmoComponent(typeof(DecalComponent), true)]
+    public class DecalGizmo : BillboardingGizmo<DecalComponent>
+    {
+        private static readonly Color VolumeColor = new Color(255, 170, 60);
+
+        private Entity volumeEntity;
+        private Material volumeMaterial;
+        private DecalVolumeMesh volumeMesh;
+
+        public DecalGizmo(EntityComponent component)
+            : base(component, "Decal", GizmoResources.FallbackGizmo)
+        {
+        }
+
+        protected override Entity Create()
+        {
+            var root = base.Create();
+
+            volumeMesh = new DecalVolumeMesh(GraphicsDevice);
+            volumeMaterial = GizmoEmissiveColorMaterial.Create(GraphicsDevice, VolumeColor);
+
+            volumeEntity = new Entity("Decal volume of {0}".ToFormat(root.Id))
+            {
+                new ModelComponent
+                {
+                    Model = new Model
+                    {
+                        volumeMaterial,
+                        new Mesh { Draw = volumeMesh.MeshDraw },
+                    },
+                    RenderGroup = RenderGroup,
+                },
+            };
+
+            return root;
+        }
+
+        public override void Update()
+        {
+            base.Update();
+
+            if (ContentEntity == null || GizmoRootEntity == null || volumeEntity == null)
+                return;
+
+            // The root follows the position and the rotation of the decal entity: apply its scale and the size of the decal to the volume
+            ContentEntity.Transform.WorldMatrix.Decompose(out var scale, out Quaternion _, out Vector3 _);
+            volumeEntity.Transform.Scale = Component.Size * scale;
+        }
+
+        public override bool IsSelected
+        {
+            set
+            {
+                var hasChanged = IsSelected != value;
+                base.IsSelected = value;
+
+                if (hasChanged)
+                {
+                    if (IsSelected)
+                        GizmoRootEntity.AddChild(volumeEntity);
+                    else
+                        GizmoRootEntity.RemoveChild(volumeEntity);
+                }
+            }
+        }
+
+        /// <summary>
+        /// The lines of the unit cube volume of a decal, and an arrow showing the projection direction (-Z).
+        /// </summary>
+        private class DecalVolumeMesh
+        {
+            public readonly MeshDraw MeshDraw;
+
+            public DecalVolumeMesh(GraphicsDevice graphicsDevice)
+            {
+                var vertices = new VertexPositionNormalTexture[13];
+                var normal = -Vector3.UnitZ;
+
+                // Corners of the volume: front face (z = 0.5, the projector side) then back face (z = -0.5)
+                for (var i = 0; i < 8; i++)
+                {
+                    var x = (i & 1) == 0 ? -0.5f : 0.5f;
+                    var y = (i & 2) == 0 ? -0.5f : 0.5f;
+                    var z = i < 4 ? 0.5f : -0.5f;
+                    vertices[i] = new VertexPositionNormalTexture(new Vector3(x, y, z), normal, Vector2.Zero);
+                }
+
+                // Projection arrow, from the center of the projector face to the center of the far face
+                vertices[8] = new VertexPositionNormalTexture(new Vector3(0.0f, 0.0f, 0.5f), normal, Vector2.Zero);
+                vertices[9] = new VertexPositionNormalTexture(new Vector3(0.0f, 0.0f, -0.5f), normal, Vector2.Zero);
+                vertices[10] = new VertexPositionNormalTexture(new Vector3(0.1f, 0.0f, -0.3f), normal, Vector2.Zero);
+                vertices[11] = new VertexPositionNormalTexture(new Vector3(-0.1f, 0.0f, -0.3f), normal, Vector2.Zero);
+                vertices[12] = new VertexPositionNormalTexture(new Vector3(0.0f, 0.1f, -0.3f), normal, Vector2.Zero);
+
+                var indices = new[]
+                {
+                    // Front face
+                    0, 1, 1, 3, 3, 2, 2, 0,
+                    // Back face
+                    4, 5, 5, 7, 7, 6, 6, 4,
+                    // Sides
+                    0, 4, 1, 5, 2, 6, 3, 7,
+                    // Arrow
+                    8, 9, 9, 10, 9, 11, 9, 12,
+                };
+
+                var vertexBuffer = Buffer.Vertex.New(graphicsDevice, vertices);
+                MeshDraw = new MeshDraw
+                {
+                    PrimitiveType = PrimitiveType.LineList,
+                    DrawCount = indices.Length,
+                    IndexBuffer = new IndexBufferBinding(Buffer.Index.New(graphicsDevice, indices), true, indices.Length),
+                    VertexBuffers = new[] { new VertexBufferBinding(vertexBuffer, VertexPositionNormalTexture.Layout, vertexBuffer.ElementCount) },
+                };
+            }
+        }
+    }
+}
