+++ b/src/app/services/musicbrainz.service.spec.ts
@@ -0,0 +1,269 @@
+import { TestBed, fakeAsync, flushMicrotasks, tick } from '@angular/core/testing';
+import { HttpClientTestingModule, HttpTestingController } from '@angular/common/http/testing';
+import {
+  buildLuceneQuery,
+  buildMusicBrainzUrl,
+  buildReleaseSeed,
+  extractMusicBrainzResults,
+  MusicBrainzError,
+  MusicBrainzService,
+  MUSICBRAINZ_DEFAULT_EDIT_NOTE,
+  MUSICBRAINZ_USER_AGENT,
+  releaseEditorUrl
+} from './musicbrainz.service';
+
+const ARTIST_MBID = '87c5dedd-371d-4a53-9f7f-80522fb7f3cb';
+const RELEASE_MBID = 'b84ee12a-09ef-421b-82de-0441a926375b';
+const API = 'https://musicbrainz.org/ws/2';
+
+describe('MusicBrainz URL building', () => {
+
+  it('builds a search URL from a Lucene query string', () => {
+    expect(buildMusicBrainzUrl({ operation: 'search', entity: 'artist', query: 'artist:björk', limit: 5, offset: 10 }))
+      .toEqual(`${API}/artist?query=artist%3Abj%C3%B6rk&limit=5&offset=10&fmt=json`);
+  });
+
+  it('builds a search query from field values', () => {
+    const url = buildMusicBrainzUrl({ operation: 'search', entity: 'recording', query: { recording: 'Jóga', artist: 'Björk' } });
+    expect(decodeURIComponent(url)).toEqual(`${API}/recording?query=recording:"Jóga" AND artist:"Björk"&fmt=json`);
+  });
+
+  it('builds a lookup URL with includes and filters', () => {
+    const url = buildMusicBrainzUrl({
+      operation: 'lookup', entity: 'artist', mbid: ARTIST_MBID.toUpperCase(),
+      inc: ['aliases', 'release-groups'], type: 'album'
+    });
+    expect(url).toEqual(`${API}/artist/${ARTIST_MBID}?inc=aliases%2Brelease-groups&type=album&fmt=json`);
+  });
+
+  it('accepts includes as a "+" separated string', () => {
+    expect(buildMusicBrainzUrl({ operation: 'lookup', entity: 'release', mbid: RELEASE_MBID, inc: 'recordings+artist-credits' }))
+      .toContain('inc=recordings%2Bartist-credits');
+  });
+
+  it('builds a browse URL', () => {
+    const url = buildMusicBrainzUrl({
+      operation: 'browse', entity: 'release-group', linkedEntity: 'artist', linkedMbid: ARTIST_MBID,
+      type: ['album', 'ep'], limit: 100
+    }, 'https://mirror.example.org/ws/2/');
+    expect(url).toEqual(`https://mirror.example.org/ws/2/release-group?artist=${ARTIST_MBID}&type=album%7Cep&limit=100&fmt=json`);
+  });
+
+  it('rejects invalid requests with a readable error', () => {
+    const cases: Array<[any, RegExp]> = [
+      [{ operation: 'lookup', entity: 'artist', mbid: 'not-an-mbid' }, /not a valid MusicBrainz identifier/],
+      [{ operation: 'lookup', entity: 'artist', mbid: ARTIST_MBID, inc: 'recordings+bogus' }, /Unsupported inc value\(s\) for artist: bogus/],
+      [{ operation: 'browse', entity: 'release', linkedEntity: 'work', linkedMbid: ARTIST_MBID }, /Cannot browse release by "work"/],
+      [{ operation: 'search', entity: 'artist', query: '   ' }, /search query is required/],
+      [{ operation: 'search', entity: 'genre', query: 'rock' }, /Cannot search MusicBrainz for "genre"/],
+      [{ operation: 'search', entity: 'artist', query: 'x', limit: 500 }, /limit must be a whole number between 1 and 100/],
+      [{ operation: 'delete', entity: 'artist' }, /Unknown MusicBrainz operation/]
+    ];
+    cases.forEach(([request, message]) => {
+      expect(() => buildMusicBrainzUrl(request)).toThrowMatching(e => e instanceof MusicBrainzError && message.test(e.message));
+    });
+  });
+});
+
+describe('MusicBrainz helpers', () => {
+
+  it('escapes quotes, ORs arrays and skips empty values in Lucene queries', () => {
+    expect(buildLuceneQuery({ release: 'Say "Hi"', type: ['album', 'ep'], country: '', label: null }))
+      .toEqual('release:"Say \\"Hi\\"" AND (type:"album" OR type:"ep")');
+  });
+
+  it('extracts result lists from search and browse responses', () => {
+    expect(extractMusicBrainzResults('release-group', { count: 1, 'release-groups': [{ id: 'a' }] })).toEqual([{ id: 'a' }]);
+    const lookup = { id: ARTIST_MBID, name: 'Björk' };
+    expect(extractMusicBrainzResults('artist', lookup)).toBe(lookup);
+  });
+
+  it('converts a release into release editor seed fields', () => {
+    const fields = buildReleaseSeed({
+      name: ' Debut ',
+      type: ['album'],
+      status: 'official',
+      barcode: '5016958997028',
+      artistCredit: [{ mbid: ARTIST_MBID, name: 'Björk', joinPhrase: ' & ' }, { name: 'Guest' }],
+      events: [{ date: '1993-07-05', country: 'GB' }],
+      labels: [{ name: 'One Little Indian', catalogNumber: 'TPLP31' }],
+      mediums: [{ format: 'CD', tracks: [{ name: 'Human Behaviour', length: 254000 }, 'Crying'] }],
+      urls: ['https://bjork.com']
+    });
+    const asPairs = fields.map(({ name, value }) => `${name}=${value}`);
+    expect(asPairs).toEqual([
+      'name=Debut',
+      'type=album',
+      'barcode=5016958997028',
+      'status=official',
+      `artist_credit.names.0.mbid=${ARTIST_MBID}`,
+      'artist_credit.names.0.name=Björk',
+      'artist_credit.names.0.join_phrase= & ',
+      'artist_credit.names.1.name=Guest',
+      'events.0.date.year=1993',
+      'events.0.date.month=7',
+      'events.0.date.day=5',
+      'events.0.country=GB',
+      'labels.0.name=One Little Indian',
+      'labels.0.catalog_number=TPLP31',
+      'mediums.0.format=CD',
+      'mediums.0.track.0.name=Human Behaviour',
+      'mediums.0.track.0.length=254000',
+      'mediums.0.track.1.name=Crying',
+      'urls.0.url=https://bjork.com',
+      `edit_note=${MUSICBRAINZ_DEFAULT_EDIT_NOTE}`
+    ]);
+  });
+
+  it('prefers an existing release group over creating a new one', () => {
+    const fields = buildReleaseSeed({ name: 'Debut', releaseGroup: RELEASE_MBID, type: 'album', editNote: '' });
+    expect(fields).toEqual([{ name: 'name', value: 'Debut' }, { name: 'release_group', value: RELEASE_MBID }]);
+  });
+
+  it('keeps multi-word release group types together', () => {
+    const fields = buildReleaseSeed({ name: 'Story', type: 'other, Audio drama', editNote: '' });
+    expect(fields).toEqual([{ name: 'name', value: 'Story' }, { name: 'type', value: 'other' }, { name: 'type', value: 'Audio drama' }]);
+  });
+
+  it('rejects releases the editor cannot be seeded with', () => {
+    expect(() => buildReleaseSeed({ type: 'album' })).toThrowError(MusicBrainzError, 'A release name is required');
+    expect(() => buildReleaseSeed({ name: 'x', mediums: [{ format: 'CD', tracks: [] }] }))
+      .toThrowError(MusicBrainzError, 'Medium 1 needs at least one track');
+  });
+
+  it('points the release editor at the configured site', () => {
+    expect(releaseEditorUrl()).toEqual('https://musicbrainz.org/release/add');
+    expect(releaseEditorUrl('https://test.musicbrainz.org/')).toEqual('https://test.musicbrainz.org/release/add');
+  });
+});
+
+describe('MusicBrainzService', () => {
+  let service: MusicBrainzService;
+  let httpMock: HttpTestingController;
+
+  beforeEach(() => {
+    TestBed.configureTestingModule({
+      imports: [HttpClientTestingModule]
+    });
+    service = TestBed.inject(MusicBrainzService);
+    httpMock = TestBed.inject(HttpTestingController);
+  });
+
+  afterEach(() => {
+    httpMock.verify();
+  });
+
+  it('identifies itself with a User-Agent and only uses headers MusicBrainz allows for CORS', fakeAsync(() => {
+    let result;
+    service.lookup('artist', ARTIST_MBID).then(r => result = r);
+    flushMicrotasks();
+    const req = httpMock.expectOne(`${API}/artist/${ARTIST_MBID}?fmt=json`);
+    expect(req.request.method).toEqual('GET');
+    expect(req.request.headers.get('User-Agent')).toEqual(MUSICBRAINZ_USER_AGENT);
+    expect(MUSICBRAINZ_USER_AGENT).toMatch(/^KendraioApp\/\d+\.\d+\.\d+ \( https:\/\/github\.com\/kendraio\/kendraio-app \)$/);
+    expect(req.request.headers.get('Accept')).toEqual('application/json');
+    // MusicBrainz answers preflights with "Access-Control-Allow-Headers: Authorization, Content-Type, User-Agent"
+    req.request.headers.keys().forEach(name => expect(['accept', 'user-agent']).toContain(name.toLowerCase()));
+    req.flush({ id: ARTIST_MBID, name: 'Björk' });
+    flushMicrotasks();
