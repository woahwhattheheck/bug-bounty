From 728cc4ead1eebfe7dd9996229cd494f6a7f50da5 Mon Sep 17 00:00:00 2001
From: woahwhattheheck <293286387+woahwhattheheck@users.noreply.github.com>
Date: Thu, 8 Oct 2026 04:10:32 +0000
Subject: [PATCH 1/3] cmake: Add find module for VST3 SDK

The Steinberg VST3 SDK is MIT licensed since version 3.8.0 and obs-deps
ships it as source code (base, pluginterfaces and public.sdk/source in
include/vst3sdk) for Windows and macOS.

FindVST3SDK locates the SDK in a dependency prefix or through
VST3SDK_ROOT (a checkout of the SDK, needed on Linux where it is not
packaged yet), reports its version and returns the SDK sources a VST3
host has to compile on the current platform.

Part of the VST3 Support RFP (discussion #5074).
---
 cmake/finders/FindVST3SDK.cmake | 139 ++++++++++++++++++++++++++++++++
 1 file changed, 139 insertions(+)
 create mode 100644 cmake/finders/FindVST3SDK.cmake

diff --git a/cmake/finders/FindVST3SDK.cmake b/cmake/finders/FindVST3SDK.cmake
new file mode 100644
index 0000000..e383685
--- /dev/null
+++ b/cmake/finders/FindVST3SDK.cmake
@@ -0,0 +1,139 @@
+#[=======================================================================[.rst
+FindVST3SDK
+-----------
+
+FindModule for the Steinberg VST 3 SDK (MIT licensed since VST 3.8.0).
+
+The SDK is distributed as source code. obs-deps installs the required parts
+(``base``, ``pluginterfaces`` and ``public.sdk/source``) to
+``<prefix>/include/vst3sdk``; alternatively ``VST3SDK_ROOT`` can point to a
+checkout of https://github.com/steinbergmedia/vst3sdk.
+
+Imported Targets
+^^^^^^^^^^^^^^^^
+
+.. versionadded:: 32.1
+
+This module defines the :prop_tgt:`IMPORTED` target ``VST3SDK::VST3SDK``,
+which provides the SDK include directory.
+
+Result Variables
+^^^^^^^^^^^^^^^^
+
+This module sets the following variables:
+
+``VST3SDK_FOUND``
+  True, if the SDK was found and contains all hosting sources.
+``VST3SDK_VERSION``
+  Detected version of the SDK.
+``VST3SDK_HOSTING_SOURCES``
+  SDK source files a VST 3 host has to compile for the current platform.
+
+Cache variables
+^^^^^^^^^^^^^^^
+
+The following cache variables may also be set:
+
+``VST3SDK_INCLUDE_DIR``
+  Directory containing ``pluginterfaces``, ``base`` and ``public.sdk``.
+
+#]=======================================================================]
+
+include(FindPackageHandleStandardArgs)
+
+find_path(
+  VST3SDK_INCLUDE_DIR
+  NAMES pluginterfaces/vst/ivstaudioprocessor.h
+  HINTS ${VST3SDK_ROOT}
+  ENV VST3SDK_ROOT
+  PATH_SUFFIXES vst3sdk include/vst3sdk
+  DOC "VST3 SDK location"
+)
+
+if(VST3SDK_INCLUDE_DIR AND EXISTS "${VST3SDK_INCLUDE_DIR}/pluginterfaces/vst/vsttypes.h")
+  file(
+    STRINGS "${VST3SDK_INCLUDE_DIR}/pluginterfaces/vst/vsttypes.h"
+    _version_string
+    REGEX "#define[ \t]+kVstVersionString"
+  )
+  string(REGEX REPLACE ".*\"VST ([0-9.]+)\".*" "\\1" VST3SDK_VERSION "${_version_string}")
+  unset(_version_string)
+else()
+  set(VST3SDK_VERSION 0.0.0)
+endif()
+
+set(
+  _vst3sdk_hosting_files
+  pluginterfaces/base/coreiids.cpp
+  pluginterfaces/base/funknown.cpp
+  public.sdk/source/common/commoniids.cpp
+  public.sdk/source/common/commonstringconvert.cpp
+  public.sdk/source/common/memorystream.cpp
+  public.sdk/source/vst/hosting/connectionproxy.cpp
+  public.sdk/source/vst/hosting/eventlist.cpp
+  public.sdk/source/vst/hosting/hostclasses.cpp
+  public.sdk/source/vst/hosting/module.cpp
+  public.sdk/source/vst/hosting/parameterchanges.cpp
+  public.sdk/source/vst/hosting/pluginterfacesupport.cpp
+  public.sdk/source/vst/hosting/processdata.cpp
+  public.sdk/source/vst/moduleinfo/moduleinfoparser.cpp
+  public.sdk/source/vst/utility/stringconvert.cpp
+  public.sdk/source/vst/vstinitiids.cpp
+)
+
+if(CMAKE_SYSTEM_NAME STREQUAL Windows)
+  list(
+    APPEND _vst3sdk_hosting_files
+    public.sdk/source/common/threadchecker_win32.cpp
+    public.sdk/source/vst/hosting/module_win32.cpp
+  )
+elseif(CMAKE_SYSTEM_NAME STREQUAL Darwin)
+  list(
+    APPEND _vst3sdk_hosting_files
+    public.sdk/source/common/threadchecker_mac.mm
+    public.sdk/source/vst/hosting/module_mac.mm
+  )
+else()
+  list(
+    APPEND _vst3sdk_hosting_files
+    public.sdk/source/common/threadchecker_linux.cpp
+    public.sdk/source/vst/hosting/module_linux.cpp
+  )
+endif()
+
+set(VST3SDK_HOSTING_SOURCES "")
+set(_vst3sdk_sources_complete FALSE)
+if(VST3SDK_INCLUDE_DIR)
+  set(_vst3sdk_sources_complete TRUE)
+  foreach(_file IN LISTS _vst3sdk_hosting_files)
+    if(EXISTS "${VST3SDK_INCLUDE_DIR}/${_file}")
+      list(APPEND VST3SDK_HOSTING_SOURCES "${VST3SDK_INCLUDE_DIR}/${_file}")
+    else()
+      message(DEBUG "VST3 SDK at ${VST3SDK_INCLUDE_DIR} is missing ${_file}")
+      set(_vst3sdk_sources_complete FALSE)
+    endif()
+  endforeach()
+endif()
+
+find_package_handle_standard_args(
+  VST3SDK
+  REQUIRED_VARS VST3SDK_INCLUDE_DIR _vst3sdk_sources_complete
+  VERSION_VAR VST3SDK_VERSION
+  REASON_FAILURE_MESSAGE
+    "Set VST3SDK_ROOT to a checkout of the VST3 SDK (containing base, pluginterfaces and public.sdk) or install it through obs-deps."
+)
+mark_as_advanced(VST3SDK_INCLUDE_DIR)
+unset(_vst3sdk_hosting_files)
+
+if(VST3SDK_FOUND AND NOT TARGET VST3SDK::VST3SDK)
+  add_library(VST3SDK::VST3SDK INTERFACE IMPORTED)
+  set_property(TARGET VST3SDK::VST3SDK PROPERTY INTERFACE_INCLUDE_DIRECTORIES "${VST3SDK_INCLUDE_DIR}")
+endif()
+
+include(FeatureSummary)
+set_package_properties(
+  VST3SDK
+  PROPERTIES
+    URL "https://github.com/steinbergmedia/vst3sdk"
+    DESCRIPTION "Steinberg VST 3 SDK, used to host VST 3 audio effects."
+)
-- 
