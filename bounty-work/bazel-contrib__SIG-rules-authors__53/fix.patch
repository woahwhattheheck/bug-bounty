+        transport = FakeTransport(
+            {
+                ("GET", page2): _response(payload=[{"n": 2}]),
+                ("GET", API + "/orgs/o/repos"): _response(
+                    payload=[{"n": 1}],
+                    headers={"Link": f'<{page2}>; rel="next", <{page2}>; rel="last"'},
+                ),
+            }
+        )
+        client = github_traffic.GitHubClient("t", transport=transport)
+        self.assertEqual(client.paginate("/orgs/o/repos"), [{"n": 1}, {"n": 2}])
+        self.assertIn("per_page=100", transport.calls[0]["url"])
+
+    def test_pagination_never_leaves_api_host(self):
+        transport = FakeTransport(
+            {
+                ("GET", API + "/orgs/o/repos"): _response(
+                    payload=[], headers={"Link": '<https://evil.example/x>; rel="next"'}
+                )
+            }
+        )
+        client = github_traffic.GitHubClient("t", transport=transport)
+        with self.assertRaises(github_traffic.GitHubError):
+            client.paginate("/orgs/o/repos")
+        self.assertEqual(len(transport.calls), 1)
+
+    def test_waits_for_primary_rate_limit_reset(self):
+        limited = _response(
+            403,
+            {"message": "API rate limit exceeded"},
+            headers={"X-RateLimit-Remaining": "0", "X-RateLimit-Reset": "1030"},
+        )
+        transport = FakeTransport(
+            {("GET", API + "/x"): [limited, _response(payload={"ok": True})]}
+        )
+        sleeps = []
+        client = github_traffic.GitHubClient(
+            "t", transport=transport, sleep=sleeps.append, clock=lambda: 1000
+        )
+        self.assertEqual(client.get("/x"), {"ok": True})
+        self.assertEqual(sleeps, [31])
+
+    def test_honors_retry_after(self):
+        limited = _response(429, {"message": "slow down"}, headers={"Retry-After": "7"})
+        transport = FakeTransport(
+            {("GET", API + "/x"): [limited, _response(payload={"ok": True})]}
+        )
+        sleeps = []
+        client = github_traffic.GitHubClient(
+            "t", transport=transport, sleep=sleeps.append
+        )
+        self.assertEqual(client.get("/x"), {"ok": True})
+        self.assertEqual(sleeps, [7])
+
+    def test_does_not_retry_missing_push_access(self):
+        denied = _response(
+            403,
+            {"message": "Must have push access to repository"},
+            headers={"X-RateLimit-Remaining": "4999"},
+        )
+        transport = FakeTransport({("GET", API + "/x"): denied})
+        client = github_traffic.GitHubClient("t", transport=transport, sleep=self.fail)
+        with self.assertRaises(github_traffic.GitHubError) as ctx:
+            client.get("/x")
+        self.assertEqual(ctx.exception.status, 403)
+        self.assertIn("push access", ctx.exception.message)
+
+    def test_gives_up_when_reset_is_too_far(self):
+        limited = _response(
+            403,
+            {"message": "API rate limit exceeded"},
+            headers={"X-RateLimit-Remaining": "0", "X-RateLimit-Reset": "99999"},
+        )
+        transport = FakeTransport({("GET", API + "/x"): limited})
+        client = github_traffic.GitHubClient(
+            "t", transport=transport, sleep=self.fail, clock=lambda: 0
+        )
+        with self.assertRaises(github_traffic.GitHubError):
+            client.get("/x")
+
+    def test_retries_connection_errors(self):
+        responses = [OSError("connection reset"), _response(payload={"ok": True})]
+
+        def transport(method, url, headers, body=None, timeout=60):
+            item = responses.pop(0)
+            if isinstance(item, Exception):
+                raise item
+            return item
+
+        sleeps = []
+        client = github_traffic.GitHubClient(
+            "t", transport=transport, sleep=sleeps.append
+        )
+        self.assertEqual(client.get("/x"), {"ok": True})
+        self.assertEqual(sleeps, [1])
+
+    def test_reports_persistent_connection_errors(self):
+        def transport(method, url, headers, body=None, timeout=60):
+            raise OSError("timed out")
+
+        client = github_traffic.GitHubClient(
+            "t", transport=transport, sleep=lambda s: None
+        )
+        with self.assertRaises(github_traffic.GitHubError) as ctx:
+            client.get("/x")
+        self.assertEqual(ctx.exception.status, 0)
+        self.assertIn("timed out", str(ctx.exception))
