+    const unknown = inc.filter(item => !allowed.includes(item));
+    if (unknown.length > 0) {
+      throw new MusicBrainzError(`Unsupported inc value(s) for ${entity}: ${unknown.join(', ')}`);
+    }
+    if (inc.length > 0) {
+      params.push(['inc', inc.join('+')]);
+    }
+  };
+  const addFilters = () => {
+    const type = toList(request.type);
+    const status = toList(request.status);
+    if (type.length > 0) {
+      params.push(['type', type.join('|')]);
+    }
+    if (status.length > 0) {
+      params.push(['status', status.join('|')]);
+    }
+  };
+  const addPaging = () => {
+    const limit = checkPaging('limit', request.limit, 1, 100);
+    const offset = checkPaging('offset', request.offset, 0, Number.MAX_SAFE_INTEGER);
+    if (!isNil(limit)) {
+      params.push(['limit', String(limit)]);
+    }
+    if (!isNil(offset)) {
+      params.push(['offset', String(offset)]);
+    }
+  };
