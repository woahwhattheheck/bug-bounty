+class TogglePrintPreview(bpy.types.Operator):
+    bl_idname = "bim.toggle_print_preview"
+    bl_label = "Toggle Print Preview"
+    bl_options = {"REGISTER", "UNDO"}
+    bl_description = (
+        "Show the active drawing in its camera view as it prints, with line weights, hatches, text and symbols.\n\n"
+        "The preview is refreshed every time the drawing is created. It is rendered using the "
+        '"svg2png_command" from the Bonsai preferences, or Inkscape or rsvg-convert if found'
+    )
+
+    @classmethod
+    def poll(cls, context):
+        if not tool.Ifc.get() or not tool.Drawing.is_drawing_active():
+            cls.poll_message_set("No active drawing.")
+            return False
+        return True
+
+    def execute(self, context):
+        dprops = tool.Drawing.get_document_props()
+        if dprops.should_show_print_preview:
+            dprops.should_show_print_preview = False
+            for drawing in tool.Ifc.get().by_type("IfcAnnotation"):
+                if drawing.ObjectType == "DRAWING" and (camera := tool.Ifc.get_object(drawing)):
+                    tool.Drawing.remove_print_preview(camera)
+            return {"FINISHED"}
+
+        assert context.scene and (camera := context.scene.camera)
+        drawing = tool.Ifc.get_entity(camera)
+        assert drawing
+        dprops.should_show_print_preview = True
+        svg = tool.Drawing.get_document_uri(tool.Drawing.get_drawing_document(drawing))
+        if svg and os.path.isfile(svg):
+            tool.Drawing.update_print_preview(drawing)
+        else:
+            # Creating the drawing also shows the preview.
+            bpy.ops.bim.create_drawing()
+
+        assert (camera := context.scene.camera) and isinstance(camera.data, bpy.types.Camera)
+        if not tool.Drawing.get_print_preview_background(camera.data):
+            dprops.should_show_print_preview = False
+            self.report(
+                {"ERROR"},
+                "Failed to render the drawing preview. Install Inkscape or rsvg-convert "
+                'or set "SVG to PNG Command" in the Bonsai preferences.',
+            )
+            return {"CANCELLED"}
+        return {"FINISHED"}
+
