 scripts/lib/robot.sh               |  17 +++++
 scripts/lib/test_fw_resolve.py     |  85 ++++++++++++++++++++++
 scripts/regression-rerun-failed.sh |   3 +-
 scripts/regression.sh              |   3 +-
 5 files changed, 215 insertions(+), 2 deletions(-)
