+  });
+
+  describe('connectMicrobloggingAccount', () => {
+    const collective = { id: COLLECTIVE_ID, type: 'COLLECTIVE', isPrivate: false } as Collective;
+    const remoteUser = { id: 3 } as User;
+
+    const mockVerifyCredentials = () => {
+      // The instance information is public, it's fetched without the token
+      nock(INSTANCE_URL)
+        .get('/api/v2/instance')
+        .reply(200, { domain: 'social.example.org', configuration: { statuses: { max_characters: 500 } } });
+      return nock(INSTANCE_URL, { reqheaders: { authorization: `Bearer ${TOKEN}` } })
+        .get('/api/v1/accounts/verify_credentials')
+        .reply(200, { id: '109', username: 'babel', acct: 'babel', url: `${INSTANCE_URL}/@babel` })
+        .get('/api/v1/apps/verify_credentials')
+        .reply(200, { scopes: ['write:statuses', 'profile'] });
+    };
+
+    it('connects a Mastodon account', async () => {
+      const scope = mockVerifyCredentials();
+      sandbox.stub(models.ConnectedAccount, 'findOne').resolves(null);
+      sandbox.stub(models.Member, 'count').resolves(30);
+      const create = sandbox.stub(models.ConnectedAccount, 'create').callsFake(async values => values);
+
+      await connectMicrobloggingAccount({
+        collective,
+        remoteUser,
+        service: Service.MASTODON,
+        token: TOKEN,
+        instanceUrl: 'social.example.org',
+        settings: { posts: { monthlyStats: false, unknownSetting: true } },
+      });
+
+      scope.done();
+      expect(create.firstCall.args[0]).to.deep.eq({
+        service: Service.MASTODON,
+        CollectiveId: COLLECTIVE_ID,
+        CreatedByUserId: 3,
+        username: '@babel@social.example.org',
+        token: TOKEN,
+        data: {
+          instanceUrl: INSTANCE_URL,
+          accountId: '109',
+          profileUrl: `${INSTANCE_URL}/@babel`,
+          limits: { maxCharacters: 500, charactersReservedPerUrl: 23 },
+          posts: { milestones: { lastMilestone: 25 } }, // Milestones reached before connecting are not celebrated
+        },
+        settings: { posts: { newContributors: true, milestones: true, monthlyStats: false } },
+      });
+    });
+
+    it('refreshes the credentials when connecting the same account again', async () => {
+      mockVerifyCredentials();
+      const existingAccount = buildConnectedAccount({
+        posts: { milestones: false },
+        settings: { needsReconnect: true },
+      });
+      sandbox.stub(models.ConnectedAccount, 'findOne').resolves(existingAccount);
+      const create = sandbox.stub(models.ConnectedAccount, 'create');
+
+      const result = await connectMicrobloggingAccount({
+        collective,
+        remoteUser,
+        service: Service.MASTODON,
+        token: TOKEN,
+        instanceUrl: INSTANCE_URL,
+      });
+
+      expect(create).to.not.have.been.called;
+      expect(result).to.eq(existingAccount);
+      expect(existingAccount.settings).to.deep.eq({
+        needsReconnect: false,
+        posts: { newContributors: true, milestones: false, monthlyStats: true },
+      });
+    });
+
+    it('refuses to connect when the feature is disabled or for private accounts', async () => {
+      const scope = mockVerifyCredentials();
+      const params = { collective, remoteUser, service: Service.MASTODON, token: TOKEN, instanceUrl: INSTANCE_URL };
+
+      await expect(
+        connectMicrobloggingAccount({ ...params, collective: { ...collective, isPrivate: true } as Collective }),
+      ).to.be.rejectedWith('not available for private accounts');
+      await expect(
+        connectMicrobloggingAccount({ ...params, collective: { ...collective, type: 'USER' } as Collective }),
+      ).to.be.rejectedWith('not available for this type of account');
+
+      sandbox.stub(config, 'features').value({ microbloggingPosts: false });
+      await expect(connectMicrobloggingAccount(params)).to.be.rejectedWith('not enabled on this platform');
+      expect(scope.isDone()).to.be.false;
+    });
+  });
+
+  describe('editMicrobloggingPostSettings', () => {
+    it('only updates the known post settings', async () => {
+      const connectedAccount = buildConnectedAccount();
+      await editMicrobloggingPostSettings(connectedAccount, { monthlyStats: false, foo: 'bar' } as never);
+      expect(connectedAccount.settings.posts).to.deep.eq({
+        newContributors: true,
+        milestones: true,
+        monthlyStats: false,
+      });
+    });
+
+    it('rejects other services', async () => {
+      const connectedAccount = models.ConnectedAccount.build({ service: Service.STRIPE });
+      await expect(editMicrobloggingPostSettings(connectedAccount, { monthlyStats: true })).to.be.rejectedWith(
+        'not supported for stripe',
+      );
+    });
+  });
+});
diff --git a/test/server/lib/microblogging/mastodon.test.ts b/test/server/lib/microblogging/mastodon.test.ts
new file mode 100644
index 000000000..bb120e55b
--- /dev/null
+++ b/test/server/lib/microblogging/mastodon.test.ts
@@ -0,0 +1,208 @@
+/* eslint-disable camelcase */
+import dns from 'dns';
+
+import { expect } from 'chai';
+import nock from 'nock';
+import sinon from 'sinon';
+
+import { Service } from '../../../../server/constants/connected-account';
+import mastodon, { normalizeMastodonInstanceUrl } from '../../../../server/lib/microblogging/mastodon';
+import {
+  MicrobloggingAuthenticationError,
+  MicrobloggingRequestError,
+} from '../../../../server/lib/microblogging/types';
+import models from '../../../../server/models';
+
+const INSTANCE_URL = 'https://social.example.org';
+const TOKEN = 'mastodon-access-token';
+
+const buildConnectedAccount = (data: Record<string, unknown> = {}) =>
+  models.ConnectedAccount.build({
+    id: 4242,
+    service: Service.MASTODON,
+    CollectiveId: 1,
+    username: '@mycollective@example.org',
+    token: TOKEN,
+    data: { instanceUrl: INSTANCE_URL, ...data },
+  });
+
+describe('server/lib/microblogging/mastodon', () => {
+  let sandbox: sinon.SinonSandbox;
+
+  before(() => nock.disableNetConnect());
+  after(() => nock.enableNetConnect());
+
+  beforeEach(() => {
+    sandbox = sinon.createSandbox();
+    // Public address, so that the SSRF protection lets the (mocked) requests through
+    sandbox.stub(dns.promises, 'resolve4').resolves(['93.184.216.34']);
+    sandbox.stub(dns.promises, 'resolve6').rejects(new Error('No IPv6 address'));
+  });
+
+  afterEach(() => {
+    sandbox.restore();
+    nock.cleanAll();
+  });
+
+  describe('normalizeMastodonInstanceUrl', () => {
+    it('accepts domains and profile URLs', () => {
+      expect(normalizeMastodonInstanceUrl('social.example.org')).to.eq(INSTANCE_URL);
+      expect(normalizeMastodonInstanceUrl(' https://social.example.org/@mycollective ')).to.eq(INSTANCE_URL);
+    });
+
+    it('only accepts HTTPS URLs without credentials', () => {
+      expect(() => normalizeMastodonInstanceUrl('http://social.example.org')).to.throw('must use HTTPS');
+      expect(() => normalizeMastodonInstanceUrl('ftp://social.example.org')).to.throw('must use HTTPS');
+      expect(() => normalizeMastodonInstanceUrl('https://user:pass@social.example.org')).to.throw('credentials');
+      expect(() => normalizeMastodonInstanceUrl('')).to.throw('Please provide');
+    });
+  });
+
+  describe('verifyCredentials', () => {
+    it('returns the account handle and the limits advertised by the server', async () => {
+      nock(INSTANCE_URL, { reqheaders: { authorization: `Bearer ${TOKEN}` } })
+        .get('/api/v1/accounts/verify_credentials')
+        .reply(200, { id: '109', username: 'mycollective', acct: 'mycollective', url: `${INSTANCE_URL}/@mycollective` })
+        .get('/api/v1/apps/verify_credentials')
+        .reply(200, { name: 'Open Collective', scopes: ['profile', 'write:statuses'] });
+      nock(INSTANCE_URL)
+        .get('/api/v2/instance')
+        .reply(200, {
+          domain: 'example.org', // Split domain: handles use `example.org`, the API is served by `social.example.org`
+          configuration: { statuses: { max_characters: 1000, characters_reserved_per_url: 23 } },
+        });
+
+      const result = await mastodon.verifyCredentials({ instanceUrl: 'social.example.org/', token: TOKEN });
+      expect(result).to.deep.eq({
+        instanceUrl: INSTANCE_URL,
+        id: '109',
+        handle: '@mycollective@example.org',
+        url: `${INSTANCE_URL}/@mycollective`,
+        limits: { maxCharacters: 1000, charactersReservedPerUrl: 23 },
+      });
+      expect(nock.isDone()).to.be.true;
+    });
+
+    it('falls back on the v1 instance API for older servers', async () => {
+      nock(INSTANCE_URL)
+        .get('/api/v1/accounts/verify_credentials')
+        .reply(200, { id: '7', username: 'mycollective', acct: 'mycollective' })
+        .get('/api/v1/apps/verify_credentials')
+        .reply(200, { name: 'Open Collective' }) // Servers older than Mastodon 4.3 don't return the scopes
+        .get('/api/v2/instance')
+        .reply(404, { error: 'Not Found' })
+        .get('/api/v1/instance')
+        .reply(200, { uri: 'social.example.org', max_toot_chars: 5000 });
+
+      const result = await mastodon.verifyCredentials({ instanceUrl: INSTANCE_URL, token: TOKEN });
+      expect(result.handle).to.eq('@mycollective@social.example.org');
+      expect(result.url).to.be.null;
+      expect(result.limits).to.deep.eq({ maxCharacters: 5000, charactersReservedPerUrl: 23 });
+      expect(nock.isDone()).to.be.true;
+    });
+
+    it('rejects tokens that cannot publish statuses', async () => {
+      nock(INSTANCE_URL)
+        .get('/api/v1/accounts/verify_credentials')
+        .reply(200, { id: '7', username: 'mycollective', acct: 'mycollective' })
+        .get('/api/v1/apps/verify_credentials')
+        .reply(200, { name: 'Open Collective', scopes: ['read'] });
+
+      await expect(mastodon.verifyCredentials({ instanceUrl: INSTANCE_URL, token: TOKEN })).to.be.rejectedWith(
+        'must have the "write:statuses" scope',
+      );
+    });
+
+    it('rejects invalid tokens', async () => {
+      nock(INSTANCE_URL)
+        .get('/api/v1/accounts/verify_credentials')
+        .reply(401, { error: 'The access token is invalid' });
+
+      await expect(mastodon.verifyCredentials({ instanceUrl: INSTANCE_URL, token: TOKEN })).to.be.rejectedWith(
+        'The access token was rejected by the Mastodon server',
+      );
+    });
+
+    it('rejects servers resolving to private addresses (SSRF)', async () => {
+      (dns.promises.resolve4 as sinon.SinonStub).resolves(['10.0.0.12']);
+      const scope = nock(INSTANCE_URL).get('/api/v1/accounts/verify_credentials').reply(200, {});
+
+      await expect(mastodon.verifyCredentials({ instanceUrl: INSTANCE_URL, token: TOKEN })).to.be.rejectedWith(
+        'This Mastodon server URL is not allowed',
+      );
+      expect(scope.isDone()).to.be.false;
+    });
+
+    it('rejects internal hostnames without resolving them', async () => {
+      await expect(
+        mastodon.verifyCredentials({ instanceUrl: 'https://mastodon.internal', token: TOKEN }),
+      ).to.be.rejectedWith('This Mastodon server URL is not allowed');
+      expect(dns.promises.resolve4).to.not.have.been.called;
+    });
+  });
+
+  describe('post', () => {
+    it('publishes a public status, threaded and with an idempotency key', async () => {
+      const scope = nock(INSTANCE_URL, {
+        reqheaders: { authorization: `Bearer ${TOKEN}`, 'idempotency-key': 'opencollective-test-1' },
+      })
+        .post('/api/v1/statuses', {
+          status: 'Hello Fediverse!',
+          visibility: 'public',
+          language: 'en',
+          in_reply_to_id: '42',
+        })
+        .reply(200, { id: '43', url: `${INSTANCE_URL}/@mycollective/43`, created_at: '2026-10-01T08:00:00.000Z' });
+
+      const result = await mastodon.post(buildConnectedAccount(), {
+        text: 'Hello Fediverse!',
+        inReplyToId: '42',
+        idempotencyKey: 'opencollective-test-1',
+      });
+
+      expect(result).to.deep.eq({
+        id: '43',
+        url: `${INSTANCE_URL}/@mycollective/43`,
+        createdAt: new Date('2026-10-01T08:00:00.000Z'),
+      });
+      scope.done();
+    });
+
+    it('throws an authentication error when the token was revoked', async () => {
+      nock(INSTANCE_URL).post('/api/v1/statuses').reply(401, { error: 'The access token was revoked' });
+
+      const promise = mastodon.post(buildConnectedAccount(), { text: 'Hello' });
+      await expect(promise).to.be.rejectedWith(MicrobloggingAuthenticationError, 'The access token was revoked');
+    });
+
+    it('throws a request error with the HTTP status for other errors', async () => {
+      nock(INSTANCE_URL)
+        .post('/api/v1/statuses')
+        .reply(422, { error: 'Validation failed: Text character limit of 500 exceeded' });
+
+      const error = await mastodon.post(buildConnectedAccount(), { text: 'Hello' }).catch(e => e);
+      expect(error).to.be.instanceOf(MicrobloggingRequestError);
+      expect(error.status).to.eq(422);
+      expect(error.message).to.include('character limit of 500 exceeded');
+    });
+
+    it('does not follow redirects', async () => {
+      nock(INSTANCE_URL).post('/api/v1/statuses').reply(302, '', { Location: 'http://169.254.169.254/latest' });
+
+      const error = await mastodon.post(buildConnectedAccount(), { text: 'Hello' }).catch(e => e);
+      expect(error).to.be.instanceOf(MicrobloggingRequestError);
+      expect(error.status).to.eq(302);
+    });
+  });
+
+  describe('getTextLimits', () => {
+    it('uses the limits stored when connecting, or Mastodon defaults', () => {
+      const custom = { maxCharacters: 1000, charactersReservedPerUrl: 23 };
+      expect(mastodon.getTextLimits(buildConnectedAccount({ limits: custom }))).to.deep.eq(custom);
+      expect(mastodon.getTextLimits(buildConnectedAccount())).to.deep.eq({
+        maxCharacters: 500,
+        charactersReservedPerUrl: 23,
+      });
+    });
+  });
+});
diff --git a/test/server/lib/microblogging/posts.test.ts b/test/server/lib/microblogging/posts.test.ts
