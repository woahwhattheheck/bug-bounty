+#include "HostLog.hpp"
+
+#include <cstdarg>
+#include <cstdio>
+
+namespace obs_vst3 {
+
+void hostLog(const char *format, ...)
+{
+	va_list arguments;
+	va_start(arguments, format);
+	std::fputs("[obs-vst3-host] ", stderr);
+	std::vfprintf(stderr, format, arguments);
+	std::fputc('\n', stderr);
+	std::fflush(stderr);
+	va_end(arguments);
+}
+
+} // namespace obs_vst3
