diff --git a/sources/engine/Stride.Rendering/Rendering/Decals/DecalProjection.sdsl b/sources/engine/Stride.Rendering/Rendering/Decals/DecalProjection.sdsl
new file mode 100644
index 0000000..3571612
--- /dev/null
+++ b/sources/engine/Stride.Rendering/Rendering/Decals/DecalProjection.sdsl
@@ -0,0 +1,160 @@
+// Copyright (c) .NET Foundation and Contributors (https://dotnetfoundation.org/ & https://stride3d.net)
+// Distributed under the MIT license. See the LICENSE.md file in the project root for more information.
+
+namespace Stride.Rendering.Decals
+{
+    /// <summary>
+    /// Projects the material of a decal onto the opaque geometry already present in the depth buffer.
+    /// </summary>
+    /// <remarks>
+    /// The decal volume (a unit cube transformed by the World matrix) is only rasterized to find the pixels that can
+    /// receive the decal. For each of them, the receiving surface is reconstructed from the depth buffer: its position,
+    /// normal and tangent frame, and the decal texture coordinates replace the streams of the volume before the
+    /// material and the lighting are evaluated, so the decal is shaded exactly like the surface it is projected on.
+    /// The material is projected along the local -Z axis; local X maps to U and local Y maps to V (upward).
+    /// </remarks>
+    shader DecalProjection : ShaderBase, NormalBase, Transformation, PositionStream4, PositionHStream4, DepthBase
+    {
+        cbuffer PerDraw.Decal
+        {
+            // x: opacity, y: angle fade scale, z: angle fade bias, w: depth fade scale (see RenderDecal.ComputeShaderParameters)
+            stage float4 DecalParameters;
+        };
+
+        // The normal of the receiving surface, in world space
+        stage stream float3 DecalSurfaceNormalWS;
+
+        // The tangent frame of the decal on the receiving surface, in world space
+        stage stream float3x3 DecalTangentToWorld;
+
+        // The opacity of the decal at the current pixel (0 outside of the volume)
+        stage stream float DecalFade;
+
+        override stage void PSMain()
+        {
+            ProjectDecal();
+
+            // Evaluate the material and the lighting on the receiving surface
+            base.PSMain();
+
+            streams.ColorTarget *= streams.DecalFade;
+
+            // Discard only now, so that the texture coordinate derivatives used by the material stay valid on the decal borders
+            clip(streams.DecalFade - 1.0 / 1024.0);
+        }
+
+        override stage void GenerateNormal_PS()
+        {
+            // The normals of the volume are meaningless: shade the decal with the normal of the receiving surface
+            streams.normalWS = streams.DecalSurfaceNormalWS;
+            streams.meshNormalWS = streams.DecalSurfaceNormalWS;
+            streams.tangentToWorld = streams.DecalTangentToWorld;
+        }
+
+        float LoadDecalDepth(int2 pixel, int2 maxPixel)
+        {
+            return GetZProjDepthFromScreenPosition(clamp(pixel, int2(0, 0), maxPixel));
+        }
+
+        float3 ComputeDecalPositionVS(float2 positionNDC, float depth)
+        {
+            float4 positionVS = mul(float4(positionNDC, depth, 1.0), ProjectionInverse);
+            return positionVS.xyz / positionVS.w;
+        }
+
+        stage void ProjectDecal()
+        {
+            uint depthWidth;
+            uint depthHeight;
+            DepthStencil.GetDimensions(depthWidth, depthHeight);
+            int2 maxPixel = int2(depthWidth, depthHeight) - 1;
+
+            int2 pixel = int2(streams.ShadingPosition.xy);
+            float2 positionNDC = streams.PositionH.xy / streams.PositionH.w;
+
+            // Size of a pixel in normalized device coordinates (the sign follows the direction of the pixel rows and columns)
+            float2 pixelSizeNDC = float2(ddx(positionNDC.x), ddy(positionNDC.y));
+
+            // Reconstruct the receiving surface from the depth buffer
+            float depth = LoadDecalDepth(pixel, maxPixel);
+            float depthRight = LoadDecalDepth(pixel + int2(1, 0), maxPixel);
+            float depthLeft = LoadDecalDepth(pixel - int2(1, 0), maxPixel);
+            float depthDown = LoadDecalDepth(pixel + int2(0, 1), maxPixel);
+            float depthUp = LoadDecalDepth(pixel - int2(0, 1), maxPixel);
+
+            float3 positionVS = ComputeDecalPositionVS(positionNDC, depth);
+
+            // Use the neighbor closest in depth on each axis, to avoid wrong normals on depth discontinuities
+            float3 tangentXVS;
+            if (abs(depthRight - depth) < abs(depth - depthLeft))
+                tangentXVS = ComputeDecalPositionVS(positionNDC + float2(pixelSizeNDC.x, 0.0), depthRight) - positionVS;
+            else
+                tangentXVS = positionVS - ComputeDecalPositionVS(positionNDC - float2(pixelSizeNDC.x, 0.0), depthLeft);
+
+            float3 tangentYVS;
+            if (abs(depthDown - depth) < abs(depth - depthUp))
+                tangentYVS = ComputeDecalPositionVS(positionNDC + float2(0.0, pixelSizeNDC.y), depthDown) - positionVS;
+            else
+                tangentYVS = positionVS - ComputeDecalPositionVS(positionNDC - float2(0.0, pixelSizeNDC.y), depthUp);
+
+            float3 normalVS = cross(tangentYVS, tangentXVS);
+            float normalLength = length(normalVS);
+            if (normalLength > 0.0)
+                normalVS /= normalLength;
+            else
+                normalVS = float3(0.0, 0.0, 1.0);
+
+            // The receiving surface is visible, so its normal faces the camera
+            float3 toCameraVS = -positionVS;
+            if (Projection[3][3] > 0.5)
+                toCameraVS = float3(0.0, 0.0, 1.0); // Orthographic projection: the view direction is constant
+            if (dot(normalVS, toCameraVS) < 0.0)
+                normalVS = -normalVS;
+
+            float3 positionWS = mul(float4(positionVS, 1.0), ViewInverse).xyz;
+            float3 normalWS = normalize(mul(normalVS, (float3x3)ViewInverse));
+
+            // Position of the receiving surface inside the decal volume (the volume is the unit cube centered on the origin)
+            float3 positionDecal = mul(float4(positionWS, 1.0), WorldInverse).xyz;
+
+            float3 axisXWS = normalize(World[0].xyz);
+            float3 axisYWS = normalize(World[1].xyz);
+            float3 axisZWS = normalize(World[2].xyz);
+
+            float fade = 0.0;
+            if (abs(positionDecal.x) <= 0.5 && abs(positionDecal.y) <= 0.5 && abs(positionDecal.z) <= 0.5)
+            {
+                // Fade out on surfaces that are not facing the projector, and toward the far end of the volume
+                float angleFade = saturate(dot(normalWS, axisZWS) * DecalParameters.y + DecalParameters.z);
+                float depthFade = saturate((positionDecal.z + 0.5) * DecalParameters.w);
+                fade = saturate(DecalParameters.x) * angleFade * depthFade;
+            }
+            streams.DecalFade = fade;
+
+            // Tangent frame: tangent along increasing U (local X), bitangent along increasing V (local -Y), like mesh tangents
+            float3 tangentWS = axisXWS - normalWS * dot(axisXWS, normalWS);
+            if (dot(tangentWS, tangentWS) < 1.0e-8)
+            {
+                // The X axis of the decal is aligned with the surface normal: derive the tangent from the Y axis instead
+                float3 decreasingVWS = axisYWS - normalWS * dot(axisYWS, normalWS);
+                tangentWS = cross(decreasingVWS, normalWS);
+            }
+            tangentWS = normalize(tangentWS);
+            float3 bitangentWS = cross(tangentWS, normalWS);
+
+            streams.DecalSurfaceNormalWS = normalWS;
+            streams.DecalTangentToWorld = float3x3(tangentWS, bitangentWS, normalWS);
+
+            // Replace the streams of the volume with the ones of the receiving surface
+#if !(STRIDE_GRAPHICS_API_DIRECT3D && STRIDE_GRAPHICS_PROFILE < GRAPHICS_PROFILE_LEVEL_10_0)
+            // The back faces of the volume are rasterized, but the receiving surface faces the camera:
+            // without this, the lighting would flip the normal as for the back faces of two-sided materials
+            streams.IsFrontFace = true;
+#endif
+            streams.PositionWS = float4(positionWS, 1.0);
+            streams.DepthVS = mul(float4(positionWS, 1.0), ViewProjection).w;
+            streams.ShadingPosition.z = depth;
+            streams.TexCoord = float2(positionDecal.x + 0.5, 0.5 - positionDecal.y);
+        }
+    };
+}
diff --git a/sources/engine/Stride.Rendering/Rendering/Decals/DecalRenderFeature.cs b/sources/engine/Stride.Rendering/Rendering/Decals/DecalRenderFeature.cs
new file mode 100644
index 0000000..a383552
--- /dev/null
+++ b/sources/engine/Stride.Rendering/Rendering/Decals/DecalRenderFeature.cs
@@ -0,0 +1,147 @@
+// Copyright (c) .NET Foundation and Contributors (https://dotnetfoundation.org/ & https://stride3d.net)
+// Distributed under the MIT license. See the LICENSE.md file in the project root for more information.
+
+using Stride.Core.Diagnostics;
+using Stride.Core.Mathematics;
+using Stride.Core.Threading;
+using Stride.Graphics;
+using Stride.Shaders;
+
+namespace Stride.Rendering.Decals
+{
+    /// <summary>
+    /// Projects the <see cref="RenderDecal"/> rendered by a <see cref="MeshRenderFeature"/> onto the receiving geometry.
+    /// </summary>
+    /// <remarks>
+    /// <para>
+    /// This feature must be added to <see cref="MeshRenderFeature.RenderFeatures"/>. For each decal, it mixes the
+    /// <c>DecalProjection</c> shader in the effect (through <see cref="StrideEffectBaseKeys.DecalShader"/>), uploads the
+    /// fade parameters, and sets up the pipeline state of the decal volume.
+    /// </para>
+    /// <para>
+    /// Decals sample the depth of the opaque geometry: they must be rendered in a stage drawn after the opaque stage,
+    /// while the depth buffer is bound as a shader resource (<c>DepthBase.DepthStencil</c>), such as the decal stage
+    /// or the transparent stage of the forward renderer.
+    /// </para>
+    /// </remarks>
+    public class DecalRenderFeature : SubRenderFeature
+    {
+        private static readonly ProfilingKey PrepareEffectPermutationsKey = new("DecalRenderFeature.PrepareEffectPermutations");
+        private static readonly ProfilingKey PrepareKey = new("DecalRenderFeature.Prepare");
+
+        private static readonly ShaderSource DecalProjectionShader = new ShaderClassSource("DecalProjection");
+
+        private StaticObjectPropertyKey<RenderEffect> renderEffectKey;
+        private ObjectPropertyKey<Vector4> decalParametersKey;
+        private ConstantBufferOffsetReference decalParameters;
+
+        /// <inheritdoc/>
+        protected override void InitializeCore()
+        {
+            base.InitializeCore();
+
+            var rootEffectRenderFeature = (RootEffectRenderFeature)RootRenderFeature;
+            renderEffectKey = rootEffectRenderFeature.RenderEffectKey;
+            decalParametersKey = RootRenderFeature.RenderData.CreateObjectKey<Vector4>();
+            decalParameters = rootEffectRenderFeature.CreateDrawCBufferOffsetSlot(DecalProjectionKeys.DecalParameters.Name);
+        }
+
+        /// <inheritdoc/>
+        public override void Extract()
+        {
+            var decalParametersData = RootRenderFeature.RenderData.GetData(decalParametersKey);
+
+            Dispatcher.ForEach(RootRenderFeature.ObjectNodeReferences, objectNodeReference =>
+            {
+                var objectNode = RootRenderFeature.GetObjectNode(objectNodeReference);
+                if (objectNode.RenderObject is RenderDecal renderDecal)
+                    decalParametersData[objectNodeReference] = renderDecal.GetShaderParameters();
+            });
+        }
+
+        /// <inheritdoc/>
+        public override void PrepareEffectPermutations(RenderDrawContext context)
+        {
+            using var _ = Profiler.Begin(PrepareEffectPermutationsKey);
+
+            var renderEffects = RootRenderFeature.RenderData.GetData(renderEffectKey);
+            var effectSlotCount = ((RootEffectRenderFeature)RootRenderFeature).EffectPermutationSlotCount;
+
+            Dispatcher.ForEach(RootRenderFeature.ObjectNodeReferences, objectNodeReference =>
+            {
+                var objectNode = RootRenderFeature.GetObjectNode(objectNodeReference);
+                if (objectNode.RenderObject is not RenderDecal renderDecal)
+                    return;
+
+                var staticObjectNode = renderDecal.StaticObjectNode;
+                for (var i = 0; i < effectSlotCount; ++i)
+                {
+                    var renderEffect = renderEffects[staticObjectNode * effectSlotCount + i];
+
+                    // Skip effects not used during this frame
+                    if (renderEffect == null || !renderEffect.IsUsedDuringThisFrame(RenderSystem))
+                        continue;
+
+                    renderEffect.EffectValidator.ValidateParameter(StrideEffectBaseKeys.DecalShader, DecalProjectionShader);
+                }
+            });
+        }
+
+        /// <inheritdoc/>
+        public override unsafe void Prepare(RenderDrawContext context)
+        {
+            using var _ = Profiler.Begin(PrepareKey);
+
+            var decalParametersData = RootRenderFeature.RenderData.GetData(decalParametersKey);
+
+            Dispatcher.ForBatched(RootRenderFeature.RenderNodes.Count, (from, toExclusive) =>
+            {
+                for (var i = from; i < toExclusive; i++)
+                {
+                    var renderNode = RootRenderFeature.RenderNodes[i];
+                    if (renderNode.RenderObject is not RenderDecal)
+                        continue;
+
+                    var perDrawLayout = renderNode.RenderEffect.Reflection?.PerDrawLayout;
+                    if (perDrawLayout == null)
+                        continue;
+
+                    var decalParametersOffset = perDrawLayout.GetConstantBufferOffset(decalParameters);
+                    if (decalParametersOffset == -1)
+                        continue;
+
+                    var mappedCB = (byte*)renderNode.Resources.ConstantBuffer.Data + decalParametersOffset;
+                    *(Vector4*)mappedCB = decalParametersData[renderNode.RenderObject.ObjectNode];
+                }
+            });
+        }
+
+        /// <inheritdoc/>
+        public override void ProcessPipelineState(RenderContext context, RenderNodeReference renderNodeReference, ref RenderNode renderNode, RenderObject renderObject, PipelineStateDescription pipelineState)
+        {
+            if (renderObject is RenderDecal renderDecal)
+                SetupPipelineState(renderDecal, pipelineState);
+        }
+
+        /// <summary>
+        /// Sets up the pipeline state used to draw the volume of a decal.
+        /// </summary>
+        /// <param name="renderDecal">The decal.</param>
+        /// <param name="pipelineState">The pipeline state to set up.</param>
+        internal static void SetupPipelineState(RenderDecal renderDecal, PipelineStateDescription pipelineState)
+        {
+            // Blend over the receiving surface: premultiplied alpha, unless the material has its own transparency mode
+            pipelineState.BlendState = renderDecal.MaterialPass?.BlendState ?? BlendStates.AlphaBlend;
+
+            // Draw the back faces of the volume, so that the decal is still visible when the camera is inside of it,
+            // and keep only the pixels where the opaque geometry is in front of them. A decal never writes depth.
+            pipelineState.DepthStencilState = new DepthStencilStateDescription(depthEnable: true, depthWriteEnable: false)
+            {
+                DepthBufferFunction = CompareFunction.GreaterEqual,
+            };
+
+            // The winding of the volume is reversed when its transformation is mirrored
+            pipelineState.RasterizerState.CullMode = renderDecal.IsScalingNegative ? CullMode.Back : CullMode.Front;
+        }
+    }
+}
