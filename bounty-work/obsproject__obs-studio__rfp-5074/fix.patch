@@ -0,0 +1,16 @@
+#pragma once
+
+namespace obs_vst3 {
+
+/*
+ * Diagnostics of the bridge process go to stderr, which is inherited from OBS.
+ * Errors that matter to the user are also returned to the module in command
+ * replies and end up in the OBS log there.
+ */
+void hostLog(const char *format, ...)
+#if defined(__GNUC__) || defined(__clang__)
+	__attribute__((format(printf, 1, 2)))
+#endif
+	;
+
+} // namespace obs_vst3
