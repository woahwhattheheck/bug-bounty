diff --git a/plugins/obs-vst3/host/linux/EditorWindowX11.cpp b/plugins/obs-vst3/host/linux/EditorWindowX11.cpp
new file mode 100644
index 0000000..eae67d3
--- /dev/null
+++ b/plugins/obs-vst3/host/linux/EditorWindowX11.cpp
@@ -0,0 +1,210 @@
+#include "EditorWindowX11.hpp"
+#include "EventLoopX11.hpp"
+
+#include <cstdint>
+
+#include <X11/Xatom.h>
+#include <X11/Xlib.h>
+#include <X11/Xutil.h>
+
+namespace obs_vst3 {
+
+using namespace Steinberg;
+
+namespace {
+
+constexpr int kDefaultWidth = 640;
+constexpr int kDefaultHeight = 480;
+
+} // namespace
+
+EditorWindowX11::EditorWindowX11(EventLoopX11 &loop, _XDisplay *display, Linux::IRunLoop *runLoop, IPlugView *view,
+				 EventLoop::CloseHandler onCloseRequested)
+	: loop_(loop),
+	  display_(display),
+	  runLoop_(runLoop),
+	  view_(shared(view)),
+	  onCloseRequested_(std::move(onCloseRequested))
+{
+}
+
+std::unique_ptr<EditorWindowX11> EditorWindowX11::create(EventLoopX11 &loop, _XDisplay *display,
+							 Linux::IRunLoop *runLoop, IPlugView *view,
+							 const std::string &title,
+							 EventLoop::CloseHandler onCloseRequested, std::string &error)
+{
+	if (view->isPlatformTypeSupported(kPlatformTypeX11EmbedWindowID) != kResultTrue) {
+		error = "The plug-in editor does not support X11";
+		return nullptr;
+	}
+
+	std::unique_ptr<EditorWindowX11> editor(
+		new EditorWindowX11(loop, display, runLoop, view, std::move(onCloseRequested)));
+
+	ViewRect rect;
+	if (view->getSize(&rect) != kResultTrue || rect.getWidth() <= 0 || rect.getHeight() <= 0) {
+		rect = ViewRect(0, 0, kDefaultWidth, kDefaultHeight);
+	}
+	editor->width_ = rect.getWidth();
+	editor->height_ = rect.getHeight();
+	editor->resizable_ = view->canResize() == kResultTrue;
+
+	int screen = DefaultScreen(display);
+	Window window = XCreateSimpleWindow(display, RootWindow(display, screen), 0, 0,
+					    static_cast<unsigned int>(editor->width_),
+					    static_cast<unsigned int>(editor->height_), 0, BlackPixel(display, screen),
+					    BlackPixel(display, screen));
+	if (!window) {
+		error = "Could not create the editor window";
+		return nullptr;
+	}
+	editor->window_ = window;
+
+	XSelectInput(display, window, StructureNotifyMask);
+
+	Atom deleteWindow = XInternAtom(display, "WM_DELETE_WINDOW", False);
+	XSetWMProtocols(display, window, &deleteWindow, 1);
+	editor->deleteWindowAtom_ = deleteWindow;
+
+	XStoreName(display, window, title.c_str());
+	Atom netWmName = XInternAtom(display, "_NET_WM_NAME", False);
+	Atom utf8String = XInternAtom(display, "UTF8_STRING", False);
+	XChangeProperty(display, window, netWmName, utf8String, 8, PropModeReplace,
+			reinterpret_cast<const unsigned char *>(title.c_str()), static_cast<int>(title.size()));
+
+	XClassHint *classHint = XAllocClassHint();
+	if (classHint) {
+		char resourceName[] = "obs-vst3-host";
+		char resourceClass[] = "obs";
+		classHint->res_name = resourceName;
+		classHint->res_class = resourceClass;
+		XSetClassHint(display, window, classHint);
+		XFree(classHint);
+	}
+
+	editor->applySizeHints(editor->width_, editor->height_);
+	loop.registerWindow(window, editor.get());
+
+	XMapRaised(display, window);
+	XSync(display, False);
+
+	view->setFrame(editor.get());
+	if (view->attached(reinterpret_cast<void *>(static_cast<uintptr_t>(window)), kPlatformTypeX11EmbedWindowID) !=
+	    kResultOk) {
+		error = "The plug-in editor could not be attached to its window";
+		return nullptr;
+	}
+	editor->attached_ = true;
+
+	XFlush(display);
+	return editor;
+}
+
+EditorWindowX11::~EditorWindowX11()
+{
+	if (attached_) {
+		view_->removed();
+	}
+	view_->setFrame(nullptr);
+
+	if (window_) {
+		loop_.unregisterWindow(window_);
+		XDestroyWindow(display_, window_);
+		XFlush(display_);
+	}
+}
+
+tresult PLUGIN_API EditorWindowX11::queryInterface(const TUID iid, void **object)
+{
+	if (FUnknownPrivate::iidEqual(iid, FUnknown::iid) || FUnknownPrivate::iidEqual(iid, IPlugFrame::iid)) {
+		*object = static_cast<IPlugFrame *>(this);
+		return kResultOk;
+	}
+
+	/* Plug-ins look up the host run loop through their frame. */
+	if (FUnknownPrivate::iidEqual(iid, Linux::IRunLoop::iid)) {
+		return runLoop_->queryInterface(iid, object);
+	}
+
+	*object = nullptr;
+	return kNoInterface;
+}
+
+void EditorWindowX11::applySizeHints(int width, int height)
+{
+	XSizeHints *hints = XAllocSizeHints();
+	if (!hints) {
+		return;
+	}
+
+	if (!resizable_) {
+		hints->flags = PMinSize | PMaxSize;
+		hints->min_width = hints->max_width = width;
+		hints->min_height = hints->max_height = height;
+	}
+
+	XSetWMNormalHints(display_, window_, hints);
+	XFree(hints);
+}
+
+tresult PLUGIN_API EditorWindowX11::resizeView(IPlugView *view, ViewRect *newSize)
+{
+	if (!newSize || view != view_.get() || newSize->getWidth() <= 0 || newSize->getHeight() <= 0) {
+		return kInvalidArgument;
+	}
+
+	resizing_ = true;
+	width_ = newSize->getWidth();
+	height_ = newSize->getHeight();
+	applySizeHints(width_, height_);
+	XResizeWindow(display_, window_, static_cast<unsigned int>(width_), static_cast<unsigned int>(height_));
+	XFlush(display_);
+	view_->onSize(newSize);
+	resizing_ = false;
+
+	return kResultTrue;
+}
+
+void EditorWindowX11::bringToFront()
+{
+	XMapRaised(display_, window_);
+	XFlush(display_);
+}
+
+void EditorWindowX11::handleEvent(const XEvent &event)
+{
+	if (event.type == ClientMessage && static_cast<unsigned long>(event.xclient.data.l[0]) == deleteWindowAtom_) {
+		/* The owner destroys this window later, outside of event dispatching. */
+		if (onCloseRequested_) {
+			onCloseRequested_();
+		}
+		return;
+	}
+
+	if (event.type != ConfigureNotify || resizing_) {
+		return;
+	}
+
+	int width = event.xconfigure.width;
+	int height = event.xconfigure.height;
+	if (width == width_ && height == height_) {
+		return;
+	}
+	width_ = width;
+	height_ = height;
+
+	if (!resizable_) {
+		return;
+	}
+
+	ViewRect rect(0, 0, width, height);
+	if (view_->checkSizeConstraint(&rect) == kResultTrue &&
+	    (rect.getWidth() != width || rect.getHeight() != height)) {
+		width_ = rect.getWidth();
+		height_ = rect.getHeight();
+		XResizeWindow(display_, window_, static_cast<unsigned int>(width_), static_cast<unsigned int>(height_));
+	}
+	view_->onSize(&rect);
+}
+
+} // namespace obs_vst3
