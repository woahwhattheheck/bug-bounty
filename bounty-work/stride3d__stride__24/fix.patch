+using System.ComponentModel;
+using Stride.Core;
+using Stride.Core.Annotations;
+using Stride.Core.Mathematics;
+using Stride.Engine.Design;
+using Stride.Rendering;
+using Stride.Rendering.Decals;
+
+namespace Stride.Engine
+{
+    /// <summary>
+    /// Projects a material onto the opaque surfaces inside a box volume, to add details such as bullet holes, signs, stains or footprints.
+    /// </summary>
+    /// <remarks>
+    /// <para>
+    /// The volume is centered on the entity and oriented by its transform. The material is projected along the
+    /// forward axis of the entity (-Z), like the light of a spot light: the local X axis maps to the horizontal texture
+    /// coordinate (U) and the local Y axis is the up direction of the texture.
+    /// </para>
+    /// <para>
+    /// Any material can be projected. Its transparency mode (Blend, Additive or Cutoff) and its alpha control how the
+    /// decal blends over the surface; an opaque material covers the whole projected area. The decal is lit and shadowed
+    /// like the surface it is projected on.
+    /// </para>
+    /// </remarks>
+    [DataContract("DecalComponent")]
+    [Display("Decal", Expand = ExpandRule.Once)]
+    [DefaultEntityComponentRenderer(typeof(DecalRenderProcessor))]
+    [ComponentOrder(11100)]
+    [ComponentCategory("Model")]
+    public sealed class DecalComponent : ActivableEntityComponent
+    {
+        /// <summary>
+        /// Gets or sets the material projected by the decal.
+        /// </summary>
+        /// <userdoc>The material projected onto the surfaces inside the decal volume. Use a material with a transparency mode to blend it over the surfaces.</userdoc>
+        [DataMember(10)]
+        [DefaultValue(null)]
+        public Material Material { get; set; }
+
+        /// <summary>
+        /// Gets or sets the size of the decal volume: the width (X) and height (Y) of the projected area, and the depth (Z) of the projection.
+        /// </summary>
+        /// <remarks>The size is expressed in the local space of the entity, so it is also scaled by the entity transform.</remarks>
+        /// <userdoc>The width and height of the projected area, and the depth of the projection along the forward axis of the entity.</userdoc>
+        [DataMember(20)]
+        public Vector3 Size { get; set; } = Vector3.One;
+
+        /// <summary>
+        /// Gets or sets the opacity of the decal, multiplied with the output of its material.
+        /// </summary>
+        /// <userdoc>The opacity of the decal. Use it to fade decals in or out.</userdoc>
+        [DataMember(30)]
+        [DataMemberRange(0.0, 1.0, 0.01, 0.1, 2)]
+        [DefaultValue(1.0f)]
+        public float Opacity { get; set; } = 1.0f;
+
+        /// <summary>
+        /// Gets or sets the angle, in degrees, between the projection direction and the surface normal from which the decal starts to fade out.
+        /// </summary>
+        /// <userdoc>The angle between the projection direction and a surface from which the decal starts to fade out.</userdoc>
+        [DataMember(40)]
+        [DataMemberRange(0.0, 180.0, 1.0, 10.0, 1)]
+        [DefaultValue(60.0f)]
+        [Display("Angle fade start")]
+        public float AngleFadeStart { get; set; } = 60.0f;
+
+        /// <summary>
+        /// Gets or sets the angle, in degrees, between the projection direction and the surface normal from which the decal is no longer visible.
+        /// </summary>
+        /// <remarks>Use an angle larger than 90 degrees to also project on surfaces facing away from the projection, such as both sides of a thin wall.</remarks>
+        /// <userdoc>The angle between the projection direction and a surface from which the decal is no longer visible. Values larger than 90 also project on surfaces facing away.</userdoc>
+        [DataMember(50)]
+        [DataMemberRange(0.0, 180.0, 1.0, 10.0, 1)]
+        [DefaultValue(85.0f)]
+        [Display("Angle fade end")]
+        public float AngleFadeEnd { get; set; } = 85.0f;
+
+        /// <summary>
+        /// Gets or sets the fraction of the projection depth, at the far end of the volume, over which the decal fades out.
+        /// </summary>
+        /// <userdoc>The fraction of the projection depth over which the decal fades out at the far end of the volume. 0 cuts the decal sharply.</userdoc>
+        [DataMember(60)]
+        [DataMemberRange(0.0, 1.0, 0.01, 0.1, 2)]
+        [DefaultValue(0.0f)]
+        [Display("Depth fade")]
+        public float DepthFade { get; set; }
+
+        /// <summary>
+        /// Gets or sets the draw order of the decal relative to the other decals. Decals with a higher sort order are drawn on top.
+        /// </summary>
+        /// <remarks>Decals with the same sort order are drawn in creation order.</remarks>
+        /// <userdoc>The draw order of overlapping decals. Decals with a higher value are drawn on top.</userdoc>
+        [DataMember(70)]
+        [DefaultValue(0)]
+        [Display("Sort order")]
+        public int SortOrder { get; set; }
+
+        /// <summary>
+        /// Gets or sets the render group of the decal.
+        /// </summary>
+        /// <userdoc>The render group of the decal, used to choose the cameras rendering it.</userdoc>
+        [DataMember(80)]
+        [DefaultValue(RenderGroup.Group0)]
+        [Display("Render group")]
+        public RenderGroup RenderGroup { get; set; }
+    }
+}
