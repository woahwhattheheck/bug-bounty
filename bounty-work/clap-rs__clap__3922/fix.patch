Subject: [PATCH 1/3] test(complete): Show delimited values on flag-like args

---
 clap_complete/tests/testsuite/engine.rs | 54 +++++++++++++++++++++++++
 1 file changed, 54 insertions(+)

diff --git a/clap_complete/tests/testsuite/engine.rs b/clap_complete/tests/testsuite/engine.rs
index c611373b..c1a74bad 100644
--- a/clap_complete/tests/testsuite/engine.rs
+++ b/clap_complete/tests/testsuite/engine.rs
@@ -1309,6 +1309,60 @@ a_pos,c_pos
     );
 }
 
+#[test]
+fn suggest_delimiter_values_flag_like() {
+    let mut cmd = Command::new("delimiter")
+        .arg(
+            clap::Arg::new("delimiter")
+                .long("delimiter")
+                .value_parser(["comma", "space"])
+                .value_delimiter(','),
+        )
+        .arg(
+            clap::Arg::new("format")
+                .long("format")
+                .num_args(0..=1)
+                .value_parser(["json", "toml"])
+                .value_delimiter(','),
+        )
+        .arg(
+            clap::Arg::new("pos")
+                .value_parser(["--a_pos", "--b_pos"])
+                .value_delimiter(',')
+                .allow_hyphen_values(true),
+        );
+
+    assert_data_eq!(
+        complete!(cmd, "--a_pos,[TAB]"),
+        snapbox::str![[r#"
+--a_pos,--a_pos
+--a_pos,--b_pos
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "--delimiter=comma,[TAB]"),
+        snapbox::str![[r#"
+--delimiter=comma,--a_pos
+--delimiter=comma,--b_pos
+--delimiter=comma,comma
+--delimiter=comma,space
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "--format --delimiter=comma,[TAB]"),
+        snapbox::str![[r#"
+--delimiter=comma,json
+--delimiter=comma,toml
+--delimiter=comma,--a_pos
+--delimiter=comma,--b_pos
+--delimiter=comma,comma
+--delimiter=comma,space
+"#]]
+    );
+}
