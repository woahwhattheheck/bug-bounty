diff --git a/server/lib/microblogging/index.ts b/server/lib/microblogging/index.ts
new file mode 100644
index 000000000..192f4eb69
--- /dev/null
+++ b/server/lib/microblogging/index.ts
@@ -0,0 +1,473 @@
+import config from 'config';
+import { pick } from 'lodash';
+
+import ActivityTypes from '../../constants/activities';
+import { CollectiveType } from '../../constants/collectives';
+import { Service } from '../../constants/connected-account';
+import MemberRoles from '../../constants/roles';
+import { Forbidden, ValidationFailed } from '../../graphql/errors';
+import models, { Activity, Collective, ConnectedAccount, User } from '../../models';
+import { SocialLinkType } from '../../models/SocialLink';
+import logger from '../logger';
+import RateLimit, { ONE_HOUR_IN_SECONDS } from '../rate-limit';
+import { reportErrorToSentry } from '../sentry';
+import { parseToBoolean } from '../utils';
+
+import mastodon from './mastodon';
+import {
+  composeMilestonePost,
+  composeMonthlyStatsPost,
+  composeNewContributorPost,
+  getHighestMilestoneReached,
+  MonthlyStats,
+} from './posts';
+import { buildPostText } from './text';
+import {
+  MicrobloggingAuthenticationError,
+  MicrobloggingPost,
+  MicrobloggingPostResult,
+  MicrobloggingPostSettings,
+  MicrobloggingPostType,
+  MicrobloggingRequestError,
+  MicrobloggingService,
+} from './types';
+
+/** Connected account services that can receive automated posts */
+const MICROBLOGGING_SERVICES: readonly Service[] = [Service.MASTODON];
+
+const SERVICES: Partial<Record<Service, MicrobloggingService>> = {
+  [Service.MASTODON]: mastodon,
+};
+
+/** Account types that can connect a microblogging account for automated posts */
+const ALLOWED_ACCOUNT_TYPES: readonly CollectiveType[] = [
+  CollectiveType.COLLECTIVE,
+  CollectiveType.FUND,
+  CollectiveType.PROJECT,
+  CollectiveType.EVENT,
+  CollectiveType.ORGANIZATION,
+];
+
+const DEFAULT_POST_SETTINGS: MicrobloggingPostSettings = {
+  [MicrobloggingPostType.NEW_CONTRIBUTOR]: true,
+  [MicrobloggingPostType.MILESTONE]: true,
+  [MicrobloggingPostType.MONTHLY_STATS]: true,
+};
+
+/** Prevents flooding the timeline of collectives receiving many contributions at once */
+const MAX_NEW_CONTRIBUTOR_POSTS_PER_HOUR = 10;
+
+/** Platform-level feature flag (`MICROBLOGGING_POSTS` env variable) */
+const isMicrobloggingPostsEnabled = (): boolean => parseToBoolean(config.features?.microbloggingPosts);
+
+const isMicrobloggingService = (service: string): boolean => (MICROBLOGGING_SERVICES as string[]).includes(service);
+
+const getService = (service: string): MicrobloggingService => {
+  const microbloggingService = SERVICES[service];
+  if (!microbloggingService) {
+    throw new ValidationFailed(`Automated posts are not supported for ${service}`);
+  }
+  return microbloggingService;
+};
+
+/** Returns the post settings of the connected account. Posts that were never configured are disabled. */
+const getPostSettings = (connectedAccount: ConnectedAccount): MicrobloggingPostSettings => {
+  const settings = connectedAccount.settings?.posts || {};
+  return {
+    [MicrobloggingPostType.NEW_CONTRIBUTOR]: settings[MicrobloggingPostType.NEW_CONTRIBUTOR] === true,
+    [MicrobloggingPostType.MILESTONE]: settings[MicrobloggingPostType.MILESTONE] === true,
+    [MicrobloggingPostType.MONTHLY_STATS]: settings[MicrobloggingPostType.MONTHLY_STATS] === true,
+  };
+};
+
+/** Keeps the known boolean flags from `input`, falling back on `defaults` */
+const sanitizePostSettings = (input: unknown, defaults: MicrobloggingPostSettings): MicrobloggingPostSettings => {
+  const result = { ...defaults };
+  if (input && typeof input === 'object') {
+    for (const type of Object.values(MicrobloggingPostType)) {
+      if (typeof input[type] === 'boolean') {
+        result[type] = input[type];
+      }
+    }
+  }
+  return result;
+};
+
+/** Number of distinct financial contributors of a collective */
+const countFinancialContributors = (CollectiveId: number): Promise<number> => {
+  return models.Member.count({
+    where: { CollectiveId, role: MemberRoles.BACKER },
+    distinct: true,
+    col: 'MemberCollectiveId',
+  });
+};
+
+/**
+ * Connects (or reconnects) a microblogging account to `collective` after checking the credentials
+ * with the service.
+ */
+export const connectMicrobloggingAccount = async ({
+  collective,
+  service,
+  token,
+  instanceUrl,
+  settings,
+  remoteUser,
+}: {
+  collective: Collective;
+  service: string;
+  token: string;
+  instanceUrl: string;
+  settings?: Record<string, unknown>;
+  remoteUser: User;
+}): Promise<ConnectedAccount> => {
+  if (!isMicrobloggingPostsEnabled()) {
+    throw new Forbidden('Automated posts are not enabled on this platform');
+  } else if (!ALLOWED_ACCOUNT_TYPES.includes(collective.type as CollectiveType)) {
+    throw new ValidationFailed('Automated posts are not available for this type of account');
+  } else if (collective.isPrivate) {
+    throw new Forbidden('Automated posts are not available for private accounts');
+  }
+
+  const microbloggingService = getService(service);
+  const accountInfo = await microbloggingService.verifyCredentials({ instanceUrl, token });
+  const data = {
+    instanceUrl: accountInfo.instanceUrl,
+    accountId: accountInfo.id,
+    profileUrl: accountInfo.url,
+    limits: accountInfo.limits,
+  };
+
+  // Connecting the same remote account again refreshes its credentials (e.g. after a token was revoked)
+  const existingAccount = await models.ConnectedAccount.findOne({
+    where: { CollectiveId: collective.id, service, username: accountInfo.handle },
+  });
+  if (existingAccount) {
+    return existingAccount.update({
+      token,
+      data: { ...existingAccount.data, ...data },
+      settings: {
+        ...existingAccount.settings,
+        needsReconnect: false,
+        posts: sanitizePostSettings(settings?.posts, getPostSettings(existingAccount)),
+      },
+    });
+  }
+
+  // Only celebrate milestones reached after connecting the account
+  const lastMilestone = getHighestMilestoneReached(await countFinancialContributors(collective.id));
+  return models.ConnectedAccount.create({
+    service,
+    CollectiveId: collective.id,
+    CreatedByUserId: remoteUser.id,
+    username: accountInfo.handle,
+    token,
+    data: { ...data, posts: { [MicrobloggingPostType.MILESTONE]: { lastMilestone } } },
+    settings: { posts: sanitizePostSettings(settings?.posts, DEFAULT_POST_SETTINGS) },
+  });
+};
+
+export const editMicrobloggingPostSettings = async (
+  connectedAccount: ConnectedAccount,
+  postSettings: Partial<MicrobloggingPostSettings>,
+): Promise<ConnectedAccount> => {
+  if (!isMicrobloggingService(connectedAccount.service)) {
+    throw new ValidationFailed(`Automated posts are not supported for ${connectedAccount.service}`);
+  }
+
+  return connectedAccount.update({
+    settings: {
+      ...connectedAccount.settings,
+      posts: sanitizePostSettings(postSettings, getPostSettings(connectedAccount)),
+    },
+  });
+};
+
+const recordPost = (
+  connectedAccount: ConnectedAccount,
+  type: MicrobloggingPostType,
+  values: Record<string, unknown>,
+): Promise<ConnectedAccount> => {
+  const posts = connectedAccount.data?.posts || {};
+  return connectedAccount.update({
+    data: { ...connectedAccount.data, posts: { ...posts, [type]: { ...posts[type], ...values } } },
+  });
+};
+
+/**
+ * Publishes a post, without ever throwing: errors are reported to Sentry, and accounts whose
+ * credentials were revoked are flagged so that we stop posting until they get reconnected.
+ */
+const publish = async (
+  connectedAccount: ConnectedAccount,
+  post: MicrobloggingPost,
+  type: MicrobloggingPostType,
+): Promise<MicrobloggingPostResult | null> => {
+  try {
+    return await getService(connectedAccount.service).post(connectedAccount, post);
+  } catch (error) {
+    if (error instanceof MicrobloggingAuthenticationError) {
+      logger.warn(`Microblogging: credentials of connected account #${connectedAccount.id} were rejected`);
+      await connectedAccount.update({ settings: { ...connectedAccount.settings, needsReconnect: true } });
+    } else if (post.inReplyToId && error instanceof MicrobloggingRequestError && [404, 422].includes(error.status)) {
+      // The post we're replying to was probably deleted, start a new thread
+      return publish(connectedAccount, { ...post, inReplyToId: null }, type);
+    } else {
+      reportErrorToSentry(error, { extra: { connectedAccountId: connectedAccount.id, type } });
+    }
+    return null;
+  }
+};
+
+/** Returns `@user@domain` from a Mastodon profile URL such as `https://mastodon.social/@user` */
+export const getFediverseHandleFromProfileUrl = (profileUrl: string): string | null => {
+  let url: URL;
+  try {
+    url = new URL(profileUrl);
+  } catch {
+    return null;
+  }
+
+  if (!['https:', 'http:'].includes(url.protocol)) {
+    return null;
+  }
+
+  const match = url.pathname.match(/^\/(?:@|users\/)([\w.-]+)(?:@([\w-]+(?:\.[\w-]+)+))?\/?$/);
+  return match ? `@${match[1]}@${match[2] || url.hostname}` : null;
+};
+
+const getContributorFediverseHandle = async (CollectiveId: number): Promise<string | null> => {
+  const socialLink = await models.SocialLink.findOne({
+    where: { CollectiveId, type: SocialLinkType.MASTODON },
+    order: [['order', 'ASC']],
+  });
+  return socialLink ? getFediverseHandleFromProfileUrl(socialLink.url) : null;
+};
+
+const getAccountUrl = (collective: { slug?: string; urlPath?: string }): string => {
+  return `${config.host.website}${collective.urlPath || `/${collective.slug}`}`;
+};
+
+const postNewContributorThanks = async (connectedAccount: ConnectedAccount, activity: Activity): Promise<void> => {
+  const rateLimit = new RateLimit(
+    `microblogging-new-contributors-${connectedAccount.id}`,
+    MAX_NEW_CONTRIBUTOR_POSTS_PER_HOUR,
+    ONE_HOUR_IN_SECONDS,
+  );
+  if (!(await rateLimit.registerCall())) {
+    logger.info(`Microblogging: rate limit reached for new contributor posts on #${connectedAccount.id}`);
+    return;
+  }
+
+  const { collective, member, order } = activity.data;
+  const contributor = member.memberCollective || {};
+  const isIncognito = Boolean(contributor.isIncognito);
+  const contributorHandle = isIncognito || !contributor.id ? null : await getContributorFediverseHandle(contributor.id);
+  const body = composeNewContributorPost({
+    collectiveName: collective.name,
+    contributorName: contributor.name,
+    contributorHandle,
+    isIncognito,
+    amount: order?.netAmount ?? order?.totalAmount,
+    currency: order?.currency,
+    interval: order?.interval,
+  });
+
+  const limits = getService(connectedAccount.service).getTextLimits(connectedAccount);
+  const result = await publish(
+    connectedAccount,
+    {
+      text: buildPostText(body, getAccountUrl(collective), limits),
+      idempotencyKey: `opencollective-activity-${activity.id}`,
+    },
+    MicrobloggingPostType.NEW_CONTRIBUTOR,
+  );
+
+  if (result) {
+    await recordPost(connectedAccount, MicrobloggingPostType.NEW_CONTRIBUTOR, {
+      lastPostId: result.id,
+      lastPostedAt: result.createdAt || new Date(),
+    });
+  }
+};
+
+const postMilestoneIfReached = async (
+  connectedAccount: ConnectedAccount,
+  activity: Activity,
+  contributorsCount: number,
+): Promise<void> => {
+  const milestone = getHighestMilestoneReached(contributorsCount);
+  const lastMilestone =
+    connectedAccount.data?.posts?.[MicrobloggingPostType.MILESTONE]?.lastMilestone ??
+    getHighestMilestoneReached(contributorsCount - 1);
+  if (!milestone || milestone <= lastMilestone) {
+    return;
+  }
+
+  const { collective } = activity.data;
+  const limits = getService(connectedAccount.service).getTextLimits(connectedAccount);
+  const body = composeMilestonePost({ collectiveName: collective.name, milestone });
+  const result = await publish(
+    connectedAccount,
+    {
+      text: buildPostText(body, getAccountUrl(collective), limits),
+      idempotencyKey: `opencollective-milestone-${activity.CollectiveId}-${milestone}`,
+    },
+    MicrobloggingPostType.MILESTONE,
+  );
+
+  if (result) {
+    await recordPost(connectedAccount, MicrobloggingPostType.MILESTONE, {
+      lastMilestone: milestone,
+      lastPostId: result.id,
+      lastPostedAt: result.createdAt || new Date(),
+    });
+  }
+};
+
+/**
+ * Activity to post pipeline, called by the notifications dispatcher for every activity. It thanks new
+ * financial contributors and celebrates milestones on the microblogging accounts connected to the
+ * collective, according to their settings.
+ */
+export const postActivityToMicroblogging = async (activity: Activity): Promise<void> => {
+  if (
+    !isMicrobloggingPostsEnabled() ||
+    activity.type !== ActivityTypes.COLLECTIVE_MEMBER_CREATED ||
+    activity.data?.member?.role !== MemberRoles.BACKER ||
+    !activity.CollectiveId ||
+    !activity.data.collective ||
+    activity.data.collective.isPrivate
+  ) {
+    return;
+  }
+
+  const connectedAccounts = await models.ConnectedAccount.findAll({
+    where: { CollectiveId: activity.CollectiveId, service: MICROBLOGGING_SERVICES as Service[] },
+  });
+
+  const activeAccounts = connectedAccounts.filter(account => !account.settings?.needsReconnect);
+  if (!activeAccounts.length) {
+    return;
+  }
+
+  let contributorsCount: number = null;
+  for (const connectedAccount of activeAccounts) {
+    const postSettings = getPostSettings(connectedAccount);
+    if (postSettings[MicrobloggingPostType.NEW_CONTRIBUTOR]) {
+      await postNewContributorThanks(connectedAccount, activity);
+    }
+    if (postSettings[MicrobloggingPostType.MILESTONE]) {
+      contributorsCount ??= await countFinancialContributors(activity.CollectiveId);
+      await postMilestoneIfReached(connectedAccount, activity, contributorsCount);
+    }
+  }
+};
+
+/** Returns the boundaries of the month before `date` (UTC) */
+const getPreviousMonth = (date: Date): { startDate: Date; endDate: Date; period: string; periodKey: string } => {
+  const startDate = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth() - 1, 1));
+  const endDate = new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), 1));
+  return {
+    startDate,
+    endDate,
+    period: startDate.toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }),
+    periodKey: startDate.toISOString().slice(0, 7),
+  };
+};
+
+const getMonthlyStats = async (
+  collective: Collective,
+  { startDate, endDate, period }: { startDate: Date; endDate: Date; period: string },
+): Promise<MonthlyStats> => {
+  const [totalReceived, totalSpent, backersStats, activeContributors, balance] = await Promise.all([
+    collective.getTotalTransactions(startDate, endDate, 'donation', 'amount'),
+    collective.getTotalTransactions(startDate, endDate, 'expense', 'amount'),
+    collective.getBackersStats(startDate, endDate),
+    collective.getBackersCount({ since: startDate, until: endDate }),
+    collective.getBalance({ endDate }),
+  ]);
+
+  return {
+    period,
+    currency: collective.currency,
+    totalReceived,
+    totalSpent,
+    balance,
+    newContributors: backersStats.backers.new,
+    activeContributors: Number(activeContributors) || 0,
+  };
+};
+
+/** Posts the stats of the previous month for a connected account. Returns true if a post was published. */
+export const postMonthlyStats = async (
+  connectedAccount: ConnectedAccount,
+  collective: Collective,
+  { date = new Date() }: { date?: Date } = {},
+): Promise<boolean> => {
+  const month = getPreviousMonth(date);
+  const monthlyState = connectedAccount.data?.posts?.[MicrobloggingPostType.MONTHLY_STATS] || {};
+  if (
+    !getPostSettings(connectedAccount)[MicrobloggingPostType.MONTHLY_STATS] ||
+    connectedAccount.settings?.needsReconnect ||
+    collective.isPrivate ||
+    monthlyState.lastPeriod === month.periodKey
+  ) {
+    return false;
+  }
+
+  const stats = await getMonthlyStats(collective, month);
+  const limits = getService(connectedAccount.service).getTextLimits(connectedAccount);
+  const body = composeMonthlyStatsPost({ collectiveName: collective.name, stats });
+  const result = await publish(
+    connectedAccount,
+    {
+      text: buildPostText(
+        body,
+        getAccountUrl({ slug: collective.slug, urlPath: await collective.getUrlPath() }),
+        limits,
+      ),
+      inReplyToId: monthlyState.lastPostId || null, // Thread the monthly reports together
+      idempotencyKey: `opencollective-monthly-stats-${connectedAccount.id}-${month.periodKey}`,
+    },
+    MicrobloggingPostType.MONTHLY_STATS,
+  );
+
+  if (!result) {
+    return false;
+  }
+
+  await recordPost(connectedAccount, MicrobloggingPostType.MONTHLY_STATS, {
+    lastPeriod: month.periodKey,
+    lastPostId: result.id,
+    lastPostedAt: result.createdAt || new Date(),
+  });
+  return true;
+};
+
+/** Entry point of the monthly CRON job */
+export const postMonthlyStatsForAllConnectedAccounts = async ({ date = new Date() }: { date?: Date } = {}) => {
+  if (!isMicrobloggingPostsEnabled()) {
+    logger.info('Microblogging: automated posts are disabled, skipping monthly stats');
+    return { posted: 0 };
+  }
+
+  const connectedAccounts = await models.ConnectedAccount.findAll({
+    where: { service: MICROBLOGGING_SERVICES as Service[] },
+    include: [{ model: models.Collective, as: 'collective', required: true, where: { deactivatedAt: null } }],
+  });
+
+  let posted = 0;
+  for (const connectedAccount of connectedAccounts) {
+    try {
+      if (await postMonthlyStats(connectedAccount, connectedAccount.collective, { date })) {
+        posted++;
+      }
+    } catch (error) {
+      reportErrorToSentry(error, { extra: pick(connectedAccount, ['id', 'CollectiveId']) });
+    }
+  }
+
+  logger.info(`Microblogging: posted monthly stats for ${posted}/${connectedAccounts.length} connected accounts`);
+  return { posted };
+};
