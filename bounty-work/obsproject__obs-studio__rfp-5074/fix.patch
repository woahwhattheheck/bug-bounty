@@ -0,0 +1,78 @@
+#pragma once
+
+#include "../bridge/BridgeProtocol.hpp"
+#include "../bridge/IpcChannel.hpp"
+
+#include <pluginterfaces/base/smartpointer.h>
+
+#include <atomic>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace Steinberg {
+class FUnknown;
+class IPlugView;
+} // namespace Steinberg
+
+namespace obs_vst3 {
+
+class EditorWindow;
+class EventLoop;
+class MessageWriter;
+class PluginInstance;
+class SharedMemory;
+
+/*
+ * Serving mode of the bridge process: one plug-in instance driven by one OBS
+ * filter. Commands are handled on the main thread inside the event loop,
+ * audio blocks are processed on a dedicated audio thread.
+ */
+class HostSession {
+public:
+	HostSession(IpcChannel commandChannel, IpcChannel audioChannel, std::unique_ptr<SharedMemory> memory);
+	~HostSession();
+
+	HostSession(const HostSession &) = delete;
+	HostSession &operator=(const HostSession &) = delete;
+
+	int run();
+
+private:
+	void handleCommand(Command command, const std::vector<uint8_t> &payload);
+	void handleIdle();
+	void audioThreadMain();
+
+	Status handleHello(const std::vector<uint8_t> &payload, MessageWriter &reply, std::string &error);
+	Status handleLoadPlugin(const std::vector<uint8_t> &payload, MessageWriter &reply, std::string &error);
+	Status handleConfigure(const std::vector<uint8_t> &payload, MessageWriter &reply, std::string &error);
+	Status handleSetState(const std::vector<uint8_t> &payload, std::string &error);
+	Status handleGetState(MessageWriter &reply, std::string &error);
+	Status handleShowEditor(const std::vector<uint8_t> &payload, std::string &error);
+
+	void closeEditor();
+	void unloadPlugin();
+
+	IpcChannel commandChannel_;
+	IpcChannel audioChannel_;
+	std::unique_ptr<SharedMemory> memory_;
+	SharedAudioHeader *header_ = nullptr;
+
+	std::unique_ptr<EventLoop> eventLoop_;
+	Steinberg::IPtr<Steinberg::FUnknown> hostContext_;
+
+	/* Guards plugin_ and its configuration against the audio thread. */
+	std::mutex pluginMutex_;
+	std::unique_ptr<PluginInstance> plugin_;
+
+	Steinberg::IPtr<Steinberg::IPlugView> editorView_;
+	std::unique_ptr<EditorWindow> editorWindow_;
+	bool editorCloseRequested_ = false;
+
+	std::thread audioThread_;
+	std::atomic<bool> audioThreadRunning_{false};
+};
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/host/ModuleScanner.cpp b/plugins/obs-vst3/host/ModuleScanner.cpp
new file mode 100644
index 0000000..c01deee
--- /dev/null
+++ b/plugins/obs-vst3/host/ModuleScanner.cpp
@@ -0,0 +1,142 @@
+#include "ModuleScanner.hpp"
+#include "HostLog.hpp"
+#include "../bridge/MessageWriter.hpp"
+
+#include <pluginterfaces/vst/ivstaudioprocessor.h>
+#include <pluginterfaces/vst/ivstcomponent.h>
+#include <public.sdk/source/vst/hosting/module.h>
+#include <public.sdk/source/vst/moduleinfo/moduleinfoparser.h>
+
+#include <fstream>
+#include <sstream>
+
+namespace obs_vst3 {
+
+namespace {
+
+std::string joinSubCategories(const std::vector<std::string> &subCategories)
+{
+	std::string joined;
+	for (const std::string &category : subCategories) {
+		if (!joined.empty()) {
+			joined += "|";
+		}
+		joined += category;
+	}
+	return joined;
+}
+
+/* Normalizes a class ID to the representation used by VST3::UID::toString(). */
+std::string normalizeClassId(const std::string &classId)
+{
+	auto uid = VST3::UID::fromString(classId);
+	return uid ? uid->toString() : std::string();
+}
+
+} // namespace
+
+bool ModuleScanner::isEffect(const std::string &category, const std::string &subCategories)
+{
+	if (category != kVstAudioEffectClass) {
+		return false;
+	}
+
+	/* Instruments are out of scope, unless they also declare themselves as effects. */
+	std::string wrapped = "|" + subCategories + "|";
+	bool isInstrument = wrapped.find("|Instrument") != std::string::npos;
+	bool isFx = wrapped.find("|Fx") != std::string::npos;
+	return isFx || !isInstrument;
+}
+
+bool ModuleScanner::scanModuleInfo(const std::string &modulePath, std::vector<ScannedClass> &classes)
+{
+	auto infoPath = VST3::Hosting::Module::getModuleInfoPath(modulePath);
+	if (!infoPath) {
+		return false;
+	}
+
+	std::ifstream file(*infoPath, std::ios::binary);
+	if (!file) {
+		return false;
+	}
+
+	std::stringstream contents;
+	contents << file.rdbuf();
+	std::string json = contents.str();
+
+	std::stringstream parseErrors;
+	auto moduleInfo = Steinberg::ModuleInfoLib::parseJson(json, &parseErrors);
+	if (!moduleInfo) {
+		hostLog("Ignoring invalid moduleinfo.json of '%s': %s", modulePath.c_str(), parseErrors.str().c_str());
+		return false;
+	}
+
+	for (const Steinberg::ModuleInfo::ClassInfo &info : moduleInfo->classes) {
+		std::string subCategories = joinSubCategories(info.subCategories);
+		if (!isEffect(info.category, subCategories)) {
+			continue;
+		}
+
+		std::string classId = normalizeClassId(info.cid);
+		if (classId.empty()) {
+			continue;
+		}
+
+		classes.push_back({classId, info.name,
+				   info.vendor.empty() ? moduleInfo->factoryInfo.vendor : info.vendor, info.version,
+				   subCategories});
+	}
+
+	return true;
+}
+
+bool ModuleScanner::scanFactory(const std::string &modulePath, std::vector<ScannedClass> &classes, std::string &error)
+{
+	auto module = VST3::Hosting::Module::create(modulePath, error);
+	if (!module) {
+		if (error.empty()) {
+			error = "Could not load the module";
+		}
+		return false;
+	}
+
+	std::string factoryVendor = module->getFactory().info().vendor();
+	for (const VST3::Hosting::ClassInfo &info : module->getFactory().classInfos()) {
+		std::string subCategories = info.subCategoriesString();
+		if (!isEffect(info.category(), subCategories)) {
+			continue;
+		}
+
+		classes.push_back({info.ID().toString(), info.name(),
+				   info.vendor().empty() ? factoryVendor : info.vendor(), info.version(),
+				   subCategories});
+	}
+
+	return true;
+}
+
+bool ModuleScanner::scan(const std::string &modulePath, std::vector<ScannedClass> &classes, std::string &error)
+{
+	classes.clear();
+
+	if (scanModuleInfo(modulePath, classes)) {
+		return true;
+	}
+
+	classes.clear();
+	return scanFactory(modulePath, classes, error);
+}
+
+void ModuleScanner::serialize(const std::vector<ScannedClass> &classes, MessageWriter &writer)
+{
+	writer.writeUInt32(static_cast<uint32_t>(classes.size()));
+	for (const ScannedClass &scannedClass : classes) {
+		writer.writeString(scannedClass.classId);
+		writer.writeString(scannedClass.name);
+		writer.writeString(scannedClass.vendor);
+		writer.writeString(scannedClass.version);
+		writer.writeString(scannedClass.subCategories);
+	}
+}
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/host/ModuleScanner.hpp b/plugins/obs-vst3/host/ModuleScanner.hpp
