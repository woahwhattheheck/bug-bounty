diff --git a/.github/workflows/soroban-compatibility.yml b/.github/workflows/soroban-compatibility.yml
new file mode 100644
index 0000000..508a5f4
--- /dev/null
+++ b/.github/workflows/soroban-compatibility.yml
@@ -0,0 +1,42 @@
+name: Soroban 21 Compatibility
+
+on:
+  pull_request:
+    branches: [main]
+    paths:
+      - Cargo.toml
+      - Cargo.lock
+      - src/**
+      - .github/workflows/soroban-compatibility.yml
+  push:
+    branches: [main]
+    paths:
+      - Cargo.toml
+      - Cargo.lock
+      - src/**
+      - .github/workflows/soroban-compatibility.yml
+
+permissions:
+  contents: read
+
+jobs:
+  compatibility:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Install Rust
+        uses: dtolnay/rust-toolchain@stable
+        with:
+          targets: wasm32v1-none
+
+      - name: Test against the Soroban host simulator without warnings
+        env:
+          RUSTFLAGS: -D warnings
+        run: cargo test --lib
+
+      - name: Install Stellar CLI
+        run: cargo install --locked stellar-cli
+
+      - name: Build Soroban runtime artifact
+        run: stellar contract build
