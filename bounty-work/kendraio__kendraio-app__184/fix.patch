+    if (!isNil(value) && String(value).trim() !== '') {
+      fields.push({ name, value: String(value).trim() });
+    }
+  };
+  const addArtistCredit = (prefix: string, credit: any) => {
+    const names = isString(credit) ? [{ name: credit }] : castArray(credit || []);
+    names.forEach((artist: any, index: number) => {
+      const entry = isString(artist) ? { name: artist } : (artist || {});
+      add(`${prefix}.names.${index}.mbid`, isMbid(entry.mbid) ? entry.mbid : undefined);
+      add(`${prefix}.names.${index}.name`, entry.name);
+      add(`${prefix}.names.${index}.artist.name`, entry.artistName);
+      if (!isNil(entry.joinPhrase) && entry.joinPhrase !== '') {
+        // join phrases are significant whitespace (" & "), so they are not trimmed
+        fields.push({ name: `${prefix}.names.${index}.join_phrase`, value: String(entry.joinPhrase) });
+      }
+    });
+  };
