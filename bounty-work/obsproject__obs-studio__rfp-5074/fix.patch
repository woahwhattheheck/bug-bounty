+cmake_minimum_required(VERSION 3.28...3.30)
+
+option(ENABLE_VST3 "Enable building OBS with VST3 plugin" ON)
+
+if(NOT ENABLE_VST3)
+  return()
+endif()
+
+if(OS_WINDOWS OR OS_MACOS)
+  find_package(VST3SDK 3.8 REQUIRED)
+else()
+  # Linux distributions do not package the SDK yet; set VST3SDK_ROOT to a checkout of it.
+  find_package(VST3SDK 3.8)
+  if(NOT VST3SDK_FOUND)
+    message(STATUS "VST3 SDK not found, obs-vst3 will not be built (set VST3SDK_ROOT to enable it)")
+    return()
+  endif()
+endif()
+
+# Code shared by the module and the bridge process (IPC channels, shared memory, messages)
+add_library(obs-vst3-bridge OBJECT)
+target_sources(
+  obs-vst3-bridge
+  PRIVATE
+    $<$<PLATFORM_ID:Windows>:bridge/IpcChannel_Windows.cpp>
+    $<$<PLATFORM_ID:Windows>:bridge/SharedMemory_Windows.cpp>
+    $<$<NOT:$<PLATFORM_ID:Windows>>:bridge/IpcChannel_Posix.cpp>
+    $<$<NOT:$<PLATFORM_ID:Windows>>:bridge/SharedMemory_Posix.cpp>
+    bridge/BridgeProtocol.hpp
+    bridge/IpcChannel.cpp
+    bridge/IpcChannel.hpp
+    bridge/MessageReader.cpp
+    bridge/MessageReader.hpp
+    bridge/MessageWriter.cpp
+    bridge/MessageWriter.hpp
+    bridge/SharedMemory.hpp
+)
+set_target_properties(obs-vst3-bridge PROPERTIES FOLDER plugins/obs-vst3 POSITION_INDEPENDENT_CODE ON)
+
+# Out-of-process plug-in host (obs-vst3-host)
+add_subdirectory(host)
+
+add_library(obs-vst3 MODULE)
+add_library(OBS::vst3 ALIAS obs-vst3)
+
+target_sources(
+  obs-vst3
+  PRIVATE
+    $<$<PLATFORM_ID:Darwin>:PluginCatalog_macOS.cpp>
+    $<$<PLATFORM_ID:Linux,FreeBSD,OpenBSD>:PluginCatalog_Linux.cpp>
+    $<$<PLATFORM_ID:Windows>:HostProcess_Windows.cpp>
+    $<$<PLATFORM_ID:Windows>:PluginCatalog_Windows.cpp>
+    $<$<NOT:$<PLATFORM_ID:Windows>>:HostProcess_Posix.cpp>
+    Base64.cpp
+    Base64.hpp
+    BridgeClient.cpp
+    BridgeClient.hpp
+    HostProcess.hpp
+    obs-vst3.cpp
+    PluginCatalog.cpp
+    PluginCatalog.hpp
+    SidechainInput.cpp
+    SidechainInput.hpp
+    VST3Filter.cpp
+    VST3Filter.hpp
+)
+
+target_link_libraries(
+  obs-vst3
+  PRIVATE OBS::libobs obs-vst3-bridge $<$<PLATFORM_ID:Windows>:shell32> $<$<PLATFORM_ID:Windows>:ole32>
+)
+
+add_dependencies(obs-vst3 obs-vst3-host)
+
+if(OS_WINDOWS)
+  configure_file(cmake/windows/obs-module.rc.in obs-vst3.rc)
+  target_sources(obs-vst3 PRIVATE obs-vst3.rc)
+endif()
+
+set_target_properties_obs(obs-vst3 PROPERTIES FOLDER plugins PREFIX "")
diff --git a/plugins/obs-vst3/HostProcess.hpp b/plugins/obs-vst3/HostProcess.hpp
new file mode 100644
index 0000000..927e964
--- /dev/null
+++ b/plugins/obs-vst3/HostProcess.hpp
@@ -0,0 +1,53 @@
+#pragma once
+
+#include "bridge/IpcChannel.hpp"
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace obs_vst3 {
+
+class SharedMemory;
+
+/*
+ * A running obs-vst3-host bridge process.
+ *
+ * launch() creates the command and audio channels, starts the executable with
+ * the bridge ends of both channels (and optionally the shared memory region)
+ * as inherited handles, and returns the module ends to the caller.
+ * Destroying the object forcefully terminates the process if it is still
+ * running, so a hung plug-in can never outlive its filter.
+ */
+class HostProcess {
+public:
+	static std::unique_ptr<HostProcess> launch(const std::string &executable,
+						   const std::vector<std::string> &arguments,
+						   const SharedMemory *sharedMemory, IpcChannel &commandChannel,
+						   IpcChannel &audioChannel, std::string &error);
+
+	~HostProcess();
+
+	HostProcess(const HostProcess &) = delete;
+	HostProcess &operator=(const HostProcess &) = delete;
+
+	bool isRunning();
+	bool waitForExit(int timeoutMs);
+	void terminate();
+	int64_t processId() const;
+
+private:
+	HostProcess() = default;
+
+#ifdef _WIN32
+	void *process_ = nullptr;
+	void *job_ = nullptr;
+	uint32_t processId_ = 0;
+#else
+	int processId_ = -1;
+	bool reaped_ = false;
+#endif
+};
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/HostProcess_Posix.cpp b/plugins/obs-vst3/HostProcess_Posix.cpp
new file mode 100644
index 0000000..9378e64
--- /dev/null
+++ b/plugins/obs-vst3/HostProcess_Posix.cpp
@@ -0,0 +1,207 @@
+#include "HostProcess.hpp"
+#include "bridge/SharedMemory.hpp"
+
+#include <cerrno>
+#include <chrono>
+#include <cstring>
+#include <thread>
+
+#include <fcntl.h>
+#include <signal.h>
+#include <spawn.h>
+#include <sys/socket.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+extern char **environ;
+
+namespace obs_vst3 {
+
+namespace {
+
+/* Child ends are moved above this number before being mapped to 3, 4 and 5. */
+constexpr int kHighDescriptorBase = 64;
+
+bool createSocketPair(int (&descriptors)[2], std::string &error)
+{
+#ifdef SOCK_CLOEXEC
+	int result = socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, descriptors);
+#else
+	int result = socketpair(AF_UNIX, SOCK_STREAM, 0, descriptors);
+	if (result == 0) {
+		fcntl(descriptors[0], F_SETFD, FD_CLOEXEC);
+		fcntl(descriptors[1], F_SETFD, FD_CLOEXEC);
+	}
+#endif
+
+	if (result != 0) {
+		error = std::string("socketpair failed: ") + std::strerror(errno);
+		return false;
+	}
+
+	return true;
+}
+
+int duplicateHigh(int descriptor)
+{
+	return fcntl(descriptor, F_DUPFD_CLOEXEC, kHighDescriptorBase);
+}
+
+void closeDescriptor(int &descriptor)
+{
+	if (descriptor >= 0) {
+		close(descriptor);
+		descriptor = -1;
+	}
+}
+
+} // namespace
+
+std::unique_ptr<HostProcess> HostProcess::launch(const std::string &executable,
+						 const std::vector<std::string> &arguments,
+						 const SharedMemory *sharedMemory, IpcChannel &commandChannel,
+						 IpcChannel &audioChannel, std::string &error)
+{
+	int commandPair[2] = {-1, -1};
+	int audioPair[2] = {-1, -1};
+
+	if (!createSocketPair(commandPair, error)) {
+		return nullptr;
+	}
+
+	if (!createSocketPair(audioPair, error)) {
+		closeDescriptor(commandPair[0]);
+		closeDescriptor(commandPair[1]);
+		return nullptr;
+	}
+
+	int childCommand = duplicateHigh(commandPair[1]);
+	int childAudio = duplicateHigh(audioPair[1]);
+	int childMemory = sharedMemory ? duplicateHigh(sharedMemory->nativeHandle()) : -1;
+	closeDescriptor(commandPair[1]);
+	closeDescriptor(audioPair[1]);
+
+	std::vector<std::string> argumentStorage;
+	argumentStorage.push_back(executable);
+	argumentStorage.push_back("--command");
+	argumentStorage.push_back(std::to_string(kChildCommandFd));
+	argumentStorage.push_back("--audio");
+	argumentStorage.push_back(std::to_string(kChildAudioFd));
+	if (sharedMemory) {
+		argumentStorage.push_back("--shared-memory");
+		argumentStorage.push_back(std::to_string(kChildSharedMemoryFd));
+		argumentStorage.push_back("--shared-memory-size");
+		argumentStorage.push_back(std::to_string(sharedMemory->size()));
+	}
+	argumentStorage.insert(argumentStorage.end(), arguments.begin(), arguments.end());
+
+	std::vector<char *> argv;
+	for (std::string &argument : argumentStorage) {
+		argv.push_back(argument.data());
+	}
+	argv.push_back(nullptr);
+
+	posix_spawn_file_actions_t actions;
+	posix_spawn_file_actions_init(&actions);
+	posix_spawn_file_actions_adddup2(&actions, childCommand, kChildCommandFd);
+	posix_spawn_file_actions_adddup2(&actions, childAudio, kChildAudioFd);
+	if (childMemory >= 0) {
+		posix_spawn_file_actions_adddup2(&actions, childMemory, kChildSharedMemoryFd);
+	}
+#if defined(__GLIBC__) && (__GLIBC__ > 2 || (__GLIBC__ == 2 && __GLIBC_MINOR__ >= 34))
+	/* Do not leak unrelated OBS descriptors into the bridge process. */
+	posix_spawn_file_actions_addclosefrom_np(&actions, kChildSharedMemoryFd + 1);
+#endif
+
+	posix_spawnattr_t attributes;
+	posix_spawnattr_init(&attributes);
+	sigset_t signals;
+	sigemptyset(&signals);
+	posix_spawnattr_setsigmask(&attributes, &signals);
+	sigaddset(&signals, SIGPIPE);
+	posix_spawnattr_setsigdefault(&attributes, &signals);
+	short flags = POSIX_SPAWN_SETSIGMASK | POSIX_SPAWN_SETSIGDEF;
+#ifdef POSIX_SPAWN_CLOEXEC_DEFAULT
+	/* macOS: only the descriptors mapped through dup2 above are inherited. */
+	flags |= POSIX_SPAWN_CLOEXEC_DEFAULT;
+#endif
+	posix_spawnattr_setflags(&attributes, flags);
+
+	pid_t pid = -1;
+	int result = posix_spawn(&pid, executable.c_str(), &actions, &attributes, argv.data(), environ);
+
+	posix_spawn_file_actions_destroy(&actions);
+	posix_spawnattr_destroy(&attributes);
+	closeDescriptor(childCommand);
+	closeDescriptor(childAudio);
+	closeDescriptor(childMemory);
+
+	if (result != 0) {
+		error = "Failed to start '" + executable + "': " + std::strerror(result);
+		closeDescriptor(commandPair[0]);
+		closeDescriptor(audioPair[0]);
+		return nullptr;
+	}
+
+	commandChannel = IpcChannel(commandPair[0]);
+	audioChannel = IpcChannel(audioPair[0]);
+
+	std::unique_ptr<HostProcess> process(new HostProcess());
+	process->processId_ = pid;
+	return process;
+}
+
+HostProcess::~HostProcess()
+{
+	terminate();
+}
+
+int64_t HostProcess::processId() const
+{
+	return processId_;
+}
+
+bool HostProcess::isRunning()
+{
+	if (processId_ <= 0 || reaped_) {
+		return false;
+	}
+
+	int status = 0;
+	pid_t result = waitpid(processId_, &status, WNOHANG);
+	if (result == processId_ || (result < 0 && errno == ECHILD)) {
+		reaped_ = true;
+		return false;
+	}
+
+	return true;
+}
+
+bool HostProcess::waitForExit(int timeoutMs)
+{
+	auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(timeoutMs);
+
+	while (isRunning()) {
+		if (std::chrono::steady_clock::now() >= deadline) {
+			return false;
+		}
+		std::this_thread::sleep_for(std::chrono::milliseconds(5));
+	}
+
+	return true;
+}
+
+void HostProcess::terminate()
+{
+	if (!isRunning()) {
+		return;
+	}
+
+	kill(processId_, SIGKILL);
+	int status = 0;
+	while (waitpid(processId_, &status, 0) < 0 && errno == EINTR) {
+	}
+	reaped_ = true;
+}
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/HostProcess_Windows.cpp b/plugins/obs-vst3/HostProcess_Windows.cpp
new file mode 100644
index 0000000..e61431b
--- /dev/null
+++ b/plugins/obs-vst3/HostProcess_Windows.cpp
@@ -0,0 +1,237 @@
+#include "HostProcess.hpp"
+#include "bridge/SharedMemory.hpp"
+
+#include <util/bmem.h>
+#include <util/platform.h>
+
+#include <atomic>
+#include <cstdint>
+
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+
+namespace obs_vst3 {
+
+namespace {
+
+std::wstring toWide(const std::string &value)
+{
+	wchar_t *converted = nullptr;
+	os_utf8_to_wcs_ptr(value.c_str(), value.size(), &converted);
+	std::wstring result = converted ? converted : L"";
+	bfree(converted);
+	return result;
+}
+
+/* Quotes one argument following the rules used by CommandLineToArgvW. */
+std::wstring quoteArgument(const std::wstring &argument)
+{
+	if (!argument.empty() && argument.find_first_of(L" \t\n\v\"") == std::wstring::npos) {
+		return argument;
+	}
+
+	std::wstring quoted = L"\"";
+	for (auto it = argument.begin();; ++it) {
+		size_t backslashes = 0;
+		while (it != argument.end() && *it == L'\\') {
+			++it;
+			++backslashes;
+		}
+
+		if (it == argument.end()) {
+			quoted.append(backslashes * 2, L'\\');
+			break;
+		}
+
+		if (*it == L'"') {
+			quoted.append(backslashes * 2 + 1, L'\\');
+		} else {
+			quoted.append(backslashes, L'\\');
+		}
+		quoted.push_back(*it);
+	}
+	quoted.push_back(L'"');
+	return quoted;
+}
+
+std::wstring handleArgument(HANDLE handle)
+{
+	return std::to_wstring(reinterpret_cast<uintptr_t>(handle));
+}
+
+/*
+ * Creates a connected named pipe pair. The module keeps the server end, the
+ * client end is opened inheritable so it can be handed to the bridge process.
+ */
+bool createPipePair(HANDLE &serverEnd, HANDLE &clientEnd, std::string &error)
+{
+	static std::atomic<unsigned> counter{0};
+
+	std::wstring name = L"\\\\.\\pipe\\obs-vst3-" + std::to_wstring(GetCurrentProcessId()) + L"-" +
+			    std::to_wstring(counter++) + L"-" + std::to_wstring(GetTickCount64());
+
+	serverEnd = CreateNamedPipeW(name.c_str(),
+				     PIPE_ACCESS_DUPLEX | FILE_FLAG_OVERLAPPED | FILE_FLAG_FIRST_PIPE_INSTANCE,
+				     PIPE_TYPE_BYTE | PIPE_READMODE_BYTE | PIPE_WAIT | PIPE_REJECT_REMOTE_CLIENTS, 1,
+				     64 * 1024, 64 * 1024, 0, nullptr);
+	if (serverEnd == INVALID_HANDLE_VALUE) {
+		error = "CreateNamedPipe failed: " + std::to_string(GetLastError());
+		return false;
+	}
+
+	SECURITY_ATTRIBUTES inheritable = {sizeof(inheritable), nullptr, TRUE};
+	clientEnd = CreateFileW(name.c_str(), GENERIC_READ | GENERIC_WRITE, 0, &inheritable, OPEN_EXISTING,
+				FILE_FLAG_OVERLAPPED, nullptr);
+	if (clientEnd == INVALID_HANDLE_VALUE) {
+		error = "Opening the bridge pipe failed: " + std::to_string(GetLastError());
+		CloseHandle(serverEnd);
+		serverEnd = INVALID_HANDLE_VALUE;
+		return false;
+	}
+
+	/* The client already connected through CreateFile above. */
+	OVERLAPPED overlapped = {};
+	overlapped.hEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+	if (!ConnectNamedPipe(serverEnd, &overlapped)) {
+		DWORD lastError = GetLastError();
+		if (lastError == ERROR_IO_PENDING) {
+			DWORD transferred = 0;
+			GetOverlappedResult(serverEnd, &overlapped, &transferred, TRUE);
+		}
+	}
+	CloseHandle(overlapped.hEvent);
+
+	return true;
+}
+
+void closeHandle(HANDLE &handle)
+{
+	if (handle && handle != INVALID_HANDLE_VALUE) {
+		CloseHandle(handle);
+	}
+	handle = INVALID_HANDLE_VALUE;
+}
+
+} // namespace
+
+std::unique_ptr<HostProcess> HostProcess::launch(const std::string &executable,
+						 const std::vector<std::string> &arguments,
+						 const SharedMemory *sharedMemory, IpcChannel &commandChannel,
+						 IpcChannel &audioChannel, std::string &error)
+{
+	HANDLE commandServer = INVALID_HANDLE_VALUE;
+	HANDLE commandClient = INVALID_HANDLE_VALUE;
+	HANDLE audioServer = INVALID_HANDLE_VALUE;
+	HANDLE audioClient = INVALID_HANDLE_VALUE;
+
+	if (!createPipePair(commandServer, commandClient, error)) {
+		return nullptr;
+	}
+	if (!createPipePair(audioServer, audioClient, error)) {
+		closeHandle(commandServer);
+		closeHandle(commandClient);
+		return nullptr;
+	}
+
+	std::wstring commandLine = quoteArgument(toWide(executable));
+	commandLine += L" --command " + handleArgument(commandClient);
+	commandLine += L" --audio " + handleArgument(audioClient);
+	if (sharedMemory) {
+		commandLine += L" --shared-memory " + handleArgument(sharedMemory->nativeHandle());
+		commandLine += L" --shared-memory-size " + std::to_wstring(sharedMemory->size());
+	}
+	for (const std::string &argument : arguments) {
+		commandLine += L" " + quoteArgument(toWide(argument));
+	}
+
+	/* Only the three handles listed here are inherited by the bridge. */
+	HANDLE inherited[3] = {commandClient, audioClient, sharedMemory ? sharedMemory->nativeHandle() : nullptr};
+	DWORD inheritedCount = sharedMemory ? 3 : 2;
+
+	SIZE_T attributeSize = 0;
+	InitializeProcThreadAttributeList(nullptr, 1, 0, &attributeSize);
+	std::vector<uint8_t> attributeStorage(attributeSize);
+	auto attributeList = reinterpret_cast<LPPROC_THREAD_ATTRIBUTE_LIST>(attributeStorage.data());
+	InitializeProcThreadAttributeList(attributeList, 1, 0, &attributeSize);
+	UpdateProcThreadAttribute(attributeList, 0, PROC_THREAD_ATTRIBUTE_HANDLE_LIST, inherited,
+				  inheritedCount * sizeof(HANDLE), nullptr, nullptr);
+
+	STARTUPINFOEXW startupInfo = {};
+	startupInfo.StartupInfo.cb = sizeof(startupInfo);
+	startupInfo.lpAttributeList = attributeList;
+
+	PROCESS_INFORMATION processInfo = {};
+	std::wstring executableWide = toWide(executable);
+	BOOL created = CreateProcessW(executableWide.c_str(), commandLine.data(), nullptr, nullptr, TRUE,
+				      CREATE_SUSPENDED | CREATE_NO_WINDOW | EXTENDED_STARTUPINFO_PRESENT, nullptr,
+				      nullptr, &startupInfo.StartupInfo, &processInfo);
+	DWORD createError = GetLastError();
+
+	DeleteProcThreadAttributeList(attributeList);
+	closeHandle(commandClient);
+	closeHandle(audioClient);
+
+	if (!created) {
+		error = "Failed to start '" + executable + "': " + std::to_string(createError);
+		closeHandle(commandServer);
+		closeHandle(audioServer);
+		return nullptr;
+	}
+
+	std::unique_ptr<HostProcess> process(new HostProcess());
+	process->process_ = processInfo.hProcess;
+	process->processId_ = processInfo.dwProcessId;
+
+	/* Kill the bridge together with OBS, even if OBS itself crashes. */
+	process->job_ = CreateJobObjectW(nullptr, nullptr);
+	if (process->job_) {
+		JOBOBJECT_EXTENDED_LIMIT_INFORMATION limits = {};
+		limits.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+		SetInformationJobObject(process->job_, JobObjectExtendedLimitInformation, &limits, sizeof(limits));
+		AssignProcessToJobObject(process->job_, processInfo.hProcess);
+	}
+
+	ResumeThread(processInfo.hThread);
+	CloseHandle(processInfo.hThread);
+
+	commandChannel = IpcChannel(commandServer);
+	audioChannel = IpcChannel(audioServer);
+	return process;
+}
+
+HostProcess::~HostProcess()
+{
+	terminate();
+
+	if (process_) {
+		CloseHandle(process_);
+	}
+	if (job_) {
+		CloseHandle(job_);
+	}
+}
+
+int64_t HostProcess::processId() const
+{
+	return processId_;
+}
+
+bool HostProcess::isRunning()
+{
+	return process_ && WaitForSingleObject(process_, 0) == WAIT_TIMEOUT;
+}
+
+bool HostProcess::waitForExit(int timeoutMs)
+{
+	return !process_ || WaitForSingleObject(process_, static_cast<DWORD>(timeoutMs)) == WAIT_OBJECT_0;
+}
+
+void HostProcess::terminate()
+{
+	if (isRunning()) {
+		TerminateProcess(process_, 1);
+		WaitForSingleObject(process_, INFINITE);
+	}
+}
+
+} // namespace obs_vst3
