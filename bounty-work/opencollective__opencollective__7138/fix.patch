+import { formatCurrency } from '../utils';
+
+import { neutralizeUserInput } from './text';
+
+/** Number of financial contributors celebrated with a milestone post */
+const CONTRIBUTORS_MILESTONES = [10, 25, 50, 100, 250, 500, 1000, 2500, 5000, 10000] as const;
+
+/** Returns the highest milestone reached with `count` contributors, or 0 */
+export const getHighestMilestoneReached = (count: number): number => {
+  return CONTRIBUTORS_MILESTONES.filter(milestone => count >= milestone).pop() || 0;
+};
+
+const formatInteger = (value: number): string => value.toLocaleString('en-US');
+
+const formatAmount = (amountInCents: number, currency: string): string => {
+  // Drop the decimals for round amounts (e.g. "$10" rather than "$10.00")
+  const precision = amountInCents % 100 === 0 ? 0 : 2;
+  return formatCurrency(amountInCents, currency, precision);
+};
+
+const INTERVAL_SUFFIXES = { month: '/month', year: '/year' };
+
+export const composeNewContributorPost = ({
+  collectiveName,
+  contributorName,
+  contributorHandle,
+  isIncognito,
+  amount,
+  currency,
+  interval,
+}: {
+  collectiveName: string;
+  contributorName?: string | null;
+  /** Fediverse handle of the contributor (`@user@domain`), used to mention them */
+  contributorHandle?: string | null;
+  isIncognito?: boolean;
+  /** Amount in cents */
+  amount?: number | null;
+  currency?: string | null;
+  interval?: string | null;
+}): string => {
+  const collective = neutralizeUserInput(collectiveName);
+  let contributor: string;
+  if (isIncognito) {
+    contributor = 'an anonymous financial contributor';
+  } else if (contributorHandle) {
+    contributor = contributorName
+      ? `${neutralizeUserInput(contributorName)} (${contributorHandle})`
+      : contributorHandle;
+  } else {
+    contributor = neutralizeUserInput(contributorName) || 'a new financial contributor';
+  }
+
+  const contribution =
+    amount > 0 && currency
+      ? `${formatAmount(amount, currency)}${INTERVAL_SUFFIXES[interval] || ''} contribution`
+      : 'contribution';
+
+  return `💖 Welcome to ${contributor}, who just joined ${collective} as a financial contributor!\n\nThank you for your ${contribution} 🙏`;
+};
+
+export const composeMilestonePost = ({ collectiveName, milestone }: { collectiveName: string; milestone: number }) => {
+  const collective = neutralizeUserInput(collectiveName);
+  return `🎉 ${collective} just reached ${formatInteger(milestone)} financial contributors! 🙌\n\nThank you all for your support. Join them:`;
+};
+
+export type MonthlyStats = {
+  /** e.g. "September 2026" */
+  period: string;
+  currency: string;
+  /** Amounts in cents */
+  totalReceived: number;
+  totalSpent: number;
+  balance: number;
+  newContributors: number;
+  activeContributors: number;
+};
+
+export const composeMonthlyStatsPost = ({ collectiveName, stats }: { collectiveName: string; stats: MonthlyStats }) => {
+  const collective = neutralizeUserInput(collectiveName);
+  const { currency } = stats;
+  const balance = formatAmount(stats.balance, currency);
+  if (!stats.totalReceived) {
+    return `📊 ${collective} in ${stats.period}: no new contributions this month.\n\nOur current balance is ${balance}. Become a financial contributor! 😃`;
+  }
+
+  const lines = [
+    `📊 ${collective} in ${stats.period}:`,
+    '',
+    `💰 ${formatAmount(stats.totalReceived, currency)} received from ${formatInteger(stats.activeContributors)} financial ${
+      stats.activeContributors === 1 ? 'contributor' : 'contributors'
+    }`,
+  ];
+
+  if (stats.newContributors > 0) {
+    lines.push(
+      `👋 ${formatInteger(stats.newContributors)} new ${stats.newContributors === 1 ? 'contributor' : 'contributors'}`,
+    );
+  }
+  if (stats.totalSpent) {
+    lines.push(`💸 ${formatAmount(Math.abs(stats.totalSpent), currency)} spent`);
+  }
+
+  lines.push(`🏦 Current balance: ${balance}`, '', 'Thank you! 🙏');
+  return lines.join('\n');
+};
