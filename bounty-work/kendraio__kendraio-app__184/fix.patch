+    add('release_group', release.releaseGroup);
+  } else {
+    toList(release.type).forEach(type => add('type', type));
+  }
+  add('comment', release.comment);
+  add('annotation', release.annotation);
+  add('barcode', release.barcode);
+  add('language', release.language);
+  add('script', release.script);
+  add('status', release.status);
+  add('packaging', release.packaging);
