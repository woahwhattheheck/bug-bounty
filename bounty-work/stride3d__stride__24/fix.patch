+
+using System;
+using System.Linq;
+using Xunit;
+using Stride.Core.Mathematics;
+using Stride.Core.Threading;
+using Stride.Graphics;
+using Stride.Rendering;
+using Stride.Rendering.Decals;
+
+namespace Stride.Engine.Tests
+{
+    /// <summary>
+    /// Tests for <see cref="DecalComponent"/>, <see cref="DecalRenderProcessor"/> and the CPU side of decal rendering.
+    /// </summary>
+    public class TestDecals
+    {
+        private const float Epsilon = 1.0e-4f;
+
+        // Same as DecalProjection.sdsl: saturate(cos(angle) * Y + Z)
+        private static float AngleFade(Vector4 parameters, float angleInDegrees)
+            => Math.Clamp(MathF.Cos(MathUtil.DegreesToRadians(angleInDegrees)) * parameters.Y + parameters.Z, 0.0f, 1.0f);
+
+        // Same as DecalProjection.sdsl: saturate((z + 0.5) * W), z being the local position in the volume along the projection axis
+        private static float DepthFade(Vector4 parameters, float localZ)
+            => Math.Clamp((localZ + 0.5f) * parameters.W, 0.0f, 1.0f);
+
+        private static void AssertNear(Vector3 expected, Vector3 actual)
+        {
+            Assert.True((expected - actual).Length() < Epsilon, $"Expected {expected} but got {actual}");
+        }
+
+        [Fact]
+        public void AngleFadeGoesFromStartToEndAngle()
+        {
+            var parameters = RenderDecal.ComputeShaderParameters(0.75f, 60.0f, 85.0f, 0.0f);
+
+            Assert.Equal(0.75f, parameters.X);
+            Assert.Equal(1.0f, AngleFade(parameters, 0.0f), Epsilon);
+            Assert.Equal(1.0f, AngleFade(parameters, 60.0f), Epsilon);
+            Assert.InRange(AngleFade(parameters, 72.5f), 0.1f, 0.9f);
+            Assert.Equal(0.0f, AngleFade(parameters, 85.0f), Epsilon);
+            Assert.Equal(0.0f, AngleFade(parameters, 120.0f), Epsilon);
+        }
+
+        [Fact]
+        public void AngleFadeWithoutRangeCutsSharply()
+        {
+            var parameters = RenderDecal.ComputeShaderParameters(1.0f, 45.0f, 45.0f, 0.0f);
+            Assert.Equal(1.0f, AngleFade(parameters, 44.0f), Epsilon);
+            Assert.Equal(0.0f, AngleFade(parameters, 46.0f), Epsilon);
+
+            // An end angle smaller than the start angle behaves as a sharp cut at the start angle
+            var reversed = RenderDecal.ComputeShaderParameters(1.0f, 45.0f, 30.0f, 0.0f);
+            Assert.Equal(1.0f, AngleFade(reversed, 44.0f), Epsilon);
+            Assert.Equal(0.0f, AngleFade(reversed, 46.0f), Epsilon);
+        }
+
+        [Fact]
+        public void AngleFadeBeyondNinetyDegreesReachesSurfacesFacingAway()
+        {
+            var parameters = RenderDecal.ComputeShaderParameters(1.0f, 150.0f, 180.0f, 0.0f);
+            Assert.Equal(1.0f, AngleFade(parameters, 120.0f), Epsilon);
+            Assert.InRange(AngleFade(parameters, 170.0f), 0.0f, 0.9f);
+        }
+
+        [Fact]
+        public void DepthFadeGoesTowardTheFarEndOfTheVolume()
+        {
+            var parameters = RenderDecal.ComputeShaderParameters(1.0f, 60.0f, 85.0f, 0.5f);
+            Assert.Equal(0.0f, DepthFade(parameters, -0.5f), Epsilon);
+            Assert.Equal(0.5f, DepthFade(parameters, -0.25f), Epsilon);
+            Assert.Equal(1.0f, DepthFade(parameters, 0.0f), Epsilon);
+            Assert.Equal(1.0f, DepthFade(parameters, 0.5f), Epsilon);
+
+            var sharp = RenderDecal.ComputeShaderParameters(1.0f, 60.0f, 85.0f, 0.0f);
+            Assert.Equal(1.0f, DepthFade(sharp, -0.499f), Epsilon);
+        }
+
+        [Fact]
+        public void ShaderParametersAreClamped()
+        {
+            Assert.Equal(1.0f, RenderDecal.ComputeShaderParameters(2.0f, 60.0f, 85.0f, 0.0f).X);
+            Assert.Equal(0.0f, RenderDecal.ComputeShaderParameters(-1.0f, 60.0f, 85.0f, 0.0f).X);
+
+            var parameters = RenderDecal.ComputeShaderParameters(1.0f, -30.0f, 400.0f, 3.0f);
+            Assert.True(float.IsFinite(parameters.Y) && float.IsFinite(parameters.Z) && float.IsFinite(parameters.W));
+            Assert.Equal(1.0f, AngleFade(parameters, 0.0f), Epsilon);
+            Assert.Equal(1.0f, DepthFade(parameters, 0.5f), Epsilon);
+        }
+
+        [Fact]
+        public void WorldMatrixMapsTheUnitCubeToTheVolume()
+        {
+            var entityWorld = Matrix.RotationY(MathUtil.PiOverTwo) * Matrix.Translation(10.0f, 2.0f, -3.0f);
+            var world = RenderDecal.ComputeWorldMatrix(new Vector3(2.0f, 1.0f, 0.5f), entityWorld);
+
+            // Center of the projector face, and a corner of the far face
+            AssertNear(Vector3.TransformCoordinate(new Vector3(0.0f, 0.0f, 0.25f), entityWorld), Vector3.TransformCoordinate(new Vector3(0.0f, 0.0f, 0.5f), world));
+            AssertNear(Vector3.TransformCoordinate(new Vector3(1.0f, 0.5f, -0.25f), entityWorld), Vector3.TransformCoordinate(new Vector3(0.5f, 0.5f, -0.5f), world));
+        }
+
+        [Fact]
+        public void BoundingBoxContainsTheRotatedVolume()
+        {
+            var world = RenderDecal.ComputeWorldMatrix(new Vector3(2.0f, 1.0f, 1.0f), Matrix.RotationZ(MathUtil.PiOverFour) * Matrix.Translation(1.0f, 2.0f, 3.0f));
+            var boundingBox = RenderDecal.ComputeBoundingBox(world);
+
+            AssertNear(new Vector3(1.0f, 2.0f, 3.0f), boundingBox.Center);
+            var halfDiagonal = 1.5f * MathF.Sqrt(0.5f);
+            AssertNear(new Vector3(halfDiagonal, halfDiagonal, 0.5f), boundingBox.Extent);
+        }
+
+        [Fact]
+        public void ProcessorCopiesTheComponentToTheRenderDecal()
+        {
+            var component = new DecalComponent
+            {
+                Size = new Vector3(2.0f, 3.0f, 4.0f),
+                Opacity = 0.5f,
+                AngleFadeStart = 10.0f,
+                AngleFadeEnd = 20.0f,
+                DepthFade = 0.3f,
+                SortOrder = -2,
+                RenderGroup = RenderGroup.Group5,
+            };
+            var entity = new Entity { component };
+            entity.Transform.Position = new Vector3(1.0f, 2.0f, 3.0f);
+            entity.Transform.UpdateWorldMatrix();
+
+            var renderDecal = new RenderDecal();
+            var materialPass = new MaterialPass();
+            DecalRenderProcessor.UpdateRenderDecal(component, renderDecal, materialPass, null);
+
+            Assert.True(renderDecal.Enabled);
+            Assert.False(renderDecal.IsShadowCaster);
+            Assert.False(renderDecal.IsScalingNegative);
+            Assert.Same(materialPass, renderDecal.MaterialPass);
+            Assert.Equal(RenderGroup.Group5, renderDecal.RenderGroup);
+            Assert.Equal(RenderDecal.ComputeWorldMatrix(component.Size, entity.Transform.WorldMatrix), renderDecal.World);
+            AssertNear(new Vector3(1.0f, 2.0f, 3.0f), renderDecal.BoundingBox.Center);
+            AssertNear(new Vector3(1.0f, 1.5f, 2.0f), renderDecal.BoundingBox.Extent);
+            Assert.Equal(0.5f, renderDecal.Opacity);
+            Assert.Equal(10.0f, renderDecal.AngleFadeStart);
+            Assert.Equal(20.0f, renderDecal.AngleFadeEnd);
+            Assert.Equal(0.3f, renderDecal.DepthFade);
+            Assert.Equal(-2, renderDecal.SortOrder);
+
+            // A mirrored decal has its volume turned inside out
+            entity.Transform.Scale = new Vector3(-1.0f, 1.0f, 1.0f);
+            entity.Transform.UpdateWorldMatrix();
+            DecalRenderProcessor.UpdateRenderDecal(component, renderDecal, materialPass, null);
+            Assert.True(renderDecal.IsScalingNegative);
+            Assert.True(renderDecal.Enabled);
+
+            // A flat volume does not project anything
+            component.Size = new Vector3(1.0f, 1.0f, 0.0f);
+            DecalRenderProcessor.UpdateRenderDecal(component, renderDecal, materialPass, null);
+            Assert.False(renderDecal.Enabled);
+
+            // Neither does a disabled component
+            component.Size = Vector3.One;
+            component.Enabled = false;
+            DecalRenderProcessor.UpdateRenderDecal(component, renderDecal, materialPass, null);
+            Assert.False(renderDecal.Enabled);
+        }
+
+        [Fact]
+        public void MeshSelectorRoutesDecalsToTheDecalStage()
+        {
+            var opaqueStage = new RenderStage("Opaque", "Main") { Index = 0 };
+            var transparentStage = new RenderStage("Transparent", "Main") { Index = 1 };
+            var decalStage = new RenderStage("Decals", "Main") { Index = 2 };
+            var selector = new MeshTransparentRenderStageSelector
+            {
+                OpaqueRenderStage = opaqueStage,
+                TransparentRenderStage = transparentStage,
+                DecalRenderStage = decalStage,
+                EffectName = "StrideForwardShadingEffect",
+            };
+            var opaqueMaterial = new MaterialPass();
+
+            var renderDecal = new RenderDecal { MaterialPass = opaqueMaterial, ActiveRenderStages = new ActiveRenderStage[3] };
+            selector.Process(renderDecal);
+            Assert.False(renderDecal.ActiveRenderStages[0].Active);
+            Assert.False(renderDecal.ActiveRenderStages[1].Active);
+            Assert.True(renderDecal.ActiveRenderStages[2].Active);
+            Assert.Equal("StrideForwardShadingEffect", renderDecal.ActiveRenderStages[2].EffectSelector.EffectName);
+
+            // Without a decal stage, decals are rendered with the transparent geometry (never with the opaque one)
+            selector.DecalRenderStage = null;
+            renderDecal.ActiveRenderStages = new ActiveRenderStage[3];
+            selector.Process(renderDecal);
+            Assert.False(renderDecal.ActiveRenderStages[0].Active);
+            Assert.True(renderDecal.ActiveRenderStages[1].Active);
+
+            // Other meshes are not affected
+            var renderMesh = new RenderMesh { MaterialPass = opaqueMaterial, ActiveRenderStages = new ActiveRenderStage[3] };
+            selector.DecalRenderStage = decalStage;
+            selector.Process(renderMesh);
+            Assert.True(renderMesh.ActiveRenderStages[0].Active);
+            Assert.False(renderMesh.ActiveRenderStages[2].Active);
+
+            // A selector without transparent nor decal stage (such as the one of the depth prepass) ignores decals
+            var depthPrepassSelector = new MeshTransparentRenderStageSelector { OpaqueRenderStage = opaqueStage, EffectName = "StrideForwardShadingEffect.ZPrepass" };
+            renderDecal.ActiveRenderStages = new ActiveRenderStage[3];
+            depthPrepassSelector.Process(renderDecal);
+            Assert.DoesNotContain(renderDecal.ActiveRenderStages, stage => stage.Active);
+        }
+
+        [Fact]
+        public void GenericSelectorIgnoresDecals()
+        {
+            var stage = new RenderStage("Picking", "Picking") { Index = 0 };
+            var selector = new SimpleGroupToRenderStageSelector { RenderStage = stage, EffectName = "Picking" };
+
+            var renderDecal = new RenderDecal { ActiveRenderStages = new ActiveRenderStage[1] };
+            selector.Process(renderDecal);
+            Assert.False(renderDecal.ActiveRenderStages[0].Active);
+
+            var renderMesh = new RenderMesh { ActiveRenderStages = new ActiveRenderStage[1] };
+            selector.Process(renderMesh);
+            Assert.True(renderMesh.ActiveRenderStages[0].Active);
+        }
+
+        [Fact]
+        public void PipelineProcessorAppliesTheDecalStates()
+        {
+            var transparentStage = new RenderStage("Transparent", "Main")
+            {
+                Index = 0,
+                Output = new RenderOutputDescription(PixelFormat.R8G8B8A8_UNorm, PixelFormat.D24_UNorm_S8_UInt),
+            };
+            var processor = new MeshPipelineProcessor { TransparentRenderStage = transparentStage };
+            var renderDecal = new RenderDecal { MaterialPass = new MaterialPass() };
+
+            var pipelineState = ProcessPipelineState(processor, transparentStage, renderDecal);
+            Assert.Equal(CullMode.Front, pipelineState.RasterizerState.CullMode);
+            Assert.True(pipelineState.DepthStencilState.DepthBufferEnable);
+            Assert.False(pipelineState.DepthStencilState.DepthBufferWriteEnable);
+            Assert.Equal(CompareFunction.GreaterEqual, pipelineState.DepthStencilState.DepthBufferFunction);
+            Assert.Equal(BlendStates.AlphaBlend, pipelineState.BlendState);
+
+            // The material blend state is kept (e.g. additive decals)
+            renderDecal.MaterialPass.BlendState = BlendStates.Additive;
+            Assert.Equal(BlendStates.Additive, ProcessPipelineState(processor, transparentStage, renderDecal).BlendState);
+
+            // Mirrored volumes have reversed faces
+            renderDecal.IsScalingNegative = true;
+            Assert.Equal(CullMode.Back, ProcessPipelineState(processor, transparentStage, renderDecal).RasterizerState.CullMode);
+        }
+
+        private static PipelineStateDescription ProcessPipelineState(PipelineProcessor processor, RenderStage renderStage, RenderObject renderObject)
+        {
+            var pipelineState = new PipelineStateDescription();
+            pipelineState.SetDefaults();
+            var renderNode = new RenderNode(renderObject, null, ViewObjectNodeReference.Invalid, renderStage);
+            processor.Process(default, ref renderNode, renderObject, pipelineState);
+            return pipelineState;
+        }
+
+        [Fact]
+        public unsafe void SortModeOrdersDecalsBySortOrderThenCreation()
+        {
+            var meshRenderFeature = new MeshRenderFeature();
+            var decals = new[]
+            {
+                new RenderDecal { SortOrder = 1 },
+                new RenderDecal { SortOrder = -1 },
+                new RenderDecal { SortOrder = 0 },
+                new RenderDecal { SortOrder = 0 },
+            };
+
+            var renderViewStage = new RenderViewStage(0) { RenderNodes = new ConcurrentCollector<RenderNodeFeatureReference>() };
+            for (var i = 0; i < decals.Length; i++)
+                renderViewStage.RenderNodes.Add(new RenderNodeFeatureReference(meshRenderFeature, new RenderNodeReference(i), decals[i]));
+            renderViewStage.RenderNodes.Close();
+
+            var sortKeys = new SortKey[decals.Length];
+            fixed (SortKey* sortKeysPointer = sortKeys)
+            {
+                new DecalSortMode().GenerateSortKey(null, renderViewStage, sortKeysPointer);
+            }
+            Array.Sort(sortKeys);
+
+            Assert.Equal(new[] { decals[1], decals[2], decals[3], decals[0] }, sortKeys.Select(sortKey => decals[sortKey.Index]));
+        }
+
+        [Fact]
+        public void RenderSystemRendersDecalsWithTheMeshRenderFeature()
+        {
+            var renderSystem = new RenderSystem();
+            var meshRenderFeature = new MeshRenderFeature();
+            renderSystem.RenderFeatures.Add(meshRenderFeature);
+
+            var renderDecal = new RenderDecal();
+            renderSystem.AddRenderObject(renderDecal);
+            Assert.Same(meshRenderFeature, renderDecal.RenderFeature);
+
+            // A render feature supporting the exact type of a render object is preferred
+            var decalOnlyRenderFeature = new DecalOnlyMeshRenderFeature();
+            renderSystem.RenderFeatures.Add(decalOnlyRenderFeature);
+            var otherRenderDecal = new RenderDecal();
+            renderSystem.AddRenderObject(otherRenderDecal);
+            Assert.Same(decalOnlyRenderFeature, otherRenderDecal.RenderFeature);
+
+            var renderMesh = new RenderMesh();
+            renderSystem.AddRenderObject(renderMesh);
+            Assert.Same(meshRenderFeature, renderMesh.RenderFeature);
+        }
+
+        [Fact]
+        public void ProcessorAddsTheDecalRenderFeatureOnlyOnce()
+        {
+            var renderSystem = new RenderSystem();
+            var meshRenderFeature = new MeshRenderFeature();
+            renderSystem.RenderFeatures.Add(meshRenderFeature);
+
+            Assert.True(DecalRenderProcessor.EnsureDecalRenderFeature(renderSystem));
+            Assert.Single(meshRenderFeature.RenderFeatures.OfType<DecalRenderFeature>());
+
+            Assert.False(DecalRenderProcessor.EnsureDecalRenderFeature(renderSystem));
+            Assert.Single(meshRenderFeature.RenderFeatures.OfType<DecalRenderFeature>());
+        }
+
+        private class DecalOnlyMeshRenderFeature : MeshRenderFeature
+        {
+            public override Type SupportedRenderObjectType => typeof(RenderDecal);
+        }
+    }
+}
