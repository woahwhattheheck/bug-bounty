+const RESULT_KEYS: Record<string, string> = {
+  annotation: 'annotations',
+  area: 'areas',
+  artist: 'artists',
+  cdstub: 'cdstubs',
+  event: 'events',
+  genre: 'genres',
+  instrument: 'instruments',
+  label: 'labels',
+  place: 'places',
+  recording: 'recordings',
+  release: 'releases',
