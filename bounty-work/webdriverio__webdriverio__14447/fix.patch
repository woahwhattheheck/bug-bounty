+                vi.mocked(process.cwd).mockRestore()
+            }
+        }
+
+        it('resolves a glob pattern with a directory from the working directory', async () => {
+            expect(await getSpecsFor(['./__fixtures__/prefix-test-0*.ts'])).toEqual(prefixSpecs)
