@@ -0,0 +1,26 @@
+#pragma once
+
+#include "../EventLoop.hpp"
+
+namespace obs_vst3 {
+
+/*
+ * NSApplication based main loop of the bridge process on macOS. Commands are
+ * read on a background thread and dispatched to the main queue, which AppKit
+ * also services during modal and event tracking loops.
+ */
+class EventLoopCocoa : public EventLoop {
+public:
+	EventLoopCocoa();
+	~EventLoopCocoa() override;
+
+	void run(IpcChannel &commandChannel, const CommandHandler &onCommand, const IdleHandler &onIdle) override;
+	void quit() override;
+	std::unique_ptr<EditorWindow> openEditor(Steinberg::IPlugView *view, const std::string &title,
+						 CloseHandler onCloseRequested, std::string &error) override;
+
+private:
+	bool running_ = false;
+};
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/host/macos/EventLoopCocoa.mm b/plugins/obs-vst3/host/macos/EventLoopCocoa.mm
new file mode 100644
index 0000000..e8f9650
--- /dev/null
+++ b/plugins/obs-vst3/host/macos/EventLoopCocoa.mm
@@ -0,0 +1,107 @@
+#include "EventLoopCocoa.hpp"
+#include "EditorWindowCocoa.hpp"
+#include "../../bridge/IpcChannel.hpp"
+
+#include <thread>
+
+#import <Cocoa/Cocoa.h>
+
+namespace obs_vst3 {
+
+    namespace {
+
+        constexpr NSTimeInterval kIdleInterval = 0.016;
+
+        struct PendingCommand {
+            Command command = Command::Invalid;
+            std::vector<uint8_t> payload;
+        };
+
+    }  // namespace
+
+    std::unique_ptr<EventLoop> EventLoop::create()
+    {
+        return std::make_unique<EventLoopCocoa>();
+    }
+
+    EventLoopCocoa::EventLoopCocoa()
+    {
+        [NSApplication sharedApplication];
+        /* Show editor windows without a Dock icon or menu bar of our own. */
+        [NSApp setActivationPolicy:NSApplicationActivationPolicyAccessory];
+        [NSApp finishLaunching];
+    }
+
+    EventLoopCocoa::~EventLoopCocoa() = default;
+
+    void EventLoopCocoa::run(IpcChannel &commandChannel, const CommandHandler &onCommand, const IdleHandler &onIdle)
+    {
+        running_ = true;
+
+        IpcChannel *channel = &commandChannel;
+        const CommandHandler *commandHandler = &onCommand;
+        EventLoopCocoa *loop = this;
+
+        std::thread reader([channel, commandHandler, loop]() {
+            for (;;) {
+                auto pending = std::make_shared<PendingCommand>();
+                if (!channel->receiveMessage(pending->command, pending->payload, -1)) {
+                    dispatch_async(dispatch_get_main_queue(), ^{
+                        loop->quit();
+                    });
+                    return;
+                }
+
+                dispatch_async(dispatch_get_main_queue(), ^{
+                    if (loop->running_) {
+                        (*commandHandler)(pending->command, pending->payload);
+                    }
+                });
+            }
+        });
+
+        @autoreleasepool {
+            const IdleHandler *idleHandler = &onIdle;
+            NSTimer *idleTimer = [NSTimer timerWithTimeInterval:kIdleInterval repeats:YES block:^(NSTimer *timer) {
+                (void) timer;
+                if (loop->running_) {
+                    (*idleHandler)();
+                }
+            }];
+            [[NSRunLoop mainRunLoop] addTimer:idleTimer forMode:NSRunLoopCommonModes];
+
+            if (running_) {
+                [NSApp run];
+            }
+
+            [idleTimer invalidate];
+        }
+
+        running_ = false;
+        commandChannel.interrupt();
+        reader.join();
+    }
+
+    void EventLoopCocoa::quit()
+    {
+        running_ = false;
+
+        [NSApp stop:nil];
+        /* -stop: only takes effect after the next event, so post one. */
+        NSEvent *event = [NSEvent otherEventWithType:NSEventTypeApplicationDefined location:NSZeroPoint modifierFlags:0
+                                           timestamp:0
+                                        windowNumber:0
+                                             context:nil
+                                             subtype:0
+                                               data1:0
+                                               data2:0];
+        [NSApp postEvent:event atStart:YES];
+    }
+
+    std::unique_ptr<EditorWindow> EventLoopCocoa::openEditor(Steinberg::IPlugView *view, const std::string &title,
+                                                             CloseHandler onCloseRequested, std::string &error)
+    {
+        return EditorWindowCocoa::create(view, title, std::move(onCloseRequested), error);
+    }
+
+}  // namespace obs_vst3
diff --git a/plugins/obs-vst3/host/main.cpp b/plugins/obs-vst3/host/main.cpp
new file mode 100644
index 0000000..9749b60
--- /dev/null
+++ b/plugins/obs-vst3/host/main.cpp
@@ -0,0 +1,157 @@
+/*
+ * obs-vst3-host: out-of-process VST3 plug-in host used by the obs-vst3 module.
+ *
+ *   obs-vst3-host --command <handle> --audio <handle> --shared-memory <handle>
+ *                 --shared-memory-size <bytes> --serve
+ *   obs-vst3-host --command <handle> --audio <handle> --scan <module path>
+ *
+ * The handles are inherited from OBS (file descriptors on POSIX, handle values
+ * on Windows). The process exits as soon as OBS closes the command channel.
+ */
+
+#include "HostLog.hpp"
+#include "HostSession.hpp"
+#include "ModuleScanner.hpp"
+#include "../bridge/IpcChannel.hpp"
+#include "../bridge/MessageWriter.hpp"
+#include "../bridge/SharedMemory.hpp"
+
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#else
+#include <csignal>
+#endif
+
+using namespace obs_vst3;
+
+namespace {
+
+struct Arguments {
+	NativeHandle command = invalidNativeHandle();
+	NativeHandle audio = invalidNativeHandle();
+	NativeHandle sharedMemory = invalidNativeHandle();
+	size_t sharedMemorySize = 0;
+	bool serve = false;
+	std::string scanPath;
+};
+
+NativeHandle parseHandle(const std::string &value)
+{
+#ifdef _WIN32
+	return reinterpret_cast<NativeHandle>(static_cast<uintptr_t>(std::strtoull(value.c_str(), nullptr, 10)));
+#else
+	return static_cast<NativeHandle>(std::strtol(value.c_str(), nullptr, 10));
+#endif
+}
+
+bool parseArguments(const std::vector<std::string> &argv, Arguments &arguments)
+{
+	for (size_t index = 1; index < argv.size(); index++) {
+		const std::string &argument = argv[index];
+		bool hasValue = index + 1 < argv.size();
+
+		if (argument == "--serve") {
+			arguments.serve = true;
+		} else if (argument == "--command" && hasValue) {
+			arguments.command = parseHandle(argv[++index]);
+		} else if (argument == "--audio" && hasValue) {
+			arguments.audio = parseHandle(argv[++index]);
+		} else if (argument == "--shared-memory" && hasValue) {
+			arguments.sharedMemory = parseHandle(argv[++index]);
+		} else if (argument == "--shared-memory-size" && hasValue) {
+			arguments.sharedMemorySize =
+				static_cast<size_t>(std::strtoull(argv[++index].c_str(), nullptr, 10));
+		} else if (argument == "--scan" && hasValue) {
+			arguments.scanPath = argv[++index];
+		} else {
+			hostLog("Unknown argument '%s'", argument.c_str());
+			return false;
+		}
+	}
+
+	return arguments.command != invalidNativeHandle() && (arguments.serve || !arguments.scanPath.empty());
+}
+
+int scanModule(IpcChannel &commandChannel, const std::string &modulePath)
+{
+	std::vector<ScannedClass> classes;
+	std::string error;
+	bool scanned = ModuleScanner::scan(modulePath, classes, error);
+
+	MessageWriter reply;
+	reply.writeInt32(static_cast<int32_t>(scanned ? Status::Ok : Status::Failed));
+	reply.writeString(error);
+	if (scanned) {
+		ModuleScanner::serialize(classes, reply);
+	}
+
+	commandChannel.sendMessage(Command::ScanModule, reply.data(), kCommandTimeoutMs);
+	return scanned ? 0 : 1;
+}
+
+int runHost(const std::vector<std::string> &argv)
+{
+	Arguments arguments;
+	if (!parseArguments(argv, arguments)) {
+		hostLog("This program is started by OBS Studio and is not meant to be run directly.");
+		return 2;
+	}
+
+	IpcChannel commandChannel(arguments.command);
+	IpcChannel audioChannel(arguments.audio);
+
+	if (!arguments.scanPath.empty()) {
+		return scanModule(commandChannel, arguments.scanPath);
+	}
+
+	if (arguments.sharedMemorySize < kSharedMemorySize) {
+		hostLog("Shared memory region is missing or too small");
+		return 2;
+	}
+
+	std::string error;
+	std::unique_ptr<SharedMemory> memory =
+		SharedMemory::attach(arguments.sharedMemory, arguments.sharedMemorySize, error);
+	if (!memory) {
+		hostLog("%s", error.c_str());
+		return 2;
+	}
+	memory->closeHandle();
+
+	HostSession session(std::move(commandChannel), std::move(audioChannel), std::move(memory));
+	return session.run();
+}
+
+} // namespace
+
+#ifdef _WIN32
+int wmain(int argc, wchar_t **argv)
+{
+	std::vector<std::string> arguments;
+	for (int index = 0; index < argc; index++) {
+		int size = WideCharToMultiByte(CP_UTF8, 0, argv[index], -1, nullptr, 0, nullptr, nullptr);
+		std::string converted(size > 0 ? static_cast<size_t>(size - 1) : 0, '\0');
+		if (size > 1) {
+			WideCharToMultiByte(CP_UTF8, 0, argv[index], -1, converted.data(), size, nullptr, nullptr);
+		}
+		arguments.push_back(converted);
+	}
+
+	return runHost(arguments);
+}
+#else
+int main(int argc, char **argv)
+{
+	/* Writes to a closed channel must fail with EPIPE instead of killing the bridge. */
+	std::signal(SIGPIPE, SIG_IGN);
+
+	return runHost(std::vector<std::string>(argv, argv + argc));
+}
+#endif
diff --git a/plugins/obs-vst3/host/windows/EditorWindowWin32.cpp b/plugins/obs-vst3/host/windows/EditorWindowWin32.cpp
new file mode 100644
index 0000000..10efbc3
--- /dev/null
+++ b/plugins/obs-vst3/host/windows/EditorWindowWin32.cpp
@@ -0,0 +1,211 @@
+#include "EditorWindowWin32.hpp"
+
+#include <pluginterfaces/gui/iplugviewcontentscalesupport.h>
+
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+
+namespace obs_vst3 {
+
+using namespace Steinberg;
+
+namespace {
+
+constexpr wchar_t kEditorWindowClass[] = L"OBSVST3HostEditor";
+constexpr int kDefaultWidth = 640;
+constexpr int kDefaultHeight = 480;
+
+std::wstring toWide(const std::string &text)
+{
+	int size = MultiByteToWideChar(CP_UTF8, 0, text.c_str(), -1, nullptr, 0);
+	std::wstring wide(size > 0 ? static_cast<size_t>(size - 1) : 0, L'\0');
+	if (size > 1) {
+		MultiByteToWideChar(CP_UTF8, 0, text.c_str(), -1, wide.data(), size);
+	}
+	return wide;
+}
+
+DWORD windowStyle(bool resizable)
+{
+	return resizable ? WS_OVERLAPPEDWINDOW : (WS_OVERLAPPEDWINDOW & ~(WS_THICKFRAME | WS_MAXIMIZEBOX));
+}
+
+} // namespace
+
+EditorWindowWin32::EditorWindowWin32(IPlugView *view, EventLoop::CloseHandler onCloseRequested)
+	: view_(shared(view)),
+	  onCloseRequested_(std::move(onCloseRequested))
+{
+}
+
+std::unique_ptr<EditorWindowWin32> EditorWindowWin32::create(IPlugView *view, const std::string &title,
+							     EventLoop::CloseHandler onCloseRequested,
+							     std::string &error)
+{
+	if (view->isPlatformTypeSupported(kPlatformTypeHWND) != kResultTrue) {
+		error = "The plug-in editor does not support Win32 windows";
+		return nullptr;
+	}
+
+	static bool classRegistered = false;
+	if (!classRegistered) {
+		WNDCLASSEXW windowClass = {};
+		windowClass.cbSize = sizeof(windowClass);
+		windowClass.style = CS_HREDRAW | CS_VREDRAW;
+		windowClass.lpfnWndProc = reinterpret_cast<WNDPROC>(windowProc);
+		windowClass.hInstance = GetModuleHandleW(nullptr);
+		windowClass.hCursor = LoadCursorW(nullptr, IDC_ARROW);
+		windowClass.hbrBackground = reinterpret_cast<HBRUSH>(GetStockObject(BLACK_BRUSH));
+		windowClass.lpszClassName = kEditorWindowClass;
+		classRegistered = RegisterClassExW(&windowClass) != 0;
+	}
+
+	std::unique_ptr<EditorWindowWin32> editor(new EditorWindowWin32(view, std::move(onCloseRequested)));
+	editor->resizable_ = view->canResize() == kResultTrue;
+
+	ViewRect rect;
+	if (view->getSize(&rect) != kResultTrue || rect.getWidth() <= 0 || rect.getHeight() <= 0) {
+		rect = ViewRect(0, 0, kDefaultWidth, kDefaultHeight);
+	}
+
+	RECT windowRect = {0, 0, rect.getWidth(), rect.getHeight()};
+	DWORD style = windowStyle(editor->resizable_);
+	AdjustWindowRectEx(&windowRect, style, FALSE, 0);
+
+	std::wstring wideTitle = toWide(title);
+	HWND window = CreateWindowExW(0, kEditorWindowClass, wideTitle.c_str(), style, CW_USEDEFAULT, CW_USEDEFAULT,
+				      windowRect.right - windowRect.left, windowRect.bottom - windowRect.top, nullptr,
+				      nullptr, GetModuleHandleW(nullptr), editor.get());
+	if (!window) {
+		error = "Could not create the editor window";
+		return nullptr;
+	}
+	editor->window_ = window;
+
+	view->setFrame(editor.get());
+	editor->updateContentScale();
+	if (view->attached(window, kPlatformTypeHWND) != kResultOk) {
+		error = "The plug-in editor could not be attached to its window";
+		return nullptr;
+	}
+	editor->attached_ = true;
+
+	ShowWindow(window, SW_SHOWNORMAL);
+	SetForegroundWindow(window);
+	return editor;
+}
+
+EditorWindowWin32::~EditorWindowWin32()
+{
+	if (attached_) {
+		view_->removed();
+	}
+	view_->setFrame(nullptr);
+
+	if (window_) {
+		HWND window = static_cast<HWND>(window_);
+		SetWindowLongPtrW(window, GWLP_USERDATA, 0);
+		DestroyWindow(window);
+	}
+}
+
+tresult PLUGIN_API EditorWindowWin32::queryInterface(const TUID iid, void **object)
+{
+	if (FUnknownPrivate::iidEqual(iid, FUnknown::iid) || FUnknownPrivate::iidEqual(iid, IPlugFrame::iid)) {
+		*object = static_cast<IPlugFrame *>(this);
+		return kResultOk;
+	}
+
+	*object = nullptr;
+	return kNoInterface;
+}
+
+void EditorWindowWin32::updateContentScale()
+{
+	FUnknownPtr<IPlugViewContentScaleSupport> scaleSupport(view_);
+	if (scaleSupport && window_) {
+		UINT dpi = GetDpiForWindow(static_cast<HWND>(window_));
+		scaleSupport->setContentScaleFactor(static_cast<float>(dpi) / USER_DEFAULT_SCREEN_DPI);
+	}
+}
+
+void EditorWindowWin32::resizeClientArea(int width, int height)
+{
+	HWND window = static_cast<HWND>(window_);
+	RECT windowRect = {0, 0, width, height};
+	AdjustWindowRectExForDpi(&windowRect, static_cast<DWORD>(GetWindowLongPtrW(window, GWL_STYLE)), FALSE, 0,
+				 GetDpiForWindow(window));
+	SetWindowPos(window, nullptr, 0, 0, windowRect.right - windowRect.left, windowRect.bottom - windowRect.top,
+		     SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE);
+}
+
+tresult PLUGIN_API EditorWindowWin32::resizeView(IPlugView *view, ViewRect *newSize)
+{
+	if (!newSize || view != view_.get() || newSize->getWidth() <= 0 || newSize->getHeight() <= 0) {
+		return kInvalidArgument;
+	}
+
+	resizing_ = true;
+	resizeClientArea(newSize->getWidth(), newSize->getHeight());
+	view_->onSize(newSize);
+	resizing_ = false;
+	return kResultTrue;
+}
+
+void EditorWindowWin32::bringToFront()
+{
+	HWND window = static_cast<HWND>(window_);
+	ShowWindow(window, SW_RESTORE);
+	SetForegroundWindow(window);
+}
+
+intptr_t __stdcall EditorWindowWin32::windowProc(void *window, unsigned int message, uintptr_t wParam, intptr_t lParam)
+{
+	HWND handle = static_cast<HWND>(window);
+
+	if (message == WM_NCCREATE) {
+		auto *create = reinterpret_cast<CREATESTRUCTW *>(lParam);
+		SetWindowLongPtrW(handle, GWLP_USERDATA, reinterpret_cast<LONG_PTR>(create->lpCreateParams));
+	}
+
+	auto *editor = reinterpret_cast<EditorWindowWin32 *>(GetWindowLongPtrW(handle, GWLP_USERDATA));
+	if (editor) {
+		return editor->handleMessage(handle, message, wParam, lParam);
+	}
+
+	return DefWindowProcW(handle, message, wParam, lParam);
+}
+
+intptr_t EditorWindowWin32::handleMessage(void *windowHandle, unsigned int message, uintptr_t wParam, intptr_t lParam)
+{
+	HWND window = static_cast<HWND>(windowHandle);
+
+	switch (message) {
+	case WM_CLOSE:
+		/* The owner destroys the window outside of message dispatching. */
+		if (onCloseRequested_) {
+			onCloseRequested_();
+		}
+		return 0;
+	case WM_SIZE:
+		if (attached_ && resizable_ && !resizing_ && wParam != SIZE_MINIMIZED) {
+			ViewRect rect(0, 0, LOWORD(lParam), HIWORD(lParam));
+			view_->checkSizeConstraint(&rect);
+			view_->onSize(&rect);
+		}
+		return 0;
+	case WM_DPICHANGED: {
+		updateContentScale();
+		auto *suggested = reinterpret_cast<RECT *>(lParam);
+		SetWindowPos(window, nullptr, suggested->left, suggested->top, suggested->right - suggested->left,
+			     suggested->bottom - suggested->top, SWP_NOZORDER | SWP_NOACTIVATE);
+		return 0;
+	}
+	default:
+		break;
+	}
+
+	return DefWindowProcW(window, message, wParam, lParam);
+}
+
+} // namespace obs_vst3
