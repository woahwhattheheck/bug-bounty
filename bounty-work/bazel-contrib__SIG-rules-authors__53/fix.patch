+"""Collect GitHub repository traffic and keep a history of it.
+
+GitHub only shows repository traffic (page views, git clones, top referrers
+and top content paths) to accounts with push access, and only for the last
+14 days. This script reads those numbers through the documented REST API
+(https://docs.github.com/en/rest/metrics/traffic), merges them into CSV files
+that keep the full history, and can publish the files to a GitHub Gist so the
+SIG can ingest them without holding a privileged token.
+
+The token is read from the environment, never from the command line.
+See README.md next to this file for setup and usage.
+"""
+
+import argparse
+import csv
+import datetime
+import io
+import json
+import os
+import re
+import sys
+import time
+import urllib.error
+import urllib.parse
+import urllib.request
+
+API_URL = "https://api.github.com"
+API_VERSION = "2022-11-28"
+USER_AGENT = "bazel-contrib-github-traffic"
+
+# Environment variables searched for the traffic token, in order.
+TOKEN_ENV_VARS = ("GITHUB_TRAFFIC_TOKEN", "GITHUB_TOKEN", "GH_TOKEN")
+# Environment variables searched for the Gist token, in order. When none is
+# set the traffic token is used for the Gist as well.
+GIST_TOKEN_ENV_VARS = ("GIST_TOKEN",)
+
+_REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
+_LINK_RE = re.compile(r'<([^>]+)>\s*;\s*rel="([^"]+)"')
+_INT_FIELDS = frozenset(
+    ["count", "uniques", "views", "views_uniques", "clones", "clones_uniques"]
+)
+
+
+class GitHubError(Exception):
+    """An HTTP error returned by the GitHub API."""
+
+    def __init__(self, status, url, message):
+        if status:
+            super().__init__(f"HTTP {status} for {url}: {message}")
+        else:
+            super().__init__(f"request to {url} failed: {message}")
+        self.status = status
+        self.url = url
+        self.message = message
+
+
+class HttpResponse:
+    """The parts of an HTTP response the client needs."""
+
+    def __init__(self, status, headers, body):
+        self.status = status
+        self.headers = {k.lower(): v for k, v in (headers or {}).items()}
+        self.body = body or b""
+
+    def json(self):
+        if not self.body:
+            return None
+        return json.loads(self.body.decode("utf-8"))
+
+
+def urllib_transport(method, url, headers, body=None, timeout=60):
+    """Performs one HTTP request with the standard library."""
+    request = urllib.request.Request(url, data=body, headers=headers, method=method)
+    try:
+        with urllib.request.urlopen(request, timeout=timeout) as response:
+            return HttpResponse(
+                response.status, dict(response.headers), response.read()
+            )
+    except urllib.error.HTTPError as e:
+        return HttpResponse(e.code, dict(e.headers or {}), e.read())
+
+
+def _error_message(response):
+    try:
+        data = response.json()
+    except ValueError:
+        data = None
+    if isinstance(data, dict) and data.get("message"):
+        return data["message"]
+    return response.body.decode("utf-8", "replace")[:200] or "no response body"
+
+
+def _next_link(header):
+    """Returns the rel="next" URL from a Link header, or None."""
+    for url, rel in _LINK_RE.findall(header or ""):
+        if "next" in rel.split():
+            return url
+    return None
+
+
+class GitHubClient:
+    """A small GitHub REST client with pagination and rate limit handling."""
+
+    def __init__(
+        self,
+        token,
+        api_url=API_URL,
+        transport=urllib_transport,
+        sleep=time.sleep,
+        clock=time.time,
+        max_retries=3,
+        max_wait=900,
+    ):
+        self.token = token
+        self.api_url = api_url.rstrip("/")
+        self.transport = transport
+        self.sleep = sleep
+        self.clock = clock
+        self.max_retries = max_retries
+        self.max_wait = max_wait
+
+    def url(self, path, params=None):
+        if path.startswith(("https://", "http://")):
+            url = path
+        else:
+            url = self.api_url + path
+        if params:
+            url += ("&" if "?" in url else "?") + urllib.parse.urlencode(params)
+        return url
+
+    def _headers(self):
+        headers = {
+            "Accept": "application/vnd.github+json",
+            "X-GitHub-Api-Version": API_VERSION,
+            "User-Agent": USER_AGENT,
+        }
+        if self.token:
+            headers["Authorization"] = "Bearer " + self.token
+        return headers
+
+    def _retry_delay(self, response, attempt):
+        """Returns how many seconds to wait before retrying, or None."""
+        status = response.status
+        headers = response.headers
+        delay = None
+        if status in (403, 429):
+            if "retry-after" in headers:
+                # Secondary rate limit.
+                try:
+                    delay = int(headers["retry-after"])
+                except ValueError:
+                    return None
+            elif headers.get("x-ratelimit-remaining") == "0":
+                # Primary rate limit: wait until the window resets.
+                try:
+                    delay = int(headers["x-ratelimit-reset"]) - int(self.clock()) + 1
+                except (KeyError, ValueError):
+                    delay = 60
+            else:
+                # A plain 403, e.g. the token lacks push access. Not retryable.
+                return None
+        elif status >= 500:
+            delay = 2**attempt
+        else:
+            return None
+        delay = max(delay, 1)
+        if delay > self.max_wait:
+            return None
+        return delay
+
+    def request(self, method, path, params=None, payload=None):
+        """Sends a request and returns the HttpResponse, raising on errors."""
+        url = self.url(path, params)
+        headers = self._headers()
+        body = None
+        if payload is not None:
+            body = json.dumps(payload).encode("utf-8")
+            headers["Content-Type"] = "application/json"
+        attempt = 0
+        while True:
+            try:
+                response = self.transport(method, url, headers, body)
+            except OSError as e:
+                # Connection errors and timeouts (urllib.error.URLError is an
+                # OSError) are retried like server errors.
+                if attempt >= self.max_retries:
+                    raise GitHubError(0, url, str(e)) from e
+                self.sleep(min(2**attempt, self.max_wait))
+                attempt += 1
+                continue
+            if response.status < 400:
+                return response
+            delay = self._retry_delay(response, attempt)
+            if delay is None or attempt >= self.max_retries:
+                raise GitHubError(response.status, url, _error_message(response))
+            self.sleep(delay)
+            attempt += 1
+
+    def get(self, path, params=None):
+        return self.request("GET", path, params).json()
+
+    def paginate(self, path, params=None):
+        """Returns all items of a paginated list endpoint."""
+        params = dict(params or {})
+        params.setdefault("per_page", 100)
+        url = self.url(path, params)
+        items = []
+        while url:
+            response = self.request("GET", url)
+            items.extend(response.json() or [])
+            url = _next_link(response.headers.get("link"))
+            # Never send the token anywhere but the API host.
+            if url and not url.startswith(self.api_url + "/"):
+                raise GitHubError(response.status, url, "pagination left the API host")
+        return items
+
+    def fetch_raw(self, url):
+        """Downloads a public URL (e.g. a Gist raw_url) without the token."""
+        try:
+            response = self.transport("GET", url, {"User-Agent": USER_AGENT}, None)
+        except OSError as e:
+            raise GitHubError(0, url, str(e)) from e
+        if response.status >= 400:
+            raise GitHubError(response.status, url, _error_message(response))
+        return response.body.decode("utf-8")
+
+
+def _repo_path(repo):
+    if not _REPO_RE.match(repo):
+        raise ValueError(f"invalid repository {repo!r}, expected OWNER/NAME")
+    owner, name = repo.split("/")
+    return f"{urllib.parse.quote(owner)}/{urllib.parse.quote(name)}"
+
+
+def list_org_repos(
+    client,
+    org,
+    include_private=False,
+    include_archived=False,
+    include_forks=False,
+    pattern=None,
+):
+    """Lists the repositories of an org whose traffic the token can read.
+
+    GitHub reports the authenticated user's permissions on each repository;
+    repositories without push access are skipped because their traffic
+    endpoints would only return 403.
+    """
+    params = {"type": "all" if include_private else "public", "sort": "full_name"}
+    repos = []
+    for repo in client.paginate(f"/orgs/{urllib.parse.quote(org)}/repos", params):
+        if repo.get("private") and not include_private:
+            continue
+        if repo.get("archived") and not include_archived:
+            continue
+        if repo.get("fork") and not include_forks:
+            continue
+        permissions = repo.get("permissions")
+        if permissions is not None and not any(
+            permissions.get(p) for p in ("admin", "maintain", "push")
+        ):
+            continue
+        if pattern and not pattern.search(repo["name"]):
+            continue
+        repos.append(repo["full_name"])
+    return repos
+
+
+def read_repos_file(path):
+    """Reads OWNER/NAME lines, ignoring blank lines and # comments."""
+    repos = []
+    with open(path, encoding="utf-8") as f:
+        for line in f:
+            line = line.split("#", 1)[0].strip()
+            if line:
+                repos.append(line)
+    return repos
+
+
+def fetch_traffic(client, repo):
+    """Fetches the four traffic endpoints for one repository."""
+    path = f"/repos/{_repo_path(repo)}/traffic"
+    return {
+        "views": client.get(path + "/views", {"per": "day"}) or {},
+        "clones": client.get(path + "/clones", {"per": "day"}) or {},
+        "referrers": client.get(path + "/popular/referrers") or [],
+        "paths": client.get(path + "/popular/paths") or [],
+    }
+
+
+class Table:
+    """One CSV file of traffic records.
+
+    Daily tables (views, clones) hold one row per repository and UTC day. When
+    the same day is seen by several runs the larger numbers are kept: a day's
+    counters only grow while it is inside GitHub's 14-day window, so re-running
+    never lowers a value that was already recorded.
+
+    Snapshot tables (summary, referrers, paths) hold what GitHub reported on a
+    collection date. GitHub only reports these as 14-day totals, so each run
+    stores a dated snapshot, and a later run on the same date replaces the
+    earlier snapshot for that repository.
+    """
+
+    def __init__(self, name, fields, key, group=None):
+        self.name = name
+        self.fields = tuple(fields)
+        self.key = tuple(key)
+        self.group = tuple(group) if group else None
+
+    def parse(self, text):
+        reader = csv.DictReader(io.StringIO(text))
+        if reader.fieldnames is None:
+            return []
+        missing = [f for f in self.fields if f not in reader.fieldnames]
+        if missing:
+            raise ValueError(
+                "{}: missing column(s) {}".format(self.name, ", ".join(missing))
+            )
+        rows = []
+        for raw in reader:
+            row = {}
+            for field in self.fields:
+                value = raw[field] or ""
+                row[field] = int(value or 0) if field in _INT_FIELDS else value
+            rows.append(row)
+        return rows
+
+    def format(self, rows):
+        out = io.StringIO()
+        writer = csv.DictWriter(out, fieldnames=self.fields, lineterminator="\n")
+        writer.writeheader()
+        for row in sorted(rows, key=self._sort_key):
+            writer.writerow(row)
+        return out.getvalue()
+
+    def _sort_key(self, row):
+        if self.group is None:
+            return tuple(row[f] for f in self.key)
+        return (
+            tuple(row[f] for f in self.group),
+            -row.get("count", 0),
+            tuple(row[f] for f in self.key),
+        )
+
+    def merge(self, existing, new):
+        """Merges newly collected rows into existing ones."""
+        if self.group is not None:
+            replaced = {tuple(r[f] for f in self.group) for r in new}
+            existing = [
+                r for r in existing if tuple(r[f] for f in self.group) not in replaced
+            ]
+            merged = {}
+            for row in list(existing) + list(new):
+                merged[tuple(row[f] for f in self.key)] = dict(row)
+            return list(merged.values())
+        merged = {}
+        for row in list(existing) + list(new):
+            key = tuple(row[f] for f in self.key)
+            old = merged.get(key)
+            if old is None:
+                merged[key] = dict(row)
+            else:
+                for field in self.fields:
+                    if field in _INT_FIELDS:
+                        old[field] = max(old[field], row[field])
+        return list(merged.values())
+
+
+TABLES = (
+    Table("views.csv", ["repo", "date", "count", "uniques"], ["repo", "date"]),
+    Table("clones.csv", ["repo", "date", "count", "uniques"], ["repo", "date"]),
+    Table(
+        "summary.csv",
+        ["collected", "repo", "views", "views_uniques", "clones", "clones_uniques"],
+        ["collected", "repo"],
+        group=["collected", "repo"],
+    ),
+    Table(
+        "referrers.csv",
+        ["collected", "repo", "referrer", "count", "uniques"],
+        ["collected", "repo", "referrer"],
+        group=["collected", "repo"],
+    ),
+    Table(
+        "paths.csv",
+        ["collected", "repo", "path", "title", "count", "uniques"],
+        ["collected", "repo", "path"],
+        group=["collected", "repo"],
+    ),
+)
+TABLES_BY_NAME = {t.name: t for t in TABLES}
+
+
+def traffic_to_rows(repo, traffic, collected):
+    """Converts the API responses for one repository into table rows."""
+    rows = {t.name: [] for t in TABLES}
+    for kind in ("views", "clones"):
+        for entry in traffic[kind].get(kind) or []:
+            rows[kind + ".csv"].append(
+                {
+                    "repo": repo,
+                    # Timestamps are aligned to UTC midnight.
+                    "date": entry["timestamp"][:10],
+                    "count": int(entry.get("count", 0)),
+                    "uniques": int(entry.get("uniques", 0)),
+                }
+            )
+    rows["summary.csv"].append(
+        {
+            "collected": collected,
+            "repo": repo,
+            "views": int(traffic["views"].get("count", 0)),
+            "views_uniques": int(traffic["views"].get("uniques", 0)),
+            "clones": int(traffic["clones"].get("count", 0)),
+            "clones_uniques": int(traffic["clones"].get("uniques", 0)),
+        }
+    )
+    for entry in traffic["referrers"]:
+        rows["referrers.csv"].append(
+            {
+                "collected": collected,
+                "repo": repo,
+                "referrer": entry.get("referrer", ""),
+                "count": int(entry.get("count", 0)),
+                "uniques": int(entry.get("uniques", 0)),
+            }
+        )
+    for entry in traffic["paths"]:
+        rows["paths.csv"].append(
+            {
+                "collected": collected,
+                "repo": repo,
+                "path": entry.get("path", ""),
+                "title": entry.get("title", ""),
+                "count": int(entry.get("count", 0)),
+                "uniques": int(entry.get("uniques", 0)),
+            }
+        )
+    return rows
+
+
+class DirectoryStore:
+    """Keeps the CSV files in a local directory."""
+
+    def __init__(self, path):
+        self.path = path
+
+    def __str__(self):
+        return self.path
+
+    def load(self):
+        files = {}
+        for table in TABLES:
+            path = os.path.join(self.path, table.name)
+            if os.path.exists(path):
+                with open(path, encoding="utf-8", newline="") as f:
+                    files[table.name] = f.read()
+        return files
+
+    def save(self, files):
+        os.makedirs(self.path, exist_ok=True)
+        for name, text in files.items():
+            path = os.path.join(self.path, name)
+            tmp = path + ".tmp"
+            with open(tmp, "w", encoding="utf-8", newline="") as f:
+                f.write(text)
+            os.replace(tmp, path)
+
+
+class GistStore:
+    """Keeps the CSV files in a GitHub Gist.
+
+    The Gist must already exist; create it once by hand (it can be secret) and
+    pass its ID. Anyone can then read the latest data from
+    https://gist.githubusercontent.com/<owner>/<id>/raw/<file>.
+    """
+
+    def __init__(self, client, gist_id):
+        self.client = client
+        self.gist_id = gist_id
+        self._loaded = {}
+
+    def __str__(self):
+        return "gist " + self.gist_id
+
+    def load(self):
+        gist = self.client.get(f"/gists/{urllib.parse.quote(self.gist_id)}")
+        files = {}
+        for name, info in (gist.get("files") or {}).items():
+            if name not in TABLES_BY_NAME:
+                continue
+            content = info.get("content")
+            # The API truncates large files; the raw URL has the full content.
+            if info.get("truncated") or content is None:
+                content = self.client.fetch_raw(info["raw_url"])
+            files[name] = content
+        self._loaded = dict(files)
+        return files
+
+    def save(self, files):
+        changed = {
+            name: {"content": text}
+            for name, text in files.items()
+            if self._loaded.get(name) != text
+        }
+        if not changed:
+            return
+        self.client.request(
+            "PATCH",
+            f"/gists/{urllib.parse.quote(self.gist_id)}",
+            payload={"files": changed},
+        )
+        self._loaded.update({name: f["content"] for name, f in changed.items()})
+
+
+def merge_tables(loaded_files, new_rows):
+    """Merges every store's files and the new rows into one text per table."""
+    result = {}
+    for table in TABLES:
+        existing = []
+        for files in loaded_files:
+            if table.name in files:
+                existing = table.merge(existing, table.parse(files[table.name]))
+        result[table.name] = table.format(table.merge(existing, new_rows[table.name]))
+    return result
+
+
+def _find_token(environ, names):
+    for name in names:
+        if environ.get(name):
+            return name, environ[name]
+    return None, None
+
+
+def _push_access_hint(error):
+    if error.status == 403:
+        return (
+            " (the token needs push access to this repository; for a"
+            ' fine-grained token grant the "Administration" repository'
+            " permission with read access)"
+        )
+    if error.status == 404:
+        return " (repository not found, or not visible to the token)"
+    return ""
+
+
+def format_summary(rows):
+    """Formats the 14-day totals of this run as a plain text table."""
+    rows = sorted(rows, key=lambda r: (-r["views"], r["repo"]))
+    header = ("repository", "views", "visitors", "clones", "cloners")
+    lines = [
+        (r["repo"], r["views"], r["views_uniques"], r["clones"], r["clones_uniques"])
+        for r in rows
+    ]
+    width = max([len(header[0])] + [len(line[0]) for line in lines])
+    out = []
+    for line in [header, *lines]:
+        name, numbers = line[0], line[1:]
+        out.append(f"{name:<{width}}" + "".join(f" {n:>9}" for n in numbers))
+    return "\n".join(out) + "\n"
+
+
+def build_parser():
+    parser = argparse.ArgumentParser(
+        description=(
+            "Collect GitHub traffic (views, clones, referrers, popular paths) "
+            "and merge it into CSV files that keep the history beyond "
+            "GitHub's 14-day window."
+        ),
+        epilog=(
+            f"The token is read from ${TOKEN_ENV_VARS[0]} (falling back to "
+            f"${' or $'.join(TOKEN_ENV_VARS[1:])}). It must belong to an "
+            "account with push access to the repositories."
+        ),
+    )
+    source = parser.add_argument_group("repositories")
+    source.add_argument(
+        "--repo",
+        action="append",
+        default=[],
+        metavar="OWNER/NAME",
+        help="repository to collect; may be repeated",
+    )
+    source.add_argument(
+        "--repos-file",
+        metavar="FILE",
+        help="file with one OWNER/NAME per line (# starts a comment)",
+    )
+    source.add_argument(
+        "--org",
+        action="append",
+        default=[],
+        help=(
+            "collect every repository of this org the token can push to; "
+            "may be repeated"
+        ),
+    )
+    source.add_argument(
+        "--match",
+        metavar="REGEX",
+        help="with --org, only keep repositories whose name matches REGEX",
+    )
+    source.add_argument(
+        "--include-private",
+        action="store_true",
+        help="with --org, also collect private repositories",
+    )
+    source.add_argument(
+        "--include-archived",
+        action="store_true",
+        help="with --org, also collect archived repositories",
+    )
+    source.add_argument(
+        "--include-forks",
+        action="store_true",
+        help="with --org, also collect forks",
+    )
+    output = parser.add_argument_group("output")
+    output.add_argument(
+        "--output-dir",
+        default="traffic-data",
+        metavar="DIR",
+        help="directory holding the CSV files (default: %(default)s)",
+    )
+    output.add_argument(
+        "--gist-id",
+        metavar="ID",
+        help="also merge into and publish to this existing GitHub Gist",
+    )
+    auth = parser.add_argument_group("authentication")
+    auth.add_argument(
+        "--token-env",
+        metavar="NAME",
+        help="environment variable holding the traffic token",
+    )
+    auth.add_argument(
+        "--gist-token-env",
+        metavar="NAME",
+        help=(
+            "environment variable holding the token used for the Gist "
+            f"(default: ${GIST_TOKEN_ENV_VARS[0]}, else the traffic token)"
+        ),
+    )
+    auth.add_argument(
+        "--api-url",
+        default=API_URL,
+        help="GitHub API base URL (default: %(default)s)",
+    )
+    return parser
+
+
+def main(argv=None, environ=None, transport=None, today=None, stdout=None, stderr=None):
+    """Runs the collector. Returns 0 on success, 1 if any repository failed
+    and 2 for configuration errors."""
+    environ = os.environ if environ is None else environ
+    transport = transport or urllib_transport
+    stdout = stdout or sys.stdout
+    stderr = stderr or sys.stderr
+    args = build_parser().parse_args(argv)
+
+    def error(message):
+        print("error: " + message, file=stderr)
+        return 2
+
+    token_vars = [args.token_env] if args.token_env else list(TOKEN_ENV_VARS)
+    _, token = _find_token(environ, token_vars)
+    if not token:
+        return error("no token found; set $" + " or $".join(token_vars))
+    client = GitHubClient(token, api_url=args.api_url, transport=transport)
+
+    pattern = None
+    if args.match:
+        try:
+            pattern = re.compile(args.match)
+        except re.error as e:
+            return error(f"invalid --match: {e}")
+
+    repos = list(args.repo)
+    try:
+        if args.repos_file:
+            repos.extend(read_repos_file(args.repos_file))
+    except OSError as e:
+        return error(str(e))
+    for repo in repos:
+        if not _REPO_RE.match(repo):
+            return error(f"invalid repository {repo!r}, expected OWNER/NAME")
+    try:
+        for org in args.org:
+            repos.extend(
+                list_org_repos(
+                    client,
+                    org,
+                    include_private=args.include_private,
+                    include_archived=args.include_archived,
+                    include_forks=args.include_forks,
+                    pattern=pattern,
+                )
+            )
+    except GitHubError as e:
+        return error(str(e))
+    repos = list(dict.fromkeys(repos))
+    if not repos:
+        return error("no repositories to collect; use --repo, --repos-file or --org")
+
+    stores = []
+    if args.output_dir:
+        stores.append(DirectoryStore(args.output_dir))
+    if args.gist_id:
+        gist_vars = (
+            [args.gist_token_env] if args.gist_token_env else list(GIST_TOKEN_ENV_VARS)
+        )
+        _, gist_token = _find_token(environ, gist_vars)
+        gist_client = GitHubClient(
+            gist_token or token, api_url=args.api_url, transport=transport
+        )
+        stores.append(GistStore(gist_client, args.gist_id))
+    if not stores:
+        return error("nothing to write; set --output-dir and/or --gist-id")
+
+    # Load existing data first so a bad Gist ID fails before any collection.
+    loaded = []
+    try:
+        for store in stores:
+            loaded.append(store.load())
+            for name in loaded[-1]:
+                TABLES_BY_NAME[name].parse(loaded[-1][name])
+    except (OSError, ValueError, GitHubError) as e:
+        return error(f"cannot read {store}: {e}")
+
+    collected = today or datetime.datetime.now(datetime.timezone.utc).date().isoformat()
+    new_rows = {t.name: [] for t in TABLES}
+    failures = []
+    for repo in repos:
+        try:
+            traffic = fetch_traffic(client, repo)
+        except GitHubError as e:
+            failures.append(repo)
+            print(f"warning: {repo}: {e}{_push_access_hint(e)}", file=stderr)
+            continue
+        for name, rows in traffic_to_rows(repo, traffic, collected).items():
+            new_rows[name].extend(rows)
+
+    if len(failures) == len(repos):
+        print("error: no traffic could be collected", file=stderr)
+        return 1
+
+    files = merge_tables(loaded, new_rows)
+    try:
+        for store in stores:
+            store.save(files)
+    except (OSError, GitHubError) as e:
+        print(f"error: cannot write {store}: {e}", file=stderr)
+        return 1
+
+    stdout.write(format_summary(new_rows["summary.csv"]))
+    written = ", ".join(str(s) for s in stores)
+    print(
+        f"collected {len(repos) - len(failures)} of {len(repos)} repositories "
+        f"on {collected}; wrote {written}",
+        file=stderr,
+    )
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
