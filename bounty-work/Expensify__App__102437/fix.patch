+jest.mock('@hooks/useEnvironment', () => () => ({environmentURL: 'https://dev.new.expensify.com:8082'}));
+jest.mock('@libs/Navigation/helpers/getStateFromPath', () => () => ({routes: [{name: jest.requireActual<{default: typeof SCREENS}>('@src/SCREENS').default.SETTINGS.SECURITY}]}));
+
