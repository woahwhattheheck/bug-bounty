+QListWidgetItem *FindSceneItem(SceneTree *tree, obs_source_t *source)
+{
+	obs_scene_t *scene = obs_scene_from_source(source);
+
+	if (!scene) {
+		return nullptr;
+	}
+
+	for (int i = 0; i < tree->count(); i++) {
+		QListWidgetItem *item = tree->item(i);
+
+		if (!SceneTree::IsFolder(item) && GetOBSRef<OBSScene>(item) == scene) {
+			return item;
+		}
+	}
+
+	return nullptr;
+}
+
+std::string GetSerializedLayout(SceneTree *tree)
+{
+	return OBS::SerializeSceneTreeLayout(tree->GetLayout());
+}
+
+} // namespace
+
+void OBSBasic::LoadSceneFolders(obs_data_t *data)
+{
+	OBSDataArrayAutoRelease folderArray = obs_data_get_array(data, OBS::sceneFoldersKey);
+	vector<OBS::SceneFolderInfo> folders = OBS::LoadSceneFolders(folderArray);
+
+	vector<string> sceneOrder;
+	OBS::SceneFolderMembership membership;
+
+	for (int i = 0; i < ui->scenes->count(); i++) {
+		QListWidgetItem *item = ui->scenes->item(i);
+
+		if (SceneTree::IsFolder(item)) {
+			continue;
+		}
+
+		OBSScene scene = GetOBSRef<OBSScene>(item);
+		obs_source_t *source = obs_scene_get_source(scene);
+		string name = QT_TO_UTF8(item->text());
+		sceneOrder.push_back(name);
+
+		OBSDataAutoRelease privateSettings = obs_source_get_private_settings(source);
+		const char *folder = obs_data_get_string(privateSettings, OBS::sceneFolderPrivateKey);
+
+		if (folder && *folder) {
+			membership[name] = folder;
+		}
+	}
+
+	/* Collections without folders keep their list exactly as it is */
+	if (folders.empty() && membership.empty()) {
+		return;
+	}
+
+	ui->scenes->ApplyLayout(OBS::BuildSceneTreeLayout(sceneOrder, membership, folders));
+}
+
+obs_data_array_t *OBSBasic::SaveSceneFolders()
+{
+	return OBS::SaveSceneFolders(OBS::GetSceneFolders(ui->scenes->GetLayout()));
+}
+
+void OBSBasic::UpdateSceneFolderSettings()
+{
+	/* Folder membership is mirrored to each scene's private settings so that
+	 * it survives being saved by versions of OBS without scene folders, and
+	 * travels with the scene through undo/redo of scene removal. */
+	QString folderName;
+
+	for (int i = 0; i < ui->scenes->count(); i++) {
+		QListWidgetItem *item = ui->scenes->item(i);
+
+		if (SceneTree::IsFolder(item)) {
+			folderName = SceneTree::GetFolderName(item);
+			continue;
+		}
+
+		OBSScene scene = GetOBSRef<OBSScene>(item);
+		OBSDataAutoRelease privateSettings = obs_source_get_private_settings(obs_scene_get_source(scene));
+
+		if (!privateSettings) {
+			continue;
+		}
+
+		if (SceneTree::IsInFolder(item) && !folderName.isEmpty()) {
+			obs_data_set_string(privateSettings, OBS::sceneFolderPrivateKey, QT_TO_UTF8(folderName));
+		} else if (obs_data_has_user_value(privateSettings, OBS::sceneFolderPrivateKey)) {
+			obs_data_erase(privateSettings, OBS::sceneFolderPrivateKey);
+		}
+	}
+}
+
+void OBSBasic::SceneTreeChanged(bool sceneOrderChanged)
+{
+	UpdateSceneFolderSettings();
+	SaveProject();
+
+	if (sceneOrderChanged) {
+		OBSProjector::UpdateMultiviewProjectors();
+		OnEvent(OBS_FRONTEND_EVENT_SCENE_LIST_CHANGED);
+	}
+}
+
+void OBSBasic::SelectCurrentSceneItem()
+{
+	QListWidgetItem *item = FindSceneItem(ui->scenes, GetCurrentSceneSource());
+
+	if (item) {
+		QSignalBlocker blocker(ui->scenes);
+		ui->scenes->setCurrentItem(item);
+	}
+}
+
+void OBSBasic::ApplySceneTreeLayout(const std::string &layoutJson)
+{
+	OBS::SceneTreeLayout layout = OBS::DeserializeSceneTreeLayout(layoutJson.c_str());
+
+	/* Expanding or collapsing folders is not an undoable action, so keep
+	 * the current state of folders that still exist */
+	for (OBS::SceneTreeEntry &entry : layout) {
+		QListWidgetItem *folder = entry.type == OBS::SceneTreeEntry::Type::Folder
+						  ? ui->scenes->FindFolder(QString::fromStdString(entry.name))
+						  : nullptr;
+
+		if (folder) {
+			entry.isCollapsed = ui->scenes->IsFolderCollapsed(folder);
+		}
+	}
+
+	ui->scenes->ApplyLayout(layout);
+
+	if (!ui->scenes->currentItem()) {
+		SelectCurrentSceneItem();
+	}
+
+	SceneTreeChanged(true);
+}
+
+void OBSBasic::AddSceneTreeUndoAction(const QString &actionName, const std::string &undoLayout,
+				      const std::string &redoLayout)
+{
+	if (undoLayout == redoLayout) {
+		return;
+	}
+
+	auto applyLayout = [this](const std::string &layout) {
+		ApplySceneTreeLayout(layout);
+	};
+
+	undo_s.add_action(actionName, applyLayout, applyLayout, undoLayout, redoLayout);
+}
+
+void OBSBasic::SceneTreeEdited(const QString &undoLayout, const QString &redoLayout)
+{
+	AddSceneTreeUndoAction(QTStr("Undo.Scenes.Reorder"), undoLayout.toStdString(), redoLayout.toStdString());
+	SceneTreeChanged(true);
+}
+
+bool OBSBasic::QuerySceneFolderName(const QString &title, const QString &text, QString &name,
+				    const QString &placeHolder)
+{
+	for (;;) {
+		string userInput;
+
+		if (!NameDialog::AskForName(this, title, text, userInput, placeHolder)) {
+			return false;
+		}
+
+		name = QT_UTF8(userInput.c_str()).trimmed();
+
+		if (name.isEmpty()) {
+			OBSMessageBox::warning(this, QTStr("NoNameEntered.Title"), QTStr("NoNameEntered.Text"));
+			continue;
+		}
+
+		if (ui->scenes->FindFolder(name)) {
+			OBSMessageBox::warning(this, QTStr("NameExists.Title"),
+					       QTStr("Basic.Main.SceneFolder.NameExists.Text"));
+			continue;
+		}
+
+		return true;
+	}
+}
+
+QString OBSBasic::GetNewSceneFolderPlaceHolder() const
+{
+	QString format = QTStr("Basic.Main.SceneFolder.DefaultName");
+	int i = 1;
+
+	while (ui->scenes->FindFolder(format.arg(i))) {
+		i++;
+	}
+
+	return format.arg(i);
+}
+
+void OBSBasic::AddSceneFolder()
+{
+	QString name;
+
+	if (!QuerySceneFolderName(QTStr("Basic.Main.SceneFolder.AddDlg.Title"),
+				  QTStr("Basic.Main.SceneFolder.AddDlg.Text"), name, GetNewSceneFolderPlaceHolder())) {
+		return;
+	}
+
+	const string undoLayout = GetSerializedLayout(ui->scenes);
+	ui->scenes->AddFolder(name, ui->scenes->GetNewFolderRow());
+	const string redoLayout = GetSerializedLayout(ui->scenes);
+
+	AddSceneTreeUndoAction(QTStr("Undo.Add").arg(name), undoLayout, redoLayout);
+	SceneTreeChanged(false);
+
+	blog(LOG_INFO, "User added scene folder '%s'", QT_TO_UTF8(name));
+}
+
+void OBSBasic::RemoveSceneFolder(QListWidgetItem *folder, bool askForConfirmation)
+{
+	if (!SceneTree::IsFolder(folder)) {
+		return;
+	}
+
+	const QString name = SceneTree::GetFolderName(folder);
+
+	if (askForConfirmation && !ui->scenes->GetFolderScenes(folder).isEmpty()) {
+		QMessageBox::StandardButton button =
+			OBSMessageBox::question(this, QTStr("ConfirmRemove.Title"),
+						QTStr("Basic.Main.SceneFolder.ConfirmRemove.Text").arg(name));
+
+		if (button != QMessageBox::Yes) {
+			return;
+		}
+	}
+
+	const bool wasCurrent = ui->scenes->currentItem() == folder;
+	const string undoLayout = GetSerializedLayout(ui->scenes);
+	ui->scenes->RemoveFolder(folder);
+	const string redoLayout = GetSerializedLayout(ui->scenes);
+
+	if (wasCurrent) {
+		SelectCurrentSceneItem();
+	}
+
+	AddSceneTreeUndoAction(QTStr("Undo.Delete").arg(name), undoLayout, redoLayout);
+	SceneTreeChanged(false);
+
+	blog(LOG_INFO, "User removed scene folder '%s'", QT_TO_UTF8(name));
+}
+
+void OBSBasic::SceneFolderNameEdited(QListWidgetItem *folder, const QString &name)
+{
+	const QString previousName = SceneTree::GetFolderName(folder);
+
+	if (name == previousName) {
+		folder->setText(previousName);
+		return;
+	}
+
+	if (name.isEmpty() || ui->scenes->FindFolder(name)) {
+		folder->setText(previousName);
+
+		if (name.isEmpty()) {
+			OBSMessageBox::warning(this, QTStr("NoNameEntered.Title"), QTStr("NoNameEntered.Text"));
+		} else {
+			OBSMessageBox::warning(this, QTStr("NameExists.Title"),
+					       QTStr("Basic.Main.SceneFolder.NameExists.Text"));
+		}
+		return;
+	}
+
+	const string undoLayout = GetSerializedLayout(ui->scenes);
+	ui->scenes->RenameFolder(folder, name);
+	const string redoLayout = GetSerializedLayout(ui->scenes);
+
+	AddSceneTreeUndoAction(QTStr("Undo.Rename").arg(name), undoLayout, redoLayout);
+	SceneTreeChanged(false);
+}
+
+bool OBSBasic::MoveSceneToFolder(obs_source_t *scene, const QString &folderName, bool addUndoAction)
+{
+	QListWidgetItem *sceneItem = FindSceneItem(ui->scenes, scene);
+
+	if (!sceneItem) {
+		return false;
+	}
+
+	QListWidgetItem *previousFolder = ui->scenes->GetFolderOf(sceneItem);
+	QListWidgetItem *folder = folderName.isEmpty() ? nullptr : ui->scenes->FindFolder(folderName);
+
+	if (folder && folder == previousFolder) {
+		return true;
+	} else if (!folder && !previousFolder && folderName.isEmpty()) {
+		return true;
+	}
+
+	const string undoLayout = GetSerializedLayout(ui->scenes);
+
+	if (!folderName.isEmpty() && !folder) {
+		folder = ui->scenes->AddFolder(folderName, ui->scenes->GetNewFolderRow());
+	}
+
+	ui->scenes->MoveSceneToFolder(sceneItem, folder);
+
+	const string redoLayout = GetSerializedLayout(ui->scenes);
+
+	if (addUndoAction) {
+		const QString sceneName = QT_UTF8(obs_source_get_name(scene));
+		QString actionName = folder ? QTStr("Undo.SceneFolder.Move").arg(sceneName, folderName)
+					    : QTStr("Undo.SceneFolder.MoveOut")
+						      .arg(sceneName, SceneTree::GetFolderName(previousFolder));
+
+		AddSceneTreeUndoAction(actionName, undoLayout, redoLayout);
+	}
+
+	SceneTreeChanged(true);
+	return true;
+}
+
+void OBSBasic::AddSceneFolderMenu(QMenu &popup, QListWidgetItem *sceneItem)
+{
+	QMenu *moveMenu = popup.addMenu(QTStr("Basic.Main.SceneFolder.MoveTo"));
+	QListWidgetItem *currentFolder = ui->scenes->GetFolderOf(sceneItem);
+	OBSSource scene = obs_scene_get_source(GetOBSRef<OBSScene>(sceneItem));
+
+	QAction *noFolder = moveMenu->addAction(QTStr("Basic.Main.SceneFolder.MoveTo.None"), this,
+						[this, scene]() { MoveSceneToFolder(scene, QString(), true); });
+	noFolder->setCheckable(true);
+	noFolder->setChecked(!currentFolder);
+
+	QList<QListWidgetItem *> folders = ui->scenes->GetFolders();
+
+	if (!folders.isEmpty()) {
+		moveMenu->addSeparator();
+	}
+
+	for (QListWidgetItem *folder : folders) {
+		QString folderName = SceneTree::GetFolderName(folder);
+		QAction *action = moveMenu->addAction(folderName, this, [this, scene, folderName]() {
+			MoveSceneToFolder(scene, folderName, true);
+		});
+		action->setCheckable(true);
+		action->setChecked(folder == currentFolder);
+	}
+
+	moveMenu->addSeparator();
+	moveMenu->addAction(QTStr("Basic.Main.SceneFolder.MoveTo.New"), this, [this, scene]() {
+		QString name;
+
+		if (QuerySceneFolderName(QTStr("Basic.Main.SceneFolder.AddDlg.Title"),
+					 QTStr("Basic.Main.SceneFolder.AddDlg.Text"), name,
+					 GetNewSceneFolderPlaceHolder())) {
+			MoveSceneToFolder(scene, name, true);
+		}
+	});
+}
+
+void OBSBasic::AddSceneFolderContextMenu(QMenu &popup, QListWidgetItem *folder)
+{
+	popup.addAction(QTStr("AddScene") + "...", this, &OBSBasic::on_actionAddScene_triggered);
+	popup.addAction(QTStr("Basic.Main.SceneFolder.Add") + "...", this, &OBSBasic::AddSceneFolder);
+	popup.addSeparator();
+
+	const bool isCollapsed = ui->scenes->IsFolderCollapsed(folder);
+	popup.addAction(QTStr(isCollapsed ? "Basic.Main.SceneFolder.Expand" : "Basic.Main.SceneFolder.Collapse"), this,
+			[this, isCollapsed]() {
+				QListWidgetItem *current = ui->scenes->currentItem();
+
+				if (SceneTree::IsFolder(current)) {
+					ui->scenes->SetFolderCollapsed(current, !isCollapsed);
+				}
+			});
+	popup.addAction(QTStr("Basic.Main.SceneFolder.ExpandAll"), this,
+			[this]() { ui->scenes->SetAllFoldersCollapsed(false); });
+	popup.addAction(QTStr("Basic.Main.SceneFolder.CollapseAll"), this,
+			[this]() { ui->scenes->SetAllFoldersCollapsed(true); });
+	popup.addSeparator();
+
+	popup.addAction(renameScene);
+	popup.addAction(QTStr("Basic.Main.SceneFolder.Remove"), this, [this]() {
+		QListWidgetItem *current = ui->scenes->currentItem();
+
+		if (SceneTree::IsFolder(current)) {
+			RemoveSceneFolder(current, true);
+		}
+	});
+	popup.addSeparator();
+
+	QMenu *order = popup.addMenu(QTStr("Basic.MainMenu.Edit.Order"));
+	order->addAction(QTStr("Basic.MainMenu.Edit.Order.MoveUp"), this, &OBSBasic::on_actionSceneUp_triggered);
+	order->addAction(QTStr("Basic.MainMenu.Edit.Order.MoveDown"), this, &OBSBasic::on_actionSceneDown_triggered);
+	order->addSeparator();
+	order->addAction(QTStr("Basic.MainMenu.Edit.Order.MoveToTop"), this, &OBSBasic::MoveSceneToTop);
+	order->addAction(QTStr("Basic.MainMenu.Edit.Order.MoveToBottom"), this, &OBSBasic::MoveSceneToBottom);
+	popup.addSeparator();
+
+	/* Toggle "Show in Multiview" for every scene of the folder at once */
+	vector<OBSSource> scenes;
+	bool isAllShown = true;
+
+	for (QListWidgetItem *sceneItem : ui->scenes->GetFolderScenes(folder)) {
+		OBSSource source = obs_scene_get_source(GetOBSRef<OBSScene>(sceneItem));
+		OBSDataAutoRelease privateSettings = obs_source_get_private_settings(source);
+
+		obs_data_set_default_bool(privateSettings, "show_in_multiview", true);
+		isAllShown = isAllShown && obs_data_get_bool(privateSettings, "show_in_multiview");
+		scenes.push_back(source);
+	}
+
+	QAction *multiviewAction = popup.addAction(QTStr("Basic.Main.SceneFolder.ShowInMultiview"));
+	multiviewAction->setCheckable(true);
+	multiviewAction->setChecked(!scenes.empty() && isAllShown);
