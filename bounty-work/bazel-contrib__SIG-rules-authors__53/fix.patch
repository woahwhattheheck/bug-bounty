+class MainTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+        self.out_dir = os.path.join(self.tmp.name, "data")
+
+    def _run(self, argv, transport, today, environ=None):
+        stdout, stderr = io.StringIO(), io.StringIO()
+        code = github_traffic.main(
+            argv,
+            environ={"GITHUB_TRAFFIC_TOKEN": "t"} if environ is None else environ,
+            transport=transport,
+            today=today,
+            stdout=stdout,
+            stderr=stderr,
+        )
+        return code, stdout.getvalue(), stderr.getvalue()
+
+    def _read(self, name):
+        with open(os.path.join(self.out_dir, name), encoding="utf-8") as f:
+            return f.read()
+
+    def test_requires_token_from_environment(self):
+        code, _, err = self._run(
+            ["--repo", "o/r", "--output-dir", self.out_dir],
+            FakeTransport(),
