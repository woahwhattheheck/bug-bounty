@@ -0,0 +1,151 @@
+import { expect } from 'chai';
+
+import {
+  composeMilestonePost,
+  composeMonthlyStatsPost,
+  composeNewContributorPost,
+  getHighestMilestoneReached,
+} from '../../../../server/lib/microblogging/posts';
+import { buildPostText, countPostCharacters, neutralizeUserInput } from '../../../../server/lib/microblogging/text';
+
+const MASTODON_LIMITS = { maxCharacters: 500, charactersReservedPerUrl: 23 };
+const ZWSP = '​';
+
+describe('server/lib/microblogging/posts', () => {
+  describe('countPostCharacters', () => {
+    it('counts characters like Mastodon', () => {
+      expect(countPostCharacters('Hello', MASTODON_LIMITS)).to.eq(5);
+      // URLs always count for 23 characters
+      expect(
+        countPostCharacters('https://opencollective.com/a-very-long-collective-slug-for-testing', MASTODON_LIMITS),
+      ).to.eq(23);
+      // Remote mentions only count their local part
+      expect(countPostCharacters('Hi @alice@fosstodon.org!', MASTODON_LIMITS)).to.eq('Hi @alice!'.length);
+      // Emojis (including multi code points ones) count for one character
+      expect(countPostCharacters('🎉👩‍💻', MASTODON_LIMITS)).to.eq(2);
+    });
+  });
+
+  describe('buildPostText', () => {
+    const url = 'https://opencollective.com/babel';
+
+    it('appends the URL when everything fits', () => {
+      expect(buildPostText('Thank you!', url, MASTODON_LIMITS)).to.eq(`Thank you!\n\n${url}`);
+      expect(buildPostText('Thank you!', null, MASTODON_LIMITS)).to.eq('Thank you!');
+    });
+
+    it('shortens the body but never the URL', () => {
+      const limits = { maxCharacters: 60, charactersReservedPerUrl: 23 };
+      const text = buildPostText('🎉 '.repeat(100), url, limits);
+      expect(text.endsWith(`…\n\n${url}`)).to.be.true;
+      expect(countPostCharacters(text, limits)).to.be.at.most(60);
+      expect(countPostCharacters(text, limits)).to.be.at.least(58);
+    });
+  });
+
+  describe('neutralizeUserInput', () => {
+    it('prevents mentions, hashtags, links and line breaks', () => {
+      const result = neutralizeUserInput('Spam @everyone@evil.example #ad\nhttps://evil.example');
+      expect(result).to.eq(`Spam @${ZWSP}everyone@${ZWSP}evil.example #${ZWSP}ad https:${ZWSP}//evil.example`);
+    });
+
+    it('strips invisible characters and limits the length', () => {
+      expect(neutralizeUserInput('A‮b​c')).to.eq('A b c');
+      expect(neutralizeUserInput('x'.repeat(100), 10)).to.eq(`${'x'.repeat(10)}…`);
+      expect(neutralizeUserInput(null)).to.eq('');
+    });
+  });
+
+  describe('composeNewContributorPost', () => {
+    it('thanks the contributor and mentions their fediverse handle', () => {
+      const post = composeNewContributorPost({
+        collectiveName: 'Babel',
+        contributorName: 'Alice',
+        contributorHandle: '@alice@fosstodon.org',
+        amount: 1000,
+        currency: 'USD',
+        interval: 'month',
+      });
+      expect(post).to.eq(
+        '💖 Welcome to Alice (@alice@fosstodon.org), who just joined Babel as a financial contributor!\n\nThank you for your $10/month contribution 🙏',
+      );
+    });
+
+    it('never names incognito contributors', () => {
+      const post = composeNewContributorPost({
+        collectiveName: 'Babel',
+        contributorName: 'Secret Person',
+        isIncognito: true,
+        amount: 2550,
+        currency: 'EUR',
+      });
+      expect(post).to.include('an anonymous financial contributor');
+      expect(post).to.include('€25.50 contribution');
+      expect(post).to.not.include('Secret Person');
+    });
+
+    it('handles zero-decimal currencies and missing amounts', () => {
+      expect(
+        composeNewContributorPost({ collectiveName: 'Babel', contributorName: 'Bob', amount: 1500, currency: 'JPY' }),
+      ).to.include('¥15 contribution');
+      expect(composeNewContributorPost({ collectiveName: 'Babel', contributorName: '' })).to.include(
+        'Welcome to a new financial contributor',
+      );
+    });
+  });
+
+  describe('composeMilestonePost', () => {
+    it('celebrates the number of contributors', () => {
+      expect(composeMilestonePost({ collectiveName: 'Babel', milestone: 1000 })).to.eq(
+        '🎉 Babel just reached 1,000 financial contributors! 🙌\n\nThank you all for your support. Join them:',
+      );
+    });
+  });
+
+  describe('getHighestMilestoneReached', () => {
+    it('returns the highest milestone reached', () => {
+      expect(getHighestMilestoneReached(0)).to.eq(0);
+      expect(getHighestMilestoneReached(9)).to.eq(0);
+      expect(getHighestMilestoneReached(10)).to.eq(10);
+      expect(getHighestMilestoneReached(99)).to.eq(50);
+      expect(getHighestMilestoneReached(123456)).to.eq(10000);
+    });
+  });
+
+  describe('composeMonthlyStatsPost', () => {
+    const stats = {
+      period: 'September 2026',
+      currency: 'USD',
+      totalReceived: 125000,
+      totalSpent: -40050,
+      balance: 300000,
+      newContributors: 3,
+      activeContributors: 42,
+    };
+
+    it('summarizes the month', () => {
+      expect(composeMonthlyStatsPost({ collectiveName: 'Babel', stats })).to.eq(
+        [
+          '📊 Babel in September 2026:',
+          '',
+          '💰 $1,250 received from 42 financial contributors',
+          '👋 3 new contributors',
+          '💸 $400.50 spent',
+          '🏦 Current balance: $3,000',
+          '',
+          'Thank you! 🙏',
+        ].join('\n'),
+      );
+    });
+
+    it('has a call to action when nothing was received', () => {
+      const post = composeMonthlyStatsPost({
+        collectiveName: 'Babel',
+        stats: { ...stats, totalReceived: 0, totalSpent: 0, newContributors: 0, activeContributors: 0 },
+      });
+      expect(post).to.eq(
+        '📊 Babel in September 2026: no new contributions this month.\n\nOur current balance is $3,000. Become a financial contributor! 😃',
+      );
+    });
+  });
+});
