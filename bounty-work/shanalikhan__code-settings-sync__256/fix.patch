@@ -0,0 +1,121 @@
+import * as fs from "fs-extra";
+import * as path from "path";
+import * as recursiveRead from "recursive-readdir";
+
+import { CustomConfig } from "../../models/customConfig.model";
+import { ISyncService } from "../../models/ISyncService.model";
+import { LocalConfig } from "../../models/localConfig.model";
+import { IExtensionState } from "../../models/state.model";
+import { FileService } from "../file.service";
+
+/**
+ * Syncs the VS Code user settings folder to a plain folder (for example a
+ * folder inside OneDrive, Dropbox or a git checkout) instead of a GitHub gist.
+ * The target folder is read from `fileSystemPath` in syncLocalSettings.json.
+ */
+export class FileSystemService implements ISyncService {
+  constructor(private state: IExtensionState) {}
+
+  public async IsConfigured(): Promise<boolean> {
+    const localConfig = await this.state.commons.InitalizeSettings();
+    const folder = FileSystemService.ResolveFolder(localConfig);
+    return folder !== "" && (await fs.pathExists(folder));
+  }
+
+  /**
+   * Copies the syncable user settings files into the configured folder
+   */
+  public async Export(): Promise<void> {
+    const localConfig = await this.state.commons.InitalizeSettings();
+    const folder = FileSystemService.ResolveFolder(localConfig);
+    if (folder === "") {
+      return;
+    }
+    await this.state.watcher.HandleStopWatching();
+
+    const userFolder = this.state.environment.USER_FOLDER;
+    const files = await FileService.ListFiles(
+      userFolder,
+      localConfig.customConfig
+    );
+    await fs.ensureDir(folder);
+    for (const file of files) {
+      const relative = path.relative(userFolder, file.filePath);
+      if (!FileSystemService.IsInside(relative)) {
+        continue;
+      }
+      const target = path.join(folder, relative);
+      await fs.ensureDir(path.dirname(target));
+      await fs.writeFile(target, file.content);
+    }
+  }
+
+  /**
+   * Copies the files from the configured folder back into the user settings folder
+   */
+  public async Import(): Promise<void> {
+    const localConfig = await this.state.commons.InitalizeSettings();
+    const folder = FileSystemService.ResolveFolder(localConfig);
+    if (folder === "" || !(await fs.pathExists(folder))) {
+      return;
+    }
+    await this.state.watcher.HandleStopWatching();
+
+    const customConfig = localConfig.customConfig;
+    const userFolder = this.state.environment.USER_FOLDER;
+    const sources: string[] = await recursiveRead(folder, [
+      (file: string, stats: fs.Stats) =>
+        !stats.isDirectory() && FileSystemService.IsSkipped(file, customConfig)
+    ]);
+    for (const source of sources) {
+      const relative = path.relative(folder, source);
+      if (!FileSystemService.IsInside(relative)) {
+        continue;
+      }
+      const target = path.join(userFolder, relative);
+      await fs.ensureDir(path.dirname(target));
+      await fs.copy(source, target, { overwrite: true });
+    }
+  }
+
+  // Nothing to reset on a folder: the files stay where the user put them
+  public Reset(): Promise<void> {
+    return Promise.resolve();
+  }
+
+  public static ResolveFolder(localConfig: LocalConfig): string {
+    const folder =
+      localConfig && localConfig.customConfig
+        ? localConfig.customConfig.fileSystemPath
+        : "";
+    return folder ? folder.trim() : "";
+  }
+
+  public static IsInside(relativePath: string): boolean {
+    return (
+      relativePath !== "" &&
+      !path.isAbsolute(relativePath) &&
+      relativePath !== ".." &&
+      !relativePath.startsWith(".." + path.sep)
+    );
+  }
+
+  public static IsSkipped(file: string, customConfig: CustomConfig): boolean {
+    const extension = path.extname(file).slice(1);
+    if (!customConfig.supportedFileExtensions.includes(extension)) {
+      return true;
+    }
+    const fileName = path.basename(file);
+    const ignoredByName = customConfig.ignoreUploadFiles.some(pattern =>
+      pattern.endsWith(".*")
+        ? fileName.startsWith(pattern.slice(0, -1))
+        : pattern === fileName
+    );
+    if (ignoredByName) {
+      return true;
+    }
+    return file
+      .split(path.sep)
+      .some(segment => customConfig.ignoreUploadFolders.includes(segment));
+  }
+}
