+import adapterPackage from '../../../assets/adapters/musicbrainz.json';
+import artist from '../../../assets/adapters/musicbrainz/artist.json';
+import dashboard from '../../../assets/adapters/musicbrainz/dashboard.json';
+import recording from '../../../assets/adapters/musicbrainz/recording.json';
+import release from '../../../assets/adapters/musicbrainz/release.json';
+import releaseGroup from '../../../assets/adapters/musicbrainz/releaseGroup.json';
+import searchArtists from '../../../assets/adapters/musicbrainz/searchArtists.json';
+import searchRecordings from '../../../assets/adapters/musicbrainz/searchRecordings.json';
+import searchReleases from '../../../assets/adapters/musicbrainz/searchReleases.json';
+import submitRelease from '../../../assets/adapters/musicbrainz/submitRelease.json';
+import { buildMusicBrainzUrl } from '../../services/musicbrainz.service';
+import { mappingUtility } from '../mapping-block/mapping-util';
+import { MusicbrainzBlockComponent } from './musicbrainz-block.component';
+
+const SAMPLE_MBID = '87c5dedd-371d-4a53-9f7f-80522fb7f3cb';
+
+const flows: Record<string, any> = {
+  artist, dashboard, recording, release, releaseGroup, searchArtists, searchRecordings, searchReleases, submitRelease
+};
+
+/** All blocks of a Flow, including nested ones (multi batches, grid cell renderers, buttons) */
+function allBlocks(blocks: any[]): any[] {
+  return (blocks || []).reduce((found, block) => [
+    ...found,
+    block,
+    ...allBlocks(block.blocks),
+    ...(block.batches || []).reduce((a, batch) => [...a, ...allBlocks(batch.blocks)], []),
+    ...(block.buttons || []).reduce((a, button) => [...a, ...allBlocks(button.blocks)], []),
+    ...(block.columnDefs || []).reduce((a, col) => [...a, ...allBlocks(col.cellRendererParams?.blocks)], [])
+  ], []);
+}
+
+describe('MusicBrainz demo Flows', () => {
+
+  it('are packaged as an installable adapter that matches the Flow files', () => {
+    const pkg: any = adapterPackage;
+    expect(pkg.name).toEqual('musicbrainz');
+    expect(pkg.workflow.map(w => w.workflowId).sort()).toEqual(Object.keys(flows).sort());
+    pkg.workflow.forEach(w => {
+      expect(pkg.attachments[w.config]).withContext(w.workflowId).toEqual(flows[w.workflowId]);
+      expect(w.title).toEqual(flows[w.workflowId].title);
+    });
+    [pkg.dashboard, ...pkg.services].forEach(entry => expect(flows[entry.workflowId]).withContext(entry.workflowId).toBeDefined());
+  });
+
+  it('only send requests that are valid for the MusicBrainz web service', () => {
+    const sampleData = { artist: 'Björk', release: 'Homogenic', recording: 'Jóga', id: SAMPLE_MBID };
+    let checked = 0;
+    Object.keys(flows).forEach(id => {
+      allBlocks(flows[id].blocks)
+        .filter(block => block.type === 'musicbrainz' && block.operation !== 'seed-release')
+        .forEach(block => {
+          const component = new MusicbrainzBlockComponent(null);
+          component.config = block;
+          component.context = { queryParams: { mbid: SAMPLE_MBID } };
+          const request = component.buildRequest(block.operation, sampleData);
+          expect(component.isIncomplete(request)).withContext(id).toBeFalse();
+          expect(() => buildMusicBrainzUrl(request)).withContext(`${id}: ${JSON.stringify(request)}`).not.toThrow();
+          checked++;
+        });
+    });
+    expect(checked).toBeGreaterThanOrEqual(10);
+  });
+
+  it('only link to MusicBrainz Flows that exist', () => {
+    let checked = 0;
+    Object.keys(flows).forEach(id => {
+      allBlocks(flows[id].blocks)
+        .filter(block => block.type === 'link-action')
+        .forEach(block => {
+          const target = block.workflowIdGetter
+            ? mappingUtility({ data: { id: SAMPLE_MBID }, context: {} }, block.workflowIdGetter)
+            : block.workflowId;
+          expect(block.adapterName).toEqual('musicbrainz');
+          expect(flows[String(target).split('?')[0]]).withContext(`${id} -> ${target}`).toBeDefined();
+          checked++;
+        });
+    });
+    expect(checked).toBeGreaterThanOrEqual(8);
+  });
+});
