+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/host/EventLoop.hpp b/plugins/obs-vst3/host/EventLoop.hpp
new file mode 100644
index 0000000..4f94e6a
--- /dev/null
+++ b/plugins/obs-vst3/host/EventLoop.hpp
@@ -0,0 +1,54 @@
+#pragma once
+
+#include "../bridge/BridgeProtocol.hpp"
+
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace Steinberg {
+class FUnknown;
+class IPlugView;
+} // namespace Steinberg
+
+namespace obs_vst3 {
+
+class EditorWindow;
+class IpcChannel;
+
+/*
+ * Main thread event loop of the bridge process. It services the command
+ * channel, the windowing system of the platform (needed by plug-in editors)
+ * and a periodic idle callback. All callbacks are invoked on the thread that
+ * called run(), which is the "UI thread" in VST3 terms.
+ */
+class EventLoop {
+public:
+	using CommandHandler = std::function<void(Command command, const std::vector<uint8_t> &payload)>;
+	using IdleHandler = std::function<void()>;
+	using CloseHandler = std::function<void()>;
+
+	static std::unique_ptr<EventLoop> create();
+
+	virtual ~EventLoop() = default;
+
+	/* Runs until quit() is called or the command channel is closed by OBS. */
+	virtual void run(IpcChannel &commandChannel, const CommandHandler &onCommand, const IdleHandler &onIdle) = 0;
+	virtual void quit() = 0;
+
+	/*
+	 * Opens a top-level window and attaches the plug-in view to it. onCloseRequested
+	 * is called when the user closes the window; the owner then destroys the window.
+	 */
+	virtual std::unique_ptr<EditorWindow> openEditor(Steinberg::IPlugView *view, const std::string &title,
+							 CloseHandler onCloseRequested, std::string &error) = 0;
+
+	/*
+	 * Platform run loop interface plug-ins may query from the host context
+	 * (Steinberg::Linux::IRunLoop on Linux), or nullptr.
+	 */
+	virtual Steinberg::FUnknown *platformRunLoop() { return nullptr; }
+};
+
+} // namespace obs_vst3
