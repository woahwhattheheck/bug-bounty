diff --git a/test/cmocka/test_scene_tree_layout.cpp b/test/cmocka/test_scene_tree_layout.cpp
new file mode 100644
index 0000000..8586f97
--- /dev/null
+++ b/test/cmocka/test_scene_tree_layout.cpp
@@ -0,0 +1,280 @@
+#include <stdarg.h>
+#include <stddef.h>
+#include <setjmp.h>
+
+extern "C" {
+#include <cmocka.h>
+}
+
+#include <models/SceneTreeLayout.hpp>
+
+#include <obs.hpp>
+
+#include <string>
+#include <vector>
+
+using OBS::SceneFolderInfo;
+using OBS::SceneFolderMembership;
+using OBS::SceneTreeEntry;
+using OBS::SceneTreeLayout;
+
+static SceneTreeEntry Scene(const char *name)
+{
+	SceneTreeEntry entry;
+	entry.type = SceneTreeEntry::Type::Scene;
+	entry.name = name;
+	return entry;
+}
+
+static SceneTreeEntry Folder(const char *name, bool isCollapsed, std::vector<std::string> scenes)
+{
+	SceneTreeEntry entry;
+	entry.type = SceneTreeEntry::Type::Folder;
+	entry.name = name;
+	entry.isCollapsed = isCollapsed;
+	entry.scenes = std::move(scenes);
+	return entry;
+}
+
+/* Writes a layout the same way the frontend saves a scene collection: flat
+ * "scene_order", "scene_folders" and the folder name in each scene's private
+ * settings. Returns the collection JSON. */
+static std::string SaveCollection(const SceneTreeLayout &layout)
+{
+	OBSDataAutoRelease collection = obs_data_create();
+	OBSDataArrayAutoRelease sceneOrder = obs_data_array_create();
+	OBSDataArrayAutoRelease sources = obs_data_array_create();
+	SceneFolderMembership membership = OBS::GetSceneFolderMembership(layout);
+
+	for (const std::string &name : OBS::GetSceneOrder(layout)) {
+		OBSDataAutoRelease orderEntry = obs_data_create();
+		obs_data_set_string(orderEntry, "name", name.c_str());
+		obs_data_array_push_back(sceneOrder, orderEntry);
+
+		OBSDataAutoRelease source = obs_data_create();
+		OBSDataAutoRelease privateSettings = obs_data_create();
+		auto it = membership.find(name);
+
+		if (it != membership.end()) {
+			obs_data_set_string(privateSettings, OBS::sceneFolderPrivateKey, it->second.c_str());
+		}
+
+		obs_data_set_string(source, "name", name.c_str());
+		obs_data_set_string(source, "id", "scene");
+		obs_data_set_obj(source, "private_settings", privateSettings);
+		obs_data_array_push_back(sources, source);
+	}
+
+	OBSDataArrayAutoRelease folders = OBS::SaveSceneFolders(OBS::GetSceneFolders(layout));
+
+	obs_data_set_array(collection, "scene_order", sceneOrder);
+	obs_data_set_array(collection, "sources", sources);
+	obs_data_set_array(collection, OBS::sceneFoldersKey, folders);
+	return obs_data_get_json(collection);
+}
+
+/* Loads a collection JSON the same way the frontend does */
+static SceneTreeLayout LoadCollection(const std::string &json)
+{
+	OBSDataAutoRelease collection = obs_data_create_from_json(json.c_str());
+	OBSDataArrayAutoRelease sceneOrder = obs_data_get_array(collection, "scene_order");
+	OBSDataArrayAutoRelease sources = obs_data_get_array(collection, "sources");
+	OBSDataArrayAutoRelease folders = obs_data_get_array(collection, OBS::sceneFoldersKey);
+
+	std::vector<std::string> order;
+	SceneFolderMembership membership;
+
+	for (size_t i = 0; i < obs_data_array_count(sceneOrder); i++) {
+		OBSDataAutoRelease entry = obs_data_array_item(sceneOrder, i);
+		order.push_back(obs_data_get_string(entry, "name"));
+	}
+
+	for (size_t i = 0; i < obs_data_array_count(sources); i++) {
+		OBSDataAutoRelease source = obs_data_array_item(sources, i);
+		OBSDataAutoRelease privateSettings = obs_data_get_obj(source, "private_settings");
+		const char *folder = obs_data_get_string(privateSettings, OBS::sceneFolderPrivateKey);
+
+		if (*folder) {
+			membership[obs_data_get_string(source, "name")] = folder;
+		}
+	}
+
+	return OBS::BuildSceneTreeLayout(order, membership, OBS::LoadSceneFolders(folders));
+}
+
+/* Simulates an older version of OBS loading and re-saving the collection: it
+ * only knows "scene_order" and "sources" and writes everything else from
+ * scratch, so "scene_folders" is lost while private settings are kept. */
+static std::string ResaveWithOlderVersion(const std::string &json, std::vector<std::string> *loadedScenes)
+{
+	OBSDataAutoRelease collection = obs_data_create_from_json(json.c_str());
+	OBSDataArrayAutoRelease sceneOrder = obs_data_get_array(collection, "scene_order");
+	OBSDataArrayAutoRelease sources = obs_data_get_array(collection, "sources");
+
+	if (loadedScenes) {
+		for (size_t i = 0; i < obs_data_array_count(sceneOrder); i++) {
+			OBSDataAutoRelease entry = obs_data_array_item(sceneOrder, i);
+			loadedScenes->push_back(obs_data_get_string(entry, "name"));
+		}
+	}
+
+	OBSDataAutoRelease resaved = obs_data_create();
+	obs_data_set_array(resaved, "scene_order", sceneOrder);
+	obs_data_set_array(resaved, "sources", sources);
+	return obs_data_get_json(resaved);
+}
+
+static SceneTreeLayout ExampleLayout()
+{
+	return {
+		Scene("Starting Soon"),
+		Folder("Gameplay", false, {"Game", "Game + Cam"}),
+		Folder("Empty", true, {}),
+		Scene("BRB"),
+		Folder("Components", true, {"Webcam Frame", "Alerts"}),
+	};
+}
+
+static void assert_layout_equal(const SceneTreeLayout &actual, const SceneTreeLayout &expected)
+{
+	assert_int_equal(actual.size(), expected.size());
+
+	for (size_t i = 0; i < expected.size(); i++) {
+		assert_true(actual[i].type == expected[i].type);
+		assert_string_equal(actual[i].name.c_str(), expected[i].name.c_str());
+		assert_int_equal(actual[i].isCollapsed, expected[i].isCollapsed);
+		assert_int_equal(actual[i].scenes.size(), expected[i].scenes.size());
+
+		for (size_t j = 0; j < expected[i].scenes.size(); j++) {
+			assert_string_equal(actual[i].scenes[j].c_str(), expected[i].scenes[j].c_str());
+		}
+	}
+}
+
+static void flat_scene_order_test(void **state)
+{
+	UNUSED_PARAMETER(state);
+
+	std::vector<std::string> order = OBS::GetSceneOrder(ExampleLayout());
+	std::vector<std::string> expected = {"Starting Soon", "Game", "Game + Cam", "BRB", "Webcam Frame", "Alerts"};
+
+	assert_true(order == expected);
+
+	std::vector<SceneFolderInfo> folders = OBS::GetSceneFolders(ExampleLayout());
+	assert_int_equal(folders.size(), 3);
+	assert_string_equal(folders[0].name.c_str(), "Gameplay");
+	assert_int_equal(folders[0].position, 1);
+	assert_string_equal(folders[1].name.c_str(), "Empty");
+	assert_int_equal(folders[1].position, 3);
+	assert_true(folders[1].isCollapsed);
+	assert_string_equal(folders[2].name.c_str(), "Components");
+	assert_int_equal(folders[2].position, 4);
+}
+
+static void save_load_roundtrip_test(void **state)
+{
+	UNUSED_PARAMETER(state);
+
+	std::string json = SaveCollection(ExampleLayout());
+	assert_layout_equal(LoadCollection(json), ExampleLayout());
+}
+
+static void collection_without_folders_test(void **state)
+{
+	UNUSED_PARAMETER(state);
+
+	SceneTreeLayout layout = OBS::BuildSceneTreeLayout({"A", "B", "C"}, {}, {});
+	assert_layout_equal(layout, {Scene("A"), Scene("B"), Scene("C")});
+}
+
+static void older_version_loads_every_scene_test(void **state)
+{
+	UNUSED_PARAMETER(state);
+
+	std::vector<std::string> loadedScenes;
+	ResaveWithOlderVersion(SaveCollection(ExampleLayout()), &loadedScenes);
+
+	assert_true(loadedScenes == OBS::GetSceneOrder(ExampleLayout()));
+}
+
+static void older_version_roundtrip_keeps_folders_test(void **state)
+{
+	UNUSED_PARAMETER(state);
+
+	std::string json = ResaveWithOlderVersion(SaveCollection(ExampleLayout()), nullptr);
+
+	/* "scene_folders" was dropped: folders with scenes come back (expanded)
+	 * from the scenes' private settings, the empty folder is gone */
+	assert_layout_equal(LoadCollection(json), {
+							  Scene("Starting Soon"),
+							  Folder("Gameplay", false, {"Game", "Game + Cam"}),
+							  Scene("BRB"),
+							  Folder("Components", false, {"Webcam Frame", "Alerts"}),
+						  });
+}
+
+static void reordered_by_older_version_test(void **state)
+{
+	UNUSED_PARAMETER(state);
+
+	/* An older version moved "Alerts" to the top and "Game" to the bottom */
+	std::vector<std::string> order = {"Alerts", "Starting Soon", "Game + Cam", "BRB", "Webcam Frame", "Game"};
+	SceneFolderMembership membership = {
+		{"Game", "Gameplay"},
+		{"Game + Cam", "Gameplay"},
+		{"Webcam Frame", "Components"},
+		{"Alerts", "Components"},
+	};
+
+	SceneTreeLayout layout = OBS::BuildSceneTreeLayout(order, membership, {});
+
+	/* Folders are placed at their first scene, every scene exactly once */
+	assert_layout_equal(layout, {
+					    Folder("Components", false, {"Alerts", "Webcam Frame"}),
+					    Scene("Starting Soon"),
+					    Folder("Gameplay", false, {"Game + Cam", "Game"}),
+					    Scene("BRB"),
+				    });
+}
+
+static void invalid_folder_data_test(void **state)
+{
+	UNUSED_PARAMETER(state);
+
+	std::vector<SceneFolderInfo> folders = {
+		{"", false, 0},      /* nameless, ignored */
+		{"Late", true, 999}, /* position past the end, clamped */
+		{"Dup", false, 1},   /* duplicate name, first one wins */
+		{"Dup", true, 0},
+	};
+	SceneFolderMembership membership = {{"B", "Dup"}, {"Ghost", "Dup"}};
+
+	SceneTreeLayout layout = OBS::BuildSceneTreeLayout({"A", "B", "A"}, membership, folders);
+
+	assert_layout_equal(layout, {Scene("A"), Folder("Dup", false, {"B"}), Folder("Late", true, {})});
+}
+
+static void undo_serialization_test(void **state)
+{
+	UNUSED_PARAMETER(state);
+
+	std::string json = OBS::SerializeSceneTreeLayout(ExampleLayout());
+	assert_layout_equal(OBS::DeserializeSceneTreeLayout(json.c_str()), ExampleLayout());
+	assert_int_equal(OBS::DeserializeSceneTreeLayout("{}").size(), 0);
+}
+
+int main()
+{
+	const struct CMUnitTest tests[] = {
+		cmocka_unit_test(flat_scene_order_test),
+		cmocka_unit_test(save_load_roundtrip_test),
+		cmocka_unit_test(collection_without_folders_test),
+		cmocka_unit_test(older_version_loads_every_scene_test),
+		cmocka_unit_test(older_version_roundtrip_keeps_folders_test),
+		cmocka_unit_test(reordered_by_older_version_test),
+		cmocka_unit_test(invalid_folder_data_test),
+		cmocka_unit_test(undo_serialization_test),
+	};
+
+	return cmocka_run_group_tests(tests, NULL, NULL);
+}
