+++ b/components/dashboard/sections/AutomatedPosts.tsx
@@ -0,0 +1,390 @@
+import React from 'react';
+import { gql, useMutation, useQuery } from '@apollo/client';
+import { defineMessages, FormattedMessage, useIntl } from 'react-intl';
+
+import { i18nGraphqlException } from '../../../lib/errors';
+import type {
+  AutomatedPostsSettingsQuery,
+  AutomatedPostsSettingsQueryVariables,
+} from '../../../lib/graphql/types/v2/graphql';
+import { ConnectedAccountService } from '../../../lib/graphql/types/v2/graphql';
+
+import { getI18nLink } from '../../I18nFormatters';
+import MessageBox from '../../MessageBox';
+import MessageBoxGraphqlError from '../../MessageBoxGraphqlError';
+import { useModal } from '../../ModalContext';
+import { Button } from '../../ui/Button';
+import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '../../ui/Card';
+import { Input } from '../../ui/Input';
+import { Label } from '../../ui/Label';
+import { Skeleton } from '../../ui/Skeleton';
+import { Switch } from '../../ui/Switch';
+import { useToast } from '../../ui/useToast';
+import DashboardHeader from '../DashboardHeader';
+
+const POST_TYPES = ['newContributors', 'milestones', 'monthlyStats'] as const;
+type PostType = (typeof POST_TYPES)[number];
+type PostSettings = Record<PostType, boolean>;
+
+const DEFAULT_POST_SETTINGS: PostSettings = { newContributors: true, milestones: true, monthlyStats: true };
+
+const POST_TYPE_LABELS = defineMessages({
+  newContributors: { defaultMessage: 'Thank new financial contributors', id: 'o3Hnzh' },
+  milestones: { defaultMessage: 'Celebrate milestones (10, 25, 50, 100... financial contributors)', id: 'xZZCIg' },
+  monthlyStats: {
+    defaultMessage: 'Share monthly stats (money received and spent, new contributors, balance)',
+    id: 'GZB/iO',
+  },
+});
+
+const automatedPostsSettingsQuery = gql`
+  query AutomatedPostsSettings($slug: String!) {
+    account(slug: $slug) {
+      id
+      connectedAccounts(service: mastodon) {
+        id
+        service
+        username
+        settings
+        createdAt
+        createdByAccount {
+          id
+          name
+          slug
+        }
+      }
+    }
+  }
+`;
+
+const connectMastodonAccountMutation = gql`
+  mutation ConnectMastodonAccount($account: AccountReferenceInput!, $connectedAccount: ConnectedAccountCreateInput!) {
+    createConnectedAccount(account: $account, connectedAccount: $connectedAccount) {
+      id
+      service
+      username
+      settings
+    }
+  }
+`;
+
+const editConnectedAccountPostSettingsMutation = gql`
+  mutation EditConnectedAccountPostSettings(
+    $connectedAccount: ConnectedAccountReferenceInput!
+    $postSettings: ConnectedAccountPostSettingsInput!
+  ) {
+    editConnectedAccountPostSettings(connectedAccount: $connectedAccount, postSettings: $postSettings) {
+      id
+      settings
+    }
+  }
+`;
+
+const disconnectMastodonAccountMutation = gql`
+  mutation DisconnectMastodonAccount($connectedAccount: ConnectedAccountReferenceInput!) {
+    deleteConnectedAccount(connectedAccount: $connectedAccount) {
+      id
+    }
+  }
+`;
+
+type MastodonAccount = AutomatedPostsSettingsQuery['account']['connectedAccounts'][number];
+
+const getPostSettings = (connectedAccount: MastodonAccount): PostSettings => {
+  const posts = connectedAccount.settings?.posts || {};
+  return {
+    newContributors: posts.newContributors === true,
+    milestones: posts.milestones === true,
+    monthlyStats: posts.monthlyStats === true,
+  };
+};
+
+/** Returns the page where Mastodon users create an access token, if the server URL looks valid */
+const getNewApplicationUrl = (serverUrl: string): string | null => {
+  try {
+    const url = new URL(/^https?:\/\//i.test(serverUrl.trim()) ? serverUrl.trim() : `https://${serverUrl.trim()}`);
+    return url.hostname.includes('.') ? `https://${url.host}/settings/applications/new` : null;
+  } catch {
+    return null;
+  }
+};
+
+const PostSettingsSwitches = ({
+  idPrefix,
+  values,
+  onChange,
+  disabled = false,
+}: {
+  idPrefix: string;
+  values: PostSettings;
+  onChange: (type: PostType, checked: boolean) => void;
+  disabled?: boolean;
+}) => {
+  const intl = useIntl();
+  return (
+    <div className="flex flex-col gap-3">
+      {POST_TYPES.map(type => (
+        <div key={type} className="flex items-center justify-between gap-4">
+          <Label htmlFor={`${idPrefix}-${type}`} className="leading-5 font-normal">
+            {intl.formatMessage(POST_TYPE_LABELS[type])}
+          </Label>
+          <Switch
+            id={`${idPrefix}-${type}`}
+            checked={values[type]}
+            disabled={disabled}
+            onCheckedChange={checked => onChange(type, checked)}
+          />
+        </div>
+      ))}
+    </div>
+  );
+};
+
+const ConnectMastodonForm = ({
+  accountSlug,
+  onSuccess,
+}: {
+  accountSlug: string;
+  onSuccess: () => Promise<unknown>;
+}) => {
+  const intl = useIntl();
+  const { toast } = useToast();
+  const [serverUrl, setServerUrl] = React.useState('');
+  const [token, setToken] = React.useState('');
+  const [postSettings, setPostSettings] = React.useState<PostSettings>(DEFAULT_POST_SETTINGS);
+  const [connect, { loading }] = useMutation(connectMastodonAccountMutation);
+  const newApplicationUrl = getNewApplicationUrl(serverUrl);
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    try {
+      await connect({
+        variables: {
+          account: { slug: accountSlug },
+          connectedAccount: {
+            service: ConnectedAccountService.mastodon,
+            instanceUrl: serverUrl.trim(),
+            token: token.trim(),
+            settings: { posts: postSettings },
+          },
+        },
+      });
+      setToken('');
+      await onSuccess();
+      toast({
+        variant: 'success',
+        message: <FormattedMessage defaultMessage="Your Mastodon account is connected" id="IS2L1M" />,
+      });
+    } catch (e) {
+      toast({ variant: 'error', message: i18nGraphqlException(intl, e) });
+    }
+  };
+
+  return (
+    <form className="flex flex-col gap-4" onSubmit={handleSubmit}>
+      <div className="flex flex-col gap-2">
+        <Label htmlFor="mastodon-server-url">
+          <FormattedMessage defaultMessage="Mastodon server" id="M8+GZw" />
+        </Label>
+        <Input
+          id="mastodon-server-url"
+          placeholder="mastodon.social"
+          value={serverUrl}
+          onChange={e => setServerUrl(e.target.value)}
+          autoComplete="url"
+          required
+        />
+      </div>
+      <div className="flex flex-col gap-2">
+        <Label htmlFor="mastodon-access-token">
+          <FormattedMessage defaultMessage="Access token" id="uTSSg3" />
+        </Label>
+        <Input
+          id="mastodon-access-token"
+          type="password"
+          value={token}
+          onChange={e => setToken(e.target.value)}
+          autoComplete="off"
+          required
+        />
+        <p className="text-xs text-muted-foreground">
+          <FormattedMessage
+            defaultMessage="On your Mastodon server, go to Preferences > Development and <Link>create a new application</Link> with the <code>write:statuses</code> and <code>profile</code> scopes (<code>read:accounts</code> on servers older than Mastodon 4.3), then copy its access token here."
+            id="fu3yBy"
+            values={{
+              code: (chunks: React.ReactNode) => <code>{chunks}</code>,
+              Link: newApplicationUrl
+                ? getI18nLink({ href: newApplicationUrl, openInNewTab: true })
+                : (chunks: React.ReactNode) => chunks,
+            }}
+          />
+        </p>
+      </div>
+      <PostSettingsSwitches
+        idPrefix="new-mastodon-account"
+        values={postSettings}
+        onChange={(type, checked) => setPostSettings(settings => ({ ...settings, [type]: checked }))}
+      />
+      <Button type="submit" className="w-fit" loading={loading} disabled={!serverUrl.trim() || !token.trim()}>
+        <FormattedMessage defaultMessage="Connect {service}" id="C9HmCs" values={{ service: 'Mastodon' }} />
+      </Button>
+    </form>
+  );
+};
+
+const MastodonAccountCard = ({
+  connectedAccount,
+  onDisconnected,
+}: {
+  connectedAccount: MastodonAccount;
+  onDisconnected: () => Promise<unknown>;
+}) => {
+  const intl = useIntl();
+  const { toast } = useToast();
+  const { showConfirmationModal } = useModal();
+  const [editPostSettings, { loading: saving }] = useMutation(editConnectedAccountPostSettingsMutation);
+  const [disconnect] = useMutation(disconnectMastodonAccountMutation);
+  const postSettings = getPostSettings(connectedAccount);
+
+  const handleChange = async (type: PostType, checked: boolean) => {
+    try {
+      await editPostSettings({
+        variables: { connectedAccount: { id: connectedAccount.id }, postSettings: { [type]: checked } },
+      });
+    } catch (e) {
+      toast({ variant: 'error', message: i18nGraphqlException(intl, e) });
+    }
+  };
+
+  const handleDisconnect = () => {
+    showConfirmationModal({
+      variant: 'destructive',
+      type: 'remove',
+      title: (
+        <FormattedMessage defaultMessage="Disconnect {serviceName}" id="ktcy9f" values={{ serviceName: 'Mastodon' }} />
+      ),
+      description: (
+        <FormattedMessage
+          defaultMessage="Automated posts will stop. You can also revoke the access token from the Development settings of your Mastodon account."
+          id="77TYqq"
+        />
+      ),
+      confirmLabel: (
+        <FormattedMessage id="collective.connectedAccounts.disconnect.button" defaultMessage="Disconnect" />
+      ),
+      onConfirm: async () => {
+        try {
+          await disconnect({ variables: { connectedAccount: { id: connectedAccount.id } } });
+          await onDisconnected();
+        } catch (e) {
+          toast({ variant: 'error', message: i18nGraphqlException(intl, e) });
+        }
+      },
+    });
+  };
+
+  return (
+    <Card className="bg-sidebar">
+      <CardHeader>
+        <CardTitle className="break-all">{connectedAccount.username}</CardTitle>
+        <CardDescription>
+          <FormattedMessage
+            id="EditWiseAccounts.connectedby"
+            defaultMessage="Connected{createdByName, select, undefined {} other { by {createdByName}}} on {updatedAt, date, short}"
+            values={{
+              updatedAt: new Date(connectedAccount.createdAt),
+              createdByName: connectedAccount.createdByAccount?.name,
+            }}
+          />
+        </CardDescription>
+      </CardHeader>
+      <CardContent className="flex flex-col gap-4">
+        {connectedAccount.settings?.needsReconnect && (
+          <MessageBox type="warning" withIcon>
+            <FormattedMessage
+              defaultMessage="Mastodon rejected the access token of this account, so automated posts are paused. Connect it again below with a new access token."
+              id="hBnqdD"
+            />
+          </MessageBox>
+        )}
+        <PostSettingsSwitches
+          idPrefix={`mastodon-account-${connectedAccount.id}`}
+          values={postSettings}
+          onChange={handleChange}
+          disabled={saving}
+        />
+        <Button variant="outline" size="sm" className="w-fit" onClick={handleDisconnect}>
+          <FormattedMessage id="collective.connectedAccounts.disconnect.button" defaultMessage="Disconnect" />
+        </Button>
+      </CardContent>
+    </Card>
+  );
+};
+
+/**
+ * Settings to publish automated posts (new contributors, milestones, monthly stats) on Mastodon.
+ */
+const AutomatedPosts = ({ accountSlug }: { accountSlug: string }) => {
+  const [showConnectForm, setShowConnectForm] = React.useState(false);
+  const { data, loading, error, refetch } = useQuery<AutomatedPostsSettingsQuery, AutomatedPostsSettingsQueryVariables>(
+    automatedPostsSettingsQuery,
+    { variables: { slug: accountSlug } },
+  );
+
+  const connectedAccounts = data?.account?.connectedAccounts || [];
+  const needsReconnect = connectedAccounts.some(connectedAccount => connectedAccount.settings?.needsReconnect);
+  const isConnectFormVisible = showConnectForm || needsReconnect || connectedAccounts.length === 0;
+
+  return (
+    <div className="flex flex-col gap-6">
+      <DashboardHeader
+        title={<FormattedMessage defaultMessage="Automated posts" id="DwZE3p" />}
+        description={
+          <FormattedMessage
+            defaultMessage="Connect a Mastodon account to thank your new financial contributors, celebrate milestones and share monthly stats with your community on the Fediverse."
+            id="mOE4C4"
+          />
+        }
+      />
+      {loading ? (
+        <Skeleton className="h-40 w-full" />
+      ) : error ? (
+        <MessageBoxGraphqlError error={error} />
+      ) : (
+        <React.Fragment>
+          {connectedAccounts.map(connectedAccount => (
+            <MastodonAccountCard
+              key={connectedAccount.id}
+              connectedAccount={connectedAccount}
+              onDisconnected={refetch}
+            />
+          ))}
+          {isConnectFormVisible ? (
+            <Card className="bg-sidebar">
+              <CardHeader>
+                <CardTitle>
+                  <FormattedMessage defaultMessage="Connect {service}" id="C9HmCs" values={{ service: 'Mastodon' }} />
+                </CardTitle>
+              </CardHeader>
+              <CardContent>
+                <ConnectMastodonForm
+                  accountSlug={accountSlug}
+                  onSuccess={async () => {
+                    setShowConnectForm(false);
+                    await refetch();
+                  }}
+                />
+              </CardContent>
+            </Card>
+          ) : (
+            <Button variant="outline" className="w-fit" onClick={() => setShowConnectForm(true)}>
+              <FormattedMessage defaultMessage="Connect another Mastodon account" id="m4J3sU" />
+            </Button>
+          )}
+        </React.Fragment>
+      )}
+    </div>
+  );
+};
+
+export default AutomatedPosts;
