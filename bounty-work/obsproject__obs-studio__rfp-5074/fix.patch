+#include "PluginCatalog.hpp"
+
+#include <util/bmem.h>
+#include <util/platform.h>
+
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <knownfolders.h>
+#include <shlobj.h>
+
+namespace obs_vst3 {
+
+namespace {
+
+std::string knownFolder(REFKNOWNFOLDERID folder)
+{
+	PWSTR widePath = nullptr;
+	std::string path;
+
+	if (SUCCEEDED(SHGetKnownFolderPath(folder, KF_FLAG_DEFAULT, nullptr, &widePath))) {
+		char *converted = nullptr;
+		os_wcs_to_utf8_ptr(widePath, 0, &converted);
+		if (converted) {
+			path = converted;
+			bfree(converted);
+		}
+	}
+
+	CoTaskMemFree(widePath);
+	return path;
+}
+
+} // namespace
+
+/*
+ * https://steinbergmedia.github.io/vst3_dev_portal/pages/Technical+Documentation/Locations+Format/Plugin+Locations.html
+ * "%COMMONPROGRAMFILES%\VST3" and the per-user "%LOCALAPPDATA%\Programs\Common\VST3".
+ */
+std::vector<std::string> PluginCatalog::defaultSearchPaths()
+{
+	std::vector<std::string> paths;
+
+	std::string userCommon = knownFolder(FOLDERID_UserProgramFilesCommon);
+	if (!userCommon.empty()) {
+		paths.push_back(userCommon + "\\VST3");
+	}
+
+	std::string common = knownFolder(FOLDERID_ProgramFilesCommon);
+	if (!common.empty()) {
+		paths.push_back(common + "\\VST3");
+	}
+
+	return paths;
+}
+
+} // namespace obs_vst3
