diff --git a/sources/engine/Stride.Engine/Rendering/Decals/DecalRenderProcessor.cs b/sources/engine/Stride.Engine/Rendering/Decals/DecalRenderProcessor.cs
new file mode 100644
index 0000000..5b8085f
--- /dev/null
+++ b/sources/engine/Stride.Engine/Rendering/Decals/DecalRenderProcessor.cs
@@ -0,0 +1,209 @@
+// Copyright (c) .NET Foundation and Contributors (https://dotnetfoundation.org/ & https://stride3d.net)
+// Distributed under the MIT license. See the LICENSE.md file in the project root for more information.
+
+using Stride.Core;
+using Stride.Core.Diagnostics;
+using Stride.Engine;
+using Stride.Extensions;
+using Stride.Graphics;
+using Stride.Graphics.GeometricPrimitives;
+
+namespace Stride.Rendering.Decals
+{
+    /// <summary>
+    /// Creates the <see cref="RenderDecal"/> of the <see cref="DecalComponent"/>s and keeps them up to date.
+    /// </summary>
+    /// <remarks>
+    /// Decals are rendered by the <see cref="MeshRenderFeature"/>, which needs a <see cref="DecalRenderFeature"/> to project them.
+    /// If the graphics compositor does not have one, it is added the first time decals are drawn, so that decals also work
+    /// with graphics compositors created before decals were supported (they are then rendered in the transparent stage).
+    /// </remarks>
+    public class DecalRenderProcessor : EntityProcessor<DecalComponent, RenderDecal>, IEntityComponentRenderProcessor
+    {
+        private static readonly Logger Log = GlobalLogger.GetLogger(nameof(DecalRenderProcessor));
+
+        private GeometricPrimitive volumePrimitive;
+        private Mesh volumeMesh;
+        private bool isDepthAsShaderResourceSupported = true;
+
+        /// <summary>
+        /// Initializes a new instance of the <see cref="DecalRenderProcessor"/> class.
+        /// </summary>
+        public DecalRenderProcessor()
+            : base(typeof(TransformComponent))
+        {
+        }
+
+        /// <inheritdoc/>
+        public VisibilityGroup VisibilityGroup { get; set; }
+
+        /// <inheritdoc/>
+        protected internal override void OnSystemAdd()
+        {
+            base.OnSystemAdd();
+
+            var graphicsDevice = Services.GetSafeServiceAs<IGraphicsDeviceService>().GraphicsDevice;
+
+            // The volume of every decal is the unit cube (from -0.5 to 0.5 on each axis), transformed by RenderDecal.World
+            volumePrimitive = GeometricPrimitive.Cube.New(graphicsDevice, 1.0f);
+            volumeMesh = new Mesh { Draw = volumePrimitive.ToMeshDraw(), Name = "DecalVolume" };
+
+            isDepthAsShaderResourceSupported = graphicsDevice.Features.HasDepthAsSRV;
+            if (!isDepthAsShaderResourceSupported)
+                Log.Warning("Decals are not rendered: this graphics device cannot read the depth buffer from shaders.");
+        }
+
+        /// <inheritdoc/>
+        protected internal override void OnSystemRemove()
+        {
+            foreach (var renderDecal in ComponentDatas.Values)
+                Unregister(renderDecal);
+
+            volumeMesh = null;
+            volumePrimitive?.Dispose();
+            volumePrimitive = null;
+
+            base.OnSystemRemove();
+        }
+
+        /// <inheritdoc/>
+        protected override RenderDecal GenerateComponentData(Entity entity, DecalComponent component)
+        {
+            return new RenderDecal { Source = component };
+        }
+
+        /// <inheritdoc/>
+        protected override bool IsAssociatedDataValid(Entity entity, DecalComponent component, RenderDecal associatedData)
+        {
+            return associatedData.Source == component;
+        }
+
+        /// <inheritdoc/>
+        protected override void OnEntityComponentRemoved(Entity entity, DecalComponent component, RenderDecal data)
+        {
+            Unregister(data);
+        }
+
+        /// <inheritdoc/>
+        public override void Draw(RenderContext context)
+        {
+            if (ComponentDatas.Count == 0 || VisibilityGroup == null)
+                return;
+
+            EnsureDecalRenderFeature(VisibilityGroup.RenderSystem);
+
+            foreach (var (component, renderDecal) in ComponentDatas)
+            {
+                var materialPass = GetMaterialPass(component);
+                var canRender = materialPass != null && isDepthAsShaderResourceSupported;
+
+                // A new material or render group can change the effect, the pipeline state and the render stages of the decal:
+                // register it again so that everything is evaluated from scratch
+                if (IsRegistered(renderDecal) && (!canRender || renderDecal.MaterialPass != materialPass || renderDecal.RenderGroup != component.RenderGroup))
+                    Unregister(renderDecal);
+
+                if (!canRender)
+                    continue;
+
+                UpdateRenderDecal(component, renderDecal, materialPass, volumeMesh);
+
+                if (!IsRegistered(renderDecal))
+                    Register(renderDecal);
+            }
+        }
+
+        /// <summary>
+        /// Copies the state of a decal component to its render decal.
+        /// </summary>
+        /// <param name="component">The decal component.</param>
+        /// <param name="renderDecal">The render decal to update.</param>
+        /// <param name="materialPass">The material pass projected by the decal.</param>
+        /// <param name="volumeMesh">The mesh of the decal volume (the unit cube).</param>
+        internal static void UpdateRenderDecal(DecalComponent component, RenderDecal renderDecal, MaterialPass materialPass, Mesh volumeMesh)
+        {
+            var volumeWorld = RenderDecal.ComputeWorldMatrix(component.Size, component.Entity.Transform.WorldMatrix);
+            var determinant = volumeWorld.Determinant();
+
+            // A flat volume does not project anything (and cannot be inverted by the shader)
+            renderDecal.Enabled = component.Enabled && determinant != 0.0f && float.IsFinite(determinant);
+            renderDecal.RenderGroup = component.RenderGroup;
+            renderDecal.MaterialPass = materialPass;
+            renderDecal.Mesh = volumeMesh;
+            renderDecal.World = volumeWorld;
+            renderDecal.IsScalingNegative = determinant < 0.0f;
+            renderDecal.BoundingBox = RenderDecal.ComputeBoundingBox(volumeWorld);
+
+            renderDecal.Opacity = component.Opacity;
+            renderDecal.AngleFadeStart = component.AngleFadeStart;
+            renderDecal.AngleFadeEnd = component.AngleFadeEnd;
+            renderDecal.DepthFade = component.DepthFade;
+            renderDecal.SortOrder = component.SortOrder;
+        }
+
+        /// <summary>
+        /// Adds a <see cref="DecalRenderFeature"/> to the mesh render features that do not have one.
+        /// </summary>
+        /// <param name="renderSystem">The render system.</param>
+        /// <returns><c>true</c> if a decal render feature was added; otherwise, <c>false</c>.</returns>
+        internal static bool EnsureDecalRenderFeature(RenderSystem renderSystem)
+        {
+            if (renderSystem == null)
+                return false;
+
+            var added = false;
+            foreach (var renderFeature in renderSystem.RenderFeatures)
+            {
+                if (renderFeature is not MeshRenderFeature meshRenderFeature || HasDecalRenderFeature(meshRenderFeature))
+                    continue;
+
+                meshRenderFeature.RenderFeatures.Add(new DecalRenderFeature());
+                Log.Info($"Added a {nameof(DecalRenderFeature)} to the {nameof(MeshRenderFeature)} of the graphics compositor to render decals.");
+                added = true;
+            }
+
+            return added;
+        }
+
+        private static bool HasDecalRenderFeature(MeshRenderFeature meshRenderFeature)
+        {
+            foreach (var subRenderFeature in meshRenderFeature.RenderFeatures)
+            {
+                if (subRenderFeature is DecalRenderFeature)
+                    return true;
+            }
+
+            return false;
+        }
+
+        private static MaterialPass GetMaterialPass(DecalComponent component)
+        {
+            // Only the first pass of the material is projected
+            var passes = component.Material?.Passes;
+            return passes is { Count: > 0 } ? passes[0] : null;
+        }
+
+        private static bool IsRegistered(RenderDecal renderDecal)
+        {
+            return renderDecal.VisibilityObjectNode != StaticObjectNodeReference.Invalid;
+        }
+
+        private void Register(RenderDecal renderDecal)
+        {
+            lock (VisibilityGroup.RenderObjects)
+            {
+                VisibilityGroup.RenderObjects.Add(renderDecal);
+            }
+        }
+
+        private void Unregister(RenderDecal renderDecal)
+        {
+            if (VisibilityGroup == null || !IsRegistered(renderDecal))
+                return;
+
+            lock (VisibilityGroup.RenderObjects)
+            {
+                VisibilityGroup.RenderObjects.Remove(renderDecal);
+            }
+        }
+    }
+}
