+import ONYXKEYS from '@src/ONYXKEYS';
+import type {TryNewDot} from '@src/types/onyx';
+
+import type * as HybridAppPackage from '@expensify/react-native-hybrid-app';
+
+import Onyx from 'react-native-onyx';
+
+import getOnyxValue from '../utils/getOnyxValue';
+import waitForBatchedUpdates from '../utils/waitForBatchedUpdates';
+
+jest.mock('@src/CONFIG', () => {
+    const actualConfig = jest.requireActual<{default: Record<string, unknown>}>('@src/CONFIG');
+    return {
+        __esModule: true,
+        default: {...actualConfig.default, IS_HYBRID_APP: true},
+    };
+});
+
+jest.mock('@libs/Navigation/Navigation', () => ({
+    clearPreloadedRoutes: jest.fn(),
+}));
+
+const {default: HybridAppModule} = jest.requireActual<typeof HybridAppPackage>('@expensify/react-native-hybrid-app');
+
+// Subscribes to Onyx and chooses between OldDot and NewDot once the user is signed in
+require('@libs/HybridApp');
+
+function buildTryNewDot(dismissed: boolean): TryNewDot {
+    return {classicRedirect: {dismissed, timestamp: new Date(), completedHybridAppOnboarding: true}};
+}
+
+const SIGNED_IN_STATE = {
+    [ONYXKEYS.SESSION]: {authToken: 'authToken', accountID: 1, email: 'admin@expensify.com'},
+    [ONYXKEYS.CREDENTIALS]: {autoGeneratedLogin: 'autoGeneratedLogin', autoGeneratedPassword: 'autoGeneratedPassword'},
+};
+
+async function signInOnNewDotSignInPage(tryNewDot: TryNewDot, needsTwoFactorAuthSetup: boolean) {
+    await Onyx.multiSet({
+        ...SIGNED_IN_STATE,
+        [ONYXKEYS.HYBRID_APP]: {useNewDotSignInPage: true},
+        [ONYXKEYS.ACCOUNT]: {needsTwoFactorAuthSetup, requiresTwoFactorAuth: false},
+        [ONYXKEYS.NVP_TRY_NEW_DOT]: tryNewDot,
+    });
+    await waitForBatchedUpdates();
+}
+
+describe('HybridApp sign in', () => {
+    let closeNativeAppSpy: jest.SpiedFunction<typeof HybridAppModule.closeReactNativeApp>;
+
+    beforeAll(() => {
+        Onyx.init({keys: ONYXKEYS});
+    });
+
+    beforeEach(async () => {
+        jest.spyOn(HybridAppModule, 'signInToOldDot').mockImplementation(() => {});
+        closeNativeAppSpy = jest.spyOn(HybridAppModule, 'closeReactNativeApp').mockImplementation(() => {});
+        await Onyx.clear();
+        await waitForBatchedUpdates();
+    });
+
+    afterEach(() => {
+        jest.restoreAllMocks();
+    });
+
+    it('keeps a Classic user in NewDot for the required 2FA setup and remembers to send them back to OldDot afterwards', async () => {
+        await signInOnNewDotSignInPage(buildTryNewDot(true), true);
+
+        expect(closeNativeAppSpy).not.toHaveBeenCalled();
+        expect(await getOnyxValue(ONYXKEYS.HYBRID_APP)).toEqual(
+            expect.objectContaining({
+                useNewDotSignInPage: false,
+                readyToShowAuthScreens: true,
+                shouldReturnToOldDotAfter2FASetup: true,
+            }),
+        );
+    });
+
+    it('remembers to send the user back to OldDot when nvp_tryNewDot has no classicRedirect, like the sign in decision does', async () => {
+        await signInOnNewDotSignInPage({}, true);
+
+        expect(closeNativeAppSpy).not.toHaveBeenCalled();
+        expect(await getOnyxValue(ONYXKEYS.HYBRID_APP)).toEqual(expect.objectContaining({readyToShowAuthScreens: true, shouldReturnToOldDotAfter2FASetup: true}));
+    });
+
+    it('does not send a NewDot user to OldDot after the required 2FA setup', async () => {
+        await signInOnNewDotSignInPage(buildTryNewDot(false), true);
+
+        expect(closeNativeAppSpy).not.toHaveBeenCalled();
+        expect(await getOnyxValue(ONYXKEYS.HYBRID_APP)).toEqual(expect.objectContaining({readyToShowAuthScreens: true, shouldReturnToOldDotAfter2FASetup: false}));
+    });
+
+    it('opens OldDot right away for a Classic user without a pending 2FA setup', async () => {
+        await signInOnNewDotSignInPage(buildTryNewDot(true), false);
+
+        expect(closeNativeAppSpy).toHaveBeenCalledWith({shouldSetNVP: false});
+        expect((await getOnyxValue(ONYXKEYS.HYBRID_APP))?.shouldReturnToOldDotAfter2FASetup).toBeUndefined();
+    });
+});
