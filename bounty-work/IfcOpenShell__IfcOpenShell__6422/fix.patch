+    PRINT_PREVIEW_IMAGE_PROP = "BIMPrintPreview"
+    PRINT_PREVIEW_MAX_SIZE_PX = 4096
+
+    @classmethod
+    def get_svg2png_commands(cls) -> Union[list[list[str]], None]:
+        if command := tool.Blender.get_addon_preferences().svg2png_command:
+            return json.loads(command)
+        if inkscape := shutil.which("inkscape"):
+            return [[inkscape, "svg", "--export-type=png", "--export-dpi", "dpi", "--export-filename", "png"]]
+        if rsvg_convert := shutil.which("rsvg-convert"):
+            return [[rsvg_convert, "--dpi-x", "dpi", "--dpi-y", "dpi", "--output", "png", "svg"]]
+        return None
+
+    @classmethod
+    def get_print_preview_dpi(cls, svg: str) -> int:
+        """Get the resolution to render the drawing at, keeping big drawings to a reasonable image size."""
+        root = etree.parse(svg).getroot()
+        try:
+            size_mm = max(float(re.match(r"[\d.]+", root.attrib[a]).group()) for a in ("width", "height"))
+        except (KeyError, AttributeError, ValueError):
+            return 96
+        dpi = cls.PRINT_PREVIEW_MAX_SIZE_PX / (size_mm / 25.4) if size_mm else 96
+        return round(max(36, min(300, dpi)))
+
+    @classmethod
+    def rasterize_svg(cls, svg: str, png: str, dpi: int) -> bool:
+        if not (commands := cls.get_svg2png_commands()):
+            return False
+        if os.path.exists(png):
+            os.remove(png)
+        os.makedirs(os.path.dirname(png), exist_ok=True)
+        replacements = {"svg": svg, "png": png, "dpi": str(dpi)}
+        for command in commands:
+            try:
+                subprocess.run([replacements.get(c, c) for c in command])
+            except OSError as e:
+                print(f"Failed to run SVG to PNG command: {e}")
+                return False
+        return os.path.isfile(png)
+
+    @classmethod
+    def get_print_preview_background(cls, camera: bpy.types.Camera) -> Union[bpy.types.CameraBackgroundImage, None]:
+        for background in camera.background_images:
+            if background.image and background.image.get(cls.PRINT_PREVIEW_IMAGE_PROP):
+                return background
+
+    @classmethod
+    def get_print_preview_path(cls, drawing: ifcopenshell.entity_instance) -> str:
+        return os.path.join(bpy.app.tempdir, "print_previews", f"{drawing.GlobalId}.png")
+
+    @classmethod
+    def update_print_preview(cls, drawing: ifcopenshell.entity_instance) -> bool:
+        """Render the drawing's generated SVG and show it in the drawing camera view, as it prints.
+
+        :return: False if there is no SVG to show or it couldn't be rendered.
+        """
+        svg = cls.get_document_uri(cls.get_drawing_document(drawing))
+        if not svg or not os.path.isfile(svg):
+            return False
+        png = cls.get_print_preview_path(drawing)
+        if not cls.rasterize_svg(svg, png, cls.get_print_preview_dpi(svg)):
+            return False
+        camera = tool.Ifc.get_object(drawing)
+        assert isinstance(camera, bpy.types.Object)
+        cls.show_print_preview(camera, png)
+        return True
+
+    @classmethod
+    def show_print_preview(cls, camera: bpy.types.Object, png: str) -> None:
+        assert isinstance(camera.data, bpy.types.Camera)
+        if background := cls.get_print_preview_background(camera.data):
+            image = background.image
+            image.filepath = png
+            image.reload()
+        else:
+            image = bpy.data.images.load(png, check_existing=True)
+            image.reload()
+            image[cls.PRINT_PREVIEW_IMAGE_PROP] = True
+            background = camera.data.background_images.new()
+            background.image = image
+        image.name = f"{camera.name} Print Preview"
+        background.display_depth = "FRONT"
+        # Drawing SVG covers exactly the camera frame.
+        background.frame_method = "STRETCH"
+        background.alpha = cls.get_document_props().print_preview_opacity
+        background.show_background_image = True
+        camera.data.show_background_images = True
+
+    @classmethod
+    def sync_print_preview(cls, drawing: ifcopenshell.entity_instance) -> None:
+        """Make sure the activated drawing shows its print preview, if enabled.
+
+        Camera data can be recreated (e.g. if drawing size has changed), which loses the preview.
+        """
+        if not cls.get_document_props().should_show_print_preview:
+            return
+        camera = tool.Ifc.get_object(drawing)
+        assert isinstance(camera, bpy.types.Object) and isinstance(camera.data, bpy.types.Camera)
+        if cls.get_print_preview_background(camera.data):
+            return
+        if os.path.isfile(png := cls.get_print_preview_path(drawing)):
+            cls.show_print_preview(camera, png)
+        else:
+            cls.update_print_preview(drawing)
+
+    @classmethod
+    def remove_print_preview(cls, camera: bpy.types.Object) -> None:
+        assert isinstance(camera.data, bpy.types.Camera)
+        if not (background := cls.get_print_preview_background(camera.data)):
+            return
+        image = background.image
+        camera.data.background_images.remove(background)
+        if image:
+            # The image is only used for the preview.
+            bpy.data.images.remove(image)
+        if not len(camera.data.background_images):
+            camera.data.show_background_images = False
+
