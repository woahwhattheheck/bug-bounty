diff --git a/src/modules/module-protocol-pulse/test-filter-apply.c b/src/modules/module-protocol-pulse/test-filter-apply.c
new file mode 100644
index 000000000..df1810f4d
--- /dev/null
+++ b/src/modules/module-protocol-pulse/test-filter-apply.c
@@ -0,0 +1,132 @@
+/* PipeWire */
+/* SPDX-FileCopyrightText: Copyright © 2026 woahwhattheheck */
+/* SPDX-License-Identifier: MIT */
+
+/* Check the filter.want / filter.apply / filter.suppress rules and the
+ * stream grouping used to pair echo-cancel streams. */
+
+#include <stdio.h>
+
+#include <spa/utils/defs.h>
+#include <spa/utils/dict.h>
+#include <spa/utils/string.h>
+
+#include "filter-apply.h"
+
+#define DICT(...) &SPA_DICT_ITEMS(__VA_ARGS__)
+
+static void test_str_in_list(void)
+{
+	spa_assert_se(filter_apply_str_in_list("phone", "phone"));
+	spa_assert_se(filter_apply_str_in_list("music  phone", "phone"));
+	spa_assert_se(filter_apply_str_in_list(" phone music", "phone"));
+	spa_assert_se(!filter_apply_str_in_list("phones", "phone"));
+	spa_assert_se(!filter_apply_str_in_list("headphone", "phone"));
+	spa_assert_se(!filter_apply_str_in_list("", "phone"));
+	spa_assert_se(!filter_apply_str_in_list(NULL, "phone"));
+
+	spa_assert_se(filter_apply_is_phone_device("phone"));
+	spa_assert_se(filter_apply_is_phone_device("Communication"));
+	spa_assert_se(filter_apply_is_phone_device("Music Communication"));
+	spa_assert_se(!filter_apply_is_phone_device("Music"));
+	spa_assert_se(!filter_apply_is_phone_device(NULL));
+}
+
+static void test_get_name(void)
+{
+	/* nothing requested */
+	spa_assert_se(filter_apply_get_name(NULL, NULL) == NULL);
+	spa_assert_se(filter_apply_get_name(DICT(
+			SPA_DICT_ITEM("media.role", "phone")), NULL) == NULL);
+
+	/* filter.want */
+	spa_assert_se(spa_streq(filter_apply_get_name(DICT(
+			SPA_DICT_ITEM(FILTER_KEY_WANT, "echo-cancel")), NULL),
+			"echo-cancel"));
+	spa_assert_se(spa_streq(filter_apply_get_name(DICT(
+			SPA_DICT_ITEM(FILTER_KEY_WANT, "echo-cancel")), "Music"),
+			"echo-cancel"));
+	spa_assert_se(filter_apply_get_name(DICT(
+			SPA_DICT_ITEM(FILTER_KEY_WANT, "")), NULL) == NULL);
+
+	/* filter.want is a hint, devices for calls cancel echo themselves */
+	spa_assert_se(filter_apply_get_name(DICT(
+			SPA_DICT_ITEM(FILTER_KEY_WANT, "echo-cancel")), "phone") == NULL);
+	spa_assert_se(filter_apply_get_name(DICT(
+			SPA_DICT_ITEM(FILTER_KEY_WANT, "echo-cancel")), "Communication") == NULL);
+
+	/* filter.apply is explicit, it wins over filter.want and the device */
+	spa_assert_se(spa_streq(filter_apply_get_name(DICT(
+			SPA_DICT_ITEM(FILTER_KEY_APPLY, "echo-cancel")), "phone"),
+			"echo-cancel"));
+	spa_assert_se(spa_streq(filter_apply_get_name(DICT(
+			SPA_DICT_ITEM(FILTER_KEY_APPLY, "equalizer-sink"),
+			SPA_DICT_ITEM(FILTER_KEY_WANT, "echo-cancel")), NULL),
+			"equalizer-sink"));
+	/* an empty filter.apply disables filter.want */
+	spa_assert_se(filter_apply_get_name(DICT(
+			SPA_DICT_ITEM(FILTER_KEY_APPLY, ""),
+			SPA_DICT_ITEM(FILTER_KEY_WANT, "echo-cancel")), NULL) == NULL);
+
+	/* filter.suppress */
+	spa_assert_se(filter_apply_get_name(DICT(
+			SPA_DICT_ITEM(FILTER_KEY_WANT, "echo-cancel"),
+			SPA_DICT_ITEM(FILTER_KEY_SUPPRESS, "echo-cancel")), NULL) == NULL);
+	spa_assert_se(filter_apply_get_name(DICT(
+			SPA_DICT_ITEM(FILTER_KEY_APPLY, "echo-cancel"),
+			SPA_DICT_ITEM(FILTER_KEY_SUPPRESS, "echo-cancel")), NULL) == NULL);
+	spa_assert_se(spa_streq(filter_apply_get_name(DICT(
+			SPA_DICT_ITEM(FILTER_KEY_WANT, "echo-cancel"),
+			SPA_DICT_ITEM(FILTER_KEY_SUPPRESS, "equalizer-sink")), NULL),
+			"echo-cancel"));
+}
+
+static void test_group(void)
+{
+	char a[256], b[256];
+
+	/* media.role comes first */
+	filter_apply_get_group(a, sizeof(a), "echo-cancel", DICT(
+			SPA_DICT_ITEM("media.role", "Communication"),
+			SPA_DICT_ITEM("application.name", "Jami")), NULL);
+	spa_assert_se(spa_streq(a, "echo-cancel-by-media-role:Communication"));
+
+	/* then the application, which can come from the client */
+	filter_apply_get_group(a, sizeof(a), "echo-cancel", DICT(
+			SPA_DICT_ITEM("media.name", "playback")), DICT(
+			SPA_DICT_ITEM("application.name", "Jami")));
+	filter_apply_get_group(b, sizeof(b), "echo-cancel", DICT(
+			SPA_DICT_ITEM("media.name", "record")), DICT(
+			SPA_DICT_ITEM("application.name", "Jami")));
+	spa_assert_se(spa_streq(a, "echo-cancel-by-application-name:Jami"));
+	spa_assert_se(spa_streq(a, b));
+
+	filter_apply_get_group(a, sizeof(a), "echo-cancel", DICT(
+			SPA_DICT_ITEM("application.id", "net.jami.Jami"),
+			SPA_DICT_ITEM("application.name", "Jami")), NULL);
+	spa_assert_se(spa_streq(a, "echo-cancel-by-application-id:net.jami.Jami"));
+
+	/* streams of different applications are not grouped */
+	filter_apply_get_group(b, sizeof(b), "echo-cancel", DICT(
+			SPA_DICT_ITEM("application.id", "org.gnome.Calls")), NULL);
+	spa_assert_se(!spa_streq(a, b));
+
+	/* streams that want a different filter are not grouped */
+	filter_apply_get_group(a, sizeof(a), "echo-cancel", DICT(
+			SPA_DICT_ITEM("media.role", "Communication")), NULL);
+	filter_apply_get_group(b, sizeof(b), "equalizer-sink", DICT(
+			SPA_DICT_ITEM("media.role", "Communication")), NULL);
+	spa_assert_se(!spa_streq(a, b));
+
+	filter_apply_get_group(a, sizeof(a), "echo-cancel", NULL, NULL);
+	spa_assert_se(spa_streq(a, "echo-cancel-fallback"));
+}
+
+int main(int argc, char *argv[])
+{
+	test_str_in_list();
+	test_get_name();
+	test_group();
+	fprintf(stdout, "filter-apply: all tests passed\n");
+	return 0;
+}
