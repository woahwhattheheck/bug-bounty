new file mode 100644
index 0000000..a39f6e4
--- /dev/null
+++ b/plugins/obs-vst3/Base64.cpp
@@ -0,0 +1,101 @@
+#include "Base64.hpp"
+
+#include <array>
+
+namespace obs_vst3 {
+
+namespace {
+
+constexpr char kAlphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+constexpr int kInvalid = -1;
+constexpr int kPadding = -2;
+
+std::array<int, 256> buildDecodeTable()
+{
+	std::array<int, 256> table;
+	table.fill(kInvalid);
+	for (int index = 0; index < 64; index++) {
+		table[static_cast<unsigned char>(kAlphabet[index])] = index;
+	}
+	table[static_cast<unsigned char>('=')] = kPadding;
+	return table;
+}
+
+} // namespace
+
+std::string encodeBase64(const std::vector<uint8_t> &data)
+{
+	std::string text;
+	text.reserve((data.size() + 2) / 3 * 4);
+
+	size_t index = 0;
+	for (; index + 2 < data.size(); index += 3) {
+		uint32_t value = (data[index] << 16) | (data[index + 1] << 8) | data[index + 2];
+		text.push_back(kAlphabet[(value >> 18) & 0x3f]);
+		text.push_back(kAlphabet[(value >> 12) & 0x3f]);
+		text.push_back(kAlphabet[(value >> 6) & 0x3f]);
+		text.push_back(kAlphabet[value & 0x3f]);
+	}
+
+	size_t remaining = data.size() - index;
+	if (remaining == 1) {
+		uint32_t value = data[index] << 16;
+		text.push_back(kAlphabet[(value >> 18) & 0x3f]);
+		text.push_back(kAlphabet[(value >> 12) & 0x3f]);
+		text.append("==");
+	} else if (remaining == 2) {
+		uint32_t value = (data[index] << 16) | (data[index + 1] << 8);
+		text.push_back(kAlphabet[(value >> 18) & 0x3f]);
+		text.push_back(kAlphabet[(value >> 12) & 0x3f]);
+		text.push_back(kAlphabet[(value >> 6) & 0x3f]);
+		text.push_back('=');
+	}
+
+	return text;
+}
+
+bool decodeBase64(const std::string &text, std::vector<uint8_t> &data)
+{
+	static const std::array<int, 256> decodeTable = buildDecodeTable();
+
+	data.clear();
+	if (text.size() % 4 != 0) {
+		return false;
+	}
+	data.reserve(text.size() / 4 * 3);
+
+	for (size_t index = 0; index < text.size(); index += 4) {
+		int values[4];
+		for (int offset = 0; offset < 4; offset++) {
+			values[offset] = decodeTable[static_cast<unsigned char>(text[index + offset])];
+			if (values[offset] == kInvalid) {
+				return false;
+			}
+		}
+
+		bool lastQuad = index + 4 == text.size();
+		if (values[0] == kPadding || values[1] == kPadding ||
+		    (!lastQuad && (values[2] == kPadding || values[3] == kPadding)) ||
+		    (values[2] == kPadding && values[3] != kPadding)) {
+			return false;
+		}
+
+		uint32_t value = (values[0] << 18) | (values[1] << 12);
+		data.push_back(static_cast<uint8_t>((value >> 16) & 0xff));
+
+		if (values[2] != kPadding) {
+			value |= values[2] << 6;
+			data.push_back(static_cast<uint8_t>((value >> 8) & 0xff));
+
+			if (values[3] != kPadding) {
+				value |= values[3];
+				data.push_back(static_cast<uint8_t>(value & 0xff));
+			}
+		}
+	}
+
+	return true;
+}
+
+} // namespace obs_vst3
