diff --git a/plugins/obs-vst3/SidechainInput.cpp b/plugins/obs-vst3/SidechainInput.cpp
new file mode 100644
index 0000000..9269914
--- /dev/null
+++ b/plugins/obs-vst3/SidechainInput.cpp
@@ -0,0 +1,184 @@
+#include "SidechainInput.hpp"
+
+#include <util/platform.h>
+
+#include <algorithm>
+#include <cstring>
+
+namespace obs_vst3 {
+
+namespace {
+
+constexpr uint64_t kReconnectIntervalNs = 3000000000ULL;
+
+} // namespace
+
+SidechainInput::SidechainInput(uint32_t channels) : channels_(std::min<uint32_t>(channels, MAX_AUDIO_CHANNELS))
+{
+	for (struct deque &buffer : buffers_) {
+		deque_init(&buffer);
+	}
+}
+
+SidechainInput::~SidechainInput()
+{
+	disconnect();
+
+	for (struct deque &buffer : buffers_) {
+		deque_free(&buffer);
+	}
+}
+
+void SidechainInput::captureCallback(void *param, obs_source_t *source, const struct audio_data *audio, bool muted)
+{
+	(void)source;
+	static_cast<SidechainInput *>(param)->capture(audio, muted);
+}
+
+void SidechainInput::capture(const struct audio_data *audio, bool muted)
+{
+	std::lock_guard<std::mutex> lock(bufferMutex_);
+
+	maxFrames_ = std::max<size_t>(maxFrames_, audio->frames);
+	size_t expectedSize = maxFrames_ * sizeof(float);
+	if (expectedSize == 0) {
+		return;
+	}
+
+	/* Keep latency bounded if the filter consumes less than the source produces. */
+	if (buffers_[0].size > expectedSize * 2) {
+		for (uint32_t channel = 0; channel < channels_; channel++) {
+			deque_pop_front(&buffers_[channel], nullptr, expectedSize);
+		}
+	}
+
+	size_t bytes = audio->frames * sizeof(float);
+	for (uint32_t channel = 0; channel < channels_; channel++) {
+		if (muted || !audio->data[channel]) {
+			deque_push_back_zero(&buffers_[channel], bytes);
+		} else {
+			deque_push_back(&buffers_[channel], audio->data[channel], bytes);
+		}
+	}
+}
+
+void SidechainInput::clearBuffers()
+{
+	std::lock_guard<std::mutex> lock(bufferMutex_);
+	for (uint32_t channel = 0; channel < channels_; channel++) {
+		deque_free(&buffers_[channel]);
+		deque_init(&buffers_[channel]);
+	}
+	maxFrames_ = 0;
+}
+
+void SidechainInput::disconnect()
+{
+	obs_weak_source_t *weakSource = nullptr;
+	{
+		std::lock_guard<std::mutex> lock(sourceMutex_);
+		weakSource = weakSource_;
+		weakSource_ = nullptr;
+	}
+
+	if (weakSource) {
+		obs_source_t *source = obs_weak_source_get_source(weakSource);
+		if (source) {
+			obs_source_remove_audio_capture_callback(source, captureCallback, this);
+			obs_source_release(source);
+		}
+		obs_weak_source_release(weakSource);
+	}
+
+	clearBuffers();
+}
+
+void SidechainInput::setSourceName(const std::string &name)
+{
+	std::string newName = name == "none" ? std::string() : name;
+
+	{
+		std::lock_guard<std::mutex> lock(sourceMutex_);
+		if (newName == sourceName_) {
+			return;
+		}
+	}
+
+	disconnect();
+
+	std::lock_guard<std::mutex> lock(sourceMutex_);
+	sourceName_ = newName;
+	/* Connect on the next tick. */
+	lastConnectAttempt_ = os_gettime_ns() - kReconnectIntervalNs;
+}
+
+void SidechainInput::tick()
+{
+	std::string name;
+	{
+		std::lock_guard<std::mutex> lock(sourceMutex_);
+		uint64_t now = os_gettime_ns();
+		if (sourceName_.empty() || weakSource_ || now - lastConnectAttempt_ < kReconnectIntervalNs) {
+			return;
+		}
+		lastConnectAttempt_ = now;
+		name = sourceName_;
+	}
+
+	obs_source_t *source = obs_get_source_by_name(name.c_str());
+	if (!source) {
+		return;
+	}
+
+	obs_weak_source_t *weakSource = obs_source_get_weak_source(source);
+	bool connected = false;
+	{
+		std::lock_guard<std::mutex> lock(sourceMutex_);
+		if (sourceName_ == name && !weakSource_) {
+			weakSource_ = weakSource;
+			weakSource = nullptr;
+			connected = true;
+		}
+	}
+
+	if (connected) {
+		obs_source_add_audio_capture_callback(source, captureCallback, this);
+	}
+
+	obs_weak_source_release(weakSource);
+	obs_source_release(source);
+}
+
+bool SidechainInput::hasSource() const
+{
+	std::lock_guard<std::mutex> lock(sourceMutex_);
+	return weakSource_ != nullptr;
+}
+
+bool SidechainInput::read(uint32_t frames, std::vector<float *> &planes)
+{
+	planes.assign(channels_, nullptr);
+	size_t bytes = frames * sizeof(float);
+
+	std::lock_guard<std::mutex> lock(bufferMutex_);
+	maxFrames_ = std::max<size_t>(maxFrames_, frames);
+
+	bool available = channels_ > 0 && buffers_[0].size >= bytes;
+	for (uint32_t channel = 0; channel < channels_; channel++) {
+		std::vector<float> &plane = planes_[channel];
+		if (plane.size() < frames) {
+			plane.resize(frames);
+		}
+
+		if (available) {
+			deque_pop_front(&buffers_[channel], plane.data(), bytes);
+		} else {
+			std::memset(plane.data(), 0, bytes);
+		}
+		planes[channel] = plane.data();
+	}
+
+	return available;
+}
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/SidechainInput.hpp b/plugins/obs-vst3/SidechainInput.hpp
new file mode 100644
index 0000000..d385a65
--- /dev/null
+++ b/plugins/obs-vst3/SidechainInput.hpp
@@ -0,0 +1,57 @@
+#pragma once
+
+#include <obs.h>
+#include <util/deque.h>
+
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace obs_vst3 {
+
+/*
+ * Audio of another OBS source, captured for a plug-in's sidechain input.
+ * Uses the same mechanism as the sidechain of the built-in compressor filter:
+ * an audio capture callback on the selected source buffers its audio, and the
+ * filter pops exactly as many frames as it processes.
+ */
+class SidechainInput {
+public:
+	explicit SidechainInput(uint32_t channels);
+	~SidechainInput();
+
+	SidechainInput(const SidechainInput &) = delete;
+	SidechainInput &operator=(const SidechainInput &) = delete;
+
+	/* An empty name or "none" disables the sidechain. */
+	void setSourceName(const std::string &name);
+
+	/* Called from video_tick: (re)connects to the source by name, retried every few seconds. */
+	void tick();
+
+	bool hasSource() const;
+
+	/* Fills `planes` with `frames` frames of sidechain audio (silence if not enough was captured). */
+	bool read(uint32_t frames, std::vector<float *> &planes);
+
+private:
+	static void captureCallback(void *param, obs_source_t *source, const struct audio_data *audio, bool muted);
+	void capture(const struct audio_data *audio, bool muted);
+	void disconnect();
+	void clearBuffers();
+
+	uint32_t channels_;
+
+	mutable std::mutex sourceMutex_;
+	obs_weak_source_t *weakSource_ = nullptr;
+	std::string sourceName_;
+	uint64_t lastConnectAttempt_ = 0;
+
+	std::mutex bufferMutex_;
+	struct deque buffers_[MAX_AUDIO_CHANNELS] = {};
+	std::vector<float> planes_[MAX_AUDIO_CHANNELS];
+	size_t maxFrames_ = 0;
+};
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/VST3Filter.cpp b/plugins/obs-vst3/VST3Filter.cpp
new file mode 100644
index 0000000..f2f9077
--- /dev/null
+++ b/plugins/obs-vst3/VST3Filter.cpp
@@ -0,0 +1,659 @@
+#include "VST3Filter.hpp"
+#include "Base64.hpp"
+#include "PluginCatalog.hpp"
+#include "SidechainInput.hpp"
+
+#include <obs-module.h>
+#include <util/platform.h>
+
+#include <algorithm>
+#include <cinttypes>
+#include <filesystem>
+
+namespace obs_vst3 {
+
+namespace {
+
+constexpr const char *kSettingPlugin = "plugin";
+constexpr const char *kSettingSidechain = "sidechain_source";
+constexpr const char *kSettingComponentState = "component_state";
+constexpr const char *kSettingControllerState = "controller_state";
+constexpr const char *kSettingStatePlugin = "state_plugin";
+
+constexpr const char *kPropertyOpenEditor = "open_editor";
+constexpr const char *kPropertyCloseEditor = "close_editor";
+constexpr const char *kPropertyRescan = "rescan_plugins";
+constexpr const char *kPropertyRestart = "restart_plugin";
+constexpr const char *kPropertyStatus = "status";
+
+constexpr uint64_t kStateSnapshotDelayNs = 1000000000ULL;
+constexpr uint64_t kRestartIntervalNs = 2000000000ULL;
+constexpr int kMaxRestartAttempts = 3;
+
+std::string replaceAll(std::string text, const std::string &placeholder, const std::string &value)
+{
+	size_t position = 0;
+	while ((position = text.find(placeholder, position)) != std::string::npos) {
+		text.replace(position, placeholder.size(), value);
+		position += value.size();
+	}
+	return text;
+}
+
+struct UiTask {
+	obs_weak_source_t *weakSource;
+	void (VST3Filter::*method)();
+};
+
+struct SidechainListContext {
+	obs_property_t *list;
+	obs_source_t *parent;
+};
+
+bool addSidechainSource(void *data, obs_source_t *source)
+{
+	auto *context = static_cast<SidechainListContext *>(data);
+
+	if (source == context->parent || (obs_source_get_output_flags(source) & OBS_SOURCE_AUDIO) == 0) {
+		return true;
+	}
+
+	const char *name = obs_source_get_name(source);
+	obs_property_list_add_string(context->list, name, name);
+	return true;
+}
+
+} // namespace
+
+VST3Filter::VST3Filter(obs_source_t *source, PluginCatalog &catalog) : source_(source), catalog_(catalog)
+{
+	struct obs_audio_info audioInfo = {};
+	if (obs_get_audio_info(&audioInfo)) {
+		sampleRate_ = audioInfo.samples_per_sec;
+		speakerLayout_ = static_cast<uint32_t>(audioInfo.speakers);
+	}
+	channels_ = std::min<uint32_t>(audio_output_get_channels(obs_get_audio()), kMaxChannels);
+
+	sidechain_ = std::make_unique<SidechainInput>(channels_);
+	sidechainPlanes_.reserve(kMaxChannels);
+}
+
+VST3Filter::~VST3Filter()
+{
+	replaceBridge(nullptr);
+	sidechain_.reset();
+}
+
+void VST3Filter::getDefaults(obs_data_t *settings)
+{
+	obs_data_set_default_string(settings, kSettingPlugin, "");
+	obs_data_set_default_string(settings, kSettingSidechain, "none");
+}
+
+std::shared_ptr<BridgeClient> VST3Filter::currentBridge()
+{
+	std::lock_guard<std::mutex> lock(bridgeMutex_);
+	return bridge_;
+}
+
+void VST3Filter::replaceBridge(std::shared_ptr<BridgeClient> bridge)
+{
+	std::shared_ptr<BridgeClient> previous;
+	{
+		std::lock_guard<std::mutex> lock(bridgeMutex_);
+		previous = std::move(bridge_);
+		bridge_ = std::move(bridge);
+	}
+
+	/* The previous bridge shuts down here, outside of the lock and off the audio thread. */
+	previous.reset();
+}
+
+PluginState VST3Filter::stateFromSettings(obs_data_t *settings, const std::string &identifier, bool &found) const
+{
+	PluginState state;
+	found = false;
+
+	if (identifier.empty() || identifier != obs_data_get_string(settings, kSettingStatePlugin)) {
+		return state;
+	}
+
+	bool componentValid = decodeBase64(obs_data_get_string(settings, kSettingComponentState), state.component);
+	bool controllerValid = decodeBase64(obs_data_get_string(settings, kSettingControllerState), state.controller);
+	found = componentValid && controllerValid && !state.component.empty();
+	return state;
+}
+
+void VST3Filter::writeStateToSettings(obs_data_t *settings, const PluginState &state, const std::string &identifier)
+{
+	obs_data_set_string(settings, kSettingComponentState, encodeBase64(state.component).c_str());
+	obs_data_set_string(settings, kSettingControllerState, encodeBase64(state.controller).c_str());
+	obs_data_set_string(settings, kSettingStatePlugin, identifier.c_str());
+}
+
+bool VST3Filter::configureBridge(BridgeClient &bridge, std::string &error)
+{
+	AudioConfiguration configuration;
+	configuration.sampleRate = static_cast<double>(sampleRate_);
+	configuration.speakerLayout = speakerLayout_;
+	configuration.channels = channels_;
+	configuration.sidechainEnabled = sidechainRequested_ && pluginInfo_.hasSidechainInput;
+
+	ConfigureResult result;
+	if (!bridge.configure(configuration, result, error)) {
+		return false;
+	}
+
+	configureResult_ = result;
+	sidechainActive_ = result.sidechainActive;
+	return true;
+}
+
+void VST3Filter::loadPlugin(const std::string &identifier, const PluginState *state)
+{
+	closeEditor();
+	replaceBridge(nullptr);
+
+	{
+		/* The remembered state must always belong to the selected plug-in. */
+		std::lock_guard<std::mutex> lock(stateMutex_);
+		if (state) {
+			lastKnownState_ = *state;
+			hasLastKnownState_ = true;
+		} else if (identifier != pluginIdentifier_) {
+			lastKnownState_ = PluginState();
+			hasLastKnownState_ = false;
+		}
+	}
+
+	pluginIdentifier_ = identifier;
+	pluginInfo_ = PluginInfo();
+	configureResult_ = ConfigureResult();
+	sidechainActive_ = false;
+	lastError_.clear();
+
+	if (identifier.empty()) {
+		return;
+	}
+
+	std::string classId;
+	std::string modulePath;
+	if (!PluginDescription::parseIdentifier(identifier, classId, modulePath)) {
+		lastError_ = "Invalid plug-in selection";
+		return;
+	}
+
+	if (sampleRate_ == 0 || channels_ == 0) {
+		lastError_ = "OBS audio is not initialized";
+		return;
+	}
+
+	std::string error;
+	std::shared_ptr<BridgeClient> bridge = BridgeClient::start(catalog_.hostExecutable(), error);
+	if (!bridge || !bridge->loadPlugin(modulePath, classId, pluginInfo_, error) ||
+	    !configureBridge(*bridge, error)) {
+		lastError_ = error;
+		blog(LOG_WARNING, "[obs-vst3: '%s'] Could not load '%s': %s", obs_source_get_name(source_),
+		     modulePath.c_str(), error.c_str());
+		return;
+	}
+
+	if (state && !bridge->setState(*state, error)) {
+		blog(LOG_WARNING, "[obs-vst3: '%s'] Could not restore the plug-in state: %s",
+		     obs_source_get_name(source_), error.c_str());
+	}
+
+	PluginState currentState;
+	if (bridge->getState(currentState, error)) {
+		std::lock_guard<std::mutex> lock(stateMutex_);
+		lastKnownState_ = std::move(currentState);
+		hasLastKnownState_ = true;
+	}
+
+	blog(LOG_INFO, "[obs-vst3: '%s'] Loaded '%s' by '%s' (latency %d samples, %u channels processed%s)",
+	     obs_source_get_name(source_), pluginInfo_.name.c_str(), pluginInfo_.vendor.c_str(),
+	     configureResult_.latencySamples, configureResult_.processedChannels,
+	     configureResult_.sidechainActive ? ", sidechain active" : "");
+
+	replaceBridge(std::move(bridge));
+}
+
+void VST3Filter::reconfigure()
+{
+	std::shared_ptr<BridgeClient> bridge = currentBridge();
+	if (!bridge || !bridge->isAlive()) {
+		return;
+	}
+
+	std::string error;
+	if (!configureBridge(*bridge, error)) {
+		lastError_ = error;
+		blog(LOG_WARNING, "[obs-vst3: '%s'] Reconfiguration failed: %s", obs_source_get_name(source_),
+		     error.c_str());
+	}
+}
+
+void VST3Filter::update(obs_data_t *settings)
+{
+	std::string identifier = obs_data_get_string(settings, kSettingPlugin);
+	std::string sidechainName = obs_data_get_string(settings, kSettingSidechain);
+	bool sidechainRequested = !sidechainName.empty() && sidechainName != "none";
+
+	sidechain_->setSourceName(sidechainRequested ? sidechainName : std::string());
+
+	std::shared_ptr<BridgeClient> bridge = currentBridge();
+	bool needsLoad = identifier != pluginIdentifier_ || (!identifier.empty() && (!bridge || !bridge->isAlive()));
+
+	if (needsLoad) {
+		sidechainRequested_ = sidechainRequested;
+
+		bool hasState = false;
+		PluginState state;
+		if (identifier == pluginIdentifier_) {
+			/* Same plug-in after its host stopped: the remembered state is newer than the settings. */
+			std::lock_guard<std::mutex> lock(stateMutex_);
+			state = lastKnownState_;
+			hasState = hasLastKnownState_;
+		}
+		if (!hasState) {
+			state = stateFromSettings(settings, identifier, hasState);
+		}
+		loadPlugin(identifier, hasState ? &state : nullptr);
+		restartAttempts_ = 0;
+		return;
+	}
+
+	if (sidechainRequested != sidechainRequested_) {
+		sidechainRequested_ = sidechainRequested;
+		if (pluginInfo_.hasSidechainInput) {
+			reconfigure();
+		}
+	}
+}
+
+void VST3Filter::save(obs_data_t *settings)
+{
+	std::shared_ptr<BridgeClient> bridge = currentBridge();
+
+	if (bridge && bridge->isAlive()) {
+		PluginState state;
+		std::string error;
+		if (bridge->getState(state, error)) {
+			writeStateToSettings(settings, state, pluginIdentifier_);
+
+			std::lock_guard<std::mutex> lock(stateMutex_);
+			lastKnownState_ = std::move(state);
+			hasLastKnownState_ = true;
+			return;
+		}
+
+		blog(LOG_WARNING, "[obs-vst3: '%s'] Could not save the plug-in state: %s", obs_source_get_name(source_),
+		     error.c_str());
+	}
+
+	/* Keep the last state we know of, e.g. while the plug-in host is restarting. */
+	std::lock_guard<std::mutex> lock(stateMutex_);
+	if (hasLastKnownState_ && !pluginIdentifier_.empty()) {
+		writeStateToSettings(settings, lastKnownState_, pluginIdentifier_);
+	}
+}
+
+struct obs_audio_data *VST3Filter::filterAudio(struct obs_audio_data *audio)
+{
+	if (!audio || audio->frames == 0) {
+		return audio;
+	}
+
+	/* Never wait here: while the bridge is (re)loaded the audio passes through unchanged. */
+	std::unique_lock<std::mutex> lock(bridgeMutex_, std::try_to_lock);
+	if (!lock.owns_lock() || !bridge_ || !bridge_->isAlive()) {
+		return audio;
+	}
+
+	const float *const *sidechain = nullptr;
+	uint32_t sidechainChannels = 0;
+	if (sidechainActive_) {
+		sidechain_->read(audio->frames, sidechainPlanes_);
+		sidechain = sidechainPlanes_.data();
+		sidechainChannels = static_cast<uint32_t>(sidechainPlanes_.size());
+	}
+
+	bridge_->process(reinterpret_cast<float *const *>(audio->data), channels_, audio->frames, sidechain,
+			 sidechainChannels);
+	return audio;
+}
+
+void VST3Filter::tick()
+{
+	sidechain_->tick();
+
+	std::shared_ptr<BridgeClient> bridge;
+	{
+		std::unique_lock<std::mutex> lock(bridgeMutex_, std::try_to_lock);
+		if (!lock.owns_lock()) {
+			return;
+		}
+		bridge = bridge_;
+	}
+
+	if (!bridge) {
+		return;
+	}
+
+	uint64_t now = os_gettime_ns();
+
+	if (!bridge->isAlive()) {
+		bool canRestart = restartAttempts_ < kMaxRestartAttempts && now - lastRestartNs_ > kRestartIntervalNs;
+		if (canRestart && !restartPending_.exchange(true)) {
+			lastRestartNs_ = now;
+			queueUiTask(&VST3Filter::restartAfterFailure);
+		}
+		return;
+	}
+
+	/* Keep a recent copy of the state so a crashed plug-in can be restored. */
+	uint32_t editCount = bridge->editCount();
+	bool editorOpen = bridge->isEditorOpen();
+	if (editCount != lastEditCount_ || (editorWasOpen_ && !editorOpen)) {
+		lastEditCount_ = editCount;
+		stateDirtySince_ = now;
+	}
+	editorWasOpen_ = editorOpen;
+
+	if (stateDirtySince_ != 0 && now - stateDirtySince_ > kStateSnapshotDelayNs && !taskPending_.exchange(true)) {
+		stateDirtySince_ = 0;
+		queueUiTask(&VST3Filter::snapshotState);
+	}
+}
+
+void VST3Filter::queueUiTask(TaskMethod method)
+{
+	auto *task = new UiTask{obs_source_get_weak_source(source_), method};
+	obs_queue_task(OBS_TASK_UI, runUiTask, task, false);
+}
+
+void VST3Filter::runUiTask(void *param)
+{
+	std::unique_ptr<UiTask> task(static_cast<UiTask *>(param));
+
+	obs_source_t *source = obs_weak_source_get_source(task->weakSource);
+	obs_weak_source_release(task->weakSource);
+	if (!source) {
+		return;
+	}
+
+	auto *filter = static_cast<VST3Filter *>(obs_obj_get_data(source));
+	if (filter) {
+		(filter->*(task->method))();
+	}
+	obs_source_release(source);
+}
+
+void VST3Filter::snapshotState()
+{
+	taskPending_ = false;
+
+	std::shared_ptr<BridgeClient> bridge = currentBridge();
+	if (!bridge || !bridge->isAlive()) {
+		return;
+	}
+
+	PluginState state;
+	std::string error;
+	if (bridge->getState(state, error)) {
+		std::lock_guard<std::mutex> lock(stateMutex_);
+		lastKnownState_ = std::move(state);
+		hasLastKnownState_ = true;
+	}
+}
+
+void VST3Filter::restartAfterFailure()
+{
+	restartPending_ = false;
+
+	std::shared_ptr<BridgeClient> bridge = currentBridge();
+	if (!bridge || bridge->isAlive() || pluginIdentifier_.empty()) {
+		return;
+	}
+
+	restartAttempts_++;
+	blog(LOG_WARNING, "[obs-vst3: '%s'] The plug-in host stopped unexpectedly, restarting '%s' (attempt %d of %d)",
+	     obs_source_get_name(source_), pluginInfo_.name.c_str(), restartAttempts_.load(), kMaxRestartAttempts);
+
+	PluginState state;
+	bool hasState = false;
+	{
+		std::lock_guard<std::mutex> lock(stateMutex_);
+		state = lastKnownState_;
+		hasState = hasLastKnownState_;
+	}
+
+	int attempts = restartAttempts_;
+	loadPlugin(pluginIdentifier_, hasState ? &state : nullptr);
+	restartAttempts_ = attempts;
+}
+
+void VST3Filter::openEditor()
+{
+	std::shared_ptr<BridgeClient> bridge = currentBridge();
+	if (!bridge || !bridge->isAlive()) {
+		return;
+	}
+
+	std::string title = pluginInfo_.name + " - " + obs_source_get_name(source_);
+	obs_source_t *parent = obs_filter_get_parent(source_);
+	if (parent) {
+		title += " (" + std::string(obs_source_get_name(parent)) + ")";
+	}
+
+	std::string error;
+	if (!bridge->showEditor(title, error)) {
+		lastError_ = error;
+		blog(LOG_WARNING, "[obs-vst3: '%s'] Could not open the plug-in editor: %s",
+		     obs_source_get_name(source_), error.c_str());
+	}
+}
+
+void VST3Filter::closeEditor()
+{
+	std::shared_ptr<BridgeClient> bridge = currentBridge();
+	if (!bridge || !bridge->isAlive() || !bridge->isEditorOpen()) {
+		return;
+	}
+
+	std::string error;
+	bridge->hideEditor(error);
+}
+
+std::string VST3Filter::statusText()
+{
+	std::shared_ptr<BridgeClient> bridge = currentBridge();
+
+	if (catalog_.isScanning()) {
+		return obs_module_text("Status.Scanning");
+	}
+
+	if (!lastError_.empty()) {
+		return replaceAll(obs_module_text("Status.Error"), "%1", lastError_);
+	}
+
+	if (pluginIdentifier_.empty()) {
+		return catalog_.plugins().empty() ? obs_module_text("Status.NoPlugins") : std::string();
+	}
+
+	if (!bridge || !bridge->isAlive()) {
+		return obs_module_text("Status.Crashed");
+	}
+
+	int32_t latency = bridge->latencySamples();
+	double latencyMs = sampleRate_ ? 1000.0 * latency / sampleRate_ : 0.0;
+	char milliseconds[32];
+	snprintf(milliseconds, sizeof(milliseconds), "%.1f", latencyMs);
+
+	std::string status = obs_module_text("Status.Latency");
+	status = replaceAll(status, "%1", std::to_string(latency));
+	status = replaceAll(status, "%2", milliseconds);
+	return status;
+}
+
+void VST3Filter::updateProperties(obs_properties_t *properties)
+{
+	std::shared_ptr<BridgeClient> bridge = currentBridge();
+	bool loaded = bridge && bridge->isAlive();
+	bool editorOpen = loaded && bridge->isEditorOpen();
+	bool failed = !pluginIdentifier_.empty() && (!loaded || !lastError_.empty());
+
+	obs_property_set_visible(obs_properties_get(properties, kPropertyOpenEditor),
+				 loaded && pluginInfo_.hasEditor && !editorOpen);
+	obs_property_set_visible(obs_properties_get(properties, kPropertyCloseEditor), editorOpen);
+	obs_property_set_visible(obs_properties_get(properties, kPropertyRestart), failed);
+	obs_property_set_visible(obs_properties_get(properties, kSettingSidechain),
+				 loaded && pluginInfo_.hasSidechainInput);
+
+	std::string status = statusText();
+	obs_property_t *statusProperty = obs_properties_get(properties, kPropertyStatus);
+	obs_property_set_description(statusProperty, status.c_str());
+	obs_property_text_set_info_type(statusProperty, failed ? OBS_TEXT_INFO_ERROR : OBS_TEXT_INFO_NORMAL);
+	obs_property_set_visible(statusProperty, !status.empty());
+}
+
+obs_property_t *VST3Filter::addPluginList(obs_properties_t *properties, PluginCatalog &catalog)
+{
+	obs_property_t *pluginList = obs_properties_add_list(properties, kSettingPlugin, obs_module_text("VST3Plugin"),
+							     OBS_COMBO_TYPE_LIST, OBS_COMBO_FORMAT_STRING);
+	obs_property_list_add_string(pluginList, obs_module_text("SelectPlugin"), "");
+
+	for (const PluginDescription &plugin : catalog.plugins()) {
+		std::string label = plugin.vendor.empty() ? plugin.name : plugin.name + " (" + plugin.vendor + ")";
+		obs_property_list_add_string(pluginList, label.c_str(), plugin.identifier().c_str());
+	}
+
+	return pluginList;
+}
+
+obs_properties_t *VST3Filter::getTypeProperties(PluginCatalog &catalog)
+{
+	obs_properties_t *properties = obs_properties_create();
+	addPluginList(properties, catalog);
+	return properties;
+}
+
+obs_properties_t *VST3Filter::getProperties()
+{
+	obs_properties_t *properties = obs_properties_create();
+	obs_property_t *pluginList = addPluginList(properties, catalog_);
+
+	bool currentListed = pluginIdentifier_.empty();
+	for (size_t index = 0; index < obs_property_list_item_count(pluginList) && !currentListed; index++) {
+		currentListed = pluginIdentifier_ == obs_property_list_item_string(pluginList, index);
+	}
+
+	if (!currentListed) {
+		/* Keep a removed or not yet scanned plug-in selectable so the setting is not lost. */
+		std::string classId;
+		std::string modulePath;
+		PluginDescription::parseIdentifier(pluginIdentifier_, classId, modulePath);
+		std::string name = pluginInfo_.name.empty() ? std::filesystem::u8path(modulePath).filename().u8string()
+							    : pluginInfo_.name;
+		std::string label = replaceAll(obs_module_text("MissingPlugin"), "%1", name);
+		obs_property_list_add_string(pluginList, label.c_str(), pluginIdentifier_.c_str());
+	}
+	obs_property_set_modified_callback2(pluginList, pluginModified, this);
+
+	obs_properties_add_button2(properties, kPropertyOpenEditor, obs_module_text("OpenPluginInterface"),
+				   openEditorClicked, this);
+	obs_properties_add_button2(properties, kPropertyCloseEditor, obs_module_text("ClosePluginInterface"),
+				   closeEditorClicked, this);
+
+	obs_property_t *sidechainList = obs_properties_add_list(properties, kSettingSidechain,
+								obs_module_text("SidechainSource"), OBS_COMBO_TYPE_LIST,
+								OBS_COMBO_FORMAT_STRING);
+	obs_property_list_add_string(sidechainList, obs_module_text("None"), "none");
+	SidechainListContext context = {sidechainList, obs_filter_get_parent(source_)};
+	obs_enum_sources(addSidechainSource, &context);
+	obs_property_set_modified_callback2(sidechainList, sidechainModified, this);
+
+	obs_properties_add_text(properties, kPropertyStatus, "", OBS_TEXT_INFO);
+
+	obs_properties_add_button2(properties, kPropertyRestart, obs_module_text("RestartPlugin"), restartClicked,
+				   this);
+	obs_properties_add_button2(properties, kPropertyRescan, obs_module_text("RescanPlugins"), rescanClicked, this);
+
+	updateProperties(properties);
+	return properties;
+}
+
+bool VST3Filter::pluginModified(void *data, obs_properties_t *properties, obs_property_t *property,
+				obs_data_t *settings)
+{
+	(void)property;
+
+	/* Apply right away so the buttons below reflect the newly loaded plug-in. */
+	auto *filter = static_cast<VST3Filter *>(data);
+	filter->update(settings);
+	filter->updateProperties(properties);
+	return true;
+}
+
+bool VST3Filter::sidechainModified(void *data, obs_properties_t *properties, obs_property_t *property,
+				   obs_data_t *settings)
+{
+	(void)property;
+
+	auto *filter = static_cast<VST3Filter *>(data);
+	filter->update(settings);
+	filter->updateProperties(properties);
+	return true;
+}
+
+bool VST3Filter::openEditorClicked(obs_properties_t *properties, obs_property_t *property, void *data)
+{
+	(void)property;
+
+	auto *filter = static_cast<VST3Filter *>(data);
+	filter->openEditor();
+	filter->updateProperties(properties);
+	return true;
+}
+
+bool VST3Filter::closeEditorClicked(obs_properties_t *properties, obs_property_t *property, void *data)
+{
+	(void)property;
+
+	auto *filter = static_cast<VST3Filter *>(data);
+	filter->closeEditor();
+	filter->updateProperties(properties);
+	return true;
+}
+
+bool VST3Filter::restartClicked(obs_properties_t *properties, obs_property_t *property, void *data)
+{
+	(void)property;
+
+	auto *filter = static_cast<VST3Filter *>(data);
+	PluginState state;
+	bool hasState = false;
+	{
+		std::lock_guard<std::mutex> lock(filter->stateMutex_);
+		state = filter->lastKnownState_;
+		hasState = filter->hasLastKnownState_;
+	}
+
+	filter->loadPlugin(filter->pluginIdentifier_, hasState ? &state : nullptr);
+	filter->restartAttempts_ = 0;
+	filter->updateProperties(properties);
+	return true;
+}
+
+bool VST3Filter::rescanClicked(obs_properties_t *properties, obs_property_t *property, void *data)
+{
+	(void)properties;
+	(void)property;
+
+	/* Returning true rebuilds the properties, including the plug-in list. */
+	auto *filter = static_cast<VST3Filter *>(data);
+	filter->catalog_.scan(true);
+	return true;
+}
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/VST3Filter.hpp b/plugins/obs-vst3/VST3Filter.hpp
new file mode 100644
index 0000000..ba32bb5
--- /dev/null
+++ b/plugins/obs-vst3/VST3Filter.hpp
@@ -0,0 +1,114 @@
+#pragma once
+
+#include "BridgeClient.hpp"
+
+#include <obs.h>
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace obs_vst3 {
+
+class PluginCatalog;
+class SidechainInput;
+
+/*
+ * One "VST3 Plug-in" audio filter instance.
+ *
+ * The plug-in itself runs in an obs-vst3-host process owned through a
+ * BridgeClient. Lifecycle operations (starting the bridge, loading,
+ * configuring, state transfer, editor) run on the OBS UI thread. The audio
+ * thread only ever try-locks the bridge, so a reload or a hung plug-in never
+ * blocks OBS audio: the filter passes audio through unchanged instead.
+ */
+class VST3Filter {
+public:
+	VST3Filter(obs_source_t *source, PluginCatalog &catalog);
+	~VST3Filter();
+
+	VST3Filter(const VST3Filter &) = delete;
+	VST3Filter &operator=(const VST3Filter &) = delete;
+
+	static void getDefaults(obs_data_t *settings);
+
+	/* Properties without a filter instance (obs_get_source_properties). */
+	static obs_properties_t *getTypeProperties(PluginCatalog &catalog);
+
+	void update(obs_data_t *settings);
+	void save(obs_data_t *settings);
+	struct obs_audio_data *filterAudio(struct obs_audio_data *audio);
+	void tick();
+	obs_properties_t *getProperties();
+
+private:
+	using TaskMethod = void (VST3Filter::*)();
+
+	std::shared_ptr<BridgeClient> currentBridge();
+	void replaceBridge(std::shared_ptr<BridgeClient> bridge);
+
+	void loadPlugin(const std::string &identifier, const PluginState *state);
+	bool configureBridge(BridgeClient &bridge, std::string &error);
+	void reconfigure();
+	void openEditor();
+	void closeEditor();
+	void restartAfterFailure();
+	void snapshotState();
+	void queueUiTask(TaskMethod method);
+
+	PluginState stateFromSettings(obs_data_t *settings, const std::string &identifier, bool &found) const;
+	void writeStateToSettings(obs_data_t *settings, const PluginState &state, const std::string &identifier);
+
+	static obs_property_t *addPluginList(obs_properties_t *properties, PluginCatalog &catalog);
+	void updateProperties(obs_properties_t *properties);
+	std::string statusText();
+
+	static void runUiTask(void *param);
+	static bool pluginModified(void *data, obs_properties_t *properties, obs_property_t *property,
+				   obs_data_t *settings);
+	static bool sidechainModified(void *data, obs_properties_t *properties, obs_property_t *property,
+				      obs_data_t *settings);
+	static bool openEditorClicked(obs_properties_t *properties, obs_property_t *property, void *data);
+	static bool closeEditorClicked(obs_properties_t *properties, obs_property_t *property, void *data);
+	static bool rescanClicked(obs_properties_t *properties, obs_property_t *property, void *data);
+	static bool restartClicked(obs_properties_t *properties, obs_property_t *property, void *data);
+
+	obs_source_t *source_;
+	PluginCatalog &catalog_;
+
+	uint32_t sampleRate_ = 0;
+	uint32_t speakerLayout_ = 0;
+	uint32_t channels_ = 0;
+
+	/* Held by the audio thread while processing; never held across IPC by other threads. */
+	std::mutex bridgeMutex_;
+	std::shared_ptr<BridgeClient> bridge_;
+	std::atomic<bool> sidechainActive_{false};
+
+	/* UI thread state. */
+	std::string pluginIdentifier_;
+	PluginInfo pluginInfo_;
+	ConfigureResult configureResult_;
+	std::string lastError_;
+	bool sidechainRequested_ = false;
+
+	std::mutex stateMutex_;
+	PluginState lastKnownState_;
+	bool hasLastKnownState_ = false;
+
+	std::atomic<bool> taskPending_{false};
+	std::atomic<bool> restartPending_{false};
+	uint32_t lastEditCount_ = 0;
+	uint64_t stateDirtySince_ = 0;
+	bool editorWasOpen_ = false;
+	std::atomic<int> restartAttempts_{0};
+	uint64_t lastRestartNs_ = 0;
+
+	std::unique_ptr<SidechainInput> sidechain_;
+	std::vector<float *> sidechainPlanes_;
+};
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/bridge/BridgeProtocol.hpp b/plugins/obs-vst3/bridge/BridgeProtocol.hpp
new file mode 100644
index 0000000..e136a3b
--- /dev/null
+++ b/plugins/obs-vst3/bridge/BridgeProtocol.hpp
@@ -0,0 +1,138 @@
+#pragma once
+
+/*
+ * Wire protocol shared by the obs-vst3 module (running inside OBS) and the
+ * obs-vst3-host bridge process (running the VST3 plug-in).
+ *
+ * Two byte-stream channels connect both processes (socket pairs on POSIX,
+ * named pipes on Windows):
+ *
+ *  - The command channel carries length-prefixed request/reply messages
+ *    (plug-in loading, configuration, state transfer, editor control).
+ *    Every request is answered by exactly one reply with the same command.
+ *  - The audio channel only carries the fixed-size ProcessRequest and
+ *    ProcessReply records that hand a block of audio over to the bridge
+ *    and back. The samples themselves live in a shared memory region whose
+ *    layout is described by SharedAudioHeader.
+ *
+ * Both processes are always built from the same source tree, the protocol
+ * version is only checked to catch mismatched installations.
+ */
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace obs_vst3 {
+
+constexpr uint32_t kProtocolVersion = 1;
+constexpr uint32_t kSharedMemoryMagic = 0x4f565333; /* "OVS3" */
+
+/* Matches MAX_AUDIO_CHANNELS and AUDIO_OUTPUT_FRAMES of libobs. */
+constexpr uint32_t kMaxChannels = 8;
+constexpr uint32_t kMaxBlockFrames = 1024;
+
+/* Upper bound for a single command payload (plug-in state can be large). */
+constexpr uint32_t kMaxPayloadSize = 64 * 1024 * 1024;
+
+enum class Command : uint32_t {
+	Invalid = 0,
+	Hello = 1,
+	LoadPlugin = 2,
+	Configure = 3,
+	SetState = 4,
+	GetState = 5,
+	ShowEditor = 6,
+	HideEditor = 7,
+	Shutdown = 8,
+	ScanModule = 9,
+};
+
+enum class Status : int32_t {
+	Invalid = 0,
+	Ok = 1,
+	Failed = 2,
+	NotLoaded = 3,
+	NotConfigured = 4,
+	Unsupported = 5,
+	Busy = 6,
+	ProtocolError = 7,
+};
+
+struct MessageHeader {
+	uint32_t command;
+	uint32_t payloadSize;
+};
+
+enum ProcessFlags : uint32_t {
+	kProcessFlagNone = 0,
+	kProcessFlagSidechain = 1u << 0,
+};
+
+struct ProcessRequest {
+	uint32_t frames;
+	uint32_t flags;
+	int64_t projectTimeSamples;
+};
+
+struct ProcessReply {
+	int32_t status;
+	uint32_t reserved;
+};
+
+static_assert(std::atomic<uint32_t>::is_always_lock_free, "Shared memory atomics must be lock-free");
+static_assert(std::atomic<int32_t>::is_always_lock_free, "Shared memory atomics must be lock-free");
+
+/*
+ * Header at the start of the shared memory region. The header is followed by
+ * three blocks of kMaxChannels planes with kMaxBlockFrames float samples each:
+ * main input, sidechain input and main output.
+ *
+ * Fields written by the bridge process are atomics so that the module can
+ * poll them from any thread without an IPC round trip.
+ */
+struct alignas(64) SharedAudioHeader {
+	uint32_t magic;
+	uint32_t version;
+	uint32_t maxChannels;
+	uint32_t maxFrames;
+
+	/* Written by the bridge process. */
+	std::atomic<uint32_t> editorOpen;
+	std::atomic<int32_t> latencySamples;
+	std::atomic<uint32_t> editCount;
+	std::atomic<uint32_t> processedBlocks;
+};
+
+enum class AudioRegion : uint32_t {
+	Input = 0,
+	Sidechain = 1,
+	Output = 2,
+};
+
+constexpr size_t kAudioRegionCount = 3;
+constexpr size_t kAudioPlaneSize = kMaxBlockFrames * sizeof(float);
+constexpr size_t kAudioRegionSize = kMaxChannels * kAudioPlaneSize;
+constexpr size_t kSharedMemorySize = sizeof(SharedAudioHeader) + kAudioRegionCount * kAudioRegionSize;
+
+inline float *audioPlane(void *sharedMemory, AudioRegion region, uint32_t channel)
+{
+	auto *base = static_cast<uint8_t *>(sharedMemory) + sizeof(SharedAudioHeader);
+	size_t offset = static_cast<size_t>(region) * kAudioRegionSize + channel * kAudioPlaneSize;
+	return reinterpret_cast<float *>(base + offset);
+}
+
+/* Timeouts (milliseconds) used by the module when talking to the bridge. */
+constexpr int kHandshakeTimeoutMs = 10000;
+constexpr int kLoadTimeoutMs = 60000;
+constexpr int kCommandTimeoutMs = 15000;
+constexpr int kProcessTimeoutMs = 500;
+constexpr int kScanTimeoutMs = 30000;
+constexpr int kShutdownTimeoutMs = 2000;
+
+/* File descriptor numbers used to hand the channels to the bridge on POSIX. */
+constexpr int kChildCommandFd = 3;
+constexpr int kChildAudioFd = 4;
+constexpr int kChildSharedMemoryFd = 5;
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/bridge/IpcChannel.cpp b/plugins/obs-vst3/bridge/IpcChannel.cpp
new file mode 100644
index 0000000..a08b433
--- /dev/null
+++ b/plugins/obs-vst3/bridge/IpcChannel.cpp
@@ -0,0 +1,65 @@
+#include "IpcChannel.hpp"
+
+#include <utility>
+
+namespace obs_vst3 {
+
+IpcChannel::IpcChannel(IpcChannel &&other) noexcept
+{
+	*this = std::move(other);
+}
+
+IpcChannel &IpcChannel::operator=(IpcChannel &&other) noexcept
+{
+	if (this != &other) {
+		close();
+		handle_ = other.handle_;
+		interrupted_ = other.interrupted_.load();
+#ifdef _WIN32
+		readEvent_ = other.readEvent_;
+		writeEvent_ = other.writeEvent_;
+#endif
+		other.reset();
+	}
+
+	return *this;
+}
+
+IpcChannel::~IpcChannel()
+{
+	close();
+}
+
+bool IpcChannel::sendMessage(Command command, const std::vector<uint8_t> &payload, int timeoutMs)
+{
+	if (payload.size() > kMaxPayloadSize) {
+		return false;
+	}
+
+	MessageHeader header = {static_cast<uint32_t>(command), static_cast<uint32_t>(payload.size())};
+	if (!write(&header, sizeof(header), timeoutMs)) {
+		return false;
+	}
+
+	return payload.empty() || write(payload.data(), payload.size(), timeoutMs);
+}
+
+bool IpcChannel::receiveMessage(Command &command, std::vector<uint8_t> &payload, int timeoutMs)
+{
+	MessageHeader header = {};
+	if (!read(&header, sizeof(header), timeoutMs)) {
+		return false;
+	}
+
+	if (header.payloadSize > kMaxPayloadSize) {
+		return false;
+	}
+
+	command = static_cast<Command>(header.command);
+	payload.resize(header.payloadSize);
+
+	/* The header was received, the payload follows immediately. */
+	return payload.empty() || read(payload.data(), payload.size(), timeoutMs < 0 ? -1 : kCommandTimeoutMs);
+}
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/bridge/IpcChannel.hpp b/plugins/obs-vst3/bridge/IpcChannel.hpp
new file mode 100644
index 0000000..64f2ec4
--- /dev/null
+++ b/plugins/obs-vst3/bridge/IpcChannel.hpp
@@ -0,0 +1,65 @@
+#pragma once
+
+#include "BridgeProtocol.hpp"
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace obs_vst3 {
+
+#ifdef _WIN32
+using NativeHandle = void *;
+#else
+using NativeHandle = int;
+#endif
+
+NativeHandle invalidNativeHandle();
+
+/*
+ * One end of a bidirectional byte stream between the module and the bridge
+ * process: a connected AF_UNIX stream socket on POSIX systems, an overlapped
+ * named pipe handle on Windows.
+ *
+ * Reads and writes take a timeout in milliseconds (negative values wait
+ * forever). Any failure (timeout, peer closed the connection, I/O error) is
+ * reported as false and the caller is expected to treat the peer as gone.
+ * One thread may read while another thread writes.
+ */
+class IpcChannel {
+public:
+	IpcChannel() = default;
+	explicit IpcChannel(NativeHandle handle);
+	~IpcChannel();
+
+	IpcChannel(const IpcChannel &) = delete;
+	IpcChannel &operator=(const IpcChannel &) = delete;
+	IpcChannel(IpcChannel &&other) noexcept;
+	IpcChannel &operator=(IpcChannel &&other) noexcept;
+
+	bool isOpen() const;
+	void close();
+
+	/* Makes a read or write blocked in another thread fail (used during shutdown). */
+	void interrupt();
+	NativeHandle nativeHandle() const { return handle_; }
+
+	bool write(const void *data, size_t size, int timeoutMs);
+	bool read(void *data, size_t size, int timeoutMs);
+
+	bool sendMessage(Command command, const std::vector<uint8_t> &payload, int timeoutMs);
+	bool receiveMessage(Command &command, std::vector<uint8_t> &payload, int timeoutMs);
+
+private:
+	void reset();
+
+	NativeHandle handle_ = invalidNativeHandle();
+	std::atomic<bool> interrupted_{false};
+#ifdef _WIN32
+	void *readEvent_ = nullptr;
+	void *writeEvent_ = nullptr;
+#endif
+};
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/bridge/IpcChannel_Posix.cpp b/plugins/obs-vst3/bridge/IpcChannel_Posix.cpp
new file mode 100644
index 0000000..e5ecc2d
--- /dev/null
+++ b/plugins/obs-vst3/bridge/IpcChannel_Posix.cpp
@@ -0,0 +1,168 @@
+#include "IpcChannel.hpp"
+
+#include <cerrno>
+#include <chrono>
+
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+namespace obs_vst3 {
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+int remainingMs(Clock::time_point deadline, int timeoutMs)
+{
+	if (timeoutMs < 0) {
+		return -1;
+	}
+
+	auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - Clock::now()).count();
+	return remaining > 0 ? static_cast<int>(remaining) : 0;
+}
+
+bool waitFor(int fd, short events, Clock::time_point deadline, int timeoutMs)
+{
+	for (;;) {
+		pollfd descriptor = {fd, events, 0};
+		int result = poll(&descriptor, 1, remainingMs(deadline, timeoutMs));
+
+		if (result > 0) {
+			return true;
+		}
+
+		if (result == 0) {
+			return false;
+		}
+
+		if (errno != EINTR) {
+			return false;
+		}
+	}
+}
+
+} // namespace
+
+NativeHandle invalidNativeHandle()
+{
+	return -1;
+}
+
+IpcChannel::IpcChannel(NativeHandle handle) : handle_(handle)
+{
+#ifdef SO_NOSIGPIPE
+	int enable = 1;
+	setsockopt(handle_, SOL_SOCKET, SO_NOSIGPIPE, &enable, sizeof(enable));
+#endif
+}
+
+bool IpcChannel::isOpen() const
+{
+	return handle_ >= 0;
+}
+
+void IpcChannel::reset()
+{
+	handle_ = -1;
+	interrupted_ = false;
+}
+
+void IpcChannel::interrupt()
+{
+	interrupted_ = true;
+	if (handle_ >= 0) {
+		/* Wakes up poll() in other threads, unlike close(). */
+		shutdown(handle_, SHUT_RDWR);
+	}
+}
+
+void IpcChannel::close()
+{
+	if (handle_ >= 0) {
+		::close(handle_);
+	}
+
+	reset();
+}
+
+bool IpcChannel::write(const void *data, size_t size, int timeoutMs)
+{
+	if (!isOpen() || interrupted_) {
+		return false;
+	}
+
+	const auto *bytes = static_cast<const uint8_t *>(data);
+	auto deadline = Clock::now() + std::chrono::milliseconds(timeoutMs < 0 ? 0 : timeoutMs);
+
+#ifdef MSG_NOSIGNAL
+	const int flags = MSG_NOSIGNAL;
+#else
+	const int flags = 0;
+#endif
+
+	while (size > 0) {
+		ssize_t written = send(handle_, bytes, size, flags | MSG_DONTWAIT);
+
+		if (written > 0) {
+			bytes += written;
+			size -= static_cast<size_t>(written);
+			continue;
+		}
+
+		if (written < 0 && errno == EINTR) {
+			continue;
+		}
+
+		if (written < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+			if (!waitFor(handle_, POLLOUT, deadline, timeoutMs)) {
+				return false;
+			}
+			continue;
+		}
+
+		return false;
+	}
+
+	return true;
+}
+
+bool IpcChannel::read(void *data, size_t size, int timeoutMs)
+{
+	if (!isOpen() || interrupted_) {
+		return false;
+	}
+
+	auto *bytes = static_cast<uint8_t *>(data);
+	auto deadline = Clock::now() + std::chrono::milliseconds(timeoutMs < 0 ? 0 : timeoutMs);
+
+	while (size > 0) {
+		if (!waitFor(handle_, POLLIN, deadline, timeoutMs)) {
+			return false;
+		}
+
+		ssize_t received = recv(handle_, bytes, size, MSG_DONTWAIT);
+
+		if (received > 0) {
+			bytes += received;
+			size -= static_cast<size_t>(received);
+			continue;
+		}
+
+		if (received == 0) {
+			/* Peer closed the connection (or crashed). */
+			return false;
+		}
+
+		if (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK) {
+			continue;
+		}
+
+		return false;
+	}
+
+	return true;
+}
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/bridge/IpcChannel_Windows.cpp b/plugins/obs-vst3/bridge/IpcChannel_Windows.cpp
new file mode 100644
index 0000000..2b7d9f1
--- /dev/null
+++ b/plugins/obs-vst3/bridge/IpcChannel_Windows.cpp
@@ -0,0 +1,165 @@
+#include "IpcChannel.hpp"
+
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+
+namespace obs_vst3 {
+
+namespace {
+
+/*
+ * Runs one overlapped ReadFile/WriteFile call and waits for its completion.
+ * On timeout the pending operation is cancelled before returning so that the
+ * OVERLAPPED structure and buffer are no longer referenced by the kernel.
+ */
+bool completeOverlapped(HANDLE handle, OVERLAPPED &overlapped, BOOL started, DWORD timeoutMs, DWORD &transferred)
+{
+	if (!started && GetLastError() != ERROR_IO_PENDING) {
+		return false;
+	}
+
+	DWORD waitResult = WaitForSingleObject(overlapped.hEvent, timeoutMs);
+	if (waitResult != WAIT_OBJECT_0) {
+		CancelIoEx(handle, &overlapped);
+		GetOverlappedResult(handle, &overlapped, &transferred, TRUE);
+		return false;
+	}
+
+	return GetOverlappedResult(handle, &overlapped, &transferred, FALSE) != FALSE;
+}
+
+DWORD toWaitTimeout(int timeoutMs)
+{
+	return timeoutMs < 0 ? INFINITE : static_cast<DWORD>(timeoutMs);
+}
+
+} // namespace
+
+NativeHandle invalidNativeHandle()
+{
+	return INVALID_HANDLE_VALUE;
+}
+
+IpcChannel::IpcChannel(NativeHandle handle) : handle_(handle)
+{
+	readEvent_ = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+	writeEvent_ = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+}
+
+bool IpcChannel::isOpen() const
+{
+	return handle_ != INVALID_HANDLE_VALUE && handle_ != nullptr && readEvent_ && writeEvent_;
+}
+
+void IpcChannel::reset()
+{
+	handle_ = INVALID_HANDLE_VALUE;
+	readEvent_ = nullptr;
+	writeEvent_ = nullptr;
+	interrupted_ = false;
+}
+
+void IpcChannel::interrupt()
+{
+	interrupted_ = true;
+	if (isOpen()) {
+		/* Cancels pending overlapped operations issued by any thread. */
+		CancelIoEx(handle_, nullptr);
+	}
+}
+
+void IpcChannel::close()
+{
+	if (handle_ != INVALID_HANDLE_VALUE && handle_ != nullptr) {
+		CloseHandle(handle_);
+	}
+	if (readEvent_) {
+		CloseHandle(readEvent_);
+	}
+	if (writeEvent_) {
+		CloseHandle(writeEvent_);
+	}
+
+	reset();
+}
+
+bool IpcChannel::write(const void *data, size_t size, int timeoutMs)
+{
+	if (!isOpen()) {
+		return false;
+	}
+
+	const auto *bytes = static_cast<const uint8_t *>(data);
+	ULONGLONG deadline = GetTickCount64() + (timeoutMs < 0 ? 0 : timeoutMs);
+
+	while (size > 0) {
+		if (interrupted_) {
+			return false;
+		}
+
+		OVERLAPPED overlapped = {};
+		overlapped.hEvent = writeEvent_;
+		ResetEvent(writeEvent_);
+
+		DWORD chunk = size > MAXDWORD ? MAXDWORD : static_cast<DWORD>(size);
+		DWORD transferred = 0;
+		BOOL started = WriteFile(handle_, bytes, chunk, nullptr, &overlapped);
+
+		DWORD wait = INFINITE;
+		if (timeoutMs >= 0) {
+			ULONGLONG now = GetTickCount64();
+			wait = now >= deadline ? 0 : static_cast<DWORD>(deadline - now);
+		}
+
+		if (!completeOverlapped(handle_, overlapped, started, wait, transferred) || transferred == 0) {
+			return false;
+		}
+
+		bytes += transferred;
+		size -= transferred;
+	}
+
+	return true;
+}
+
+bool IpcChannel::read(void *data, size_t size, int timeoutMs)
+{
+	if (!isOpen()) {
+		return false;
+	}
+
+	auto *bytes = static_cast<uint8_t *>(data);
+	ULONGLONG deadline = GetTickCount64() + (timeoutMs < 0 ? 0 : timeoutMs);
+
+	while (size > 0) {
+		if (interrupted_) {
+			return false;
+		}
+
+		OVERLAPPED overlapped = {};
+		overlapped.hEvent = readEvent_;
+		ResetEvent(readEvent_);
+
+		DWORD chunk = size > MAXDWORD ? MAXDWORD : static_cast<DWORD>(size);
+		DWORD transferred = 0;
+		BOOL started = ReadFile(handle_, bytes, chunk, nullptr, &overlapped);
+
+		DWORD wait = toWaitTimeout(timeoutMs);
+		if (timeoutMs >= 0) {
+			ULONGLONG now = GetTickCount64();
+			wait = now >= deadline ? 0 : static_cast<DWORD>(deadline - now);
+		}
+
+		/* ERROR_BROKEN_PIPE: the other process closed its end or exited. */
+		if (!completeOverlapped(handle_, overlapped, started, wait, transferred) || transferred == 0) {
+			return false;
+		}
+
+		bytes += transferred;
+		size -= transferred;
+	}
+
+	return true;
+}
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/bridge/MessageReader.cpp b/plugins/obs-vst3/bridge/MessageReader.cpp
new file mode 100644
index 0000000..2e7e6d1
--- /dev/null
+++ b/plugins/obs-vst3/bridge/MessageReader.cpp
@@ -0,0 +1,76 @@
+#include "MessageReader.hpp"
+
+#include <cstring>
+
+namespace obs_vst3 {
+
+bool MessageReader::extract(void *data, size_t size)
+{
+	if (size > buffer_.size() - offset_) {
+		return false;
+	}
+
+	if (size > 0) {
+		std::memcpy(data, buffer_.data() + offset_, size);
+	}
+
+	offset_ += size;
+	return true;
+}
+
+bool MessageReader::readUInt32(uint32_t &value)
+{
+	return extract(&value, sizeof(value));
+}
+
+bool MessageReader::readInt32(int32_t &value)
+{
+	return extract(&value, sizeof(value));
+}
+
+bool MessageReader::readUInt64(uint64_t &value)
+{
+	return extract(&value, sizeof(value));
+}
+
+bool MessageReader::readDouble(double &value)
+{
+	return extract(&value, sizeof(value));
+}
+
+bool MessageReader::readBool(bool &value)
+{
+	uint32_t raw = 0;
+	if (!readUInt32(raw)) {
+		return false;
+	}
+
+	value = raw != 0;
+	return true;
+}
+
+bool MessageReader::readString(std::string &value)
+{
+	uint32_t size = 0;
+	if (!readUInt32(size) || size > buffer_.size() - offset_) {
+		return false;
+	}
+
+	value.assign(reinterpret_cast<const char *>(buffer_.data() + offset_), size);
+	offset_ += size;
+	return true;
+}
+
+bool MessageReader::readBlob(std::vector<uint8_t> &value)
+{
+	uint32_t size = 0;
+	if (!readUInt32(size) || size > buffer_.size() - offset_) {
+		return false;
+	}
+
+	value.assign(buffer_.begin() + offset_, buffer_.begin() + offset_ + size);
+	offset_ += size;
+	return true;
+}
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/bridge/MessageReader.hpp b/plugins/obs-vst3/bridge/MessageReader.hpp
new file mode 100644
index 0000000..f42a3dc
--- /dev/null
+++ b/plugins/obs-vst3/bridge/MessageReader.hpp
@@ -0,0 +1,35 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace obs_vst3 {
+
+/*
+ * Reads values written by MessageWriter. Every read is bounds checked and
+ * returns false once the payload is exhausted or malformed, so a corrupt or
+ * truncated message can never cause an out-of-bounds access.
+ */
+class MessageReader {
+public:
+	explicit MessageReader(const std::vector<uint8_t> &buffer) : buffer_(buffer) {}
+
+	bool readUInt32(uint32_t &value);
+	bool readInt32(int32_t &value);
+	bool readUInt64(uint64_t &value);
+	bool readDouble(double &value);
+	bool readBool(bool &value);
+	bool readString(std::string &value);
+	bool readBlob(std::vector<uint8_t> &value);
+
+	bool atEnd() const { return offset_ == buffer_.size(); }
+
+private:
+	bool extract(void *data, size_t size);
+
+	const std::vector<uint8_t> &buffer_;
+	size_t offset_ = 0;
+};
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/bridge/MessageWriter.cpp b/plugins/obs-vst3/bridge/MessageWriter.cpp
new file mode 100644
index 0000000..ffbd24c
--- /dev/null
+++ b/plugins/obs-vst3/bridge/MessageWriter.cpp
@@ -0,0 +1,55 @@
+#include "MessageWriter.hpp"
+
+#include <cstring>
+
+namespace obs_vst3 {
+
+void MessageWriter::append(const void *data, size_t size)
+{
+	const auto *bytes = static_cast<const uint8_t *>(data);
+	buffer_.insert(buffer_.end(), bytes, bytes + size);
+}
+
+void MessageWriter::writeUInt32(uint32_t value)
+{
+	append(&value, sizeof(value));
+}
+
+void MessageWriter::writeInt32(int32_t value)
+{
+	append(&value, sizeof(value));
+}
+
+void MessageWriter::writeUInt64(uint64_t value)
+{
+	append(&value, sizeof(value));
+}
+
+void MessageWriter::writeDouble(double value)
+{
+	append(&value, sizeof(value));
+}
+
+void MessageWriter::writeBool(bool value)
+{
+	writeUInt32(value ? 1 : 0);
+}
+
+void MessageWriter::writeString(const std::string &value)
+{
+	writeUInt32(static_cast<uint32_t>(value.size()));
+	append(value.data(), value.size());
+}
+
+void MessageWriter::writeBlob(const std::vector<uint8_t> &value)
+{
+	writeUInt32(static_cast<uint32_t>(value.size()));
+	append(value.data(), value.size());
+}
+
+void MessageWriter::writeBytes(const std::vector<uint8_t> &bytes)
+{
+	append(bytes.data(), bytes.size());
+}
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/bridge/MessageWriter.hpp b/plugins/obs-vst3/bridge/MessageWriter.hpp
new file mode 100644
index 0000000..d808008
--- /dev/null
+++ b/plugins/obs-vst3/bridge/MessageWriter.hpp
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace obs_vst3 {
+
+/* Serializes command payloads into a byte buffer (native byte order). */
+class MessageWriter {
+public:
+	void writeUInt32(uint32_t value);
+	void writeInt32(int32_t value);
+	void writeUInt64(uint64_t value);
+	void writeDouble(double value);
+	void writeBool(bool value);
+	void writeString(const std::string &value);
+	void writeBlob(const std::vector<uint8_t> &value);
+	void writeBytes(const std::vector<uint8_t> &bytes);
+
+	const std::vector<uint8_t> &data() const { return buffer_; }
+	void clear() { buffer_.clear(); }
+
+private:
+	void append(const void *data, size_t size);
+
+	std::vector<uint8_t> buffer_;
+};
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/bridge/SharedMemory.hpp b/plugins/obs-vst3/bridge/SharedMemory.hpp
new file mode 100644
index 0000000..114c842
--- /dev/null
+++ b/plugins/obs-vst3/bridge/SharedMemory.hpp
@@ -0,0 +1,42 @@
+#pragma once
+
+#include "IpcChannel.hpp"
+
+#include <cstddef>
+#include <memory>
+#include <string>
+
+namespace obs_vst3 {
+
+/*
+ * Anonymous shared memory region used to exchange audio samples with the
+ * bridge process. The module creates the region and hands the native handle
+ * to the bridge process at launch (inherited file descriptor / handle), so
+ * no named object is ever visible to other processes.
+ */
+class SharedMemory {
+public:
+	static std::unique_ptr<SharedMemory> create(size_t size, std::string &error);
+	static std::unique_ptr<SharedMemory> attach(NativeHandle handle, size_t size, std::string &error);
+
+	~SharedMemory();
+
+	SharedMemory(const SharedMemory &) = delete;
+	SharedMemory &operator=(const SharedMemory &) = delete;
+
+	void *data() const { return data_; }
+	size_t size() const { return size_; }
+	NativeHandle nativeHandle() const { return handle_; }
+
+	/* Closes the handle while keeping the mapping alive. */
+	void closeHandle();
+
+private:
+	SharedMemory(NativeHandle handle, void *data, size_t size) : handle_(handle), data_(data), size_(size) {}
+
+	NativeHandle handle_;
+	void *data_;
+	size_t size_;
+};
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/bridge/SharedMemory_Posix.cpp b/plugins/obs-vst3/bridge/SharedMemory_Posix.cpp
new file mode 100644
index 0000000..cffb43b
--- /dev/null
+++ b/plugins/obs-vst3/bridge/SharedMemory_Posix.cpp
@@ -0,0 +1,103 @@
+#include "SharedMemory.hpp"
+
+#include <atomic>
+#include <cerrno>
+#include <cstring>
+
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+namespace obs_vst3 {
+
+namespace {
+
+int createAnonymousFile(std::string &error)
+{
+#if defined(__linux__)
+	int fd = memfd_create("obs-vst3-audio", MFD_CLOEXEC);
+	if (fd < 0) {
+		error = std::string("memfd_create failed: ") + std::strerror(errno);
+	}
+	return fd;
+#else
+	static std::atomic<unsigned> counter{0};
+	for (int attempt = 0; attempt < 16; attempt++) {
+		std::string name = "/obs-vst3-" + std::to_string(getpid()) + "-" + std::to_string(counter++);
+		int fd = shm_open(name.c_str(), O_RDWR | O_CREAT | O_EXCL, 0600);
+		if (fd >= 0) {
+			/* Unlink right away, the region lives on through the descriptor. */
+			shm_unlink(name.c_str());
+			fcntl(fd, F_SETFD, FD_CLOEXEC);
+			return fd;
+		}
+		if (errno != EEXIST) {
+			break;
+		}
+	}
+	error = std::string("shm_open failed: ") + std::strerror(errno);
+	return -1;
+#endif
+}
+
+} // namespace
+
+std::unique_ptr<SharedMemory> SharedMemory::create(size_t size, std::string &error)
+{
+	int fd = createAnonymousFile(error);
+	if (fd < 0) {
+		return nullptr;
+	}
+
+	if (ftruncate(fd, static_cast<off_t>(size)) != 0) {
+		error = std::string("ftruncate failed: ") + std::strerror(errno);
+		::close(fd);
+		return nullptr;
+	}
+
+	void *data = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+	if (data == MAP_FAILED) {
+		error = std::string("mmap failed: ") + std::strerror(errno);
+		::close(fd);
+		return nullptr;
+	}
+
+	return std::unique_ptr<SharedMemory>(new SharedMemory(fd, data, size));
+}
+
+std::unique_ptr<SharedMemory> SharedMemory::attach(NativeHandle handle, size_t size, std::string &error)
+{
+	struct stat info = {};
+	if (fstat(handle, &info) != 0 || static_cast<size_t>(info.st_size) < size) {
+		error = "Shared memory descriptor is invalid or too small";
+		return nullptr;
+	}
+
+	void *data = mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, handle, 0);
+	if (data == MAP_FAILED) {
+		error = std::string("mmap failed: ") + std::strerror(errno);
+		return nullptr;
+	}
+
+	return std::unique_ptr<SharedMemory>(new SharedMemory(handle, data, size));
+}
+
+void SharedMemory::closeHandle()
+{
+	if (handle_ >= 0) {
+		::close(handle_);
+		handle_ = -1;
+	}
+}
+
+SharedMemory::~SharedMemory()
+{
+	if (data_) {
+		munmap(data_, size_);
+	}
+
+	closeHandle();
+}
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/bridge/SharedMemory_Windows.cpp b/plugins/obs-vst3/bridge/SharedMemory_Windows.cpp
new file mode 100644
index 0000000..535eec6
--- /dev/null
+++ b/plugins/obs-vst3/bridge/SharedMemory_Windows.cpp
@@ -0,0 +1,61 @@
+#include "SharedMemory.hpp"
+
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+
+namespace obs_vst3 {
+
+std::unique_ptr<SharedMemory> SharedMemory::create(size_t size, std::string &error)
+{
+	/* Inheritable so that the bridge process can map it through the handle value. */
+	SECURITY_ATTRIBUTES attributes = {sizeof(attributes), nullptr, TRUE};
+
+	ULARGE_INTEGER mappingSize;
+	mappingSize.QuadPart = size;
+
+	HANDLE mapping = CreateFileMappingW(INVALID_HANDLE_VALUE, &attributes, PAGE_READWRITE, mappingSize.HighPart,
+					    mappingSize.LowPart, nullptr);
+	if (!mapping) {
+		error = "CreateFileMapping failed: " + std::to_string(GetLastError());
+		return nullptr;
+	}
+
+	void *data = MapViewOfFile(mapping, FILE_MAP_ALL_ACCESS, 0, 0, size);
+	if (!data) {
+		error = "MapViewOfFile failed: " + std::to_string(GetLastError());
+		CloseHandle(mapping);
+		return nullptr;
+	}
+
+	return std::unique_ptr<SharedMemory>(new SharedMemory(mapping, data, size));
+}
+
+std::unique_ptr<SharedMemory> SharedMemory::attach(NativeHandle handle, size_t size, std::string &error)
+{
+	void *data = MapViewOfFile(handle, FILE_MAP_ALL_ACCESS, 0, 0, size);
+	if (!data) {
+		error = "MapViewOfFile failed: " + std::to_string(GetLastError());
+		return nullptr;
+	}
+
+	return std::unique_ptr<SharedMemory>(new SharedMemory(handle, data, size));
+}
+
+void SharedMemory::closeHandle()
+{
+	if (handle_) {
+		CloseHandle(handle_);
+		handle_ = nullptr;
+	}
+}
+
+SharedMemory::~SharedMemory()
+{
+	if (data_) {
+		UnmapViewOfFile(data_);
+	}
+
+	closeHandle();
+}
+
+} // namespace obs_vst3
