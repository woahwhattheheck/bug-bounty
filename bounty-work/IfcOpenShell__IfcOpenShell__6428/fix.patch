+    SHEET_LAYOUT_PROP = "BIMSheetLayout"
+    SHEET_LAYOUT_ITEM_PROP = "BIMSheetLayoutReference"
+
+    @classmethod
+    def get_sheet_layout_collection(cls) -> Union[bpy.types.Collection, None]:
+        return next((c for c in bpy.data.collections if c.get(cls.SHEET_LAYOUT_PROP)), None)
+
+    @classmethod
+    def create_sheet_layout_objects(cls, layout: dict[str, Any], names: dict[int, str]) -> list[bpy.types.Object]:
+        """Create temporary objects to arrange sheet items in the viewport.
+
+        The sheet lies in the XY plane with its top left corner at the origin, at real size (1 mm is 1 mm).
+
+        :param layout: Sheet layout, see ``SheetBuilder.get_sheet_layout``.
+        :param names: Map of sheet item reference ids to their names.
+        :return: Sheet object, followed by the objects of the sheet items.
+        """
+        assert bpy.context.scene
+        collection = bpy.data.collections.new("Sheet Layout")
+        collection[cls.SHEET_LAYOUT_PROP] = True
+        bpy.context.scene.collection.children.link(collection)
+
+        def create_rectangle(name: str, x: float, y: float, width: float, height: float) -> bpy.types.Object:
+            mesh = bpy.data.meshes.new(name)
+            mesh.from_pydata([(0, 0, 0), (width, 0, 0), (width, -height, 0), (0, -height, 0)], [], [(0, 1, 2, 3)])
+            obj = bpy.data.objects.new(name, mesh)
+            obj.location = (x, -y, 0)
+            obj.lock_location[2] = True
+            obj.lock_rotation = (True, True, True)
+            obj.lock_scale = (True, True, True)
+            collection.objects.link(obj)
+            return obj
+
+        mm = 0.001
+        sheet = create_rectangle("Sheet", 0, 0, layout["width"] * mm, layout["height"] * mm)
+        sheet.display_type = "WIRE"
+        sheet.lock_location = (True, True, True)
+        objs = [sheet]
+        for item in layout["items"]:
+            x, y, width, height = (v * mm for v in item["content"])
+            obj = create_rectangle(names.get(item["reference_id"], "Unnamed"), x, y, width, height)
+            obj[cls.SHEET_LAYOUT_ITEM_PROP] = item["reference_id"]
+            obj.show_name = True
+            obj.show_wire = True
+            if item["title"]:
+                title_x, title_y, title_width, title_height = (v * mm for v in item["title"])
+                title = create_rectangle(f"{obj.name} Title", title_x - x, title_y - y, title_width, title_height)
+                title.parent = obj
+                title.display_type = "WIRE"
+                title.hide_select = True
+            objs.append(obj)
+        return objs
+
+    @classmethod
+    def get_sheet_layout_positions(cls) -> dict[int, tuple[float, float]]:
+        """Get positions of sheet items arranged in the viewport, in mm."""
+        positions = {}
+        if not (collection := cls.get_sheet_layout_collection()):
+            return positions
+        for obj in collection.objects:
+            if (reference_id := obj.get(cls.SHEET_LAYOUT_ITEM_PROP)) is not None:
+                positions[reference_id] = (round(obj.location.x * 1000, 2), round(-obj.location.y * 1000, 2))
+        return positions
+
+    @classmethod
+    def remove_sheet_layout_objects(cls) -> None:
+        if not (collection := cls.get_sheet_layout_collection()):
+            return
+        for obj in list(collection.objects):
+            mesh = obj.data
+            bpy.data.objects.remove(obj)
+            if isinstance(mesh, bpy.types.Mesh) and not mesh.users:
+                bpy.data.meshes.remove(mesh)
+        bpy.data.collections.remove(collection)
+
+    @classmethod
+    def isolate_sheet_layout_objects(cls, objs: list[bpy.types.Object]) -> None:
+        """Show only the sheet layout in the viewport, looking at it from the top."""
+        context_override = tool.Blender.get_viewport_context()
+        space = context_override["space_data"]
+        assert isinstance(space, bpy.types.SpaceView3D) and space.region_3d
+        if space.local_view:
+            with bpy.context.temp_override(**context_override):
+                bpy.ops.view3d.localview(frame_selected=False)
+        bpy.ops.object.select_all(action="DESELECT")
+        for obj in objs:
+            obj.select_set(True)
+        with bpy.context.temp_override(**context_override):
+            bpy.ops.view3d.localview(frame_selected=False)
+            bpy.ops.view3d.view_axis(type="TOP")
+            bpy.ops.view3d.view_selected()
+        bpy.ops.object.select_all(action="DESELECT")
+        objs[0].hide_select = True
+
+    @classmethod
+    def exit_sheet_layout_view(cls) -> None:
+        context_override = tool.Blender.get_viewport_context()
+        space = context_override["space_data"]
+        assert isinstance(space, bpy.types.SpaceView3D)
+        if space.local_view:
+            with bpy.context.temp_override(**context_override):
+                bpy.ops.view3d.localview(frame_selected=False)
+
