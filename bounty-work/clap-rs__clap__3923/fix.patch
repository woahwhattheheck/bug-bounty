Date: Thu, 8 Oct 2026 05:18:35 +0000
Subject: [PATCH 1/2] test(complete): Show require_equals behavior

---
 clap_complete/tests/testsuite/engine.rs | 100 ++++++++++++++++++++++++
 1 file changed, 100 insertions(+)

diff --git a/clap_complete/tests/testsuite/engine.rs b/clap_complete/tests/testsuite/engine.rs
index c611373b..9d8d463f 100644
--- a/clap_complete/tests/testsuite/engine.rs
+++ b/clap_complete/tests/testsuite/engine.rs
@@ -1309,6 +1309,106 @@ a_pos,c_pos
     );
 }
 
+#[test]
+fn suggest_require_equals() {
+    let mut cmd = Command::new("exhaustive")
+        .arg(
+            clap::Arg::new("format")
+                .long("format")
+                .short('F')
+                .require_equals(true)
+                .value_parser(["json", "yaml"]),
+        )
+        .arg(
+            clap::Arg::new("color")
+                .long("color")
+                .short('c')
+                .require_equals(true)
+                .num_args(0..=1)
+                .value_parser(["always", "never"]),
+        )
+        .arg(clap::Arg::new("pos").value_parser(["pos_a", "pos_b"]));
+
+    assert_data_eq!(
+        complete!(cmd, "--[TAB]"),
+        snapbox::str![[r#"
+--format
+--color
+--help	Print help
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "--format [TAB]"),
+        snapbox::str![[r#"
+json
+yaml
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "--color [TAB]"),
+        snapbox::str![[r#"
+always
+never
+pos_a
+pos_b
+--format
+--color
+--help	Print help
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "--color=[TAB]"),
+        snapbox::str![[r#"
+--color=always
+--color=never
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "-[TAB]"),
+        snapbox::str![[r#"
+-F	--format
+-c	--color
+-h	Print help
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "-F[TAB]"),
+        snapbox::str![[r#"
+-Fjson
+-Fyaml
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "-F [TAB]"),
+        snapbox::str![[r#"
+json
+yaml
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "-c[TAB]"),
+        snapbox::str![[r#"
+-calways
+-cnever
+"#]]
+    );
+
+    assert_data_eq!(
+        complete!(cmd, "-c=[TAB]"),
+        snapbox::str![[r#"
+-c=always
+-c=never
+"#]]
+    );
+}
+
