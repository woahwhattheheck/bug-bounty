+import React from 'react'
+import { css } from '@emotion/core'
+import { normalizeSocialLinks } from './utils/socialLinks'
+
+// Icons from Feather (https://feathericons.com), MIT License
+const icons = {
+  github: (
+    <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
+  ),
+  twitter: (
+    <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z" />
+  ),
+  donate: (
+    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
+  ),
+  custom: (
+    <g>
+      <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
+      <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
+    </g>
+  )
+}
+
+const Icon = ({ type }) => (
+  <svg
+    xmlns="http://www.w3.org/2000/svg"
+    viewBox="0 0 24 24"
+    fill="none"
+    stroke="currentColor"
+    strokeWidth="2"
+    strokeLinecap="round"
+    strokeLinejoin="round"
+    aria-hidden="true"
+    focusable="false"
+  >
+    {icons[type]}
+  </svg>
+)
+
+export const SocialLinks = ({ links }) => {
+  const items = normalizeSocialLinks(links)
+
+  if (items.length === 0) {
+    return null
+  }
+
+  return (
+    <div css={styles.socialLinks}>
+      {items.map((item, index) => {
+        // Custom links without their own icon also show their title,
+        // so that several custom links can be told apart
+        const iconOnly = item.type !== 'custom' || Boolean(item.icon)
+        return (
+          <a
+            key={`${index}:${item.link}`}
+            css={[styles.link, !iconOnly && styles.textLink]}
+            href={item.link}
+            title={item.title}
+            aria-label={iconOnly ? item.title : undefined}
+            target="_blank"
+            rel="noopener noreferrer"
+          >
+            {item.icon || <Icon type={item.type} />}
+            {!iconOnly && <span css={styles.text}>{item.title}</span>}
+          </a>
+        )
+      })}
+    </div>
+  )
+}
+
+const styles = {
+  socialLinks: css`
+    flex-shrink: 0;
+    display: flex;
+    flex-wrap: wrap;
+    align-items: center;
+    padding: 6px 8px;
+    border-top: 1px solid var(--border-color);
+    background: var(--sidebar-bg);
+  `,
+  link: css`
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    min-width: 32px;
+    height: 32px;
+    margin: 2px;
+    border-radius: 3px;
+    color: #999;
+    font-size: 0.85rem;
+    text-decoration: none;
+    transition: color 0.2s ease, background-color 0.2s ease;
+    &:hover,
+    &:focus {
+      color: var(--theme-color);
+      background-color: rgba(0, 0, 0, 0.05);
+    }
+    & svg {
+      flex-shrink: 0;
+      width: 18px;
+      height: 18px;
+    }
+  `,
+  textLink: css`
+    max-width: 100%;
+    padding: 0 8px;
+  `,
+  text: css`
+    margin-left: 6px;
+    overflow: hidden;
+    white-space: nowrap;
+    text-overflow: ellipsis;
+  `
+}
diff --git a/src/utils/socialLinks.js b/src/utils/socialLinks.js
new file mode 100644
index 0000000..634563f
--- /dev/null
+++ b/src/utils/socialLinks.js
@@ -0,0 +1,91 @@
+const hasOwn = (object, key) =>
+  Object.prototype.hasOwnProperty.call(object, key)
+
+// `https://...`, `mailto:...`, `//cdn...` etc. are used as-is
+const isUrl = value => /^([a-z][a-z\d+\-.]*:|\/\/)/i.test(value)
+
+// Allow `egoist/demoboard`, `@_egoistlily` or `github.com/egoist`
+// as a shorthand for a full URL
+const profileUrl = host => {
+  const hostPrefix = new RegExp(`^(www\\.)?${host.replace(/\./g, '\\.')}/`, 'i')
+  return value => {
+    if (isUrl(value)) {
+      return value
+    }
+
+    const path = value.replace(hostPrefix, '').replace(/^[@/]+/, '')
+    return `https://${host}/${path}`
+  }
+}
+
+const BUILTIN_TYPES = {
+  github: { title: 'GitHub', toUrl: profileUrl('github.com') },
+  twitter: { title: 'Twitter', toUrl: profileUrl('twitter.com') },
+  donate: { title: 'Donate', toUrl: value => value }
+}
+
+const BUILTIN_ORDER = ['github', 'twitter', 'donate']
+
+const readableUrl = url =>
+  url.replace(/^[a-z][a-z\d+\-.]*:(\/\/)?/i, '').replace(/\/+$/, '')
+
+const normalizeLink = item => {
+  if (typeof item === 'string') {
+    item = { link: item }
+  }
+
+  if (!item || typeof item !== 'object') {
+    return null
+  }
+
+  const rawLink = item.link
+  if (typeof rawLink !== 'string' || rawLink.trim() === '') {
+    return null
+  }
+
+  const type =
+    typeof item.type === 'string' && hasOwn(BUILTIN_TYPES, item.type)
+      ? item.type
+      : 'custom'
+  const builtin = type === 'custom' ? null : BUILTIN_TYPES[type]
+  const link = builtin ? builtin.toUrl(rawLink.trim()) : rawLink.trim()
+
+  return {
+    type,
+    link,
+    title: item.title || (builtin ? builtin.title : readableUrl(link)),
+    icon: item.icon
+  }
+}
+
+/**
+ * Normalize the `socialLinks` mount option into a list of
+ * `{ type, link, title, icon }` objects, where `type` is one of
+ * `github`, `twitter`, `donate` or `custom`.
+ *
+ * Accepts either an object:
+ *   { github, twitter, donate, custom: [{ title, link, icon }] }
+ * or an array of links (rendered in the given order):
+ *   [{ type, link, title, icon }]
+ *
+ * @param {Object|Array} socialLinks The `socialLinks` option of `mount()`
+ * @returns {Array} The links to render
+ */
+export const normalizeSocialLinks = socialLinks => {
+  if (!socialLinks || typeof socialLinks !== 'object') {
+    return []
+  }
+
+  const items = Array.isArray(socialLinks)
+    ? socialLinks
+    : BUILTIN_ORDER.filter(type => hasOwn(socialLinks, type))
+        .map(type => {
+          const value = socialLinks[type]
+          return typeof value === 'string'
+            ? { type, link: value }
+            : { ...value, type }
+        })
+        .concat(socialLinks.custom || [])
+
+  return items.map(normalizeLink).filter(Boolean)
+}
