diff --git a/frontend/models/SceneTreeLayout.cpp b/frontend/models/SceneTreeLayout.cpp
new file mode 100644
index 0000000..c0d0add
--- /dev/null
+++ b/frontend/models/SceneTreeLayout.cpp
@@ -0,0 +1,260 @@
+#include "SceneTreeLayout.hpp"
+
+#include <obs.hpp>
+
+#include <algorithm>
+#include <unordered_set>
+
+namespace OBS {
+
+namespace {
+constexpr const char *entryTypeScene = "scene";
+constexpr const char *entryTypeFolder = "folder";
+} // namespace
+
+SceneTreeLayout BuildSceneTreeLayout(const std::vector<std::string> &sceneOrder,
+				     const SceneFolderMembership &membership,
+				     const std::vector<SceneFolderInfo> &folders)
+{
+	/* Remove duplicate scene names, keeping the first occurrence */
+	std::vector<std::string> scenes;
+	std::unordered_set<std::string> knownScenes;
+	scenes.reserve(sceneOrder.size());
+
+	for (const std::string &scene : sceneOrder) {
+		if (knownScenes.insert(scene).second) {
+			scenes.push_back(scene);
+		}
+	}
+
+	/* Collect folder definitions, ignoring nameless and duplicate folders */
+	std::vector<SceneFolderInfo> folderList;
+	std::unordered_set<std::string> knownFolders;
+
+	for (const SceneFolderInfo &folder : folders) {
+		if (folder.name.empty() || !knownFolders.insert(folder.name).second) {
+			continue;
+		}
+
+		SceneFolderInfo info = folder;
+		info.position = std::min(info.position, scenes.size());
+		folderList.push_back(info);
+	}
+
+	/* Recreate folders that only exist in scene private settings, e.g.
+	 * after the collection was saved by a version of OBS without folders */
+	auto getFolderOfScene = [&membership](const std::string &scene) -> std::string {
+		auto it = membership.find(scene);
+		return it != membership.end() ? it->second : std::string();
+	};
+
+	for (size_t i = 0; i < scenes.size(); i++) {
+		std::string folder = getFolderOfScene(scenes[i]);
+
+		if (!folder.empty() && knownFolders.insert(folder).second) {
+			folderList.push_back({folder, false, i});
+		}
+	}
+
+	std::stable_sort(folderList.begin(), folderList.end(),
+			 [](const SceneFolderInfo &a, const SceneFolderInfo &b) { return a.position < b.position; });
+
+	/* Assign scenes to folders, keeping their relative order */
+	std::unordered_map<std::string, std::vector<std::string>> folderScenes;
+
+	for (const std::string &scene : scenes) {
+		std::string folder = getFolderOfScene(scene);
+
+		if (!folder.empty()) {
+			folderScenes[folder].push_back(scene);
+		}
+	}
+
+	SceneTreeLayout layout;
+	size_t nextFolder = 0;
+
+	auto addFolder = [&](const SceneFolderInfo &info) {
+		SceneTreeEntry entry;
+		entry.type = SceneTreeEntry::Type::Folder;
+		entry.name = info.name;
+		entry.isCollapsed = info.isCollapsed;
+		entry.scenes = std::move(folderScenes[info.name]);
+		layout.push_back(std::move(entry));
+	};
+
+	for (size_t i = 0; i < scenes.size(); i++) {
+		while (nextFolder < folderList.size() && folderList[nextFolder].position <= i) {
+			addFolder(folderList[nextFolder++]);
+		}
+
+		if (getFolderOfScene(scenes[i]).empty()) {
+			SceneTreeEntry entry;
+			entry.type = SceneTreeEntry::Type::Scene;
+			entry.name = scenes[i];
+			layout.push_back(std::move(entry));
+		}
+	}
+
+	while (nextFolder < folderList.size()) {
+		addFolder(folderList[nextFolder++]);
+	}
+
+	return layout;
+}
+
+std::vector<std::string> GetSceneOrder(const SceneTreeLayout &layout)
+{
+	std::vector<std::string> order;
+
+	for (const SceneTreeEntry &entry : layout) {
+		if (entry.type == SceneTreeEntry::Type::Scene) {
+			order.push_back(entry.name);
+		} else if (entry.type == SceneTreeEntry::Type::Folder) {
+			order.insert(order.end(), entry.scenes.begin(), entry.scenes.end());
+		}
+	}
+
+	return order;
+}
+
+std::vector<SceneFolderInfo> GetSceneFolders(const SceneTreeLayout &layout)
+{
+	std::vector<SceneFolderInfo> folders;
+	size_t sceneCount = 0;
+
+	for (const SceneTreeEntry &entry : layout) {
+		if (entry.type == SceneTreeEntry::Type::Scene) {
+			sceneCount++;
+		} else if (entry.type == SceneTreeEntry::Type::Folder) {
+			folders.push_back({entry.name, entry.isCollapsed, sceneCount});
+			sceneCount += entry.scenes.size();
+		}
+	}
+
+	return folders;
+}
+
+SceneFolderMembership GetSceneFolderMembership(const SceneTreeLayout &layout)
+{
+	SceneFolderMembership membership;
+
+	for (const SceneTreeEntry &entry : layout) {
+		if (entry.type != SceneTreeEntry::Type::Folder) {
+			continue;
+		}
+
+		for (const std::string &scene : entry.scenes) {
+			membership[scene] = entry.name;
+		}
+	}
+
+	return membership;
+}
+
+obs_data_array_t *SaveSceneFolders(const std::vector<SceneFolderInfo> &folders)
+{
+	obs_data_array_t *array = obs_data_array_create();
+
+	for (const SceneFolderInfo &folder : folders) {
+		OBSDataAutoRelease data = obs_data_create();
+		obs_data_set_string(data, "name", folder.name.c_str());
+		obs_data_set_bool(data, "collapsed", folder.isCollapsed);
+		obs_data_set_int(data, "position", (long long)folder.position);
+		obs_data_array_push_back(array, data);
+	}
+
+	return array;
+}
+
+std::vector<SceneFolderInfo> LoadSceneFolders(obs_data_array_t *array)
+{
+	std::vector<SceneFolderInfo> folders;
+	size_t count = obs_data_array_count(array);
+
+	for (size_t i = 0; i < count; i++) {
+		OBSDataAutoRelease data = obs_data_array_item(array, i);
+		long long position = obs_data_get_int(data, "position");
+
+		SceneFolderInfo folder;
+		folder.name = obs_data_get_string(data, "name");
+		folder.isCollapsed = obs_data_get_bool(data, "collapsed");
+		folder.position = position > 0 ? (size_t)position : 0;
+		folders.push_back(folder);
+	}
+
+	return folders;
+}
+
+std::string SerializeSceneTreeLayout(const SceneTreeLayout &layout)
+{
+	OBSDataAutoRelease data = obs_data_create();
+	OBSDataArrayAutoRelease entries = obs_data_array_create();
+
+	for (const SceneTreeEntry &entry : layout) {
+		OBSDataAutoRelease entryData = obs_data_create();
+
+		if (entry.type == SceneTreeEntry::Type::Scene) {
+			obs_data_set_string(entryData, "type", entryTypeScene);
+			obs_data_set_string(entryData, "name", entry.name.c_str());
+		} else if (entry.type == SceneTreeEntry::Type::Folder) {
+			OBSDataArrayAutoRelease scenes = obs_data_array_create();
+
+			for (const std::string &scene : entry.scenes) {
+				OBSDataAutoRelease sceneData = obs_data_create();
+				obs_data_set_string(sceneData, "name", scene.c_str());
+				obs_data_array_push_back(scenes, sceneData);
+			}
+
+			obs_data_set_string(entryData, "type", entryTypeFolder);
+			obs_data_set_string(entryData, "name", entry.name.c_str());
+			obs_data_set_bool(entryData, "collapsed", entry.isCollapsed);
+			obs_data_set_array(entryData, "scenes", scenes);
+		} else {
+			continue;
+		}
+
+		obs_data_array_push_back(entries, entryData);
+	}
+
+	obs_data_set_array(data, "entries", entries);
+	return obs_data_get_json(data);
+}
+
+SceneTreeLayout DeserializeSceneTreeLayout(const char *json)
+{
+	SceneTreeLayout layout;
+	OBSDataAutoRelease data = obs_data_create_from_json(json);
+	OBSDataArrayAutoRelease entries = obs_data_get_array(data, "entries");
+	size_t count = obs_data_array_count(entries);
+
+	for (size_t i = 0; i < count; i++) {
+		OBSDataAutoRelease entryData = obs_data_array_item(entries, i);
+		std::string type = obs_data_get_string(entryData, "type");
+
+		SceneTreeEntry entry;
+		entry.name = obs_data_get_string(entryData, "name");
+
+		if (type == entryTypeScene) {
+			entry.type = SceneTreeEntry::Type::Scene;
+		} else if (type == entryTypeFolder) {
+			OBSDataArrayAutoRelease scenes = obs_data_get_array(entryData, "scenes");
+			size_t sceneCount = obs_data_array_count(scenes);
+
+			for (size_t j = 0; j < sceneCount; j++) {
+				OBSDataAutoRelease sceneData = obs_data_array_item(scenes, j);
+				entry.scenes.push_back(obs_data_get_string(sceneData, "name"));
+			}
+
+			entry.type = SceneTreeEntry::Type::Folder;
+			entry.isCollapsed = obs_data_get_bool(entryData, "collapsed");
+		} else {
+			continue;
+		}
+
+		layout.push_back(std::move(entry));
+	}
+
+	return layout;
+}
+
+} // namespace OBS
diff --git a/frontend/models/SceneTreeLayout.hpp b/frontend/models/SceneTreeLayout.hpp
new file mode 100644
index 0000000..3b379be
--- /dev/null
+++ b/frontend/models/SceneTreeLayout.hpp
@@ -0,0 +1,79 @@
+#pragma once
+
+#include <obs.h>
+
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace OBS {
+
+/* Top-level key of the scene collection that stores the folder list. Older
+ * versions of OBS do not know this key and simply ignore it. */
+inline constexpr const char *sceneFoldersKey = "scene_folders";
+
+/* Key in a scene's private settings that names the folder the scene belongs
+ * to. Private settings are preserved by every version of OBS, so folder
+ * membership survives a round trip through an older version. */
+inline constexpr const char *sceneFolderPrivateKey = "scene_folder";
+
+/* Folder metadata as stored in the scene collection. `position` is the number
+ * of scenes (in the flat "scene_order" array) that precede the folder header,
+ * which allows empty folders to keep their place in the list. */
+struct SceneFolderInfo {
+	std::string name;
+	bool isCollapsed = false;
+	size_t position = 0;
+};
+
+/* One top-level entry of the Scenes dock: either a scene that is not inside a
+ * folder, or a folder together with the scenes it contains. */
+struct SceneTreeEntry {
+	enum class Type { Invalid, Scene, Folder };
+
+	Type type = Type::Invalid;
+	std::string name;
+	bool isCollapsed = false;
+	std::vector<std::string> scenes;
+
+	bool operator==(const SceneTreeEntry &other) const
+	{
+		return type == other.type && name == other.name && isCollapsed == other.isCollapsed &&
+		       scenes == other.scenes;
+	}
+};
+
+using SceneTreeLayout = std::vector<SceneTreeEntry>;
+using SceneFolderMembership = std::unordered_map<std::string, std::string>;
+
+/* Builds the visual layout of the Scenes dock.
+ *
+ * - `sceneOrder` is the flat scene order ("scene_order" in the collection).
+ * - `membership` maps scene names to folder names (from private settings).
+ * - `folders` is the folder list ("scene_folders" in the collection); it may be
+ *   empty, for example when the collection was last saved by an older version
+ *   of OBS. Folders that are referenced by a scene but missing from the list are
+ *   recreated (expanded) at the position of their first scene.
+ *
+ * Every scene of `sceneOrder` appears exactly once in the result. */
+SceneTreeLayout BuildSceneTreeLayout(const std::vector<std::string> &sceneOrder,
+				     const SceneFolderMembership &membership,
+				     const std::vector<SceneFolderInfo> &folders);
+
+/* Flat scene order of a layout, as written to "scene_order". */
+std::vector<std::string> GetSceneOrder(const SceneTreeLayout &layout);
+
+/* Folder list of a layout, as written to "scene_folders". */
+std::vector<SceneFolderInfo> GetSceneFolders(const SceneTreeLayout &layout);
+
+/* Folder membership of every scene inside a folder. */
+SceneFolderMembership GetSceneFolderMembership(const SceneTreeLayout &layout);
+
+obs_data_array_t *SaveSceneFolders(const std::vector<SceneFolderInfo> &folders);
+std::vector<SceneFolderInfo> LoadSceneFolders(obs_data_array_t *array);
+
+/* JSON (de)serialization of a complete layout, used for undo/redo. */
+std::string SerializeSceneTreeLayout(const SceneTreeLayout &layout);
+SceneTreeLayout DeserializeSceneTreeLayout(const char *json);
+
+} // namespace OBS
