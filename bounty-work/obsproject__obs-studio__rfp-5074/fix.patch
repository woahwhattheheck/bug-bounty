+/* Top-level Win32 window embedding a plug-in editor (kPlatformTypeHWND). */
+class EditorWindowWin32 : public EditorWindow {
+public:
+	static std::unique_ptr<EditorWindowWin32> create(Steinberg::IPlugView *view, const std::string &title,
