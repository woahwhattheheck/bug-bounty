@@ -0,0 +1,67 @@
+import type { MicrobloggingTextLimits } from './types';
+
+const URL_REGEX = /https?:\/\/[^\s<>"]+/gi;
+/** `@user@domain` mentions only count for their `@user` part */
+const REMOTE_MENTION_REGEX = /(^|[^\w/])@([\w.-]+)@[\w.-]+\.\w+/gi;
+const ELLIPSIS = '…';
+const ZERO_WIDTH_SPACE = '​';
+
+const graphemeSegmenter = new Intl.Segmenter('en', { granularity: 'grapheme' });
+
+const splitGraphemes = (text: string): string[] => Array.from(graphemeSegmenter.segment(text), s => s.segment);
+
+/**
+ * Counts the characters of a post the way Mastodon does: URLs have a fixed weight, remote
+ * mentions only count their local part and emojis count as one character.
+ */
+export const countPostCharacters = (text: string, limits: MicrobloggingTextLimits): number => {
+  const countableText = text
+    .replace(URL_REGEX, 'x'.repeat(limits.charactersReservedPerUrl))
+    .replace(REMOTE_MENTION_REGEX, '$1@$2');
+  return splitGraphemes(countableText).length;
+};
+
+/**
+ * Builds the final text of a post: `body` is shortened with an ellipsis if needed so that the
+ * body and the optional `url` fit within the service limits. The URL is never truncated.
+ */
+export const buildPostText = (body: string, url: string | null, limits: MicrobloggingTextLimits): string => {
+  const suffix = url ? `\n\n${url}` : '';
+  const fullText = `${body}${suffix}`;
+  if (countPostCharacters(fullText, limits) <= limits.maxCharacters) {
+    return fullText;
+  }
+
+  // Binary search the longest prefix of the body that fits with the ellipsis
+  const graphemes = splitGraphemes(body);
+  let low = 0;
+  let high = graphemes.length;
+  while (low < high) {
+    const mid = Math.ceil((low + high) / 2);
+    const candidate = `${graphemes.slice(0, mid).join('').trimEnd()}${ELLIPSIS}${suffix}`;
+    if (countPostCharacters(candidate, limits) <= limits.maxCharacters) {
+      low = mid;
+    } else {
+      high = mid - 1;
+    }
+  }
+
+  return `${graphemes.slice(0, low).join('').trimEnd()}${ELLIPSIS}${suffix}`;
+};
+
+/**
+ * Makes a user-provided string (account name, etc.) safe to include in a post: it cannot
+ * mention anyone, add hashtags or links, or span multiple lines.
+ */
+export const neutralizeUserInput = (value: string, maxLength = 60): string => {
+  const singleLine = (value || '')
+    .replace(/[\p{Cc}\p{Cf}]/gu, ' ') // control and format characters (incl. zero-width & bidi overrides)
+    .replace(/\s+/g, ' ')
+    .trim();
+
+  const graphemes = splitGraphemes(singleLine);
+  const shortened =
+    graphemes.length > maxLength ? `${graphemes.slice(0, maxLength).join('').trimEnd()}${ELLIPSIS}` : singleLine;
+
+  return shortened.replace(/([@#])/g, `$1${ZERO_WIDTH_SPACE}`).replace(/:\/\//g, `:${ZERO_WIDTH_SPACE}//`);
+};
