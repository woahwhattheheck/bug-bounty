+  add('edit_note', isNil(release.editNote) ? MUSICBRAINZ_DEFAULT_EDIT_NOTE : release.editNote);
+  add('redirect_uri', release.redirectUri);
+  return fields;
+}
+
+/** The URL of the release editor that seed fields are POSTed to */
+export function releaseEditorUrl(siteRoot = MUSICBRAINZ_SITE_ROOT) {
+  return `${String(siteRoot || MUSICBRAINZ_SITE_ROOT).replace(/\/+$/, '')}/release/add`;
+}
+
+interface CacheEntry {
+  expiresAt: number;
+  value: any;
+}
+
+@Injectable({
+  providedIn: 'root'
+})
+export class MusicBrainzService {
+
+  private nextSlotAt = 0;
+  private readonly cache = new Map<string, CacheEntry>();
+  private readonly inFlight = new Map<string, Promise<any>>();
+
+  constructor(private readonly http: HttpClient) {
+  }
+
+  /** Run a search, lookup or browse request against the MusicBrainz web service */
+  request(request: MusicBrainzRequest, options: MusicBrainzClientOptions = {}): Promise<any> {
+    let url: string;
+    try {
+      url = buildMusicBrainzUrl(request, options.apiRoot);
+    } catch (error) {
+      return Promise.reject(error);
+    }
+    return this.get(url, options);
+  }
+
+  search(entity: string, query: string | Record<string, any>, extra: Partial<MusicBrainzRequest> = {},
+         options: MusicBrainzClientOptions = {}) {
+    return this.request({ ...extra, operation: 'search', entity, query }, options);
+  }
+
+  lookup(entity: string, mbid: string, inc?: string | string[], options: MusicBrainzClientOptions = {}) {
+    return this.request({ operation: 'lookup', entity, mbid, inc }, options);
+  }
+
+  browse(entity: string, linkedEntity: string, linkedMbid: string, extra: Partial<MusicBrainzRequest> = {},
+         options: MusicBrainzClientOptions = {}) {
+    return this.request({ ...extra, operation: 'browse', entity, linkedEntity, linkedMbid }, options);
+  }
+
+  /** GET a WS/2 URL through the shared, rate limited queue */
+  get(url: string, options: MusicBrainzClientOptions = {}): Promise<any> {
+    const cacheTtlMs = isNil(options.cacheTtlMs) ? 5 * 60 * 1000 : Number(options.cacheTtlMs);
+    const cached = this.cache.get(url);
+    if (cached && cached.expiresAt > this.now()) {
+      return Promise.resolve(cached.value);
+    }
+    if (this.inFlight.has(url)) {
+      return this.inFlight.get(url);
+    }
+    const pending = this.fetchWithRetry(url, options, 0)
+      .then(value => {
+        if (cacheTtlMs > 0) {
+          this.remember(url, value, cacheTtlMs);
+        }
+        return value;
+      })
+      .finally(() => this.inFlight.delete(url));
+    this.inFlight.set(url, pending);
+    return pending;
+  }
+
+  /** Remove all cached responses */
+  clearCache() {
+    this.cache.clear();
+  }
+
+  /** The delay that is enforced between two requests to the given web service root */
+  effectiveMinInterval(options: MusicBrainzClientOptions = {}) {
+    const requested = isNil(options.minIntervalMs) ? MUSICBRAINZ_MIN_INTERVAL_MS : Number(options.minIntervalMs);
+    const apiRoot = options.apiRoot || MUSICBRAINZ_API_ROOT;
+    if (isMusicBrainzHost(apiRoot)) {
+      return Math.max(MUSICBRAINZ_MIN_INTERVAL_MS, requested || 0);
+    }
+    return Math.max(0, requested || 0);
+  }
+
+  headers(options: MusicBrainzClientOptions = {}) {
+    let headers = new HttpHeaders({ Accept: 'application/json' });
+    // MusicBrainz' CORS policy explicitly allows the User-Agent header. Browsers that do not
+    // let scripts set it (Chromium) drop it and send their own User-Agent plus the Origin.
+    // Do NOT add headers such as 'ngsw-bypass' here: they are not in MusicBrainz'
+    // Access-Control-Allow-Headers list, so the CORS preflight would fail.
+    if (options.sendUserAgent !== false) {
+      headers = headers.set('User-Agent', options.userAgent || MUSICBRAINZ_USER_AGENT);
+    }
+    return headers;
+  }
+
+  private async fetchWithRetry(url: string, options: MusicBrainzClientOptions, attempt: number): Promise<any> {
+    const maxRetries = isNil(options.maxRetries) ? 2 : Math.max(0, Number(options.maxRetries));
+    const minInterval = this.effectiveMinInterval(options);
+    await this.waitForSlot(minInterval);
+    try {
+      return await this.http.get(url, { headers: this.headers(options) }).toPromise();
+    } catch (error) {
+      const status = get(error, 'status');
+      if (RETRYABLE_STATUS.includes(status) && attempt < maxRetries) {
+        // Back off before asking again: 1s, 2s, 4s... on top of the normal spacing
+        await this.delay(Math.max(minInterval, MUSICBRAINZ_MIN_INTERVAL_MS) * Math.pow(2, attempt));
+        return this.fetchWithRetry(url, options, attempt + 1);
+      }
+      throw this.toError(error, url);
+    }
+  }
+
+  /** Reserve the next free request slot (FIFO) and wait until it starts */
+  private waitForSlot(minInterval: number): Promise<void> {
+    const now = this.now();
+    const startAt = Math.max(now, this.nextSlotAt);
+    this.nextSlotAt = startAt + minInterval;
+    return this.delay(startAt - now);
+  }
+
+  private delay(ms: number): Promise<void> {
+    if (ms <= 0) {
+      return Promise.resolve();
+    }
+    return new Promise(resolve => setTimeout(resolve, ms));
+  }
+
+  private now() {
+    return Date.now();
+  }
+
+  private remember(url: string, value: any, ttl: number) {
+    this.cache.delete(url);
+    this.cache.set(url, { value, expiresAt: this.now() + ttl });
+    while (this.cache.size > MAX_CACHE_ENTRIES) {
+      this.cache.delete(this.cache.keys().next().value);
+    }
+  }
+
+  private toError(error: any, url: string): MusicBrainzError {
+    if (error instanceof MusicBrainzError) {
+      return error;
+    }
+    const status = get(error, 'status');
+    const detail = get(error, 'error.error') || get(error, 'statusText') || get(error, 'message') || 'Request failed';
+    if (status === 503 || status === 429) {
+      return new MusicBrainzError(
+        `MusicBrainz is busy or rate limiting requests (HTTP ${status}). Please try again in a moment.`, status, url);
+    }
+    if (status === 0 || (error instanceof HttpErrorResponse && !status)) {
+      return new MusicBrainzError('Could not reach MusicBrainz. Check your connection and try again.', 0, url);
+    }
+    return new MusicBrainzError(`MusicBrainz request failed (HTTP ${status}): ${detail}`, status, url);
+  }
+}
