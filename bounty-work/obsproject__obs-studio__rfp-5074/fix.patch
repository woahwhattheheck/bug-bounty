+++ b/plugins/obs-vst3/host/SpeakerLayouts.cpp
@@ -0,0 +1,68 @@
+#include "SpeakerLayouts.hpp"
+
+#include <pluginterfaces/vst/vstspeaker.h>
+
+namespace obs_vst3 {
+
+namespace {
+
+/* Values of enum speaker_layout in libobs/media-io/audio-io.h. */
+enum ObsSpeakerLayout : uint32_t {
+	kObsSpeakersUnknown = 0,
+	kObsSpeakersMono = 1,
+	kObsSpeakersStereo = 2,
+	kObsSpeakers2Point1 = 3,
+	kObsSpeakers4Point0 = 4,
+	kObsSpeakers4Point1 = 5,
+	kObsSpeakers5Point1 = 6,
+	kObsSpeakers7Point1 = 8,
+};
+
+} // namespace
+
+Steinberg::Vst::SpeakerArrangement speakerArrangementForLayout(uint32_t speakerLayout, uint32_t channels)
+{
+	using namespace Steinberg::Vst;
+
+	switch (speakerLayout) {
+	case kObsSpeakersMono:
+		return SpeakerArr::kMono;
+	case kObsSpeakersStereo:
+		return SpeakerArr::kStereo;
+	case kObsSpeakers2Point1:
+		/* FL, FR, LFE */
+		return SpeakerArr::kStereo | kSpeakerLfe;
+	case kObsSpeakers4Point0:
+		/* FL, FR, FC, RC */
+		return SpeakerArr::k40Cine;
+	case kObsSpeakers4Point1:
+		/* FL, FR, FC, LFE, RC */
+		return SpeakerArr::k41Cine;
+	case kObsSpeakers5Point1:
+		/* FL, FR, FC, LFE, RL, RR */
+		return SpeakerArr::k51;
+	case kObsSpeakers7Point1:
+		/* FL, FR, FC, LFE, RL, RR, SL, SR */
+		return SpeakerArr::k71Music;
+	default:
+		break;
+	}
+
+	switch (channels) {
+	case 1:
+		return SpeakerArr::kMono;
+	case 2:
+		return SpeakerArr::kStereo;
+	default:
+		break;
+	}
+
+	/* Unknown layout: use the first speakers in VST3 channel order (L, R, C, Lfe, Ls, Rs, ...). */
+	SpeakerArrangement arrangement = 0;
+	for (uint32_t channel = 0; channel < channels && channel < 16; channel++) {
+		arrangement |= static_cast<SpeakerArrangement>(1) << channel;
+	}
+	return arrangement;
+}
+
+} // namespace obs_vst3
