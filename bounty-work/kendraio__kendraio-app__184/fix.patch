+  event: [...MISC_INCLUDES, ...RELATIONSHIP_INCLUDES],
+  genre: ['aliases'],
+  instrument: [...MISC_INCLUDES, ...RELATIONSHIP_INCLUDES],
+  label: [...MISC_INCLUDES, ...RELATIONSHIP_INCLUDES, 'releases', 'discids', 'media', 'artist-credits'],
+  place: [...MISC_INCLUDES, ...RELATIONSHIP_INCLUDES],
+  recording: [...MISC_INCLUDES, ...RELATIONSHIP_INCLUDES,
