+
+QStringList OBSBasic::GetSceneFolderNames() const
+{
+	QStringList names;
+
+	for (QListWidgetItem *folder : ui->scenes->GetFolders()) {
+		names.append(SceneTree::GetFolderName(folder));
+	}
+
+	return names;
+}
+
+QString OBSBasic::GetSceneFolderName(obs_source_t *scene) const
+{
+	QListWidgetItem *sceneItem = FindSceneItem(ui->scenes, scene);
+	QListWidgetItem *folder = ui->scenes->GetFolderOf(sceneItem);
+
+	return folder ? SceneTree::GetFolderName(folder) : QString();
+}
+
+QList<OBSSource> OBSBasic::GetSceneFolderScenes(const QString &folderName) const
+{
+	QList<OBSSource> scenes;
+	QListWidgetItem *folder = ui->scenes->FindFolder(folderName);
+
+	for (QListWidgetItem *sceneItem : ui->scenes->GetFolderScenes(folder)) {
+		scenes.append(OBSSource(obs_scene_get_source(GetOBSRef<OBSScene>(sceneItem))));
+	}
+
+	return scenes;
+}
+
+bool OBSBasic::CreateSceneFolder(const QString &folderName)
+{
+	QString name = folderName.trimmed();
+
+	if (name.isEmpty() || ui->scenes->FindFolder(name)) {
+		return false;
+	}
+
+	ui->scenes->AddFolder(name);
+	SceneTreeChanged(false);
+	return true;
+}
+
+bool OBSBasic::DeleteSceneFolder(const QString &folderName)
+{
+	QListWidgetItem *folder = ui->scenes->FindFolder(folderName);
+
+	if (!folder) {
+		return false;
+	}
+
+	const bool wasCurrent = ui->scenes->currentItem() == folder;
+	ui->scenes->RemoveFolder(folder);
+
+	if (wasCurrent) {
+		SelectCurrentSceneItem();
+	}
+
+	SceneTreeChanged(false);
+	return true;
+}
+
+bool OBSBasic::SetSceneFolder(obs_source_t *scene, const QString &folderName)
+{
+	return MoveSceneToFolder(scene, folderName.trimmed(), false);
+}
