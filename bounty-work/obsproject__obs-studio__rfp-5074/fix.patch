diff --git a/plugins/obs-vst3/host/windows/EventLoopWin32.cpp b/plugins/obs-vst3/host/windows/EventLoopWin32.cpp
new file mode 100644
index 0000000..3e3ae1b
--- /dev/null
+++ b/plugins/obs-vst3/host/windows/EventLoopWin32.cpp
@@ -0,0 +1,143 @@
+#include "EventLoopWin32.hpp"
+#include "EditorWindowWin32.hpp"
+#include "../../bridge/IpcChannel.hpp"
+
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <ole2.h>
+
+namespace obs_vst3 {
+
+namespace {
+
+constexpr UINT kCommandMessage = WM_APP + 1;
+constexpr UINT kChannelClosedMessage = WM_APP + 2;
+constexpr UINT_PTR kIdleTimer = 1;
+constexpr UINT kIdleIntervalMs = 16;
+constexpr wchar_t kMessageWindowClass[] = L"OBSVST3HostMessages";
+
+struct PendingCommand {
+	Command command;
+	std::vector<uint8_t> payload;
+};
+
+} // namespace
+
+std::unique_ptr<EventLoop> EventLoop::create()
+{
+	return std::make_unique<EventLoopWin32>();
+}
+
+EventLoopWin32::EventLoopWin32()
+{
+	/* Plug-in editors expect physical pixel coordinates and an STA COM apartment on the UI thread. */
+	SetProcessDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE_V2);
+	oleInitialized_ = SUCCEEDED(OleInitialize(nullptr));
+
+	WNDCLASSEXW windowClass = {};
+	windowClass.cbSize = sizeof(windowClass);
+	windowClass.lpfnWndProc = reinterpret_cast<WNDPROC>(messageWindowProc);
+	windowClass.hInstance = GetModuleHandleW(nullptr);
+	windowClass.lpszClassName = kMessageWindowClass;
+	RegisterClassExW(&windowClass);
+
+	messageWindow_ = CreateWindowExW(0, kMessageWindowClass, L"", 0, 0, 0, 0, 0, HWND_MESSAGE, nullptr,
+					 GetModuleHandleW(nullptr), nullptr);
+	SetWindowLongPtrW(static_cast<HWND>(messageWindow_), GWLP_USERDATA, reinterpret_cast<LONG_PTR>(this));
+}
+
+EventLoopWin32::~EventLoopWin32()
+{
+	if (messageWindow_) {
+		DestroyWindow(static_cast<HWND>(messageWindow_));
+	}
+	if (oleInitialized_) {
+		OleUninitialize();
+	}
+}
+
+intptr_t __stdcall EventLoopWin32::messageWindowProc(void *window, unsigned int message, uintptr_t wParam,
+						     intptr_t lParam)
+{
+	HWND handle = static_cast<HWND>(window);
+	auto *loop = reinterpret_cast<EventLoopWin32 *>(GetWindowLongPtrW(handle, GWLP_USERDATA));
+
+	switch (message) {
+	case kCommandMessage: {
+		std::unique_ptr<PendingCommand> pending(reinterpret_cast<PendingCommand *>(lParam));
+		if (loop && loop->onCommand_) {
+			(*loop->onCommand_)(pending->command, pending->payload);
+		}
+		return 0;
+	}
+	case kChannelClosedMessage:
+		if (loop) {
+			loop->quit();
+		}
+		return 0;
+	case WM_TIMER:
+		if (wParam == kIdleTimer && loop && loop->onIdle_) {
+			(*loop->onIdle_)();
+		}
+		return 0;
+	default:
+		break;
+	}
+
+	return DefWindowProcW(handle, message, wParam, lParam);
+}
+
+void EventLoopWin32::run(IpcChannel &commandChannel, const CommandHandler &onCommand, const IdleHandler &onIdle)
+{
+	onCommand_ = &onCommand;
+	onIdle_ = &onIdle;
+	HWND messageWindow = static_cast<HWND>(messageWindow_);
+
+	std::thread reader([&commandChannel, messageWindow]() {
+		for (;;) {
+			auto pending = std::make_unique<PendingCommand>();
+			if (!commandChannel.receiveMessage(pending->command, pending->payload, -1)) {
+				PostMessageW(messageWindow, kChannelClosedMessage, 0, 0);
+				return;
+			}
+
+			if (!PostMessageW(messageWindow, kCommandMessage, 0, reinterpret_cast<LPARAM>(pending.get()))) {
+				return;
+			}
+			pending.release();
+		}
+	});
+
+	SetTimer(messageWindow, kIdleTimer, kIdleIntervalMs, nullptr);
+
+	MSG message;
+	while (GetMessageW(&message, nullptr, 0, 0) > 0) {
+		TranslateMessage(&message);
+		DispatchMessageW(&message);
+	}
+
+	KillTimer(messageWindow, kIdleTimer);
+
+	/* Stop the reader, then drop commands that were posted but not handled. */
+	commandChannel.interrupt();
+	reader.join();
+	while (PeekMessageW(&message, messageWindow, kCommandMessage, kCommandMessage, PM_REMOVE)) {
+		delete reinterpret_cast<PendingCommand *>(message.lParam);
+	}
+
+	onCommand_ = nullptr;
+	onIdle_ = nullptr;
+}
+
+void EventLoopWin32::quit()
+{
+	PostQuitMessage(0);
+}
+
+std::unique_ptr<EditorWindow> EventLoopWin32::openEditor(Steinberg::IPlugView *view, const std::string &title,
+							 CloseHandler onCloseRequested, std::string &error)
+{
+	return EditorWindowWin32::create(view, title, std::move(onCloseRequested), error);
+}
+
+} // namespace obs_vst3
