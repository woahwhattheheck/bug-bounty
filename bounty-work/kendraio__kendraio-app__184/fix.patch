diff --git a/src/app/blocks/musicbrainz-block/musicbrainz-block.component.ts b/src/app/blocks/musicbrainz-block/musicbrainz-block.component.ts
new file mode 100644
index 00000000..9aa8be1f
--- /dev/null
+++ b/src/app/blocks/musicbrainz-block/musicbrainz-block.component.ts
@@ -0,0 +1,168 @@
+import { Component } from '@angular/core';
+import { get, has, isNil, isPlainObject, isString } from 'lodash-es';
+import { BaseBlockComponent } from '../base-block/base-block.component';
+import { mappingUtility } from '../mapping-block/mapping-util';
+import {
+  buildReleaseSeed,
+  extractMusicBrainzResults,
+  MusicBrainzClientOptions,
+  MusicBrainzRequest,
+  MusicBrainzSeedField,
+  MusicBrainzService,
+  MUSICBRAINZ_SITE_ROOT,
+  releaseEditorUrl
+} from '../../services/musicbrainz.service';
+
+/**
+ * MusicBrainz block: search, look up and browse the MusicBrainz database, or seed
+ * the MusicBrainz release editor so an artist can submit a release.
+ *
+ * Every request option can be set statically in the block config or computed from the
+ * incoming data / context with a JMESPath expression in `valueGetters`.
+ * See docs/workflow/blocks/musicbrainz.rst
+ */
+@Component({
+  selector: 'app-musicbrainz-block',
+  templateUrl: './musicbrainz-block.component.html',
+  styleUrls: ['./musicbrainz-block.component.scss']
+})
+export class MusicbrainzBlockComponent extends BaseBlockComponent {
+
+  isLoading = false;
+  hasError = false;
+  errorMessage = '';
+
+  seedFields: MusicBrainzSeedField[] = [];
+  seedAction = releaseEditorUrl();
+  seedLabel = 'Open in MusicBrainz release editor';
+  seedSummary = '';
+
+  // Used to ignore responses from requests that were superseded by newer input
+  private requestCounter = 0;
+
+  constructor(private readonly musicbrainz: MusicBrainzService) {
+    super();
+  }
+
+  onData(data: any, firstChange: boolean) {
+    if (firstChange && get(this.config, 'skipInit', true)) {
+      return;
+    }
+    const operation = this.resolve('operation', data) || 'search';
+    if (operation === 'seed-release') {
+      this.prepareReleaseSeed(data);
+    } else {
+      this.runRequest(operation, data);
+    }
+  }
+
+  /** Read a config value, preferring a JMESPath expression from `valueGetters` */
+  resolve(key: string, data: any) {
+    const getter = get(this.config, ['valueGetters', key]);
+    if (isString(getter) && getter.trim() !== '') {
+      return mappingUtility({ data, context: this.context }, getter);
+    }
+    return get(this.config, key);
+  }
+
+  buildRequest(operation: string, data: any): MusicBrainzRequest {
+    const request: any = { operation, entity: this.resolve('entity', data) || 'artist' };
+    // `type` is the block type in the block config, so the type/status filters are
+    // configured as `releaseType` and `releaseStatus`
+    const keys = {
+      query: 'query', mbid: 'mbid', inc: 'inc', linkedEntity: 'linkedEntity', linkedMbid: 'linkedMbid',
+      limit: 'limit', offset: 'offset', releaseType: 'type', releaseStatus: 'status', dismax: 'dismax'
+    };
+    Object.keys(keys).forEach(configKey => {
+      const value = this.resolve(configKey, data);
+      if (!isNil(value)) {
+        request[keys[configKey]] = value;
+      }
+    });
+    return request;
+  }
+
+  clientOptions(): MusicBrainzClientOptions {
+    const options: MusicBrainzClientOptions = {};
+    ['apiRoot', 'userAgent', 'sendUserAgent', 'minIntervalMs', 'maxRetries', 'cacheTtlMs'].forEach(key => {
+      if (has(this.config, key)) {
+        options[key] = get(this.config, key);
+      }
+    });
+    return options;
+  }
+
+  /** True when the request has nothing to ask yet (e.g. an empty search form) */
+  isIncomplete(request: MusicBrainzRequest) {
+    const empty = (value: any) => isNil(value) || (isString(value) && value.trim() === '')
+      || (isPlainObject(value) && Object.values(value).every(v => isNil(v) || String(v).trim() === ''));
+    switch (request.operation) {
+      case 'search':
+        return empty(request.query);
+      case 'lookup':
+        return empty(request.mbid);
+      case 'browse':
+        return empty(request.linkedMbid);
+      default:
+        return false;
+    }
+  }
+
+  async runRequest(operation: string, data: any) {
+    const requestId = ++this.requestCounter;
+    this.seedFields = [];
+    const request = this.buildRequest(operation, data);
+    if (this.isIncomplete(request)) {
+      // Nothing to ask yet: stay quiet instead of showing an error or calling the API
+      this.hasError = false;
+      this.isLoading = false;
+      return;
+    }
+    this.hasError = false;
+    this.isLoading = true;
+    try {
+      const response = await this.musicbrainz.request(request, this.clientOptions());
+      if (requestId !== this.requestCounter) {
+        return;
+      }
+      this.isLoading = false;
+      const output = get(this.config, 'resultsOnly', false)
+        ? extractMusicBrainzResults(request.entity, response)
+        : response;
+      this.output.emit(output);
+    } catch (error) {
+      if (requestId !== this.requestCounter) {
+        return;
+      }
+      this.isLoading = false;
+      this.hasError = true;
+      this.errorMessage = get(error, 'message', 'MusicBrainz request failed');
+    }
+  }
+
+  prepareReleaseSeed(data: any) {
+    ++this.requestCounter;
+    this.isLoading = false;
+    const hasGetter = !!get(this.config, 'valueGetters.release');
+    const release = hasGetter || has(this.config, 'release') ? this.resolve('release', data) : data;
+    if (!isPlainObject(release) || !isString(get(release, 'name')) || release.name.trim() === '') {
+      // Wait for the release details (e.g. from a form) before offering the button
+      this.seedFields = [];
+      this.hasError = false;
+      return;
+    }
+    try {
+      this.seedFields = buildReleaseSeed(release);
+      this.seedAction = releaseEditorUrl(get(this.config, 'siteRoot', MUSICBRAINZ_SITE_ROOT));
+      this.seedLabel = get(this.config, 'label', 'Open in MusicBrainz release editor');
+      const trackCount = this.seedFields.filter(field => /^mediums\.\d+\.track\.\d+\.name$/.test(field.name)).length;
+      this.seedSummary = `${release.name.trim()}${trackCount ? ` (${trackCount} track${trackCount === 1 ? '' : 's'})` : ''}`;
+      this.hasError = false;
+      this.output.emit({ action: this.seedAction, fields: this.seedFields });
+    } catch (error) {
+      this.seedFields = [];
+      this.hasError = true;
+      this.errorMessage = get(error, 'message', 'Invalid release data');
+    }
+  }
+}
