diff --git a/plugins/obs-vst3/host/linux/EventLoopX11.cpp b/plugins/obs-vst3/host/linux/EventLoopX11.cpp
new file mode 100644
index 0000000..8e586ca
--- /dev/null
+++ b/plugins/obs-vst3/host/linux/EventLoopX11.cpp
@@ -0,0 +1,159 @@
+#include "EventLoopX11.hpp"
+#include "EditorWindowX11.hpp"
+#include "../HostLog.hpp"
+#include "../../bridge/IpcChannel.hpp"
+
+#include <algorithm>
+#include <cerrno>
+#include <chrono>
+
+#include <poll.h>
+
+#include <X11/Xlib.h>
+
+namespace obs_vst3 {
+
+namespace {
+
+using Clock = std::chrono::steady_clock;
+
+constexpr int kIdleIntervalMs = 16;
+
+int millisecondsUntil(Clock::time_point deadline)
+{
+	auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - Clock::now()).count();
+	return remaining > 0 ? static_cast<int>(remaining) : 0;
+}
+
+} // namespace
+
+std::unique_ptr<EventLoop> EventLoop::create()
+{
+	return std::make_unique<EventLoopX11>();
+}
+
+EventLoopX11::EventLoopX11()
+{
+	/* Must precede any other Xlib call in this process, plug-ins may use Xlib from several threads. */
+	XInitThreads();
+}
+
+EventLoopX11::~EventLoopX11()
+{
+	if (display_) {
+		XCloseDisplay(display_);
+	}
+}
+
+bool EventLoopX11::openDisplay(std::string &error)
+{
+	if (display_) {
+		return true;
+	}
+
+	display_ = XOpenDisplay(nullptr);
+	if (!display_) {
+		error = "Cannot show the plug-in editor: no X11 display is available";
+		return false;
+	}
+
+	return true;
+}
+
+void EventLoopX11::registerWindow(unsigned long window, EditorWindowX11 *editor)
+{
+	windows_[window] = editor;
+}
+
+void EventLoopX11::unregisterWindow(unsigned long window)
+{
+	windows_.erase(window);
+}
+
+void EventLoopX11::processWindowEvents()
+{
+	while (XPending(display_) > 0) {
+		XEvent event;
+		XNextEvent(display_, &event);
+
+		auto window = windows_.find(event.xany.window);
+		if (window != windows_.end()) {
+			window->second->handleEvent(event);
+		}
+	}
+}
+
+std::unique_ptr<EditorWindow> EventLoopX11::openEditor(Steinberg::IPlugView *view, const std::string &title,
+						       CloseHandler onCloseRequested, std::string &error)
+{
+	if (!openDisplay(error)) {
+		return nullptr;
+	}
+
+	return EditorWindowX11::create(*this, display_, &runLoop_, view, title, std::move(onCloseRequested), error);
+}
+
+void EventLoopX11::quit()
+{
+	running_ = false;
+}
+
+void EventLoopX11::run(IpcChannel &commandChannel, const CommandHandler &onCommand, const IdleHandler &onIdle)
+{
+	running_ = true;
+	Clock::time_point nextIdle = Clock::now();
+	std::vector<pollfd> descriptors;
+
+	while (running_) {
+		descriptors.clear();
+		descriptors.push_back({commandChannel.nativeHandle(), POLLIN, 0});
+		if (display_) {
+			descriptors.push_back({ConnectionNumber(display_), POLLIN, 0});
+		}
+
+		size_t pluginDescriptors = descriptors.size();
+		runLoop_.prepare(descriptors);
+
+		int timeout = std::min(runLoop_.timeoutMs(kIdleIntervalMs), millisecondsUntil(nextIdle));
+		if (display_) {
+			XFlush(display_);
+			if (XPending(display_) > 0) {
+				timeout = 0;
+			}
+		}
+
+		int result = poll(descriptors.data(), descriptors.size(), timeout);
+		if (result < 0 && errno != EINTR) {
+			hostLog("poll() failed, leaving the event loop");
+			break;
+		}
+
+		if (display_) {
+			processWindowEvents();
+		}
+
+		bool idleDue = Clock::now() >= nextIdle;
+		if (result > 0 || idleDue) {
+			runLoop_.dispatch(descriptors, pluginDescriptors, idleDue);
+		}
+		runLoop_.dispatchTimers();
+
+		if (result > 0 && descriptors[0].revents != 0) {
+			Command command = Command::Invalid;
+			std::vector<uint8_t> payload;
+			if (!commandChannel.receiveMessage(command, payload, kCommandTimeoutMs)) {
+				/* OBS closed the connection or exited. */
+				running_ = false;
+				break;
+			}
+			onCommand(command, payload);
+		}
+
+		if (idleDue) {
+			onIdle();
+			nextIdle = Clock::now() + std::chrono::milliseconds(kIdleIntervalMs);
+		}
+	}
+}
+
+} // namespace obs_vst3
