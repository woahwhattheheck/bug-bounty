index 000000000..d9af6b7c9
--- /dev/null
+++ b/server/lib/microblogging/types.ts
@@ -0,0 +1,85 @@
+import type { Service } from '../../constants/connected-account';
+import type { ConnectedAccount } from '../../models';
+
+/**
+ * The kinds of automated posts that can be published on a microblogging account.
+ * Each of them can be toggled individually in `ConnectedAccount.settings.posts`.
+ */
+export enum MicrobloggingPostType {
+  /** Thank a new financial contributor */
+  NEW_CONTRIBUTOR = 'newContributors',
+  /** Celebrate a number of financial contributors (10, 25, 50, ...) */
+  MILESTONE = 'milestones',
+  /** Summary of the previous month: money received, spent, new contributors and balance */
+  MONTHLY_STATS = 'monthlyStats',
+}
+
+export type MicrobloggingPostSettings = Record<MicrobloggingPostType, boolean>;
+
+/** Rules used by a service to compute the length of a post */
+export type MicrobloggingTextLimits = {
+  /** Max number of characters in a post */
+  maxCharacters: number;
+  /** Number of characters counted for any URL, whatever its real length */
+  charactersReservedPerUrl: number;
+};
+
+export type MicrobloggingPost = {
+  text: string;
+  /** Thread the post under a previous one */
+  inReplyToId?: string | null;
+  /** Lets the service deduplicate retries of the same post */
+  idempotencyKey?: string;
+  language?: string;
+};
+
+export type MicrobloggingPostResult = {
+  id: string;
+  url: string | null;
+  createdAt: Date | null;
+};
+
+export type MicrobloggingAccountInfo = {
+  /** Normalized base URL of the server hosting the account, e.g. `https://mastodon.social` */
+  instanceUrl: string;
+  /** Remote id of the account on the service */
+  id: string;
+  /** Full handle of the account, e.g. `@opencollective@mastodon.social` */
+  handle: string;
+  /** Public URL of the profile */
+  url: string | null;
+  limits: MicrobloggingTextLimits;
+};
+
+/**
+ * Interface implemented by every microblogging service (Mastodon today) that Open Collective
+ * can publish automated posts to. Credentials live in a `ConnectedAccount`.
+ */
+export interface MicrobloggingService {
+  readonly service: Service;
+  /** Checks the credentials and returns the account they belong to, plus the posting limits */
+  verifyCredentials(credentials: { instanceUrl: string; token: string }): Promise<MicrobloggingAccountInfo>;
+  /** Publishes a post with the credentials stored in the connected account */
+  post(connectedAccount: ConnectedAccount, post: MicrobloggingPost): Promise<MicrobloggingPostResult>;
+  /** Returns the text limits for this connected account */
+  getTextLimits(connectedAccount: ConnectedAccount): MicrobloggingTextLimits;
+}
+
+/** Raised when the service rejects the credentials. The account must be reconnected. */
+export class MicrobloggingAuthenticationError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = 'MicrobloggingAuthenticationError';
+  }
+}
+
+/** Raised when the service answers with an HTTP error other than an authentication error */
+export class MicrobloggingRequestError extends Error {
+  public readonly status: number;
+
+  constructor(message: string, status: number) {
+    super(message);
+    this.name = 'MicrobloggingRequestError';
+    this.status = status;
+  }
+}
