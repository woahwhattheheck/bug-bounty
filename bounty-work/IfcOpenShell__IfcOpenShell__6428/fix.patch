+
+    def execute(self, context):
+        props = tool.Drawing.get_document_props()
+        sheet = tool.Ifc.get().by_id(tool.Drawing.get_active_sheet().ifc_definition_id)
+        layout_path = tool.Drawing.get_document_uri(sheet, "LAYOUT")
+        if not layout_path or not os.path.isfile(layout_path):
+            self.report({"ERROR"}, "Sheet layout file not found.")
+            return {"CANCELLED"}
+
+        sheet_builder = sheeter.SheetBuilder()
+        sheet_builder.update_sheet_drawing_sizes(sheet)
+        layout = sheet_builder.get_sheet_layout(sheet)
+
+        names = {}
+        for item in layout["items"]:
+            reference = tool.Ifc.get().by_id(item["reference_id"])
+            name = os.path.splitext(os.path.basename(reference.Location or ""))[0] or "Unnamed"
+            if identification := tool.Document.get_external_reference_id(reference):
+                name = f"{identification} - {name}"
+            names[item["reference_id"]] = name
+
+        objs = tool.Drawing.create_sheet_layout_objects(layout, names)
+        tool.Drawing.isolate_sheet_layout_objects(objs)
+        props.editing_sheet_layout_id = sheet.id()
+        return {"FINISHED"}
