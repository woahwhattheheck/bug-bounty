index 000000000..d6e63f4d5
--- /dev/null
+++ b/server/lib/microblogging/mastodon.ts
@@ -0,0 +1,240 @@
+import axios, { AxiosError, Method } from 'axios';
+
+import { Service } from '../../constants/connected-account';
+import { ValidationFailed } from '../../graphql/errors';
+import type { ConnectedAccount } from '../../models';
+import { getPinnedAxiosAgentsForWebhookUrl, WebhookUrlNotAllowedError } from '../webhooks';
+
+import {
+  MicrobloggingAccountInfo,
+  MicrobloggingAuthenticationError,
+  MicrobloggingPost,
+  MicrobloggingPostResult,
+  MicrobloggingRequestError,
+  MicrobloggingService,
+  MicrobloggingTextLimits,
+} from './types';
+
+/** Mastodon defaults, used when the instance does not advertise its own configuration */
+const DEFAULT_LIMITS: MicrobloggingTextLimits = { maxCharacters: 500, charactersReservedPerUrl: 23 };
+const REQUEST_TIMEOUT_MS = 15_000;
+/** Scopes that allow publishing statuses */
+const WRITE_STATUSES_SCOPES = ['write', 'write:statuses'];
+const USERNAME_REGEX = /^[\w.-]+$/;
+
+type MastodonAccount = { id: string; username: string; acct: string; url?: string };
+type MastodonStatus = { id: string; url?: string | null; uri?: string; created_at?: string };
+type MastodonInstanceV2 = {
+  domain?: string;
+  configuration?: { statuses?: { max_characters?: number; characters_reserved_per_url?: number } };
+};
+type MastodonInstanceV1 = MastodonInstanceV2 & { uri?: string; max_toot_chars?: number };
+type MastodonApplication = { scopes?: string[] };
+
+/**
+ * Normalizes what users type as their instance ("mastodon.social", "https://mastodon.social/@me")
+ * into an origin (`https://mastodon.social`). Only HTTPS is accepted.
+ */
+export const normalizeMastodonInstanceUrl = (value: string): string => {
+  let input = (value || '').trim();
+  if (!input) {
+    throw new ValidationFailed('Please provide the URL of your Mastodon server');
+  } else if (!/^[a-z][a-z\d+.-]*:\/\//i.test(input)) {
+    input = `https://${input}`;
+  }
+
+  let url: URL;
+  try {
+    url = new URL(input);
+  } catch {
+    throw new ValidationFailed(`Invalid Mastodon server URL: ${value}`);
+  }
+
+  if (url.protocol !== 'https:') {
+    throw new ValidationFailed('The Mastodon server URL must use HTTPS');
+  } else if (url.username || url.password) {
+    throw new ValidationFailed('The Mastodon server URL must not contain credentials');
+  }
+
+  return url.origin;
+};
+
+const getErrorMessage = (data: unknown): string | null => {
+  if (data && typeof data === 'object' && typeof data['error'] === 'string') {
+    return data['error'];
+  }
+  return null;
+};
+
+const request = async <T>(
+  instanceUrl: string,
+  token: string | null,
+  {
+    method = 'GET',
+    path,
+    data,
+    headers = {},
+  }: { method?: Method; path: string; data?: unknown; headers?: Record<string, string> },
+): Promise<T> => {
+  const url = new URL(path, instanceUrl).toString();
+  // Resolves and pins the IP addresses of the instance to prevent requests to internal networks (SSRF)
+  const agents = await getPinnedAxiosAgentsForWebhookUrl(url);
+  try {
+    const response = await axios.request<T>({
+      url,
+      method,
+      data,
+      headers: {
+        Accept: 'application/json',
+        ...(token ? { Authorization: `Bearer ${token}` } : {}),
+        ...headers,
+      },
+      timeout: REQUEST_TIMEOUT_MS,
+      maxRedirects: 0,
+      ...agents,
+    });
+    return response.data;
+  } catch (error) {
+    if (error instanceof AxiosError && error.response) {
+      const message = getErrorMessage(error.response.data) || error.message;
+      if (error.response.status === 401) {
+        throw new MicrobloggingAuthenticationError(`Mastodon rejected the access token: ${message}`);
+      }
+      throw new MicrobloggingRequestError(
+        `Mastodon API error (${error.response.status}): ${message}`,
+        error.response.status,
+      );
+    }
+    throw error;
+  }
+};
+
+const toPositiveInteger = (value: unknown): number | null => {
+  return Number.isInteger(value) && (value as number) > 0 ? (value as number) : null;
+};
+
+/**
+ * Fetches the domain and the post length limits of the instance, falling back on the v1 API for
+ * older servers and on Mastodon defaults when nothing is advertised.
+ */
+const fetchInstanceInfo = async (instanceUrl: string): Promise<{ domain: string; limits: MicrobloggingTextLimits }> => {
+  let instance: MastodonInstanceV1;
+  try {
+    instance = await request<MastodonInstanceV2>(instanceUrl, null, { path: '/api/v2/instance' });
+  } catch (error) {
+    if (!(error instanceof MicrobloggingRequestError)) {
+      throw error;
+    }
+    instance = await request<MastodonInstanceV1>(instanceUrl, null, { path: '/api/v1/instance' }).catch(() => null);
+  }
+
+  const statusesConfig = instance?.configuration?.statuses;
+  return {
+    domain: instance?.domain || instance?.uri || new URL(instanceUrl).hostname,
+    limits: {
+      maxCharacters:
+        toPositiveInteger(statusesConfig?.max_characters) ||
+        toPositiveInteger(instance?.max_toot_chars) ||
+        DEFAULT_LIMITS.maxCharacters,
+      charactersReservedPerUrl:
+        toPositiveInteger(statusesConfig?.characters_reserved_per_url) || DEFAULT_LIMITS.charactersReservedPerUrl,
+    },
+  };
+};
+
+/**
+ * Mastodon >= 4.3 returns the scopes of the token. Older servers don't, in which case we can't
+ * check ahead of time and rely on the first post failing.
+ */
+const assertCanWriteStatuses = async (instanceUrl: string, token: string): Promise<void> => {
+  const application = await request<MastodonApplication>(instanceUrl, token, {
+    path: '/api/v1/apps/verify_credentials',
+  }).catch(error => {
+    if (error instanceof MicrobloggingAuthenticationError) {
+      throw error;
+    }
+    return null;
+  });
+
+  const scopes = application?.scopes;
+  if (Array.isArray(scopes) && !scopes.some(scope => WRITE_STATUSES_SCOPES.includes(scope))) {
+    throw new ValidationFailed('The access token must have the "write:statuses" scope to publish posts');
+  }
+};
+
+const mastodon: MicrobloggingService = {
+  service: Service.MASTODON,
+
+  async verifyCredentials({ instanceUrl, token }): Promise<MicrobloggingAccountInfo> {
+    const origin = normalizeMastodonInstanceUrl(instanceUrl);
+    if (!token) {
+      throw new ValidationFailed('An access token is required');
+    }
+
+    let account: MastodonAccount;
+    try {
+      account = await request<MastodonAccount>(origin, token, { path: '/api/v1/accounts/verify_credentials' });
+      await assertCanWriteStatuses(origin, token);
+    } catch (error) {
+      if (error instanceof WebhookUrlNotAllowedError) {
+        throw new ValidationFailed(`This Mastodon server URL is not allowed: ${error.message}`);
+      } else if (error instanceof MicrobloggingAuthenticationError) {
+        throw new ValidationFailed('The access token was rejected by the Mastodon server');
+      } else if (error instanceof MicrobloggingRequestError) {
+        throw new ValidationFailed(
+          `Unable to verify the access token. Make sure it has the "profile" or "read:accounts" scope. (${error.message})`,
+        );
+      }
+      throw error;
+    }
+
+    if (!account?.id || !account.username || !USERNAME_REGEX.test(account.username)) {
+      throw new ValidationFailed('The Mastodon server returned an invalid account');
+    }
+
+    const { domain, limits } = await fetchInstanceInfo(origin);
+    return {
+      instanceUrl: origin,
+      id: String(account.id),
+      handle: `@${account.username}@${domain}`,
+      url: account.url || null,
+      limits,
+    };
+  },
+
+  async post(connectedAccount: ConnectedAccount, post: MicrobloggingPost): Promise<MicrobloggingPostResult> {
+    const instanceUrl = connectedAccount.data?.instanceUrl;
+    if (!instanceUrl) {
+      throw new Error(`Mastodon connected account #${connectedAccount.id} has no instance URL`);
+    }
+
+    const status = await request<MastodonStatus>(instanceUrl, connectedAccount.token, {
+      method: 'POST',
+      path: '/api/v1/statuses',
+      headers: post.idempotencyKey ? { 'Idempotency-Key': post.idempotencyKey } : {},
+      data: {
+        status: post.text,
+        visibility: 'public',
+        language: post.language || 'en',
+        ...(post.inReplyToId ? { in_reply_to_id: post.inReplyToId } : {}), // eslint-disable-line camelcase
+      },
+    });
+
+    return {
+      id: String(status.id),
+      url: status.url || status.uri || null,
+      createdAt: status.created_at ? new Date(status.created_at) : null,
+    };
+  },
+
+  getTextLimits(connectedAccount: ConnectedAccount): MicrobloggingTextLimits {
+    return {
+      maxCharacters: toPositiveInteger(connectedAccount.data?.limits?.maxCharacters) || DEFAULT_LIMITS.maxCharacters,
+      charactersReservedPerUrl:
+        toPositiveInteger(connectedAccount.data?.limits?.charactersReservedPerUrl) ||
+        DEFAULT_LIMITS.charactersReservedPerUrl,
+    };
+  },
+};
+
+export default mastodon;
