+			Steinberg::IPlugView *view, EventLoop::CloseHandler onCloseRequested);
+
+	void applySizeHints(int width, int height);
+
+	EventLoopX11 &loop_;
+	_XDisplay *display_;
+	Steinberg::Linux::IRunLoop *runLoop_;
+	Steinberg::IPtr<Steinberg::IPlugView> view_;
+	EventLoop::CloseHandler onCloseRequested_;
+
+	unsigned long window_ = 0;
+	unsigned long deleteWindowAtom_ = 0;
