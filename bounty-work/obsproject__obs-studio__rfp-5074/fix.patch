diff --git a/plugins/obs-vst3/BridgeClient.cpp b/plugins/obs-vst3/BridgeClient.cpp
new file mode 100644
index 0000000..49f3aa8
--- /dev/null
+++ b/plugins/obs-vst3/BridgeClient.cpp
@@ -0,0 +1,353 @@
+#include "BridgeClient.hpp"
+#include "HostProcess.hpp"
+#include "bridge/MessageReader.hpp"
+#include "bridge/MessageWriter.hpp"
+#include "bridge/SharedMemory.hpp"
+
+#include <obs-module.h>
+
+#include <algorithm>
+#include <cstring>
+#include <new>
+
+namespace obs_vst3 {
+
+namespace {
+
+bool readStatus(MessageReader &reader, std::string &error)
+{
+	int32_t status = 0;
+	std::string message;
+	if (!reader.readInt32(status) || !reader.readString(message)) {
+		error = "Malformed reply from the plug-in host";
+		return false;
+	}
+
+	if (static_cast<Status>(status) != Status::Ok) {
+		error = message.empty() ? "The plug-in host reported an error" : message;
+		return false;
+	}
+
+	return true;
+}
+
+} // namespace
+
+std::unique_ptr<BridgeClient> BridgeClient::start(const std::string &hostExecutable, std::string &error)
+{
+	std::unique_ptr<BridgeClient> client(new BridgeClient());
+
+	client->memory_ = SharedMemory::create(kSharedMemorySize, error);
+	if (!client->memory_) {
+		return nullptr;
+	}
+
+	auto *header = new (client->memory_->data()) SharedAudioHeader();
+	header->magic = kSharedMemoryMagic;
+	header->version = kProtocolVersion;
+	header->maxChannels = kMaxChannels;
+	header->maxFrames = kMaxBlockFrames;
+	header->editorOpen.store(0);
+	header->latencySamples.store(0);
+	header->editCount.store(0);
+	header->processedBlocks.store(0);
+	client->header_ = header;
+
+	client->process_ = HostProcess::launch(hostExecutable, {"--serve"}, client->memory_.get(),
+					       client->commandChannel_, client->audioChannel_, error);
+	if (!client->process_) {
+		return nullptr;
+	}
+
+	/* The bridge mapped the region through its inherited copy of the handle. */
+	client->memory_->closeHandle();
+	client->alive_ = true;
+
+	MessageWriter hello;
+	hello.writeUInt32(kProtocolVersion);
+
+	std::vector<uint8_t> reply;
+	if (!client->request(Command::Hello, hello, reply, kHandshakeTimeoutMs, error)) {
+		return nullptr;
+	}
+
+	MessageReader reader(reply);
+	uint32_t version = 0;
+	if (!readStatus(reader, error) || !reader.readUInt32(version) || version != kProtocolVersion) {
+		if (error.empty()) {
+			error = "Plug-in host protocol version mismatch";
+		}
+		return nullptr;
+	}
+
+	blog(LOG_INFO, "[obs-vst3] Started plug-in host process (pid %lld)",
+	     static_cast<long long>(client->process_->processId()));
+	return client;
+}
+
+BridgeClient::~BridgeClient()
+{
+	if (process_ && alive_) {
+		std::string error;
+		std::vector<uint8_t> reply;
+		request(Command::Shutdown, MessageWriter(), reply, kShutdownTimeoutMs, error);
+		process_->waitForExit(kShutdownTimeoutMs);
+	}
+
+	/* Closing the channels makes a still running bridge exit on its own. */
+	commandChannel_.close();
+	audioChannel_.close();
+	process_.reset();
+}
+
+void BridgeClient::markDead()
+{
+	if (alive_.exchange(false)) {
+		blog(LOG_WARNING, "[obs-vst3] The plug-in host process stopped responding");
+		if (process_) {
+			process_->terminate();
+		}
+	}
+}
+
+bool BridgeClient::request(Command command, const MessageWriter &payload, std::vector<uint8_t> &reply, int timeoutMs,
+			   std::string &error)
+{
+	std::lock_guard<std::mutex> lock(commandMutex_);
+
+	if (!alive_) {
+		error = "The plug-in host process is not running";
+		return false;
+	}
+
+	Command replyCommand = Command::Invalid;
+	if (!commandChannel_.sendMessage(command, payload.data(), timeoutMs) ||
+	    !commandChannel_.receiveMessage(replyCommand, reply, timeoutMs)) {
+		error = "The plug-in host process did not respond";
+		markDead();
+		return false;
+	}
+
+	if (replyCommand != command) {
+		error = "Unexpected reply from the plug-in host process";
+		markDead();
+		return false;
+	}
+
+	return true;
+}
+
+bool BridgeClient::loadPlugin(const std::string &modulePath, const std::string &classId, PluginInfo &info,
+			      std::string &error)
+{
+	MessageWriter payload;
+	payload.writeString(modulePath);
+	payload.writeString(classId);
+
+	std::vector<uint8_t> reply;
+	if (!request(Command::LoadPlugin, payload, reply, kLoadTimeoutMs, error)) {
+		return false;
+	}
+
+	MessageReader reader(reply);
+	if (!readStatus(reader, error)) {
+		return false;
+	}
+
+	if (!reader.readString(info.name) || !reader.readString(info.vendor) || !reader.readBool(info.hasEditor) ||
+	    !reader.readBool(info.hasSidechainInput)) {
+		error = "Malformed reply from the plug-in host";
+		return false;
+	}
+
+	return true;
+}
+
+bool BridgeClient::configure(const AudioConfiguration &configuration, ConfigureResult &result, std::string &error)
+{
+	MessageWriter payload;
+	payload.writeDouble(configuration.sampleRate);
+	payload.writeUInt32(configuration.speakerLayout);
+	payload.writeUInt32(configuration.channels);
+	payload.writeUInt32(kMaxBlockFrames);
+	payload.writeBool(configuration.sidechainEnabled);
+
+	std::vector<uint8_t> reply;
+	if (!request(Command::Configure, payload, reply, kCommandTimeoutMs, error)) {
+		return false;
+	}
+
+	MessageReader reader(reply);
+	if (!readStatus(reader, error)) {
+		return false;
+	}
+
+	if (!reader.readInt32(result.latencySamples) || !reader.readUInt32(result.processedChannels) ||
+	    !reader.readBool(result.sidechainActive)) {
+		error = "Malformed reply from the plug-in host";
+		return false;
+	}
+
+	return true;
+}
+
+bool BridgeClient::setState(const PluginState &state, std::string &error)
+{
+	MessageWriter payload;
+	payload.writeBlob(state.component);
+	payload.writeBlob(state.controller);
+
+	std::vector<uint8_t> reply;
+	if (!request(Command::SetState, payload, reply, kCommandTimeoutMs, error)) {
+		return false;
+	}
+
+	MessageReader reader(reply);
+	return readStatus(reader, error);
+}
+
+bool BridgeClient::getState(PluginState &state, std::string &error)
+{
+	std::vector<uint8_t> reply;
+	if (!request(Command::GetState, MessageWriter(), reply, kCommandTimeoutMs, error)) {
+		return false;
+	}
+
+	MessageReader reader(reply);
+	if (!readStatus(reader, error)) {
+		return false;
+	}
+
+	if (!reader.readBlob(state.component) || !reader.readBlob(state.controller)) {
+		error = "Malformed reply from the plug-in host";
+		return false;
+	}
+
+	return true;
+}
+
+bool BridgeClient::showEditor(const std::string &title, std::string &error)
+{
+	MessageWriter payload;
+	payload.writeString(title);
+
+	std::vector<uint8_t> reply;
+	if (!request(Command::ShowEditor, payload, reply, kCommandTimeoutMs, error)) {
+		return false;
+	}
+
+	MessageReader reader(reply);
+	return readStatus(reader, error);
+}
+
+bool BridgeClient::hideEditor(std::string &error)
+{
+	std::vector<uint8_t> reply;
+	if (!request(Command::HideEditor, MessageWriter(), reply, kCommandTimeoutMs, error)) {
+		return false;
+	}
+
+	MessageReader reader(reply);
+	return readStatus(reader, error);
+}
+
+bool BridgeClient::process(float *const *channels, uint32_t channelCount, uint32_t frames,
+			   const float *const *sidechain, uint32_t sidechainChannels)
+{
+	std::lock_guard<std::mutex> lock(audioMutex_);
+
+	if (!alive_ || channelCount == 0) {
+		return false;
+	}
+
+	channelCount = std::min(channelCount, kMaxChannels);
+	sidechainChannels = std::min(sidechainChannels, kMaxChannels);
+
+	for (uint32_t offset = 0; offset < frames; offset += kMaxBlockFrames) {
+		uint32_t blockFrames = std::min(kMaxBlockFrames, frames - offset);
+		if (!processBlock(channels, channelCount, offset, blockFrames, sidechain, sidechainChannels)) {
+			return false;
+		}
+	}
+
+	return true;
+}
+
+bool BridgeClient::processBlock(float *const *channels, uint32_t channelCount, uint32_t offset, uint32_t frames,
+				const float *const *sidechain, uint32_t sidechainChannels)
+{
+	void *memory = memory_->data();
+	size_t bytes = frames * sizeof(float);
+
+	for (uint32_t channel = 0; channel < channelCount; channel++) {
+		float *input = audioPlane(memory, AudioRegion::Input, channel);
+		if (channels[channel]) {
+			std::memcpy(input, channels[channel] + offset, bytes);
+		} else {
+			std::memset(input, 0, bytes);
+		}
+	}
+
+	ProcessRequest processRequest = {frames, kProcessFlagNone, projectTimeSamples_};
+	if (sidechain && sidechainChannels > 0) {
+		for (uint32_t channel = 0; channel < sidechainChannels; channel++) {
+			float *input = audioPlane(memory, AudioRegion::Sidechain, channel);
+			if (sidechain[channel]) {
+				std::memcpy(input, sidechain[channel] + offset, bytes);
+			} else {
+				std::memset(input, 0, bytes);
+			}
+		}
+		processRequest.flags |= kProcessFlagSidechain;
+	}
+
+	ProcessReply processReply = {};
+	if (!audioChannel_.write(&processRequest, sizeof(processRequest), kProcessTimeoutMs) ||
+	    !audioChannel_.read(&processReply, sizeof(processReply), kProcessTimeoutMs)) {
+		markDead();
+		return false;
+	}
+
+	projectTimeSamples_ += frames;
+
+	if (static_cast<Status>(processReply.status) != Status::Ok) {
+		/* Not configured yet or reconfiguring: leave the audio untouched. */
+		return false;
+	}
+
+	for (uint32_t channel = 0; channel < channelCount; channel++) {
+		if (channels[channel]) {
+			std::memcpy(channels[channel] + offset, audioPlane(memory, AudioRegion::Output, channel),
+				    bytes);
+		}
+	}
+
+	return true;
+}
+
+bool BridgeClient::isAlive() const
+{
+	return alive_;
+}
+
+bool BridgeClient::isEditorOpen() const
+{
+	return alive_ && header_->editorOpen.load() != 0;
+}
+
+int32_t BridgeClient::latencySamples() const
+{
+	return header_->latencySamples.load();
+}
+
+uint32_t BridgeClient::editCount() const
+{
+	return header_->editCount.load();
+}
+
+int64_t BridgeClient::processId() const
+{
+	return process_ ? process_->processId() : -1;
+}
+
+} // namespace obs_vst3
