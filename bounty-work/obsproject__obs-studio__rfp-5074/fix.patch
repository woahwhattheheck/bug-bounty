@@ -0,0 +1,103 @@
+#pragma once
+
+#include "bridge/BridgeProtocol.hpp"
+#include "bridge/IpcChannel.hpp"
+
+#include <atomic>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace obs_vst3 {
+
+class HostProcess;
+class MessageWriter;
+class SharedMemory;
+
+struct PluginInfo {
+	std::string name;
+	std::string vendor;
+	bool hasEditor = false;
+	bool hasSidechainInput = false;
+};
+
+struct AudioConfiguration {
+	double sampleRate = 0.0;
+	uint32_t speakerLayout = 0; /* enum speaker_layout of libobs */
+	uint32_t channels = 0;
+	bool sidechainEnabled = false;
+};
+
+struct ConfigureResult {
+	int32_t latencySamples = 0;
+	uint32_t processedChannels = 0;
+	bool sidechainActive = false;
+};
+
+struct PluginState {
+	std::vector<uint8_t> component;
+	std::vector<uint8_t> controller;
+};
+
+/*
+ * Module side of the bridge: owns one obs-vst3-host process that runs a single
+ * VST3 plug-in instance.
+ *
+ * Command methods (load, configure, state and editor control) are blocking
+ * round trips with generous timeouts and are serialized internally. process()
+ * is called from the OBS audio thread and only ever waits kProcessTimeoutMs.
+ * Once any request fails because the bridge stopped responding, the client
+ * is marked dead; isAlive() then returns false and the owning filter passes
+ * audio through until it starts a new bridge.
+ */
+class BridgeClient {
+public:
+	static std::unique_ptr<BridgeClient> start(const std::string &hostExecutable, std::string &error);
+
+	~BridgeClient();
+
+	BridgeClient(const BridgeClient &) = delete;
+	BridgeClient &operator=(const BridgeClient &) = delete;
+
+	bool loadPlugin(const std::string &modulePath, const std::string &classId, PluginInfo &info,
+			std::string &error);
+	bool configure(const AudioConfiguration &configuration, ConfigureResult &result, std::string &error);
+	bool setState(const PluginState &state, std::string &error);
+	bool getState(PluginState &state, std::string &error);
+	bool showEditor(const std::string &title, std::string &error);
+	bool hideEditor(std::string &error);
+
+	/* Processes planar float audio in place. Returns false if the audio was left untouched. */
+	bool process(float *const *channels, uint32_t channelCount, uint32_t frames, const float *const *sidechain,
+		     uint32_t sidechainChannels);
+
+	bool isAlive() const;
+	bool isEditorOpen() const;
+	int32_t latencySamples() const;
+	uint32_t editCount() const;
+	int64_t processId() const;
+
+private:
+	BridgeClient() = default;
+
+	bool request(Command command, const MessageWriter &payload, std::vector<uint8_t> &reply, int timeoutMs,
+		     std::string &error);
+	bool processBlock(float *const *channels, uint32_t channelCount, uint32_t offset, uint32_t frames,
+			  const float *const *sidechain, uint32_t sidechainChannels);
+	void markDead();
+
+	std::unique_ptr<HostProcess> process_;
+	std::unique_ptr<SharedMemory> memory_;
+	SharedAudioHeader *header_ = nullptr;
+	IpcChannel commandChannel_;
+	IpcChannel audioChannel_;
+
+	std::mutex commandMutex_;
+	std::mutex audioMutex_;
+	std::atomic<bool> alive_{false};
+	int64_t projectTimeSamples_ = 0;
+};
+
+} // namespace obs_vst3
