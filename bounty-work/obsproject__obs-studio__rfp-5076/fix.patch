+bool SceneTree::IsFolder(const QListWidgetItem *item)
+{
+	return item && item->data(FolderRole).toBool();
+}
+
+bool SceneTree::IsFolder(const QModelIndex &index)
+{
+	return index.isValid() && index.data(FolderRole).toBool();
+}
+
+bool SceneTree::IsInFolder(const QListWidgetItem *item)
+{
+	return item && !IsFolder(item) && item->data(InFolderRole).toBool();
+}
+
+QString SceneTree::GetFolderName(const QListWidgetItem *folder)
+{
+	/* The name is kept separately from the display text, which already
+	 * contains the new name while the folder is being renamed */
+	return IsFolder(folder) ? folder->data(FolderNameRole).toString() : QString();
+}
+
+bool SceneTree::HasFolders() const
+{
+	for (int i = 0; i < count(); i++) {
+		if (IsFolder(item(i))) {
+			return true;
+		}
+	}
+
+	return false;
+}
+
+int SceneTree::GetSceneCount() const
+{
+	int sceneCount = 0;
+
+	for (int i = 0; i < count(); i++) {
+		if (!IsFolder(item(i))) {
+			sceneCount++;
+		}
+	}
+
+	return sceneCount;
+}
+
+QList<QListWidgetItem *> SceneTree::GetFolders() const
+{
+	QList<QListWidgetItem *> folders;
+
+	for (int i = 0; i < count(); i++) {
+		if (IsFolder(item(i))) {
+			folders.append(item(i));
+		}
+	}
+
+	return folders;
+}
+
+QListWidgetItem *SceneTree::FindFolder(const QString &name) const
+{
+	for (int i = 0; i < count(); i++) {
+		QListWidgetItem *folder = item(i);
+
+		if (IsFolder(folder) && GetFolderName(folder) == name) {
+			return folder;
+		}
+	}
+
+	return nullptr;
+}
+
+QListWidgetItem *SceneTree::GetFolderOf(const QListWidgetItem *sceneItem) const
+{
+	if (!IsInFolder(sceneItem)) {
+		return nullptr;
+	}
+
+	for (int i = row(sceneItem) - 1; i >= 0; i--) {
+		QListWidgetItem *previous = item(i);
+
+		if (IsFolder(previous)) {
+			return previous;
+		} else if (!IsInFolder(previous)) {
+			break;
+		}
+	}
+
+	return nullptr;
+}
+
+QList<QListWidgetItem *> SceneTree::GetFolderScenes(const QListWidgetItem *folder) const
+{
+	QList<QListWidgetItem *> scenes;
+
+	if (!IsFolder(folder)) {
+		return scenes;
+	}
+
+	const int end = GetEntryEnd(row(folder));
+
+	for (int i = row(folder) + 1; i < end; i++) {
+		scenes.append(item(i));
+	}
+
+	return scenes;
+}
+
+QListWidgetItem *SceneTree::AddFolder(const QString &name, int row, bool collapsed)
+{
+	QListWidgetItem *folder = new QListWidgetItem(name);
+	folder->setData(FolderRole, true);
+	folder->setData(FolderNameRole, name);
+	folder->setData(FolderCollapsedRole, collapsed);
+	folder->setFlags(Qt::ItemIsSelectable | Qt::ItemIsEnabled | Qt::ItemIsDragEnabled | Qt::ItemIsDropEnabled);
+
+	QFont font = folder->font();
+	font.setBold(true);
+	folder->setFont(font);
+
+	if (row < 0 || row > count()) {
+		row = count();
+	}
+
+	/* Folders cannot be nested */
+	if (row < count() && IsInFolder(item(row))) {
+		row = GetEntryEnd(GetEntryStart(row));
+	}
+
+	insertItem(row, folder);
+	UpdateFolders();
+
+	return folder;
+}
+
+void SceneTree::RemoveFolder(QListWidgetItem *folder)
+{
+	if (!IsFolder(folder)) {
+		return;
+	}
+
+	/* Scenes of the folder become top-level scenes at the same position */
+	for (QListWidgetItem *scene : GetFolderScenes(folder)) {
+		scene->setData(InFolderRole, false);
+	}
+
+	{
+		QSignalBlocker blocker(this);
+		delete folder;
+	}
+
+	UpdateFolders();
+}
+
+void SceneTree::RenameFolder(QListWidgetItem *folder, const QString &name)
+{
+	if (!IsFolder(folder)) {
+		return;
+	}
+
+	folder->setData(FolderNameRole, name);
+	folder->setText(name);
+	UpdateFolders();
+}
+
+int SceneTree::GetNewFolderRow() const
+{
+	QListWidgetItem *current = currentItem();
+
+	if (!current) {
+		return count();
+	}
+
+	return GetEntryEnd(GetEntryStart(row(current)));
+}
+
+bool SceneTree::IsFolderCollapsed(const QListWidgetItem *folder) const
+{
+	return IsFolder(folder) && folder->data(FolderCollapsedRole).toBool();
+}
+
+void SceneTree::SetFolderCollapsed(QListWidgetItem *folder, bool collapsed)
+{
+	if (!IsFolder(folder) || IsFolderCollapsed(folder) == collapsed) {
+		return;
+	}
+
+	if (collapsed) {
+		/* Do not hide the current item, select its folder instead */
+		QListWidgetItem *current = currentItem();
+
+		if (current && GetFolderOf(current) == folder) {
+			QSignalBlocker blocker(this);
+			setCurrentItem(folder);
+		}
+	}
+
+	folder->setData(FolderCollapsedRole, collapsed);
+	UpdateFolders();
+
+	emit folderStateChanged();
+}
+
+void SceneTree::SetAllFoldersCollapsed(bool collapsed)
+{
+	for (QListWidgetItem *folder : GetFolders()) {
+		SetFolderCollapsed(folder, collapsed);
+	}
+}
+
+void SceneTree::InsertScene(QListWidgetItem *sceneItem)
+{
+	QListWidgetItem *current = currentItem();
+	int insertRow = currentRow() + 1;
+	bool inFolder = false;
+
+	if (IsFolder(current)) {
+		insertRow = GetEntryEnd(row(current));
+		inFolder = true;
+	} else if (current) {
+		inFolder = IsInFolder(current);
+	}
+
+	sceneItem->setData(InFolderRole, inFolder);
+	insertItem(insertRow, sceneItem);
+
+	if (HasFolders()) {
+		UpdateFolders();
+	}
+}
+
+void SceneTree::MoveSceneToFolder(QListWidgetItem *sceneItem, QListWidgetItem *folder)
+{
+	if (!sceneItem || IsFolder(sceneItem)) {
+		return;
+	}
+
+	QListWidgetItem *currentFolder = GetFolderOf(sceneItem);
+
+	if (currentFolder == folder) {
+		return;
+	}
+
+	if (folder) {
+		MoveEntryTo(sceneItem, GetEntryEnd(row(folder)), true);
+
+		if (currentItem() == sceneItem) {
+			SetFolderCollapsed(folder, false);
+		}
+	} else {
+		MoveEntryTo(sceneItem, GetEntryEnd(row(currentFolder)), false);
+	}
+
+	emit scenesReordered();
+}
+
+bool SceneTree::MoveEntry(QListWidgetItem *entry, int offset)
+{
+	if (!entry || offset == 0) {
+		return false;
+	}
+
+	const int entryRow = row(entry);
+	bool moved = false;
+
+	if (IsInFolder(entry)) {
+		/* Scenes inside a folder move within that folder */
+		QListWidgetItem *folder = GetFolderOf(entry);
+		const int firstRow = row(folder) + 1;
+		const int endRow = GetEntryEnd(row(folder));
+		const int targetRow = entryRow + (offset > 0 ? 1 : -1);
+
+		if (targetRow >= firstRow && targetRow < endRow) {
+			moved = MoveRows(entryRow, 1, offset > 0 ? targetRow + 1 : targetRow);
+		}
+	} else {
+		/* Top-level scenes and folders move past whole top-level entries */
+		const int endRow = GetEntryEnd(entryRow);
+
+		if (offset < 0 && entryRow > 0) {
+			moved = MoveRows(entryRow, endRow - entryRow, GetEntryStart(entryRow - 1));
+		} else if (offset > 0 && endRow < count()) {
+			moved = MoveRows(entryRow, endRow - entryRow, GetEntryEnd(endRow));
+		}
+	}
+
+	if (moved) {
+		UpdateFolders();
+		emit scenesReordered();
+	}
+
+	return moved;
+}
+
+bool SceneTree::MoveEntryToEdge(QListWidgetItem *entry, bool toTop)
+{
+	if (!entry) {
+		return false;
+	}
+
+	const int entryRow = row(entry);
+	bool moved = false;
+
+	if (IsInFolder(entry)) {
+		QListWidgetItem *folder = GetFolderOf(entry);
+		const int firstRow = row(folder) + 1;
+		const int endRow = GetEntryEnd(row(folder));
+
+		moved = MoveRows(entryRow, 1, toTop ? firstRow : endRow);
+	} else {
+		const int endRow = GetEntryEnd(entryRow);
+
+		moved = MoveRows(entryRow, endRow - entryRow, toTop ? 0 : count());
+	}
+
+	if (moved) {
+		UpdateFolders();
+		emit scenesReordered();
+	}
+
+	return moved;
+}
+
+OBS::SceneTreeLayout SceneTree::GetLayout() const
+{
+	OBS::SceneTreeLayout layout;
+	bool isInsideFolder = false;
+
+	for (int i = 0; i < count(); i++) {
+		QListWidgetItem *entryItem = item(i);
+		std::string name = entryItem->text().toStdString();
+
+		if (IsFolder(entryItem)) {
+			OBS::SceneTreeEntry entry;
+			entry.type = OBS::SceneTreeEntry::Type::Folder;
+			entry.name = GetFolderName(entryItem).toStdString();
+			entry.isCollapsed = IsFolderCollapsed(entryItem);
+			layout.push_back(std::move(entry));
+			isInsideFolder = true;
+		} else if (isInsideFolder && IsInFolder(entryItem)) {
+			layout.back().scenes.push_back(name);
+		} else {
+			OBS::SceneTreeEntry entry;
+			entry.type = OBS::SceneTreeEntry::Type::Scene;
+			entry.name = name;
+			layout.push_back(std::move(entry));
+			isInsideFolder = false;
+		}
+	}
+
+	return layout;
+}
+
+void SceneTree::ApplyLayout(const OBS::SceneTreeLayout &layout)
+{
+	QSignalBlocker blocker(this);
+	isApplyingLayout = true;
+
+	QListWidgetItem *current = currentItem();
+	QString currentFolderName;
+
+	if (IsFolder(current)) {
+		currentFolderName = GetFolderName(current);
+		current = nullptr;
+	}
+
+	std::vector<QListWidgetItem *> sceneItems;
+	sceneItems.reserve(count());
+
+	while (count() > 0) {
+		QListWidgetItem *entryItem = takeItem(0);
+
+		if (IsFolder(entryItem)) {
+			delete entryItem;
+		} else {
+			sceneItems.push_back(entryItem);
+		}
+	}
+
+	auto takeScene = [&sceneItems](const std::string &name) -> QListWidgetItem * {
+		for (auto it = sceneItems.begin(); it != sceneItems.end(); ++it) {
+			if ((*it)->text().toStdString() == name) {
+				QListWidgetItem *sceneItem = *it;
+				sceneItems.erase(it);
+				return sceneItem;
+			}
+		}
+
+		return nullptr;
+	};
+
+	auto addScene = [this](QListWidgetItem *sceneItem, bool inFolder) {
+		sceneItem->setData(InFolderRole, inFolder);
+		addItem(sceneItem);
+	};
+
+	for (const OBS::SceneTreeEntry &entry : layout) {
+		if (entry.type == OBS::SceneTreeEntry::Type::Scene) {
+			if (QListWidgetItem *sceneItem = takeScene(entry.name)) {
+				addScene(sceneItem, false);
+			}
+		} else if (entry.type == OBS::SceneTreeEntry::Type::Folder) {
+			QString name = QString::fromStdString(entry.name);
+
+			if (name.isEmpty() || FindFolder(name)) {
+				continue;
+			}
+
+			QListWidgetItem *folder = AddFolder(name, count(), entry.isCollapsed);
+
+			if (!currentFolderName.isEmpty() && name == currentFolderName) {
+				current = folder;
+			}
+
+			for (const std::string &sceneName : entry.scenes) {
+				if (QListWidgetItem *sceneItem = takeScene(sceneName)) {
+					addScene(sceneItem, true);
+				}
+			}
+		}
+	}
+
+	/* Scenes missing from the layout stay in the list as top-level scenes */
+	for (QListWidgetItem *sceneItem : sceneItems) {
+		addScene(sceneItem, false);
+	}
+
+	if (current) {
+		setCurrentItem(current);
+	}
+
+	isApplyingLayout = false;
+	UpdateFolders();
+}
+
+void SceneTree::UpdateFolders()
+{
+	QListWidgetItem *folder = nullptr;
+
+	for (int i = 0; i < count(); i++) {
+		QListWidgetItem *entryItem = item(i);
+
+		if (IsFolder(entryItem)) {
+			folder = entryItem;
+			continue;
+		}
+
+		const bool inFolder = folder && entryItem->data(InFolderRole).toBool();
+		if (!inFolder) {
+			folder = nullptr;
+		}
+
+		if (entryItem->data(InFolderRole).toBool() != inFolder) {
+			entryItem->setData(InFolderRole, inFolder);
+		}
+
+		const bool hidden = inFolder && IsFolderCollapsed(folder);
+		if (entryItem->isHidden() != hidden) {
+			entryItem->setHidden(hidden);
+		}
+
+		QString description =
+			inFolder ? QTStr("Basic.Main.SceneFolder.Accessible.Scene").arg(GetFolderName(folder))
+				 : QString();
+		if (entryItem->data(Qt::AccessibleDescriptionRole).toString() != description) {
+			entryItem->setData(Qt::AccessibleDescriptionRole, description);
+		}
+	}
+
+	for (QListWidgetItem *folderItem : GetFolders()) {
+		const char *lookup = IsFolderCollapsed(folderItem) ? "Basic.Main.SceneFolder.Accessible.Collapsed"
+								   : "Basic.Main.SceneFolder.Accessible.Expanded";
+		QString description = QTStr(lookup).arg(GetFolderScenes(folderItem).count());
+
+		if (folderItem->data(Qt::AccessibleDescriptionRole).toString() != description) {
+			folderItem->setData(Qt::AccessibleDescriptionRole, description);
+		}
+	}
+
+	if (gridMode) {
+		QResizeEvent event(size(), size());
+		SceneTree::resizeEvent(&event);
+	}
+
+	viewport()->update();
+}
+
+int SceneTree::GetIndentation() const
+{
+	int indicatorWidth = 10;
+
+	if (folderIndicator) {
+		folderIndicator->ensurePolished();
+		indicatorWidth =
+			folderIndicator->style()->pixelMetric(QStyle::PM_IndicatorWidth, nullptr, folderIndicator);
+	}
+
+	return std::max(16, indicatorWidth + 8);
+}
+
+QRect SceneTree::GetFolderIndicatorRect(const QRect &itemRect) const
+{
+	return QRect(itemRect.left(), itemRect.top(), GetIndentation(), itemRect.height());
+}
+
+void SceneTree::PaintFolderIndicator(QPainter *painter, const QRect &rect, bool collapsed) const
+{
+	if (!folderIndicator) {
+		return;
+	}
+
+	folderIndicator->ensurePolished();
+
+	QStyle *indicatorStyle = folderIndicator->style();
+
+	QStyleOptionButton option;
+	option.initFrom(folderIndicator);
+	option.state &= ~(QStyle::State_On | QStyle::State_Off);
+	option.state |= QStyle::State_Enabled | (collapsed ? QStyle::State_On : QStyle::State_Off);
+
+	const int width = indicatorStyle->pixelMetric(QStyle::PM_IndicatorWidth, &option, folderIndicator);
+	const int height = indicatorStyle->pixelMetric(QStyle::PM_IndicatorHeight, &option, folderIndicator);
+	option.rect = QRect(0, 0, width, height);
+	option.rect.moveCenter(rect.center());
+
+	indicatorStyle->drawPrimitive(QStyle::PE_IndicatorCheckBox, &option, painter, folderIndicator);
+}
+
+int SceneTree::GetEntryEnd(int entryRow) const
+{
+	if (!IsFolder(item(entryRow))) {
+		return entryRow + 1;
+	}
+
+	int endRow = entryRow + 1;
+
+	while (endRow < count() && IsInFolder(item(endRow))) {
+		endRow++;
+	}
+
+	return endRow;
+}
+
+int SceneTree::GetEntryStart(int entryRow) const
+{
+	QListWidgetItem *entryItem = item(entryRow);
+
+	if (!IsInFolder(entryItem)) {
+		return entryRow;
+	}
+
+	QListWidgetItem *folder = GetFolderOf(entryItem);
+	return folder ? row(folder) : entryRow;
+}
+
+bool SceneTree::MoveRows(int first, int rowCount, int destination)
+{
+	if (rowCount <= 0 || first < 0 || first + rowCount > count() || destination < 0 || destination > count()) {
+		return false;
+	}
+
+	if (destination >= first && destination <= first + rowCount) {
+		return false;
+	}
+
+	QListWidgetItem *current = currentItem();
+	QSignalBlocker blocker(this);
+
+	QList<QListWidgetItem *> moving;
+	for (int i = 0; i < rowCount; i++) {
+		moving.append(takeItem(first));
+	}
+
+	if (destination > first) {
+		destination -= rowCount;
+	}
+
+	for (int i = 0; i < moving.count(); i++) {
+		insertItem(destination + i, moving[i]);
+	}
+
+	if (current) {
+		setCurrentItem(current);
+	}
+
+	return true;
+}
+
+void SceneTree::MoveEntryTo(QListWidgetItem *entry, int destination, bool destinationInFolder)
+{
+	const int first = row(entry);
+	const int end = GetEntryEnd(first);
+
+	if (IsFolder(entry)) {
+		/* Folders cannot be nested, keep them at the top level */
+		destinationInFolder = false;
+
+		if (destination < count() && IsInFolder(item(destination))) {
+			destination = GetEntryEnd(GetEntryStart(destination));
+		}
+	}
+
+	MoveRows(first, end - first, destination);
+
+	if (!IsFolder(entry)) {
+		entry->setData(InFolderRole, destinationInFolder);
+	}
+
+	UpdateFolders();
+}
+
+QList<QListWidgetItem *> SceneTree::GetVisibleItems(const QListWidgetItem *exclude) const
+{
+	QList<QListWidgetItem *> visibleItems;
+	const QListWidgetItem *excludedFolder = IsFolder(exclude) ? exclude : nullptr;
+
+	for (int i = 0; i < count(); i++) {
+		QListWidgetItem *entryItem = item(i);
+
+		if (entryItem->isHidden() || entryItem == exclude) {
+			continue;
+		}
+
+		if (excludedFolder && GetFolderOf(entryItem) == excludedFolder) {
+			continue;
+		}
+
+		visibleItems.append(entryItem);
+	}
+
+	return visibleItems;
+}
+
+QListWidgetItem *SceneTree::GetLastVisibleItem() const
+{
+	for (int i = count() - 1; i >= 0; i--) {
+		if (!item(i)->isHidden()) {
+			return item(i);
+		}
+	}
+
+	return nullptr;
+}
