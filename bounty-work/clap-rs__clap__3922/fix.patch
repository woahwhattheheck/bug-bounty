From 9a891a0edcb7a17aa14121b40888a6e7afe206ee Mon Sep 17 00:00:00 2001
From: woahwhattheheck <293286387+woahwhattheheck@users.noreply.github.com>
Date: Thu, 8 Oct 2026 05:15:17 +0000
Subject: [PATCH 3/3] fix(complete): Don't split delimited values out of flags

When completing a value, everything up to the last value delimiter was
treated as prior values of the argument being completed.
For a raw argument like `--delimiter=comma,`, this meant positionals and
pending options offered `--delimiter=comma,<value>` candidates even
though the parser treats the whole argument as a flag.

We now only split on the delimiter when the parser would treat the raw
argument as values for that argument, matching its hyphenated value and
negative number rules.
---
 clap_complete/src/engine/complete.rs    | 80 +++++++++++++++++++++++--
 clap_complete/tests/testsuite/engine.rs | 12 ----
 2 files changed, 74 insertions(+), 18 deletions(-)

diff --git a/clap_complete/src/engine/complete.rs b/clap_complete/src/engine/complete.rs
index 43fe72f9..fd6c2a31 100644
--- a/clap_complete/src/engine/complete.rs
+++ b/clap_complete/src/engine/complete.rs
@@ -162,9 +162,11 @@ fn complete_arg(
                 .get_positionals()
                 .find(|p| p.get_index() == Some(pos_index))
             {
-                completions.extend(complete_arg_value(
-                    arg.to_value(),
+                let is_value = is_escaped || is_value_of(arg, cmd, positional, false);
+                completions.extend(complete_raw_arg_value(
+                    arg,
                     positional,
+                    is_value,
                     current_dir,
                     0,
                 ));
@@ -178,9 +180,11 @@ fn complete_arg(
                 .get_positionals()
                 .find(|p| p.get_index() == Some(pos_index))
             {
-                completions.extend(complete_arg_value(
-                    arg.to_value(),
+                let is_value = is_escaped || is_value_of(arg, cmd, positional, true);
+                completions.extend(complete_raw_arg_value(
+                    arg,
                     positional,
+                    is_value,
                     current_dir,
                     num_arg.saturating_sub(1),
                 ));
@@ -194,9 +198,11 @@ fn complete_arg(
             }
         }
         ParseState::Opt((opt, count)) => {
-            completions.extend(complete_arg_value(
-                arg.to_value(),
+            let is_value = is_value_of(arg, cmd, opt, true);
+            completions.extend(complete_raw_arg_value(
+                arg,
                 opt,
+                is_value,
                 current_dir,
                 count.saturating_sub(1),
             ));
@@ -343,6 +349,24 @@ fn complete_option(
     completions
 }
 
+/// Complete a raw command-line argument as a value of `value_arg`
+///
+/// Prior delimited values are only split off when `arg` is parsed as values.
+/// Otherwise, like with `--flag=a,b`, the delimiter belongs to the flag.
+fn complete_raw_arg_value(
+    arg: &clap_lex::ParsedArg<'_>,
+    value_arg: &clap::Arg,
+    is_value: bool,
+    current_dir: Option<&std::path::Path>,
+    arg_index: usize,
+) -> Vec<CompletionCandidate> {
+    if is_value {
+        complete_arg_value(arg.to_value(), value_arg, current_dir, arg_index)
+    } else {
+        complete_value(arg.to_value(), value_arg, current_dir, arg_index)
+    }
+}
+
 fn complete_arg_value(
     value: Result<&str, &OsStr>,
     arg: &clap::Arg,
@@ -727,6 +751,50 @@ fn parse_opt_value(opt: &clap::Arg, count: usize) -> ParseState<'_> {
     }
 }
 
+/// Whether the parser would treat `arg` as a value of `value_arg`, rather than as flags
+///
+/// `is_continuation` is set when `value_arg` already started taking values, like after `--opt`.
+fn is_value_of(
+    arg: &clap_lex::ParsedArg<'_>,
+    cmd: &clap::Command,
+    value_arg: &clap::Arg,
+    is_continuation: bool,
+) -> bool {
+    if arg.is_stdio() || !arg.to_value_os().starts_with("-") {
+        true
+    } else if is_continuation && value_arg.is_allow_hyphen_values_set() {
+        true
+    } else if value_arg.is_allow_negative_numbers_set() && arg.is_negative_number() {
+        true
+    } else if value_arg.is_positional() && value_arg.is_allow_hyphen_values_set() {
+        // Known flags take precedence over hyphenated values
+        if let Some((flag, _)) = arg.to_long() {
+            flag.is_ok_and(|flag| {
+                !cmd.get_arguments().any(|a| {
+                    a.get_long() == Some(flag)
+                        || a.get_all_aliases().is_some_and(|l| l.contains(&flag))
+                })
+            })
+        } else if let Some(mut short) = arg.to_short() {
+            short.any(|flag| {
+                let is_known = flag
+                    .map(|flag| {
+                        cmd.get_arguments().any(|a| {
+                            a.get_short() == Some(flag)
+                                || a.get_all_short_aliases().is_some_and(|s| s.contains(&flag))
+                        })
+                    })
+                    .unwrap_or(false);
+                !is_known
+            })
+        } else {
+            false
+        }
+    } else {
+        false
+    }
+}
+
 fn pos_allows_hyphen(cmd: &clap::Command, pos_index: usize) -> bool {
     cmd.get_positionals()
         .find(|a| a.get_index() == Some(pos_index))
