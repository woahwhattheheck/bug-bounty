@@ -0,0 +1,234 @@
+// Copyright (c) .NET Foundation and Contributors (https://dotnetfoundation.org/ & https://stride3d.net)
+// Distributed under the MIT license. See the LICENSE.md file in the project root for more information.
+using System;
+using System.Collections.Generic;
+using FirstPersonShooter.Player;
+using Stride.Core.Mathematics;
+using Stride.Engine;
+using Stride.Engine.Events;
+using Stride.Graphics;
+using Stride.Physics;
+using Stride.Rendering;
+using Stride.Rendering.Materials;
+using Stride.Rendering.Materials.ComputeColors;
+
+namespace FirstPersonShooter
+{
+    /// <summary>
+    /// Leaves a bullet hole decal on the surfaces hit by the gun.
+    /// </summary>
+    /// <remarks>
+    /// Each bullet hole is an entity with a <see cref="DecalComponent"/> projecting into the surface along the opposite of its normal.
+    /// Bullet holes on moving objects are attached to them, so they move along.
+    /// </remarks>
+    public class BulletHoleDecals : SyncScript
+    {
+        private readonly EventReceiver<WeaponFiredResult> weaponFiredEvent = new EventReceiver<WeaponFiredResult>(WeaponScript.WeaponFired);
+
+        private readonly List<BulletHole> bulletHoles = new List<BulletHole>();
+
+        private readonly Random random = new Random();
+
+        /// <summary>
+        /// The material projected by the bullet holes. When not set, a simple procedural bullet hole is used.
+        /// </summary>
+        public Material Material { get; set; }
+
+        /// <summary>
+        /// The width and height of a bullet hole, in meters.
+        /// </summary>
+        public float Size { get; set; } = 0.15f;
+
+        /// <summary>
+        /// The depth of the projection, in meters, centered on the impact point.
+        /// </summary>
+        public float ProjectionDepth { get; set; } = 0.1f;
+
+        /// <summary>
+        /// The maximum number of bullet holes. When it is reached, the oldest bullet hole is removed.
+        /// </summary>
+        public int MaxBulletHoles { get; set; } = 50;
+
+        /// <summary>
+        /// The time, in seconds, a bullet hole stays before fading out. Bullet holes stay forever when it is 0.
+        /// </summary>
+        public float Lifetime { get; set; } = 30.0f;
+
+        /// <summary>
+        /// The duration, in seconds, of the fade out of a bullet hole.
+        /// </summary>
+        public float FadeOutDuration { get; set; } = 2.0f;
+
+        public override void Start()
+        {
+            Material ??= CreateBulletHoleMaterial();
+        }
+
+        public override void Update()
+        {
+            while (weaponFiredEvent.TryReceive(out var weaponFired))
+            {
+                if (weaponFired.DidHit)
+                    AddBulletHole(weaponFired.HitResult);
+            }
+
+            if (Lifetime <= 0.0f)
+                return;
+
+            var elapsed = (float)Game.UpdateTime.Elapsed.TotalSeconds;
+            for (var i = bulletHoles.Count - 1; i >= 0; i--)
+            {
+                var bulletHole = bulletHoles[i];
+                bulletHole.Age += elapsed;
+
+                var remaining = Lifetime + FadeOutDuration - bulletHole.Age;
+                if (remaining <= 0.0f)
+                {
+                    RemoveBulletHole(i);
+                    continue;
+                }
+
+                // Fade the decal out at the end of its life
+                bulletHole.Decal.Opacity = FadeOutDuration > 0.0f ? Math.Min(remaining / FadeOutDuration, 1.0f) : 1.0f;
+            }
+        }
+
+        public override void Cancel()
+        {
+            for (var i = bulletHoles.Count - 1; i >= 0; i--)
+                RemoveBulletHole(i);
+        }
+
+        private void AddBulletHole(HitResult hit)
+        {
+            var hitEntity = hit.Collider?.Entity;
+            if (hitEntity == null || hit.Collider is CharacterComponent || Material == null)
+                return;
+
+            if (MaxBulletHoles <= 0)
+                return;
+
+            if (bulletHoles.Count >= MaxBulletHoles)
+                RemoveBulletHole(0);
+
+            var decal = new DecalComponent
+            {
+                Material = Material,
+                Size = new Vector3(Size, Size, ProjectionDepth),
+                // Bullet holes on the edge of an object do not stretch on the sides
+                AngleFadeStart = 70.0f,
+                AngleFadeEnd = 85.0f,
+            };
+            var entity = new Entity("Bullet hole") { decal };
+
+            // Attach the bullet hole to moving objects, so that it follows them
+            if (hit.Collider is RigidbodyComponent)
+                hitEntity.AddChild(entity);
+            else
+                Entity.Scene.Entities.Add(entity);
+
+            entity.Transform.UseTRS = false;
+            entity.Transform.WorldMatrix = CreateBulletHoleWorldMatrix(hit.Point, hit.Normal, (float)random.NextDouble() * MathUtil.TwoPi);
+            entity.Transform.UpdateLocalFromWorld();
+
+            bulletHoles.Add(new BulletHole { Entity = entity, Decal = decal });
+        }
+
+        private void RemoveBulletHole(int index)
+        {
+            // Removes the entity from its scene, and detaches it from the object it was attached to
+            bulletHoles[index].Entity.Scene = null;
+            bulletHoles.RemoveAt(index);
+        }
+
+        /// <summary>
+        /// Creates the transformation of a decal projecting into a surface: its forward axis (-Z) points into the surface.
+        /// </summary>
+        private static Matrix CreateBulletHoleWorldMatrix(Vector3 position, Vector3 surfaceNormal, float rotation)
+        {
+            var zAxis = Vector3.Normalize(surfaceNormal);
+            var reference = MathF.Abs(zAxis.Y) < 0.99f ? Vector3.UnitY : Vector3.UnitX;
+            var xAxis = Vector3.Normalize(Vector3.Cross(reference, zAxis));
+            var yAxis = Vector3.Cross(zAxis, xAxis);
+
+            // Random rotation around the normal, so that bullet holes don't all look the same
+            var (sin, cos) = MathF.SinCos(rotation);
+
+            var world = Matrix.Identity;
+            world.Right = xAxis * cos + yAxis * sin;
+            world.Up = yAxis * cos - xAxis * sin;
+            world.Backward = zAxis;
+            world.TranslationVector = position;
+            return world;
+        }
+
+        /// <summary>
+        /// Creates a bullet hole material from a procedural texture: a dark hole surrounded by a jagged, fading crater.
+        /// </summary>
+        private Material CreateBulletHoleMaterial()
+        {
+            const int TextureSize = 128;
+            const int RimSectors = 24;
+
+            var noise = new Random(1234);
+            var rim = new float[RimSectors];
+            for (var i = 0; i < RimSectors; i++)
+                rim[i] = 0.7f + 0.25f * (float)noise.NextDouble();
+
+            var pixels = new Color[TextureSize * TextureSize];
+            for (var y = 0; y < TextureSize; y++)
+            {
+                for (var x = 0; x < TextureSize; x++)
+                {
+                    // Position relative to the center, from -1 to 1
+                    var u = (x + 0.5f) / TextureSize * 2.0f - 1.0f;
+                    var v = (y + 0.5f) / TextureSize * 2.0f - 1.0f;
+                    var radius = MathF.Sqrt(u * u + v * v);
+
+                    // Radius of the crater in this direction, interpolated between random values
+                    var sector = (MathF.Atan2(v, u) / MathUtil.TwoPi + 0.5f) * RimSectors;
+                    var sectorIndex = (int)sector % RimSectors;
+                    var rimRadius = MathUtil.Lerp(rim[sectorIndex], rim[(sectorIndex + 1) % RimSectors], sector - MathF.Floor(sector));
+
+                    const float HoleRadius = 0.2f;
+                    if (radius < HoleRadius)
+                    {
+                        pixels[y * TextureSize + x] = new Color(8, 7, 6, 255);
+                    }
+                    else
+                    {
+                        var crater = Math.Clamp((radius - HoleRadius) / (rimRadius - HoleRadius), 0.0f, 1.0f);
+                        var shade = (byte)MathUtil.Lerp(30.0f, 70.0f, crater);
+                        var alpha = (byte)(230.0f * MathF.Pow(1.0f - crater, 1.5f));
+                        pixels[y * TextureSize + x] = new Color(shade, (byte)(shade * 0.95f), (byte)(shade * 0.9f), alpha);
+                    }
+                }
+            }
+
+            var texture = Texture.New2D(GraphicsDevice, TextureSize, TextureSize, PixelFormat.R8G8B8A8_UNorm_SRgb, pixels);
+
+            return Material.New(GraphicsDevice, new MaterialDescriptor
+            {
+                Attributes =
+                {
+                    Diffuse = new MaterialDiffuseMapFeature(new ComputeTextureColor(texture)),
+                    DiffuseModel = new MaterialDiffuseLambertModelFeature(),
+                    MicroSurface = new MaterialGlossinessMapFeature(new ComputeFloat(0.2f)),
+                    Specular = new MaterialMetalnessMapFeature(new ComputeFloat(0.0f)),
+                    SpecularModel = new MaterialSpecularMicrofacetModelFeature(),
+                    // The alpha of the texture shapes the bullet hole
+                    Transparency = new MaterialTransparencyBlendFeature(),
+                },
+            });
+        }
+
+        private class BulletHole
+        {
+            public Entity Entity;
+
+            public DecalComponent Decal;
+
+            public float Age;
+        }
+    }
+}
