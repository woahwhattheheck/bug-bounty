+void SceneTree::GridDrop(QDropEvent *event, QListWidgetItem *dragged)
+{
+	QList<QListWidgetItem *> visibleItems = GetVisibleItems();
+	if (visibleItems.isEmpty()) {
+		return;
+	}
+
+	int scrollWid = verticalScrollBar()->sizeHint().width();
+	const QRect firstItem = visualItemRect(visibleItems.first());
+	const QRect lastItem = visualItemRect(visibleItems.last());
+	const int h = lastItem.y() + lastItem.height();
+	const int firstItemY = abs(firstItem.y());
+
+	if (h < height()) {
+		setVerticalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+		scrollWid = 0;
+	} else {
+		setVerticalScrollBarPolicy(Qt::ScrollBarAlwaysOn);
+	}
+
+	float wid = contentsRect().width() - scrollWid - 1;
+	int columns = std::max(1, (int)std::ceil(wid / maxWidth));
+
+	QPoint point = event->position().toPoint();
+
+	int x = (float)point.x() / wid * columns;
+	int y = (point.y() + firstItemY) / itemHeight;
+
+	/* Position among the visible items, without the dragged entry */
+	QList<QListWidgetItem *> otherItems = GetVisibleItems(dragged);
+	int slot = std::clamp(x + y * columns, 0, (int)otherItems.count());
+
+	int destination = slot < otherItems.count() ? row(otherItems[slot]) : count();
+	bool destinationInFolder = false;
+
+	if (slot > 0 && !IsFolder(dragged)) {
+		QListWidgetItem *previous = otherItems[slot - 1];
+		destinationInFolder = IsInFolder(previous) || (IsFolder(previous) && !IsFolderCollapsed(previous));
+	}
+
+	MoveEntryTo(dragged, destination, destinationInFolder);
+}
