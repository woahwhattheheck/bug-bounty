@@ -0,0 +1,48 @@
+// Copyright (c) .NET Foundation and Contributors (https://dotnetfoundation.org/ & https://stride3d.net)
+// Distributed under the MIT license. See the LICENSE.md file in the project root for more information.
+
+using Stride.Core;
+
+namespace Stride.Rendering.Decals
+{
+    /// <summary>
+    /// Sorts decals by <see cref="RenderDecal.SortOrder"/>, then by creation order, so that overlapping decals are
+    /// blended in a stable order and the most recent ones are drawn on top.
+    /// </summary>
+    /// <remarks>
+    /// Sort key pattern: [RenderFeature Sort Key 8 bits] [Decal sort order 32 bits] [unused 24 bits], ties broken by creation order.
+    /// </remarks>
+    [DataContract("DecalSortMode")]
+    public class DecalSortMode : SortMode
+    {
+        /// <inheritdoc/>
+        public override unsafe void GenerateSortKey(RenderView renderView, RenderViewStage renderViewStage, SortKey* sortKeys)
+        {
+            var renderNodes = renderViewStage.RenderNodes;
+
+            for (var i = 0; i < renderNodes.Count; ++i)
+            {
+                var renderNode = renderNodes[i];
+                var renderObject = renderNode.RenderObject;
+
+                sortKeys[i] = new SortKey { Value = ComputeSortKeyValue(renderNode.RootRenderFeature.SortKey, renderObject), Index = i, StableIndex = renderObject.Index };
+            }
+        }
+
+        /// <summary>
+        /// Computes the value of the sort key of a render object.
+        /// </summary>
+        /// <param name="renderFeatureSortKey">The sort key of the render feature of the object.</param>
+        /// <param name="renderObject">The render object.</param>
+        /// <returns>The value of the sort key.</returns>
+        internal static ulong ComputeSortKeyValue(byte renderFeatureSortKey, RenderObject renderObject)
+        {
+            var sortOrder = renderObject is RenderDecal renderDecal ? renderDecal.SortOrder : 0;
+
+            // Flip the sign bit so that negative sort orders come first when compared as unsigned values
+            var orderedSortOrder = unchecked((uint)sortOrder ^ 0x80000000u);
+
+            return ((ulong)renderFeatureSortKey << 56) | ((ulong)orderedSortOrder << 24);
+        }
+    }
+}
diff --git a/sources/engine/Stride.Rendering/Rendering/Decals/RenderDecal.cs b/sources/engine/Stride.Rendering/Rendering/Decals/RenderDecal.cs
new file mode 100644
index 0000000..564e1f9
--- /dev/null
+++ b/sources/engine/Stride.Rendering/Rendering/Decals/RenderDecal.cs
@@ -0,0 +1,132 @@
+// Copyright (c) .NET Foundation and Contributors (https://dotnetfoundation.org/ & https://stride3d.net)
+// Distributed under the MIT license. See the LICENSE.md file in the project root for more information.
+
+using System;
+using Stride.Core.Mathematics;
+
+namespace Stride.Rendering.Decals
+{
+    /// <summary>
+    /// A decal: a material projected onto the opaque geometry that is inside a box volume.
+    /// </summary>
+    /// <remarks>
+    /// <para>
+    /// The volume is the unit cube (from -0.5 to 0.5 on each axis) transformed by <see cref="RenderMesh.World"/>.
+    /// The material is projected along the local forward axis (-Z), with the local X axis mapped to the U texture
+    /// coordinate and the local Y axis mapped to the V texture coordinate (flipped so that the texture is upright).
+    /// </para>
+    /// <para>
+    /// A decal is drawn by the <see cref="MeshRenderFeature"/> like any <see cref="RenderMesh"/>, so it is lit and
+    /// shadowed by the same lights as the rest of the scene. The <see cref="DecalRenderFeature"/> sub render feature
+    /// must be part of the mesh render feature: it reconstructs the receiving surface from the depth buffer and
+    /// projects the material onto it.
+    /// </para>
+    /// </remarks>
+    public class RenderDecal : RenderMesh
+    {
+        /// <summary>
+        /// The largest value used for a fade scale, so that a zero-width fade range becomes a hard cut.
+        /// </summary>
+        internal const float MaxFadeScale = 1.0e4f;
+
+        /// <summary>
+        /// The global opacity of the decal, multiplied with the output of its material.
+        /// </summary>
+        public float Opacity = 1.0f;
+
+        /// <summary>
+        /// The angle, in degrees, between the projection axis and the surface normal from which the decal starts to fade out.
+        /// </summary>
+        public float AngleFadeStart = 60.0f;
+
+        /// <summary>
+        /// The angle, in degrees, between the projection axis and the surface normal from which the decal is no longer visible.
+        /// </summary>
+        public float AngleFadeEnd = 85.0f;
+
+        /// <summary>
+        /// The fraction of the projection depth, at the far end of the volume, over which the decal fades out.
+        /// </summary>
+        public float DepthFade;
+
+        /// <summary>
+        /// The draw order of the decal relative to the other decals. Decals with a higher sort order are drawn on top.
+        /// </summary>
+        public int SortOrder;
+
+        /// <summary>
+        /// Initializes a new instance of the <see cref="RenderDecal"/> class.
+        /// </summary>
+        public RenderDecal()
+        {
+            // A decal only receives light and never occludes anything.
+            IsShadowCaster = false;
+        }
+
+        /// <summary>
+        /// Gets the parameters uploaded to the decal shader: opacity, angle fade scale, angle fade bias and depth fade scale.
+        /// </summary>
+        /// <returns>The packed decal shader parameters.</returns>
+        public Vector4 GetShaderParameters() => ComputeShaderParameters(Opacity, AngleFadeStart, AngleFadeEnd, DepthFade);
+
+        /// <summary>
+        /// Computes the parameters uploaded to the decal shader.
+        /// </summary>
+        /// <param name="opacity">The global opacity of the decal.</param>
+        /// <param name="angleFadeStart">The angle, in degrees, from which the decal starts to fade out.</param>
+        /// <param name="angleFadeEnd">The angle, in degrees, from which the decal is no longer visible.</param>
+        /// <param name="depthFade">The fraction of the projection depth over which the decal fades out.</param>
+        /// <returns>
+        /// The opacity in X; in Y and Z the scale and bias that map the cosine between the surface normal and the projection axis
+        /// to an angle fade factor; in W the scale that maps the normalized distance from the far end of the volume to a depth fade factor.
+        /// </returns>
+        /// <remarks>
+        /// The shader computes <c>saturate(cos(angle) * Y + Z)</c> for the angle fade and <c>saturate((z + 0.5) * W)</c>
+        /// for the depth fade, where <c>z</c> is the position of the receiving surface along the local Z axis of the volume.
+        /// </remarks>
+        public static Vector4 ComputeShaderParameters(float opacity, float angleFadeStart, float angleFadeEnd, float depthFade)
+        {
+            var start = Math.Clamp(angleFadeStart, 0.0f, 180.0f);
+            var end = Math.Clamp(angleFadeEnd, 0.0f, 180.0f);
+            if (end < start)
+                end = start;
+
+            var cosStart = MathF.Cos(MathUtil.DegreesToRadians(start));
+            var cosEnd = MathF.Cos(MathUtil.DegreesToRadians(end));
+
+            // fade = saturate((cos - cosEnd) / (cosStart - cosEnd))
+            var angleRange = cosStart - cosEnd;
+            var angleScale = angleRange > 1.0f / MaxFadeScale ? 1.0f / angleRange : MaxFadeScale;
+            var angleBias = -cosEnd * angleScale;
+
+            // fade = saturate(normalizedDistanceFromFarEnd / depthFade)
+            var clampedDepthFade = Math.Clamp(depthFade, 0.0f, 1.0f);
+            var depthScale = clampedDepthFade > 1.0f / MaxFadeScale ? 1.0f / clampedDepthFade : MaxFadeScale;
+
+            return new Vector4(Math.Clamp(opacity, 0.0f, 1.0f), angleScale, angleBias, depthScale);
+        }
+
+        /// <summary>
+        /// Computes the world matrix of the projection volume of a decal.
+        /// </summary>
+        /// <param name="size">The size of the volume: width and height of the projected area, and depth of the projection.</param>
+        /// <param name="world">The world matrix of the decal entity.</param>
+        /// <returns>The world matrix transforming the unit cube into the projection volume.</returns>
+        public static Matrix ComputeWorldMatrix(Vector3 size, Matrix world)
+        {
+            return Matrix.Scaling(size) * world;
+        }
+
+        /// <summary>
+        /// Computes the world space bounding box of the projection volume of a decal.
+        /// </summary>
+        /// <param name="volumeWorld">The world matrix of the projection volume, see <see cref="ComputeWorldMatrix"/>.</param>
+        /// <returns>The bounding box of the volume in world space.</returns>
+        public static BoundingBoxExt ComputeBoundingBox(Matrix volumeWorld)
+        {
+            var boundingBox = new BoundingBoxExt(new Vector3(-0.5f), new Vector3(0.5f));
+            boundingBox.Transform(volumeWorld);
+            return boundingBox;
+        }
+    }
+}
