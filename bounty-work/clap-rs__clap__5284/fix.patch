+/// Gets the long flags of subcommands and their aliases, with formatted `--` prefix.
+///
+/// Subcommand `pacman sync` with `long_flag("sync")` would be converted to `--sync`.
+fn long_flag_subcommands(p: &clap::Command) -> Vec<CompletionCandidate> {
+    debug!("long_flag_subcommands: name={}", p.get_name());
+
+    p.get_subcommands()
+        .flat_map(|sc| {
+            let visible: Vec<_> = sc
+                .get_long_flag()
+                .into_iter()
+                .chain(sc.get_visible_long_flag_aliases())
+                .collect();
+            let hidden: Vec<_> = sc
+                .get_all_long_flag_aliases()
+                .filter(|s| !visible.contains(s))
+                .collect();
+            let candidate =
+                |s| populate_command_candidate(CompletionCandidate::new(format!("--{s}")), p, sc);
+            let hidden = hidden.into_iter().map(move |s| candidate(s).hide(true));
+            visible.into_iter().map(candidate).chain(hidden)
+        })
+        .collect()
+}
+
+/// Gets the short flags of subcommands and their aliases.
+///
+/// Subcommand `pacman sync` with `short_flag('S')` would be converted to `S`.
+fn short_flag_subcommands(p: &clap::Command) -> Vec<CompletionCandidate> {
+    debug!("short_flag_subcommands: name={}", p.get_name());
+
+    p.get_subcommands()
+        .flat_map(|sc| {
+            let visible: Vec<_> = sc
+                .get_short_flag()
+                .into_iter()
+                .chain(sc.get_visible_short_flag_aliases())
+                .collect();
+            let hidden: Vec<_> = sc
+                .get_all_short_flag_aliases()
+                .filter(|s| !visible.contains(s))
+                .collect();
+            let candidate = |s: char| {
+                populate_command_candidate(CompletionCandidate::new(s.to_string()), p, sc)
+            };
+            let hidden = hidden.into_iter().map(move |s| candidate(s).hide(true));
+            visible.into_iter().map(candidate).chain(hidden)
+        })
+        .collect()
+}
