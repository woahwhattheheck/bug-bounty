+    const {Pressable, Text} = jest.requireActual<typeof ReactNative>('react-native');
+    return {
+        __esModule: true,
+        default: ({onButtonPress}: {onButtonPress: () => void}) =>
+            mockReact.createElement(Pressable, {testID: 'gotItButton', onPress: onButtonPress}, mockReact.createElement(Text, null, 'Got it')),
+    };
+});
