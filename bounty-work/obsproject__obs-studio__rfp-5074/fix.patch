@@ -0,0 +1,35 @@
+#pragma once
+
+#include <string>
+#include <vector>
+
+namespace obs_vst3 {
+
+class MessageWriter;
+
+struct ScannedClass {
+	std::string classId;
+	std::string name;
+	std::string vendor;
+	std::string version;
+	std::string subCategories;
+};
+
+/*
+ * Lists the audio effect classes of one VST3 module. Runs in a dedicated
+ * bridge process (obs-vst3-host --scan) so a plug-in crashing while being
+ * loaded cannot take OBS down. The moduleinfo.json shipped inside modern
+ * bundles is preferred because it does not require loading the binary.
+ */
+class ModuleScanner {
+public:
+	static bool scan(const std::string &modulePath, std::vector<ScannedClass> &classes, std::string &error);
+	static void serialize(const std::vector<ScannedClass> &classes, MessageWriter &writer);
+
+private:
+	static bool scanModuleInfo(const std::string &modulePath, std::vector<ScannedClass> &classes);
+	static bool scanFactory(const std::string &modulePath, std::vector<ScannedClass> &classes, std::string &error);
+	static bool isEffect(const std::string &category, const std::string &subCategories);
+};
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/host/ParameterQueue.cpp b/plugins/obs-vst3/host/ParameterQueue.cpp
new file mode 100644
index 0000000..c365809
--- /dev/null
+++ b/plugins/obs-vst3/host/ParameterQueue.cpp
@@ -0,0 +1,70 @@
+#include "ParameterQueue.hpp"
+
+namespace obs_vst3 {
+
+namespace {
+
+constexpr size_t kReservedChanges = 256;
+
+} // namespace
+
+ParameterQueue::ParameterQueue()
+{
+	pending_.reserve(kReservedChanges);
+}
+
+void ParameterQueue::store(std::vector<ParameterChange> &pending, Steinberg::Vst::ParamID id,
+			   Steinberg::Vst::ParamValue value)
+{
+	/* Only the most recent value of a parameter matters for the next block. */
+	for (ParameterChange &change : pending) {
+		if (change.id == id) {
+			change.value = value;
+			return;
+		}
+	}
+
+	pending.push_back({id, value});
+}
+
+void ParameterQueue::push(Steinberg::Vst::ParamID id, Steinberg::Vst::ParamValue value)
+{
+	std::lock_guard<std::mutex> lock(mutex_);
+	store(pending_, id, value);
+}
+
+void ParameterQueue::drain(std::vector<ParameterChange> &changes)
+{
+	/* The vector is swapped in as the new pending list, keep it allocation free for tryPush(). */
+	changes.clear();
+	changes.reserve(kReservedChanges);
+
+	std::lock_guard<std::mutex> lock(mutex_);
+	changes.swap(pending_);
+}
+
+bool ParameterQueue::tryPush(Steinberg::Vst::ParamID id, Steinberg::Vst::ParamValue value)
+{
+	std::unique_lock<std::mutex> lock(mutex_, std::try_to_lock);
+	if (!lock.owns_lock() || pending_.size() >= pending_.capacity()) {
+		return false;
+	}
+
+	store(pending_, id, value);
+	return true;
+}
+
+bool ParameterQueue::tryDrain(std::vector<ParameterChange> &changes)
+{
+	changes.clear();
+
+	std::unique_lock<std::mutex> lock(mutex_, std::try_to_lock);
+	if (!lock.owns_lock()) {
+		return false;
+	}
+
+	changes.swap(pending_);
+	return true;
+}
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/host/ParameterQueue.hpp b/plugins/obs-vst3/host/ParameterQueue.hpp
new file mode 100644
index 0000000..62b893d
--- /dev/null
+++ b/plugins/obs-vst3/host/ParameterQueue.hpp
@@ -0,0 +1,41 @@
+#pragma once
+
+#include <pluginterfaces/vst/vsttypes.h>
+
+#include <mutex>
+#include <vector>
+
+namespace obs_vst3 {
+
+struct ParameterChange {
+	Steinberg::Vst::ParamID id;
+	Steinberg::Vst::ParamValue value;
+};
+
+/*
+ * Hands parameter changes between the editor (main) thread and the audio
+ * thread. The audio thread side only ever uses try_lock, so it never waits
+ * for the main thread; changes that cannot be transferred immediately are
+ * picked up with the next block.
+ */
+class ParameterQueue {
+public:
+	ParameterQueue();
+
+	/* Main thread. */
+	void push(Steinberg::Vst::ParamID id, Steinberg::Vst::ParamValue value);
+	void drain(std::vector<ParameterChange> &changes);
+
+	/* Audio thread. */
+	bool tryPush(Steinberg::Vst::ParamID id, Steinberg::Vst::ParamValue value);
+	bool tryDrain(std::vector<ParameterChange> &changes);
+
+private:
+	static void store(std::vector<ParameterChange> &pending, Steinberg::Vst::ParamID id,
+			  Steinberg::Vst::ParamValue value);
+
+	std::mutex mutex_;
+	std::vector<ParameterChange> pending_;
+};
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/host/PluginInstance.cpp b/plugins/obs-vst3/host/PluginInstance.cpp
new file mode 100644
index 0000000..d621ad2
--- /dev/null
+++ b/plugins/obs-vst3/host/PluginInstance.cpp
@@ -0,0 +1,596 @@
+#include "PluginInstance.hpp"
+#include "ComponentHandler.hpp"
+#include "HostLog.hpp"
+#include "SpeakerLayouts.hpp"
+
+#include <pluginterfaces/vst/ivstprocesscontext.h>
+#include <pluginterfaces/vst/vstspeaker.h>
+#include <public.sdk/source/common/memorystream.h>
+#include <public.sdk/source/vst/hosting/connectionproxy.h>
