+++ b/plugins/obs-vst3/PluginCatalog.cpp
@@ -0,0 +1,441 @@
+#include "PluginCatalog.hpp"
+#include "HostProcess.hpp"
+#include "bridge/MessageReader.hpp"
+
+#include <obs-module.h>
+#include <util/platform.h>
+
+#include <algorithm>
+#include <cctype>
+#include <filesystem>
+#include <set>
+#include <system_error>
+
+namespace obs_vst3 {
+
+namespace fs = std::filesystem;
+
+namespace {
+
+constexpr int kCacheVersion = 1;
+constexpr int kMaxSearchDepth = 4;
+constexpr int kMaxFingerprintFiles = 512;
+constexpr size_t kClassIdLength = 32;
+
+bool hasVst3Extension(const fs::path &path)
+{
+	std::string extension = path.extension().u8string();
+	std::transform(extension.begin(), extension.end(), extension.begin(),
+		       [](unsigned char character) { return static_cast<char>(std::tolower(character)); });
+	return extension == ".vst3";
+}
+
+} // namespace
+
+std::string PluginDescription::identifier() const
+{
+	return classId + "|" + modulePath;
+}
+
+bool PluginDescription::parseIdentifier(const std::string &identifier, std::string &classId, std::string &modulePath)
+{
+	if (identifier.size() <= kClassIdLength + 1 || identifier[kClassIdLength] != '|') {
+		return false;
+	}
+
+	classId = identifier.substr(0, kClassIdLength);
+	modulePath = identifier.substr(kClassIdLength + 1);
+	return true;
+}
+
+PluginCatalog::PluginCatalog(std::string hostExecutable, std::string cacheFile)
+	: hostExecutable_(std::move(hostExecutable)),
+	  cacheFile_(std::move(cacheFile))
+{
+}
+
+PluginCatalog::~PluginCatalog()
+{
+	if (worker_.joinable()) {
+		worker_.join();
+	}
+}
+
+void PluginCatalog::scanInBackground()
+{
+	std::lock_guard<std::mutex> lock(mutex_);
+	if (scanning_ || worker_.joinable()) {
+		return;
+	}
+
+	scanning_ = true;
+	worker_ = std::thread([this]() {
+		runScan(false);
+
+		std::lock_guard<std::mutex> finishedLock(mutex_);
+		scanning_ = false;
+		scanFinished_.notify_all();
+	});
+}
+
+void PluginCatalog::waitForBackgroundScan()
+{
+	{
+		std::unique_lock<std::mutex> lock(mutex_);
+		scanFinished_.wait(lock, [this]() { return !scanning_; });
+	}
+
+	if (worker_.joinable()) {
+		worker_.join();
+	}
+}
+
+void PluginCatalog::scan(bool forceRescan)
+{
+	waitForBackgroundScan();
+
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		scanning_ = true;
+	}
+
+	runScan(forceRescan);
+
+	std::lock_guard<std::mutex> lock(mutex_);
+	scanning_ = false;
+	scanFinished_.notify_all();
+}
+
+bool PluginCatalog::isScanning() const
+{
+	std::lock_guard<std::mutex> lock(mutex_);
+	return scanning_;
+}
+
+std::vector<PluginDescription> PluginCatalog::plugins() const
+{
+	std::vector<PluginDescription> result;
+
+	std::lock_guard<std::mutex> lock(mutex_);
+	for (const ModuleEntry &module : modules_) {
+		result.insert(result.end(), module.classes.begin(), module.classes.end());
+	}
+
+	std::sort(result.begin(), result.end(), [](const PluginDescription &left, const PluginDescription &right) {
+		std::string leftName = left.name + left.vendor;
+		std::string rightName = right.name + right.vendor;
+		std::transform(leftName.begin(), leftName.end(), leftName.begin(),
+			       [](unsigned char character) { return static_cast<char>(std::tolower(character)); });
+		std::transform(rightName.begin(), rightName.end(), rightName.begin(),
+			       [](unsigned char character) { return static_cast<char>(std::tolower(character)); });
+		return leftName < rightName;
+	});
+
+	return result;
+}
+
+std::vector<std::string> PluginCatalog::findModules() const
+{
+	std::vector<std::string> modules;
+	std::set<std::string> seen;
+
+	for (const std::string &searchPath : defaultSearchPaths()) {
+		std::error_code error;
+		fs::path root = fs::u8path(searchPath);
+		if (!fs::is_directory(root, error)) {
+			continue;
+		}
+
+		auto options = fs::directory_options::follow_directory_symlink |
+			       fs::directory_options::skip_permission_denied;
+		fs::recursive_directory_iterator iterator(root, options, error);
+		for (; !error && iterator != fs::recursive_directory_iterator(); iterator.increment(error)) {
+			const fs::directory_entry &entry = *iterator;
+
+			if (!hasVst3Extension(entry.path())) {
+				if (iterator.depth() >= kMaxSearchDepth) {
+					iterator.disable_recursion_pending();
+				}
+				continue;
+			}
+
+			/* A .vst3 entry is either a bundle directory or a legacy single-file module. */
+			if (entry.is_directory(error)) {
+				iterator.disable_recursion_pending();
+			}
+
+			std::string modulePath = entry.path().lexically_normal().u8string();
+			if (seen.insert(modulePath).second) {
+				modules.push_back(modulePath);
+			}
+		}
+	}
+
+	return modules;
+}
+
+std::string PluginCatalog::fingerprint(const std::string &modulePath)
+{
+	std::error_code error;
+	fs::path path = fs::u8path(modulePath);
+
+	uintmax_t totalSize = 0;
+	int64_t newestWrite = 0;
+	int fileCount = 0;
+
+	auto account = [&](const fs::path &file) {
+		std::error_code fileError;
+		uintmax_t size = fs::file_size(file, fileError);
+		if (!fileError) {
+			totalSize += size;
+		}
+
+		auto written = fs::last_write_time(file, fileError);
+		if (!fileError) {
+			newestWrite = std::max<int64_t>(newestWrite, written.time_since_epoch().count());
+		}
+		fileCount++;
+	};
+
+	if (fs::is_directory(path, error)) {
+		fs::recursive_directory_iterator iterator(path, fs::directory_options::skip_permission_denied, error);
+		for (; !error && iterator != fs::recursive_directory_iterator(); iterator.increment(error)) {
+			if (fileCount >= kMaxFingerprintFiles) {
+				break;
+			}
+			if (iterator->is_regular_file(error)) {
+				account(iterator->path());
+			}
+		}
+	} else {
+		account(path);
+	}
+
+	return std::to_string(fileCount) + ":" + std::to_string(totalSize) + ":" + std::to_string(newestWrite);
+}
+
+bool PluginCatalog::scanModule(const std::string &modulePath, ModuleEntry &entry) const
+{
+	entry.classes.clear();
+	entry.error.clear();
+
+	IpcChannel commandChannel;
+	IpcChannel audioChannel;
+	std::string error;
+	std::unique_ptr<HostProcess> process = HostProcess::launch(hostExecutable_, {"--scan", modulePath}, nullptr,
+								   commandChannel, audioChannel, error);
+	if (!process) {
+		entry.error = error;
+		return false;
+	}
+
+	Command command = Command::Invalid;
+	std::vector<uint8_t> payload;
+	if (!commandChannel.receiveMessage(command, payload, kScanTimeoutMs) || command != Command::ScanModule) {
+		entry.error = process->isRunning() ? "Timed out while scanning"
+						   : "The plug-in crashed while being scanned";
+		return false;
+	}
+
+	process->waitForExit(kShutdownTimeoutMs);
+
+	MessageReader reader(payload);
+	int32_t status = 0;
+	uint32_t count = 0;
+	if (!reader.readInt32(status) || !reader.readString(entry.error)) {
+		entry.error = "Malformed scan result";
+		return false;
+	}
+
+	if (static_cast<Status>(status) != Status::Ok) {
+		if (entry.error.empty()) {
+			entry.error = "The module could not be loaded";
+		}
+		return false;
+	}
+
+	if (!reader.readUInt32(count)) {
+		entry.error = "Malformed scan result";
+		return false;
+	}
+
+	for (uint32_t index = 0; index < count; index++) {
+		PluginDescription description;
+		description.modulePath = modulePath;
+		if (!reader.readString(description.classId) || !reader.readString(description.name) ||
+		    !reader.readString(description.vendor) || !reader.readString(description.version) ||
+		    !reader.readString(description.subCategories)) {
+			entry.error = "Malformed scan result";
+			entry.classes.clear();
+			return false;
+		}
+
+		if (description.classId.size() == kClassIdLength) {
+			entry.classes.push_back(std::move(description));
+		}
+	}
+
+	return true;
+}
+
+void PluginCatalog::runScan(bool forceRescan)
+{
+	loadCache();
+
+	std::vector<ModuleEntry> previous;
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		previous = modules_;
+	}
+
+	std::vector<ModuleEntry> current;
+	int scannedModules = 0;
+	int failedModules = 0;
+
+	for (const std::string &modulePath : findModules()) {
+		std::string moduleFingerprint = fingerprint(modulePath);
+
+		auto cached = std::find_if(previous.begin(), previous.end(), [&modulePath](const ModuleEntry &entry) {
+			return entry.path == modulePath;
+		});
+		if (!forceRescan && cached != previous.end() && cached->fingerprint == moduleFingerprint) {
+			current.push_back(*cached);
+			continue;
+		}
+
+		ModuleEntry entry;
+		entry.path = modulePath;
+		entry.fingerprint = moduleFingerprint;
+		if (!scanModule(modulePath, entry)) {
+			blog(LOG_WARNING, "[obs-vst3] Skipping '%s': %s", modulePath.c_str(), entry.error.c_str());
+			failedModules++;
+		}
+		scannedModules++;
+		current.push_back(std::move(entry));
+	}
+
+	size_t effectCount = 0;
+	for (const ModuleEntry &entry : current) {
+		effectCount += entry.classes.size();
+	}
+
+	blog(LOG_INFO, "[obs-vst3] Found %zu VST3 effect(s) in %zu module(s) (%d scanned, %d failed)", effectCount,
+	     current.size(), scannedModules, failedModules);
+
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		modules_ = std::move(current);
+	}
+
+	saveCache();
+}
+
+void PluginCatalog::loadCache()
+{
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		if (cacheLoaded_) {
+			return;
+		}
+		cacheLoaded_ = true;
+	}
+
+	obs_data_t *cache = obs_data_create_from_json_file(cacheFile_.c_str());
+	if (!cache) {
+		return;
+	}
+
+	std::vector<ModuleEntry> modules;
+	if (obs_data_get_int(cache, "version") == kCacheVersion) {
+		obs_data_array_t *moduleArray = obs_data_get_array(cache, "modules");
+		size_t moduleCount = obs_data_array_count(moduleArray);
+
+		for (size_t moduleIndex = 0; moduleIndex < moduleCount; moduleIndex++) {
+			obs_data_t *moduleData = obs_data_array_item(moduleArray, moduleIndex);
+
+			ModuleEntry entry;
+			entry.path = obs_data_get_string(moduleData, "path");
+			entry.fingerprint = obs_data_get_string(moduleData, "fingerprint");
+			entry.error = obs_data_get_string(moduleData, "error");
+
+			obs_data_array_t *classArray = obs_data_get_array(moduleData, "classes");
+			size_t classCount = obs_data_array_count(classArray);
+			for (size_t classIndex = 0; classIndex < classCount; classIndex++) {
+				obs_data_t *classData = obs_data_array_item(classArray, classIndex);
+
+				PluginDescription description;
+				description.modulePath = entry.path;
+				description.classId = obs_data_get_string(classData, "class_id");
+				description.name = obs_data_get_string(classData, "name");
+				description.vendor = obs_data_get_string(classData, "vendor");
+				description.version = obs_data_get_string(classData, "version");
+				description.subCategories = obs_data_get_string(classData, "sub_categories");
+				if (description.classId.size() == kClassIdLength) {
+					entry.classes.push_back(std::move(description));
+				}
+
+				obs_data_release(classData);
+			}
+			obs_data_array_release(classArray);
+			obs_data_release(moduleData);
+
+			if (!entry.path.empty()) {
+				modules.push_back(std::move(entry));
+			}
+		}
+		obs_data_array_release(moduleArray);
+	}
+	obs_data_release(cache);
+
+	std::lock_guard<std::mutex> lock(mutex_);
+	modules_ = std::move(modules);
+}
+
+void PluginCatalog::saveCache() const
+{
+	obs_data_t *cache = obs_data_create();
+	obs_data_array_t *moduleArray = obs_data_array_create();
+
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+		for (const ModuleEntry &entry : modules_) {
+			obs_data_t *moduleData = obs_data_create();
+			obs_data_set_string(moduleData, "path", entry.path.c_str());
+			obs_data_set_string(moduleData, "fingerprint", entry.fingerprint.c_str());
+			obs_data_set_string(moduleData, "error", entry.error.c_str());
+
+			obs_data_array_t *classArray = obs_data_array_create();
+			for (const PluginDescription &description : entry.classes) {
+				obs_data_t *classData = obs_data_create();
+				obs_data_set_string(classData, "class_id", description.classId.c_str());
+				obs_data_set_string(classData, "name", description.name.c_str());
+				obs_data_set_string(classData, "vendor", description.vendor.c_str());
+				obs_data_set_string(classData, "version", description.version.c_str());
+				obs_data_set_string(classData, "sub_categories", description.subCategories.c_str());
+				obs_data_array_push_back(classArray, classData);
+				obs_data_release(classData);
+			}
+			obs_data_set_array(moduleData, "classes", classArray);
+			obs_data_array_release(classArray);
+
+			obs_data_array_push_back(moduleArray, moduleData);
+			obs_data_release(moduleData);
+		}
+	}
+
+	obs_data_set_int(cache, "version", kCacheVersion);
+	obs_data_set_array(cache, "modules", moduleArray);
+	obs_data_array_release(moduleArray);
+
+	std::string directory = fs::u8path(cacheFile_).parent_path().u8string();
+	if (!directory.empty()) {
+		os_mkdirs(directory.c_str());
+	}
+
+	if (!obs_data_save_json_safe(cache, cacheFile_.c_str(), "tmp", "bak")) {
+		blog(LOG_WARNING, "[obs-vst3] Could not write the plug-in cache '%s'", cacheFile_.c_str());
+	}
+	obs_data_release(cache);
+}
+
+} // namespace obs_vst3
diff --git a/plugins/obs-vst3/PluginCatalog.hpp b/plugins/obs-vst3/PluginCatalog.hpp
new file mode 100644
index 0000000..f300446
--- /dev/null
+++ b/plugins/obs-vst3/PluginCatalog.hpp
@@ -0,0 +1,85 @@
+#pragma once
+
+#include <condition_variable>
+#include <cstdint>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace obs_vst3 {
+
+/* One audio effect class found in a VST3 module. */
+struct PluginDescription {
+	std::string modulePath;
+	std::string classId;
+	std::string name;
+	std::string vendor;
+	std::string version;
+	std::string subCategories;
+
+	/* Value stored in the filter settings: "<class id>|<module path>". */
+	std::string identifier() const;
+	static bool parseIdentifier(const std::string &identifier, std::string &classId, std::string &modulePath);
+};
+
+/*
+ * Discovers VST3 modules in the standard locations and keeps a cache of the
+ * effect classes they contain.
+ *
+ * Each new or modified module is inspected by a short-lived obs-vst3-host
+ * process ("--scan"), so a plug-in that crashes or hangs while loading never
+ * affects OBS. Results (including failures) are cached in the module config
+ * directory keyed by path and a fingerprint of the bundle contents, so later
+ * scans only look at modules that changed.
+ */
+class PluginCatalog {
+public:
+	PluginCatalog(std::string hostExecutable, std::string cacheFile);
+	~PluginCatalog();
+
+	PluginCatalog(const PluginCatalog &) = delete;
+	PluginCatalog &operator=(const PluginCatalog &) = delete;
+
+	/* Starts a scan on a background thread (used at module load). */
+	void scanInBackground();
+
+	/* Scans synchronously; waits for a background scan first. */
+	void scan(bool forceRescan);
+
+	std::vector<PluginDescription> plugins() const;
+	bool isScanning() const;
+	const std::string &hostExecutable() const { return hostExecutable_; }
+
+	/* Standard VST3 locations of the current platform (PluginCatalog_<platform>.cpp). */
+	static std::vector<std::string> defaultSearchPaths();
+
+private:
+	struct ModuleEntry {
+		std::string path;
+		std::string fingerprint;
+		std::string error;
+		std::vector<PluginDescription> classes;
+	};
+
+	void runScan(bool forceRescan);
+	void waitForBackgroundScan();
+	std::vector<std::string> findModules() const;
+	bool scanModule(const std::string &modulePath, ModuleEntry &entry) const;
+	void loadCache();
+	void saveCache() const;
+
+	static std::string fingerprint(const std::string &modulePath);
+
+	std::string hostExecutable_;
+	std::string cacheFile_;
+
+	mutable std::mutex mutex_;
+	std::condition_variable scanFinished_;
+	std::vector<ModuleEntry> modules_;
+	bool scanning_ = false;
+	bool cacheLoaded_ = false;
+	std::thread worker_;
+};
+
+} // namespace obs_vst3
