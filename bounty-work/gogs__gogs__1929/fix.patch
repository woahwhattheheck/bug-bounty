Subject: [PATCH 1/2] style(gitdaemon): gofmt struct literal alignment (#1929)

The previous gofmt pass left the request literal in parseRequest and the
TestParseRequest table misaligned after gitProtocol/expProtocol were
added, so the golangci-lint gofmt formatter fails on both files.
---
 internal/gitdaemon/gitdaemon.go      |  8 +++---
 internal/gitdaemon/gitdaemon_test.go | 38 ++++++++++++++--------------
 2 files changed, 23 insertions(+), 23 deletions(-)

diff --git a/internal/gitdaemon/gitdaemon.go b/internal/gitdaemon/gitdaemon.go
index 301415e5..b540855b 100644
--- a/internal/gitdaemon/gitdaemon.go
+++ b/internal/gitdaemon/gitdaemon.go
@@ -148,10 +148,10 @@ func parseRequest(payload []byte) (*request, error) {
 	repoName = strings.TrimSuffix(repoName, ".wiki")
 
 	return &request{
-		service: service,
-		path:    strings.ToLower(repoPath),
-		owner:   strings.ToLower(ownerName),
-		repo:    strings.ToLower(repoName),
+		service:     service,
+		path:        strings.ToLower(repoPath),
+		owner:       strings.ToLower(ownerName),
+		repo:        strings.ToLower(repoName),
 		gitProtocol: requestedGitProtocol(payload),
 	}, nil
 }
